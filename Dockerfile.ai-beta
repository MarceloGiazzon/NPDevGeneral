FROM mcr.microsoft.com/powershell:7.4-debian-12

ENV DEBIAN_FRONTEND=noninteractive \
    NPDEV_AI_BETA_CONTAINER=true \
    TZ=UTC

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        openjdk-17-jdk \
        nodejs \
        npm \
        unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["pwsh", "./scripts/quality/run-ai-beta-gate.ps1"]
