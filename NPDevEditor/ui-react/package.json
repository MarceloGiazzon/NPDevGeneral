{
  "name": "npdev-ui-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:stage": "node ./scripts/stage-playwright-static-host.mjs",
    "e2e:generated-app": "playwright test --config=playwright.generated-app.config.ts",
    "build:templates": "vite build && node ./scripts/export-to-generator.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^5.6.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  }
}
