{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/tenant-samples-catalog.schema.json",
  "title": "NPDev Tenant Samples Catalog",
  "type": "object",
  "required": ["version", "samples"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "modelPath", "configPath", "status"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "modelPath": { "type": "string", "minLength": 1 },
          "configPath": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
