        {
          "name": "status",
          "type": "enum",
          "enumValues": [
            "Pending",
            "Confirmed",
            "Seated",
            "Cancelled",
            "NoShow"
          ],
          "required": true,
          "ui": {
            "label": "Status",
            "widget": "select"
          }
        }
      ],
      "lifecycle": {
        "statusField": "status",
        "states": [
          {
            "value": "Pending",
            "label": "Pending",
            "initial": true
          },
          {
            "value": "Confirmed",
            "label": "Confirmed"
          },
          {
            "value": "Seated",
            "label": "Seated",
            "terminal": true
          },
          {
            "value": "Cancelled",
            "label": "Cancelled",
            "terminal": true
          },
          {
            "value": "NoShow",
            "label": "No show",
            "terminal": true
          }
        ],
        "transitions": [
          {
            "from": "Pending",
            "to": "Confirmed",
            "event": "ReservationConfirmed",
            "actionLabel": "Confirm reservation"
          },
          {
            "from": "Confirmed",
            "to": "Seated",
            "event": "ReservationSeated",
            "actionLabel": "Seat party"
          },
          {
            "from": "Pending",
            "to": "Cancelled",
            "event": "ReservationCancelled",
            "actionLabel": "Cancel reservation"
          },
          {
            "from": "Confirmed",
            "to": "Cancelled",
            "event": "ReservationCancelled",
            "actionLabel": "Cancel reservation"
          },
          {
            "from": "Confirmed",
            "to": "NoShow",
            "event": "ReservationNoShow",
            "actionLabel": "Mark no-show"
          }
        ]
      },
      "invariants": [
        {
          "name": "ReservationTenantRequired",
          "expr": "tenantId != null"
