          {
            "value": "Submitted",
            "label": "Submitted"
          },
          {
            "value": "Paid",
            "label": "Paid",
            "terminal": true
          },
          {
            "value": "Cancelled",
            "label": "Cancelled",
            "terminal": true
          }
        ],
        "transitions": [
          {
            "from": "Open",
            "to": "Submitted",
            "event": "DiningOrderSubmitted",
            "actionLabel": "Submit order"
          },
          {
            "from": "Submitted",
            "to": "Paid",
            "requiredPayload": [
              "paidAt"
            ],
            "guard": "paidAt != null",
            "event": "DiningOrderPaid",
            "actionLabel": "Mark paid"
          },
          {
            "from": "Open",
            "to": "Cancelled",
            "event": "DiningOrderCancelled",
            "actionLabel": "Cancel order"
          }
        ]
      },
