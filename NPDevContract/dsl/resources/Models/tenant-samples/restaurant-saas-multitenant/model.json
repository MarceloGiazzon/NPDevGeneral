      "tenantReferenceField": "tenantId",
      "sampleTenants": [
        "Pizza House",
        "Sushi Bar",
        "Vegan Bistro"
      ],
      "currentRuntimeBoundary": "CRUD rows carry tenantId. Automatic authenticated-tenant CRUD filtering is not claimed by this sample."
    }
  },
