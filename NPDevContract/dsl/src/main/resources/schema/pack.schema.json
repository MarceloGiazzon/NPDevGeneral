{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/npdev-pack.schema.json",
  "title": "NPDev DSL 1.0.0 Pack",
  "description": "A named, versioned domain module that groups concepts and capabilities for composition into app models.",
  "type": "object",
  "required": [
    "dslVersion",
    "pack",
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "dslVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "pack": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Pack identifier (lowercase, no spaces). Used as the namespace prefix for all definitions contributed by this pack."
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "description": "Optional Java/package namespace for generated code."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "packs": {
      "type": "array",
      "description": "PK-3: transitive pack dependencies -- local files only, resolved via npdev.lock, never a network fetch. `version` is a minimal constraint: an exact version (\"2.0.3\") or a caret constraint (\"^2.0\", compatible-within-major -- same major, minor/patch at least as high).",
      "items": {
        "type": "object",
        "required": ["pack", "version"],
        "properties": {
          "pack": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(\\^)?\\d+\\.\\d+(\\.\\d+)?$"
          }
        },
        "additionalProperties": false
      }
    },
    "requires": {
      "type": "object",
      "description": "PK-3: what this pack needs from the composing app (or from a transitive importer's own provides). Composition refuses when a requirement is unbound -- see model.schema.json's root `provides`.",
      "properties": {
        "roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "network": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/concept" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "domainTypes": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/domainType" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/capability" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "customCapabilities": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/capability" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/binding" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/event" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/flow" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "orchestrationRules": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/orchestrationRule" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "orchestrations": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/orchestrationRule" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/query" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "ruleProfiles": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/ruleProfile" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "procedures": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/procedure" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "conversions": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/conversion" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/panel" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "aggregates": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/aggregate" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "autoPanels": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/autoPanel" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/document" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "selectors": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/selector" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "guidePages": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/guidePage" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/role" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "webhooks": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/webhook" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      },
      "description": "R6.2: a pack may declare inbound webhook doors alongside its other members. `source` is never namespace-qualified by pack composition (see model.schema.json's webhook $def)."
    },
    "sequences": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/sequence" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      },
      "description": "R5.3: a pack may declare document-numbering counters alongside its other members. `name` is never namespace-qualified by pack composition (see model.schema.json's sequence $def)."
    },
    "propertyScopes": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/propertyScope" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/property" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "B20 (S2): the other bounded contexts this context fragment may reference via context::Concept (D1). An unlisted context named in a context::Concept reference is a compile error, never a silent resolve-to-nothing (D3, X0). The import graph must be acyclic -- a cycle is a compile error, not a warning."
    },
    "metadata": {
      "type": "object"
    },
    "fragments": {
      "type": "array",
      "items": {
        "$ref": "model.schema.json#/$defs/localModelRef"
      }
    },
    "category": {
      "type": "string",
      "enum": ["security", "web-ui", "crypto", "bots", "ai-tools", "finance", "math", "other"],
      "description": "Author-ecosystem catalog grouping shown in the Store panel's drill-down."
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "description": "Free-text attribution for who published this pack."
    },
    "forkedFrom": {
      "type": "object",
      "description": "Attribution when this pack was derived from another published pack.",
      "required": ["pack", "version"],
      "properties": {
        "pack": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "originAuthor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "migrations": {
      "type": "object",
      "description": "PK-4 Stage A/B/C: the migration-replay chain for this pack's version history, keyed '<oldVersion> -> <newVersion>' (e.g. \"1.0.0 -> 1.1.0\"). `npdev pack publish` auto-populates an empty array here for every non-BREAKING (ADDITIVE/PATCH-only, or no-op) version bump -- see com.npdev.dsl.v1.pack.PackPublishGate. A non-empty array is hand-authored by the pack author for a BREAKING bump, one op per DSL-level change the hop actually made; com.npdev.dsl.v1.pack.PackMigrationComposer composes hops across a multi-version jump and synthesizes the renamedFrom markers com.npdev.dsl.v1.pack.PackMigrationChainSynthesizer injects before the app model is generated. Once published, a hop's array is immutable -- see PackPublishGate's chain-immutability check.",
      "propertyNames": {
        "pattern": "^\\d+\\.\\d+\\.\\d+ -> \\d+\\.\\d+\\.\\d+$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "description": "A field was renamed within the same concept.",
              "properties": {
                "op": { "const": "renameField" },
                "concept": { "type": "string", "minLength": 1 },
                "from": { "type": "string", "minLength": 1 },
                "to": { "type": "string", "minLength": 1 }
              },
              "required": ["op", "concept", "from", "to"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "A concept itself was renamed.",
              "properties": {
                "op": { "const": "renameConcept" },
                "from": { "type": "string", "minLength": 1 },
                "to": { "type": "string", "minLength": 1 }
              },
              "required": ["op", "from", "to"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Audit trail only -- never consulted by renamedFrom synthesis, since an added field needs no replay to reach the new pack version cleanly.",
              "properties": {
                "op": { "const": "addField" },
                "concept": { "type": "string", "minLength": 1 },
                "field": { "type": "string", "minLength": 1 }
              },
              "required": ["op", "concept", "field"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Audit trail only -- never consulted by renamedFrom synthesis; a dropped field is an ordinary, ack-token-gated destructive change with no rename to preserve.",
              "properties": {
                "op": { "const": "dropField" },
                "concept": { "type": "string", "minLength": 1 },
                "field": { "type": "string", "minLength": 1 }
              },
              "required": ["op", "concept", "field"],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "firstPublishedVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "REG-151: the pack's own true first-ever-published version, pinned once by `npdev pack publish --write` (either at this pack's first publish under this field's existence, backfilled from its migrations chain's own earliest hop, or -- for a pack with no chain yet -- copied from its own current `version`) and immutable thereafter, exactly like a migrations hop (see PackPublishGate's chain-immutability check). Exists as a trust anchor independent of the migrations chain's own current content: PackDependencyGraphWalker's untracked-pack fallback prefers this field over PackMigrationChain.earliestFromVersion() (which can be fooled if the chain's own earliest hop is later removed/truncated by a hand-edit that bypasses the publish gate)."
    }
  },
  "additionalProperties": false
}
