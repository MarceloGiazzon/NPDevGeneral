{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "npdev:ai-catalog:card.v1",
  "title": "AI catalog L1 card (generated by scripts/pack-repo/build-ai-catalog.py; never hand-written)",
  "type": "object",
  "required": ["id", "version", "trust", "need", "provides", "use", "limit"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "trust": {"enum": ["draft", "verified", "certified"], "description": "draft = composes; verified = built-in or reached 'probed'; certified = owner-reviewed"},
    "need": {"type": "string", "maxLength": 120, "description": "the user need in plain words, the same line as L0"},
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concepts": {"type": "array", "items": {"type": "string"}, "description": "Name(keyField, keyField, status:A|B|C)"},
        "roles": {"type": "array", "items": {"type": "string"}, "description": "logical role to bind -> what it may do"},
        "flows": {"type": "array", "items": {"type": "string"}, "description": "FlowName(input) -> effect"},
        "events": {"type": "array", "items": {"type": "string"}},
        "functions": {"type": "array", "items": {"type": "string"}},
        "screens": {"type": "array", "items": {"type": "string"}},
        "extendPoints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "requires": {"type": "array", "items": {"type": "string"}},
    "use": {"type": "string", "maxLength": 600, "description": "the exact JSON line to put in a model's packs[] to consume the pack"},
    "limit": {"type": "string", "maxLength": 200, "description": "the first handoff limit / reviewNotes line"},
    "budgetTokens": {"type": "integer", "maximum": 350}
  }
}
