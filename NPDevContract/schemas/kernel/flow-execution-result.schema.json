{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://npdev.local/contracts/flow-execution-result.schema.json",
    "title":  "NPDev Kernel Flow Execution Result",
    "type":  "object",
    "additionalProperties":  true,
    "properties":  {
                       "contractVersion":  {
                                               "description":  "Kernel result contract version.",
                                               "type":  "string"
                                           },
                       "status":  {
                                      "description":  "Execution status.",
                                      "type":  "string"
                                  },
                       "output":  {
                                      "type":  "object",
                                      "description":  "Flow output payload.",
                                      "additionalProperties":  true
                                  },
                       "diagnostics":  {
                                           "type":  "array",
                                           "description":  "Warnings or errors from flow execution.",
                                           "items":  {
                                                         "type":  "object",
                                                         "additionalProperties":  true
                                                     }
                                       }
                   },
    "required":  [
                     "contractVersion",
                     "status"
                 ]
}
