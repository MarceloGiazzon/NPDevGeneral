{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "npdev:pack-workshop:probe.v1",
  "title": "Pack behaviour probe (packs/<id>/probes/*.json, run by `npdev pack workshop test`)",
  "description": "A declarative script of REST calls against a booted consumer app, one acting identity per step. Written by the authoring AI next to its pack; run by the workshop, never by the AI. Variables: ${name} from a step's `save`, ${rand} (unique per run).",
  "type": "object",
  "required": ["schemaVersion", "pack", "users", "steps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "npdev-pack-probe.v1"},
    "pack": {"type": "string"},
    "description": {"type": "string"},
    "users": {
      "type": "array",
      "minItems": 1,
      "description": "Identities the runner creates (one static API key each). `role` is the role token the identity holds; omit for a signed-in user with no role.",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "role": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "as", "method", "path", "expect"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "as": {"type": "string", "description": "a name from `users`"},
          "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
          "path": {"type": "string", "pattern": "^/"},
          "body": {},
          "expect": {
            "type": "object",
            "required": ["status"],
            "additionalProperties": false,
            "properties": {
              "status": {"anyOf": [{"type": "integer"}, {"type": "array", "minItems": 1, "items": {"type": "integer"}}]},
              "json": {"type": "object", "description": "dotted path (content.0.name) -> exact value the response must hold"},
              "has": {"type": "array", "items": {"type": "string"}, "description": "dotted paths that must exist in the response"},
              "rows": {
                "type": "object",
                "additionalProperties": false,
                "description": "row count of a list response (totalElements, else the array length)",
                "properties": {"min": {"type": "integer"}, "max": {"type": "integer"}, "exact": {"type": "integer"}}
              }
            }
          },
          "save": {"type": "object", "description": "variable name -> dotted path in the response to remember", "additionalProperties": {"type": "string"}}
        }
      }
    }
  }
}
