{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/npdev-config-v1.schema.json",
  "title": "NPDev Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configVersion",
    "scenario",
    "generator",
    "bootstrap",
    "artifact",
    "finalExec",
    "database",
    "runtime"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "configVersion": {
      "type": "string",
      "const": "1.0"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outputRoot"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "outputRoot": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failIfModelMissing",
        "failIfConfigMissing",
        "cleanOutputBeforeGenerate",
        "emitPluginAssets",
        "emitRuntimeAssets",
        "emitUiAssets"
      ],
      "properties": {
        "failIfModelMissing": { "type": "boolean" },
        "failIfConfigMissing": { "type": "boolean" },
        "cleanOutputBeforeGenerate": { "type": "boolean" },
        "emitPluginAssets": { "type": "boolean" },
        "emitRuntimeAssets": { "type": "boolean" },
        "emitUiAssets": { "type": "boolean" }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "mergeStrategy"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "mergeStrategy": {
          "type": "string",
          "enum": ["clean-copy", "robocopy-merge"]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "generatedFolderName", "libsFolderName", "metaFolderName"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "generatedFolderName": {
          "type": "string",
          "minLength": 1
        },
        "libsFolderName": {
          "type": "string",
          "minLength": 1
        },
        "metaFolderName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finalExec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "deleteBeforeMount"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "deleteBeforeMount": {
          "type": "boolean"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "host",
        "port",
        "database",
        "username",
        "password",
        "adminDatabase",
        "resetMode"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["docker-postgres", "postgres"]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        },
        "adminDatabase": {
          "type": "string",
          "minLength": 1
        },
        "resetMode": {
          "type": "string",
          "enum": ["reset", "preserve"]
        },
        "containerName": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["springProfile", "serverPort", "javaArgs", "gradleTask"],
      "properties": {
        "springProfile": {
          "type": "string",
          "minLength": 1
        },
        "serverPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "javaArgs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gradleTask": {
          "type": "string",
          "enum": ["bootRun"]
        }
      }
    },
    "build": {
      "type": "object",
      "description": "deps-and-java/PLAN.md D1/D2: build facts, not domain truth -- kept out of model.json on purpose (a new model.json array triggers the four-place threading hazard that produced REG-108).",
      "additionalProperties": false,
      "properties": {
        "javaVersion": {
          "type": "integer",
          "description": "The generated app's own Gradle toolchain language version. Platform modules (dsl/kernel/generator/adapters/runtimehost source) stay pinned at 17 regardless of this value -- only the generated app's own compile/run toolchain is variable. ROUND2_PLAN.md R1c: no upper enum on purpose -- any integer >=17 is accepted at this layer; the real ceiling (whatever the generated app's own bundled Gradle wrapper/foojay resolver can actually resolve a JDK for) is enforced by Gradle itself at build time, not guessed at here.",
          "minimum": 17,
          "default": 17
        },
        "repositories": {
          "type": "array",
          "description": "deps-and-java/PLAN.md W2.1: extra Maven repositories the app's own build.dependencies[] may need beyond mavenCentral() (always implicitly available).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1, "pattern": "^https?://" }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "description": "deps-and-java/PLAN.md W2.1/D2 (AppDependenciesEmitter, npdev-dependencies.gradle): app-scoped third-party dependencies. String shorthand = implementation + Maven coordinate.",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^:\\s]+:[^:\\s]+:[^:\\s]+$",
                "description": "Maven coordinate shorthand (groupId:artifactId:version), implementation scope."
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["coordinate"],
                "properties": {
                  "coordinate": { "type": "string", "minLength": 1, "pattern": "^[^:\\s]+:[^:\\s]+:[^:\\s]+$" },
                  "scope": { "type": "string", "enum": ["implementation", "runtimeOnly", "compileOnly", "testImplementation"] }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["jar"],
                "description": "A local jar, resolved relative to <model.json's own directory>/libs/ at generation time.",
                "properties": {
                  "jar": { "type": "string", "minLength": 1 },
                  "scope": { "type": "string", "enum": ["implementation", "runtimeOnly", "compileOnly", "testImplementation"] }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["platform"],
                "description": "A Maven BOM, imported via Gradle's platform(...) so it constrains versions without itself becoming a direct dependency.",
                "properties": {
                  "platform": { "type": "string", "minLength": 1, "pattern": "^[^:\\s]+:[^:\\s]+:[^:\\s]+$" }
                }
              }
            ]
          }
        }
      }
    },
    "trialDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiKey": {
          "type": "string",
          "minLength": 1
        },
        "recommendedProfiles": {
          "type": "string",
          "minLength": 1
        },
        "runtimeUrl": {
          "type": "string",
          "minLength": 1
        },
        "databaseMode": {
          "type": "string",
          "enum": ["step0-h2", "docker-postgres", "postgres"]
        },
        "pluginDiscoveryMode": {
          "type": "string",
          "enum": ["classpath", "filesystem-folder"]
        },
        "pluginPackageDirectory": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "description": "Behaviour-setting defaults for the whole app, as settingId -> value (NPDev resolution-pipeline envelope).",
      "additionalProperties": {
        "type": ["boolean", "string", "integer", "number"]
      }
    },
    "overrides": {
      "type": "object",
      "description": "Per-target setting overrides keyed by selector (module:Name | concept:Name | field:Concept.field).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": ["boolean", "string", "integer", "number"]
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
