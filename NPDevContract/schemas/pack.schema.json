{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/npdev-pack.schema.json",
  "title": "NPDev DSL 1.0.0 Pack",
  "description": "A named, versioned domain module that groups concepts and capabilities for composition into app models.",
  "type": "object",
  "required": [
    "dslVersion",
    "pack",
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "dslVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "pack": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Pack identifier (lowercase, no spaces). Used as the namespace prefix for all definitions contributed by this pack."
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "description": "Optional Java/package namespace for generated code."
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/concept" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "domainTypes": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/domainType" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/capability" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "customCapabilities": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/capability" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/binding" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/event" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/flow" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "orchestrationRules": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/orchestrationRule" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "orchestrations": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/orchestrationRule" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/query" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "ruleProfiles": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/ruleProfile" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "procedures": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/procedure" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "conversions": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/conversion" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/panel" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/role" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "propertyScopes": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/propertyScope" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "model.schema.json#/$defs/property" },
          { "$ref": "model.schema.json#/$defs/localModelRef" }
        ]
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "B20 (S2): the other bounded contexts this context fragment may reference via context::Concept (D1). An unlisted context named in a context::Concept reference is a compile error, never a silent resolve-to-nothing (D3, X0). The import graph must be acyclic -- a cycle is a compile error, not a warning."
    },
    "metadata": {
      "type": "object"
    },
    "fragments": {
      "type": "array",
      "items": {
        "$ref": "model.schema.json#/$defs/localModelRef"
      }
    },
    "category": {
      "type": "string",
      "enum": ["security", "web-ui", "crypto", "bots", "ai-tools", "finance", "math", "other"],
      "description": "Author-ecosystem catalog grouping shown in the Store panel's drill-down."
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "description": "Free-text attribution for who published this pack."
    },
    "forkedFrom": {
      "type": "object",
      "description": "Attribution when this pack was derived from another published pack.",
      "required": ["pack", "version"],
      "properties": {
        "pack": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "originAuthor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "migrations": {
      "type": "object",
      "description": "PK-4 Stage A/B: the migration-replay chain for this pack's version history, keyed '<oldVersion> -> <newVersion>' (e.g. \"1.0.0 -> 1.1.0\"). `npdev pack publish` auto-populates an empty array here for every non-BREAKING (ADDITIVE/PATCH-only, or no-op) version bump -- see com.npdev.dsl.v1.pack.PackPublishGate. What a non-empty array contains is Stage C's contract, not yet defined here; this field only reserves the shape so a chain link exists to be filled in later, without another schema change.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  },
  "additionalProperties": false
}
