{
  "schemaVersion": "npdev-doc-inventory-policy.v1",
  "rule": "Process/programme markdown is BANNED as a repo artifact. A plan, checklist, findings log, handoff, retrospective, session digest or status register is an agent's or a programme's WORKING STATE, not documentation. Write it to the evidence directory (NPDev_General__OutsideRepo) or record it as structured data under ledger/. Durable machine truth belongs in JSON/YAML; durable human docs belong in docs/ and are few.",
  "why": "Measured 2026-08-11: 302 tracked .md files / 59,754 lines, of which 265 files / 39,705 lines were read by NOTHING -- 88% of the files served no machine purpose. They accumulated because each session externalised its state as a new document, then gates were written against those documents, and the documents could no longer be deleted.",
  "processDocPatterns": [
    {
      "pattern": "_PLAN\\.md$",
      "describes": "a plan"
    },
    {
      "pattern": "_CHECKLISTS?\\.md$",
      "describes": "a work checklist"
    },
    {
      "pattern": "_FINDINGS\\.md$",
      "describes": "a findings log"
    },
    {
      "pattern": "_HANDOFF\\.md$",
      "describes": "a session handoff"
    },
    {
      "pattern": "_RETROSPECTIVE\\.md$",
      "describes": "a retrospective"
    },
    {
      "pattern": "_ADVERSARIAL_REVIEW\\.md$",
      "describes": "a review-round record"
    },
    {
      "pattern": "_IMPLEMENTATION_NOTES\\.md$",
      "describes": "implementation notes"
    },
    {
      "pattern": "_REGISTER\\.md$",
      "describes": "a status register"
    },
    {
      "pattern": "_ROADMAP\\.md$",
      "describes": "a roadmap"
    },
    {
      "pattern": "_GAPS\\.md$",
      "describes": "a gaps log"
    },
    {
      "pattern": "_SNAPSHOT\\.md$",
      "describes": "a point-in-time snapshot"
    },
    {
      "pattern": "(^|/)MOVE\\d+[^/]*\\.md$",
      "describes": "a numbered programme move"
    },
    {
      "pattern": "(^|/)AI_SESSION_[^/]*\\.md$",
      "describes": "a session digest"
    },
    {
      "pattern": "_SPEC\\.md$",
      "describes": "a programme spec"
    },
    {
      "pattern": "_BRIEFS?[^/]*\\.md$",
      "describes": "a briefing note"
    }
  ],
  "exempt": [
