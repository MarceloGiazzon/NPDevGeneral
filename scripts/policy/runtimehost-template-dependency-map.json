{
  "version": 1,
  "contracts": [
    {
      "id": "networknt-schema-validator",
      "description": "Generated RuntimeHost sample apps emit plugin schema validators that import com.networknt.schema classes and therefore require the RuntimeHost build template to declare the networknt JSON schema validator dependency.",
      "sampleSearchRoot": "NPDevSamples\\simple-contact-intake\\Output\\App\\src\\main\\java",
      "requiredImportPatterns": [
        "import com.networknt.schema.JsonSchema;",
        "import com.networknt.schema.JsonSchemaFactory;",
        "import com.networknt.schema.SpecVersion;",
        "import com.networknt.schema.ValidationMessage;"
      ],
      "requiredGradleCoordinates": [
        "com.networknt:json-schema-validator:1.5.6"
      ]
    }
  ],
  "migrationLayout": {
    "sampleAppRoot": "NPDevSamples\\simple-contact-intake\\Output\\App",
    "canonicalMigrationRoot": "src\\main\\resources\\db\\migration",
    "forbiddenGeneratedMigrationRoot": "npdev-generated\\src\\main\\resources\\db\\migration",
    "verificationTasks": [
      "enforceSingleMigrationSource",
      "test"
    ]
  }
}
