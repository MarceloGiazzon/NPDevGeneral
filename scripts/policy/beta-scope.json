    "workspaceRootRequired": true
  },
  "sourceOfTruth": {
    "scopePolicy": "scripts/policy/beta0-scope.json",
    "aiBetaProofReport": "scripts/reports/out/ai-beta-gate-report.json",
    "releaseProofReport": "scripts/reports/out/beta-release-gate-report.json",
    "finalProofReport": "scripts/reports/out/beta0-final-release-check-report.json"
  },
  "readinessRule": "Expanded AI-only Beta 0 is blocked unless the final release check validates every blocking report from scripts/reports/blocking-report-manifest.json against the current expanded contract version and current runId.",
  "legacyContext": {
    "previousPolicyVersion": "npdev-beta-scope.v1",
    "note": "The previous simple-crud-workflow-only policy is intentionally invalid for expanded Beta 0 release evidence."
  }
}
