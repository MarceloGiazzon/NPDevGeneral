{
  "schemaVersion": "npdev-beta-scope.v1",
  "release": "ai-only-beta-0",
  "supportedSurfaces": {
    "inputContracts": [
      "ai-model.v1",
      "ai-generator-config.v1",
      "ai-verification-report.v1"
    ],
    "officialContracts": [
      "model.schema.json",
      "config.schema.json"
    ],
    "verificationMedium": "rest-smoke-checks",
    "runtimeProfile": "ai-beta-local",
    "databaseModes": [
      "embedded-test",
      "docker-postgres"
    ],
    "appKinds": [
      "simple-crud-workflow"
    ]
  },
  "excludedSurfaces": [
    "public-production-deployment",
    "arbitrary-shell",
    "arbitrary-custom-code",
    "external-network-by-default",
    "manual-smoke-pass",
    "production-auth",
    "multi-cloud-deployment",
    "ui-only-required-verification"
  ],
  "commandExecution": {
    "mode": "controlled-runner-required",
    "defaultTimeoutSeconds": 300,
    "maxTimeoutSeconds": 600,
    "network": "disabled-by-default",
    "workspaceRootRequired": true
  },
  "sourceOfTruth": {
    "aiBetaProofReport": "scripts/reports/out/ai-beta-gate-report.json",
    "releaseProofReport": "scripts/reports/out/beta-release-gate-report.json"
  },
  "readinessRule": "AI-only Beta 0 is blocked unless run-ai-beta-gate.ps1 and run-beta-release-gate.ps1 both exit 0 and write current source-of-truth reports for the current workspace fingerprint.",
  "legacyContext": {
    "previousPolicyVersion": "1.1",
    "note": "The previous broad beta release policy was superseded for the AI-only Beta 0 implementation batch. Historical release evidence remains diagnostic only and is not current AI-only Beta 0 proof."
  }
}
