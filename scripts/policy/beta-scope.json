{
  "schemaVersion": "npdev-beta-scope.v2",
  "release": "ai-only-beta-0",
  "delegatesTo": "scripts/policy/beta0-scope.json",
  "expandedBeta0ContractVersion": "expanded-beta0.2026-05-05",
  "supportedSurfaces": {
    "inputContracts": [
      "ai-model.v1",
      "ai-generator-config.v1",
      "ai-custom-panel.v1",
      "ai-custom-procedure.v1",
      "workflow-contract.v1",
      "tenant-auth-role-contract.v1",
      "ai-verification-report.v1",
      "npdev-ai-command-request.v1"
    ],
    "officialContracts": [
      "model.schema.json",
      "config.schema.json",
      "panel-contract",
      "procedure-contract",
      "workflow-contract",
      "security-contract"
    ],
    "verificationMedium": "expanded-smoke-checks",
    "runtimeProfile": "ai-beta-local",
    "databaseModes": [
      "embedded-test",
      "docker-postgres"
    ],
    "appKinds": [
      "expanded-beta-application"
    ]
  },
  "excludedSurfaces": [
    "public-production-deployment",
    "arbitrary-shell",
