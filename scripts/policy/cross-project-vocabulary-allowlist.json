    },
    {
      "name": "provider-scheduling",
      "pattern": "overlapsProvider|provider_id|Provider is already booked"
    },
    {
      "name": "room-scheduling",
      "pattern": "overlapsRoom|room_id|Room is already booked"
    },
    {
      "name": "sample-overlap-helper",
      "pattern": "providerHasOverlap|roomHasOverlap|appointmentHasOverlap|FROM appointments"
    },
    {
      "name": "restaurant",
      "pattern": "DiningTable|MenuItem|DiningOrder|PaymentReceipt|Pizza House|Sushi Bar|Vegan Bistro"
    },
    {
      "name": "insurance-claim",
      "pattern": "InsuranceClaim"
    },
    {
      "name": "clinic-identifiers",
      "pattern": "\\bmrn\\b|\\bnpi\\b|medicalRecordNumber|providerNpi"
    },
    {
      "name": "expense-sample",
      "pattern": "ExpenseRequest|employeeEmail|managerApproval|reimbursement"
    },
    {
      "name": "contact-intake-sample",
      "pattern": "ContactMessage|contact_intake|contactMessage"
