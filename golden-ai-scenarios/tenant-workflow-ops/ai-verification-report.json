        "status": "UP"
      }
    },
    {
      "id": "create-ticket",
      "type": "http",
      "method": "POST",
      "path": "/api/tickets",
      "headers": {
        "Content-Type": "application/json",
        "X-Api-Key": "dev-key"
      },
      "body": {
        "tenantId": "tenant-a",
        "title": "Beta workflow request",
        "status": "open"
      },
      "expectedStatus": 201,
      "expectedJsonContains": {
        "title": "Beta workflow request"
      }
    }
  ]
}
