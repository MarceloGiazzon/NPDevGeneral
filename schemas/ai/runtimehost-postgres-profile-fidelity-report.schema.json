{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/runtimehost-postgres-profile-fidelity-report.schema.json",
  "title": "NPDev RuntimeHost Postgres Profile Fidelity Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "checkpoint",
    "workspaceRoot",
    "overallStatus",
    "postgresProfileExists",
    "flywayEnabled",
    "h2UrlAbsentFromPostgresProfile",
    "canonicalDemoBusinessE2EITPostgresPassed",
    "testcontainersJdbcUrl",
    "selectedProofAppRoot",
    "checks",
    "blockers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "npdev-runtimehost-postgres-profile-fidelity-report.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint": {
      "const": "Checkpoint 2 - RuntimeHost Postgres Profile Fidelity"
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "overallStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "postgresProfileExists": {
      "type": "boolean"
    },
    "flywayEnabled": {
      "type": "boolean"
    },
    "h2UrlAbsentFromPostgresProfile": {
      "type": "boolean"
    },
    "canonicalDemoBusinessE2EITPostgresPassed": {
      "type": "boolean"
    },
    "testcontainersJdbcUrl": {
      "type": "string",
      "minLength": 1
    },
    "selectedProofAppRoot": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "passed",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overallStatus": {
            "const": "passed"
          }
        },
        "required": [
          "overallStatus"
        ]
      },
      "then": {
        "properties": {
          "postgresProfileExists": {
            "const": true
          },
          "flywayEnabled": {
            "const": true
          },
          "h2UrlAbsentFromPostgresProfile": {
            "const": true
          },
          "canonicalDemoBusinessE2EITPostgresPassed": {
            "const": true
          },
          "blockers": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
