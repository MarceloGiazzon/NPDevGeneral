{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/roadmap-closure-check-report.schema.json",
  "title": "NPDev Roadmap Closure Check Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "scriptPath",
    "workspaceRoot",
    "overallStatus",
    "checks",
    "blockers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "npdev-roadmap-closure-check-report.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "scriptPath": {
      "const": "scripts/quality/run-roadmap-closure-check.ps1"
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "overallStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "passed",
          "reason",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "blockers": {
      "type": "array"
    }
  }
}
