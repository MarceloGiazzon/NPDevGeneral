{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schemas/ai/final-evidence-bundle-manifest.schema.json",
  "title": "NPDev Final Evidence Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "scriptPath",
    "workspaceRoot",
    "overallStatus",
    "bundleRoot",
    "requiredReportCount",
    "missingReportCount",
    "failedReportCount",
    "schemaInvalidReportCount",
    "schemaValidationReportPath",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "npdev-final-evidence-bundle-manifest.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scriptPath": { "const": "scripts/quality/generate-final-evidence-bundle.ps1" },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "overallStatus": {
      "$comment": "REG-32 (2026-07-24): added precondition-unmet (REG-3 pattern) -- required reports the ~21 producer gates never ran are an expected, non-fatal precondition, not a defect.",
      "enum": ["passed", "failed", "precondition-unmet"]
    },
    "bundleRoot": { "type": "string", "minLength": 1 },
    "requiredReportCount": { "const": 21 },
    "missingReportCount": { "type": "integer", "minimum": 0 },
    "failedReportCount": { "type": "integer", "minimum": 0 },
    "schemaInvalidReportCount": { "type": "integer", "minimum": 0 },
    "schemaValidationReportPath": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 21,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reportPath",
          "bundledPath",
          "schemaPath",
          "schemaVersion",
          "overallStatus",
          "bytes",
          "sha256"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "reportPath": { "type": "string", "minLength": 1 },
          "bundledPath": { "type": "string", "minLength": 1 },
          "schemaPath": { "type": "string", "minLength": 1 },
          "schemaVersion": {
            "$comment": "REG-35 (2026-07-29): empty when the report was never generated -- generate-final-evidence-bundle.ps1 has no schemaVersion to read from a file that does not exist.",
            "type": "string"
          },
          "overallStatus": {
            "$comment": "REG-35 (2026-07-29): not just passed/failed -- Get-ReportStatus (generate-final-evidence-bundle.ps1) also emits 'missing' (producer never ran, the REG-32 precondition-unmet case) and 'missing-status' (report exists but declares neither overallStatus nor status); an existing report may also declare its own non-passed/failed status string (e.g. a producer using the same precondition-unmet pattern), so this stays open rather than an overfit enum.",
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "$comment": "REG-35 (2026-07-29): 0 when the report was never generated (no file to size).",
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$comment": "REG-35 (2026-07-29): empty when the report was never generated (no file to hash).",
            "type": "string",
            "pattern": "^([0-9a-f]{64})?$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "overallStatus": { "const": "passed" } }, "required": ["overallStatus"] },
      "then": {
        "properties": {
          "missingReportCount": { "const": 0 },
          "failedReportCount": { "const": 0 },
          "schemaInvalidReportCount": { "const": 0 }
        }
      }
    }
  ]
}
