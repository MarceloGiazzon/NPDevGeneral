{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/maturity-score-report.schema.json",
  "title": "NPDev Maturity Score Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "scriptPath",
    "workspaceRoot",
    "overallStatus",
    "policyPath",
    "scores",
    "areas",
    "caps",
    "claimValidation",
    "remainingCappedMaturityReasons"
  ],
  "properties": {
    "schemaVersion": {
      "const": "npdev-maturity-score-report.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "scriptPath": {
      "const": "scripts/quality/run-maturity-score.ps1"
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "overallStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "policyPath": {
      "const": "scripts/policy/maturity-score-policy.json"
    },
    "scores": {
      "type": "object",
      "required": [
        "beta0MaturityScore",
        "productMaturityScore"
      ],
      "properties": {
        "beta0MaturityScore": {
          "type": "object",
          "required": [
            "raw",
            "capped",
            "confidence"
          ]
        },
        "productMaturityScore": {
          "type": "object",
          "required": [
            "raw",
            "capped",
            "confidence"
          ]
        }
      }
    },
    "areas": {
      "type": "array",
      "minItems": 1
    },
    "caps": {
      "type": "array"
    },
    "claimValidation": {
      "type": "object",
      "required": [
        "passed",
        "failures"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "remainingCappedMaturityReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
