{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/runbook-workflow-alignment-tests-report.schema.json",
  "title": "NPDev Runbook Workflow Alignment Tests Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "scriptPath",
    "overallStatus",
    "assertions",
    "fixtureReports",
    "failures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "npdev-runbook-workflow-alignment-test-report.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "scriptPath": {
      "const": "scripts/quality/run-runbook-workflow-alignment-tests.ps1"
    },
    "overallStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "assertions": {
      "type": "object",
      "required": [
        "failed",
        "names"
      ],
      "properties": {
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "names": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "fixtureReports": {
      "type": "array",
      "minItems": 1
    },
    "failures": {
      "type": "array"
    }
  }
}
