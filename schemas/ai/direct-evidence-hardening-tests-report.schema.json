{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/direct-evidence-hardening-tests-report.schema.json",
  "title": "NPDev Direct Evidence Hardening Tests Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "scriptPath",
    "overallStatus",
    "testedReports",
    "assertions",
    "failures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "npdev-direct-evidence-hardening-test-report.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "scriptPath": {
      "const": "scripts/quality/run-direct-evidence-hardening-tests.ps1"
    },
    "overallStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "testedReports": {
      "type": "array",
      "minItems": 1
    },
    "assertions": {
      "type": "object",
      "required": [
        "failed"
      ],
      "properties": {
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "failures": {
      "type": "array"
    }
  }
}
