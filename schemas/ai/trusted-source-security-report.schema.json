{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schemas/ai/trusted-source-security-report.schema.json",
  "title": "NPDev Trusted Source Security Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "scriptPath",
    "workspaceRoot",
    "overallStatus",
    "astValidationImplemented",
    "regexOnlyValidationReplaced",
    "bytecodeRestrictionsVerified",
    "productIntegratedBytecodeInspectionPassed",
    "bytecodeRestrictionProofHarnessPassed",
    "dependencyClasspathRestrictionsVerified",
    "trustedPanelParserSanitizerVerified",
    "trustedPanelSanitizerVerified",
    "cspHardeningVerified",
    "admissionEscapeVectorsBlocked",
    "runtimeSandboxEscapeTestsPassed",
    "productionSandboxProvided",
    "etcPasswdBlocked",
    "externalNetworkBlocked",
    "systemExitBlocked",
    "reflectionBlocked",
    "classloaderBlocked",
    "processBuilderBlocked",
    "securityManagerSoleContainment",
    "trustedSourceExecutionBroadlyEnabledByDefault",
    "checks",
    "findings",
    "doesNotSolve"
  ],
  "properties": {
    "schemaVersion": { "const": "npdev-trusted-source-security-report.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scriptPath": { "const": "scripts/quality/run-trusted-source-security-check.ps1" },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "overallStatus": { "enum": ["passed", "failed"] },
    "astValidationImplemented": { "type": "boolean" },
    "regexOnlyValidationReplaced": { "type": "boolean" },
    "bytecodeRestrictionsVerified": { "type": "boolean" },
    "productIntegratedBytecodeInspectionPassed": { "type": "boolean" },
    "bytecodeRestrictionProofHarnessPassed": { "type": "boolean" },
    "dependencyClasspathRestrictionsVerified": { "type": "boolean" },
    "trustedPanelParserSanitizerVerified": { "type": "boolean" },
    "trustedPanelSanitizerVerified": { "type": "boolean" },
    "cspHardeningVerified": { "type": "boolean" },
    "admissionEscapeVectorsBlocked": { "type": "boolean" },
    "runtimeSandboxEscapeTestsPassed": { "type": "boolean" },
    "productionSandboxProvided": { "type": "boolean" },
    "etcPasswdBlocked": { "type": "boolean" },
    "externalNetworkBlocked": { "type": "boolean" },
    "systemExitBlocked": { "type": "boolean" },
    "reflectionBlocked": { "type": "boolean" },
    "classloaderBlocked": { "type": "boolean" },
    "processBuilderBlocked": { "type": "boolean" },
    "securityManagerSoleContainment": { "type": "boolean" },
    "trustedSourceExecutionBroadlyEnabledByDefault": { "type": "boolean" },
    "testXmlPath": { "type": "string" },
    "compatibilityTestXmlPath": { "type": "string" },
    "productIntegratedBytecodeProofPath": { "type": "string" },
    "bytecodeProofPath": { "type": "string" },
    "checks": { "type": "array", "items": { "type": "object" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "doesNotSolve": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "overallStatus": { "const": "passed" } }, "required": ["overallStatus"] },
      "then": {
        "properties": {
          "astValidationImplemented": { "const": true },
          "regexOnlyValidationReplaced": { "const": true },
          "bytecodeRestrictionsVerified": { "const": true },
          "productIntegratedBytecodeInspectionPassed": { "const": true },
          "bytecodeRestrictionProofHarnessPassed": { "const": true },
          "dependencyClasspathRestrictionsVerified": { "const": true },
          "trustedPanelParserSanitizerVerified": { "const": true },
          "trustedPanelSanitizerVerified": { "const": true },
          "cspHardeningVerified": { "const": true },
          "admissionEscapeVectorsBlocked": { "const": true },
          "runtimeSandboxEscapeTestsPassed": { "const": false },
          "productionSandboxProvided": { "const": false },
          "etcPasswdBlocked": { "const": true },
          "externalNetworkBlocked": { "const": true },
          "systemExitBlocked": { "const": true },
          "reflectionBlocked": { "const": true },
          "classloaderBlocked": { "const": true },
          "processBuilderBlocked": { "const": true },
          "securityManagerSoleContainment": { "const": false },
          "trustedSourceExecutionBroadlyEnabledByDefault": { "const": false }
        }
      }
    }
  ]
}
