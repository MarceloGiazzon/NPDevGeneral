{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schemas/ai/custom-procedure.schema.json",
  "title": "NPDev AI Custom Procedure",
  "type": "object",
  "required": ["schemaVersion", "procedureId", "executionMode", "trust", "inputs", "outputs"],
  "properties": {
    "schemaVersion": { "const": "ai-custom-procedure.v1" },
    "procedureId": { "type": "string" },
    "executionMode": { "const": "governed" },
    "trust": { "enum": ["trusted", "inproc"] },
    "inputs": { "type": "array" },
    "outputs": { "type": "array" },
    "sideEffects": { "type": "array", "default": [] },
    "steps": { "type": "array", "default": [] },
    "implementation": {
      "type": "object",
      "required": ["mode", "language", "entrypoint", "className"],
      "properties": {
        "mode": { "enum": ["trustedSource"] },
        "language": { "enum": ["java"] },
        "entrypoint": { "type": "string" },
        "className": { "type": "string" },
        "method": { "type": "string", "default": "execute" }
      },
      "additionalProperties": true
    }
  },
  "not": {
    "anyOf": [
      { "required": ["script"] },
      { "required": ["externalCommand"] },
      { "required": ["customHtml"] }
    ]
  },
  "additionalProperties": true
}
