{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schemas/ai/dsl-parser-robustness-report.schema.json",
  "title": "NPDev DSL Parser Robustness Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "scriptPath",
    "workspaceRoot",
    "overallStatus",
    "checkpoint",
    "canonicalSchemaPath",
    "parserPath",
    "schemaValidatorPath",
    "schemaValidationExceptionPath",
    "schemaFirstValidationBeforeManualParser",
    "canonicalSchemaValidationUsed",
    "schemaInvalidFailsBeforeManualParser",
    "typedSchemaDiagnosticsExposed",
    "pathBasedSchemaErrors",
    "semanticDiagnosticsSuggestedFixVerified",
    "positiveAstCompatibilityPassed",
    "canonicalAndOfficialModelsRetainAstBehavior",
    "handwrittenParserRetained",
    "jsonModelParserReplaced",
    "legacyEntitiesRootRejectionPreserved",
    "parserRobustnessTestsPassed",
    "validationErrorFormatTestsPassed",
    "canonicalDemoRegressionPassed",
    "officialSamplesRegressionPassed",
    "legacySchemaRejectionPassed",
    "testSuites",
    "validationCommands",
    "findings",
    "failures",
    "doesNotSolve"
  ],
  "properties": {
    "schemaVersion": { "const": "npdev-dsl-parser-robustness-report.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scriptPath": { "const": "scripts/quality/run-dsl-parser-robustness-check.ps1" },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "overallStatus": { "enum": [ "passed", "failed" ] },
    "checkpoint": { "const": "CP14" },
    "canonicalSchemaPath": { "type": "string", "minLength": 1 },
    "parserPath": { "type": "string", "minLength": 1 },
    "schemaValidatorPath": { "type": "string", "minLength": 1 },
    "schemaValidationExceptionPath": { "type": "string", "minLength": 1 },
    "schemaFirstValidationBeforeManualParser": { "type": "boolean" },
    "canonicalSchemaValidationUsed": { "type": "boolean" },
    "schemaInvalidFailsBeforeManualParser": { "type": "boolean" },
    "typedSchemaDiagnosticsExposed": { "type": "boolean" },
    "pathBasedSchemaErrors": { "type": "boolean" },
    "semanticDiagnosticsSuggestedFixVerified": { "type": "boolean" },
    "positiveAstCompatibilityPassed": { "type": "boolean" },
    "canonicalAndOfficialModelsRetainAstBehavior": { "type": "boolean" },
    "handwrittenParserRetained": { "type": "boolean" },
    "jsonModelParserReplaced": { "const": false },
    "legacyEntitiesRootRejectionPreserved": { "type": "boolean" },
    "parserRobustnessTestsPassed": { "type": "boolean" },
    "validationErrorFormatTestsPassed": { "type": "boolean" },
    "canonicalDemoRegressionPassed": { "type": "boolean" },
    "officialSamplesRegressionPassed": { "type": "boolean" },
    "legacySchemaRejectionPassed": { "type": "boolean" },
    "testSuites": { "type": "array", "minItems": 5 },
    "validationCommands": { "type": "array", "minItems": 1 },
    "findings": { "type": "array" },
    "failures": { "type": "array" },
    "doesNotSolve": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "overallStatus": { "const": "passed" } },
        "required": [ "overallStatus" ]
      },
      "then": {
        "properties": {
          "schemaFirstValidationBeforeManualParser": { "const": true },
          "canonicalSchemaValidationUsed": { "const": true },
          "schemaInvalidFailsBeforeManualParser": { "const": true },
          "typedSchemaDiagnosticsExposed": { "const": true },
          "pathBasedSchemaErrors": { "const": true },
          "semanticDiagnosticsSuggestedFixVerified": { "const": true },
          "positiveAstCompatibilityPassed": { "const": true },
          "canonicalAndOfficialModelsRetainAstBehavior": { "const": true },
          "handwrittenParserRetained": { "const": true },
          "legacyEntitiesRootRejectionPreserved": { "const": true },
          "parserRobustnessTestsPassed": { "const": true },
          "validationErrorFormatTestsPassed": { "const": true },
          "canonicalDemoRegressionPassed": { "const": true },
          "officialSamplesRegressionPassed": { "const": true },
          "legacySchemaRejectionPassed": { "const": true },
          "failures": { "maxItems": 0 }
        }
      }
    }
  ]
}
