{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schemas/ai/ai-model.schema.json",
  "title": "NPDev AI Model",
  "type": "object",
  "required": [
    "schemaVersion",
    "app",
    "entities",
    "flows"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ai-model.v1"
    },
    "app": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "simple-crud-workflow"
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "fields"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "required"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                },
                "type": {
                  "enum": [
                    "string",
                    "text",
                    "email",
                    "integer",
                    "number",
                    "boolean",
                    "date",
                    "datetime",
                    "uuid"
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "entity",
          "operation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "entity": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "operation": {
            "enum": [
              "create",
              "read",
              "update",
              "delete",
              "list"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
