{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schemas/ai/scenario-manifest.schema.json",
  "title": "NPDev AI Scenario Manifest",
  "type": "object",
  "required": ["schemaVersion", "scenarioId", "kind", "expectedOutcome", "files"],
  "properties": {
    "schemaVersion": {
      "enum": ["ai-scenario-manifest.v1", "ai-scenario.v1"]
    },
    "scenarioId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "kind": {
      "enum": ["positive", "negative", "ai-only-functional-beta", "ai-custom-procedure-panel-functional-beta", "ai-custom-panel-functional-beta", "ai-custom-procedure-functional-beta"]
    },
    "files": {
      "type": "object",
      "properties": {
        "aiModel": { "type": "string" },
        "aiConfig": { "type": "string" },
        "verification": { "type": "string" },
        "commandRequest": { "type": "string" },
        "model": { "type": "string" },
        "config": { "type": "string" },
        "expectedBehavior": { "type": "string" },
        "customProcedure": { "type": "string" },
        "expectedProcedureBehavior": { "type": "string" },
        "customPanel": { "type": "string" },
        "expectedPanelBehavior": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["strictExecution", "surfaceProfile"],
      "properties": {
        "strictExecution": { "const": true },
        "surfaceProfile": { "const": "supported-core" }
      },
      "additionalProperties": true
    },
    "requestedSurfaces": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["supported-core"]
    },
    "operations": {
      "type": "array",
      "items": { "type": "object" },
      "default": []
    },
    "expectedOutcome": {
      "enum": ["pass", "fail"]
    },
    "expectedFailureStage": {
      "enum": ["ai-model-schema", "ai-config-schema", "verification-schema", "scope-policy", "command-policy", "smoke-verification"]
    },
    "expectedErrorCode": { "type": "string" },
    "legacyExpectedOutcome": { "type": "object" }
  },
  "additionalProperties": true
}
