{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/postgres-fidelity-report.schema.json",
  "title": "NPDev Kernel Postgres Fidelity Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "checkpoint",
    "workspaceRoot",
    "overallStatus",
    "h2ReferencesInPostgresTests",
    "postgresAdapterTestsPassed",
    "advisoryLockConcurrencyProof",
    "testcontainersImage",
    "testcontainersVersion",
    "checks",
    "blockers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "npdev-postgres-fidelity-report.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint": {
      "const": "Checkpoint 1 - Kernel Postgres Adapter Fidelity"
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "overallStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "h2ReferencesInPostgresTests": {
      "type": "integer",
      "minimum": 0
    },
    "postgresAdapterTestsPassed": {
      "type": "boolean"
    },
    "advisoryLockConcurrencyProof": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "testcontainersImage": {
      "type": "string",
      "minLength": 1
    },
    "testcontainersVersion": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "passed",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overallStatus": {
            "const": "passed"
          }
        },
        "required": [
          "overallStatus"
        ]
      },
      "then": {
        "properties": {
          "h2ReferencesInPostgresTests": {
            "const": 0
          },
          "postgresAdapterTestsPassed": {
            "const": true
          },
          "advisoryLockConcurrencyProof": {
            "const": "passed"
          },
          "blockers": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
