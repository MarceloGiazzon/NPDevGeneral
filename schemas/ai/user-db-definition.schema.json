{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/user-db-definition.schema.json",
  "title": "NPDev User DB Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["database", "schemaLifecycle"],
  "properties": {
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "createInternalTables", "createBusinessTables"],
      "properties": {
        "engine": { "enum": ["Postgres", "InMemory", "H2Local", "H2Server", "MySQL", "SqlServer"] },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1 },
        "databaseName": { "type": "string", "minLength": 1 },
        "schemaName": { "type": "string", "minLength": 1 },
        "jdbcUrl": { "type": "string", "minLength": 1 },
        "h2FilePath": { "type": "string", "minLength": 1 },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "createInternalTables": { "type": "boolean" },
        "createBusinessTables": { "type": "boolean" },
        "externallyProvisioned": {
          "type": "boolean",
          "description": "STOR-14. Optional, defaults to false. True means THIS SERVER IS YOURS, NOT NPDEV'S: NPDev did not start it and must never start, stop or destroy it, so the generated _ops toolbox refuses Create/Start/Stop/Reset and reports reachability instead of container state. Orthogonal to schemaLifecycle.ownership, which is about the SCHEMA (whether NPDev issues DDL) rather than the SERVER (whether NPDev provisioned it); all four combinations are meaningful. Refused on the embedded engines (InMemory, H2Local), which have no server to be external."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "engine": { "const": "Postgres" } }, "required": ["engine"] },
          "then": { "required": ["host", "port", "username", "password"] }
        },
        {
          "if": { "properties": { "engine": { "const": "H2Local" } }, "required": ["engine"] },
          "then": { "required": ["username", "password"] }
        },
        {
          "if": { "properties": { "engine": { "const": "H2Server" } }, "required": ["engine"] },
          "then": {
            "required": ["username", "password"],
            "anyOf": [
              { "required": ["jdbcUrl"] },
              { "required": ["host", "port"] }
            ]
          }
        },
        {
          "if": { "properties": { "engine": { "const": "MySQL" } }, "required": ["engine"] },
          "then": { "required": ["host", "port", "username", "password"] }
        },
        {
          "if": { "properties": { "engine": { "const": "SqlServer" } }, "required": ["engine"] },
          "then": { "required": ["host", "port", "username", "password"] }
        }
      ]
    },
    "schemaLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "allowDestructiveRecreate", "destructiveRecreateConfirmation", "scope"],
      "properties": {
        "strategy": {
          "enum": ["DropAndRecreateOnStructureChange", "RecreateOnAppStart", "KeepExistingIfCompatible"]
        },
        "allowDestructiveRecreate": { "type": "boolean" },
        "destructiveRecreateConfirmation": { "type": "string" },
        "scope": { "enum": ["NpdevOwnedTablesOnly", "NpdevOwnedLogicalStoresOnly"] },
        "ownership": {
          "enum": ["NpdevManaged", "ExternallyManaged"],
          "description": "REG-7.1. Optional, defaults to NpdevManaged (today's only behavior) when absent. ExternallyManaged means NPDev does not own this database's schema: it never issues DDL, only verifies compatibility at boot."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "strategy": { "const": "DropAndRecreateOnStructureChange" } },
            "required": ["strategy"]
          },
          "then": {
            "properties": {
              "allowDestructiveRecreate": { "const": true },
              "destructiveRecreateConfirmation": { "const": "I_UNDERSTAND_TABLE_DATA_WILL_BE_DELETED" },
              "scope": { "const": "NpdevOwnedTablesOnly" }
            }
          }
        },
        {
          "if": {
            "properties": { "ownership": { "const": "ExternallyManaged" } },
            "required": ["ownership"]
          },
          "then": {
            "properties": {
              "strategy": { "const": "KeepExistingIfCompatible" },
              "allowDestructiveRecreate": { "const": false }
            }
          }
        }
      ]
    }
  }
}
