{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schemas/ai/shift-left-ai-safety-report.schema.json",
  "title": "NPDev Shift-Left AI Safety Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "scriptPath",
    "workspaceRoot",
    "overallStatus",
    "schemaLevelRestrictionsPassed",
    "preAstSafetyLintPassed",
    "destructiveShellCommandsRejectedEarly",
    "suspiciousCommandChainingRejectedEarly",
    "unsafeExternalUrlsRejectedEarly",
    "pathTraversalRejectedEarly",
    "unboundedBulkOperationsRejectedEarly",
    "negativeScenariosFailAtEarliestStage",
    "runtimeFirewallDefenseInDepthPreserved",
    "schemaCases",
    "lintCases",
    "validationCommands",
    "findings",
    "doesNotSolve"
  ],
  "properties": {
    "schemaVersion": { "const": "npdev-shift-left-ai-safety-report.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scriptPath": { "const": "scripts/quality/run-shift-left-ai-safety-check.ps1" },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "overallStatus": { "enum": ["passed", "failed"] },
    "schemaLevelRestrictionsPassed": { "type": "boolean" },
    "preAstSafetyLintPassed": { "type": "boolean" },
    "destructiveShellCommandsRejectedEarly": { "type": "boolean" },
    "suspiciousCommandChainingRejectedEarly": { "type": "boolean" },
    "unsafeExternalUrlsRejectedEarly": { "type": "boolean" },
    "pathTraversalRejectedEarly": { "type": "boolean" },
    "unboundedBulkOperationsRejectedEarly": { "type": "boolean" },
    "negativeScenariosFailAtEarliestStage": { "type": "boolean" },
    "runtimeFirewallDefenseInDepthPreserved": { "type": "boolean" },
    "schemaCases": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "lintCases": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "validationCommands": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "doesNotSolve": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "overallStatus": { "const": "passed" } }, "required": ["overallStatus"] },
      "then": {
        "properties": {
          "schemaLevelRestrictionsPassed": { "const": true },
          "preAstSafetyLintPassed": { "const": true },
          "destructiveShellCommandsRejectedEarly": { "const": true },
          "suspiciousCommandChainingRejectedEarly": { "const": true },
          "unsafeExternalUrlsRejectedEarly": { "const": true },
          "pathTraversalRejectedEarly": { "const": true },
          "unboundedBulkOperationsRejectedEarly": { "const": true },
          "negativeScenariosFailAtEarliestStage": { "const": true },
          "runtimeFirewallDefenseInDepthPreserved": { "const": true }
        }
      }
    }
  ]
}
