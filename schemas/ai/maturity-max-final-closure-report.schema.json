{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schemas/ai/maturity-max-final-closure-report.schema.json",
  "title": "NPDev Maturity Max Final Closure Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "scriptPath",
    "workspaceRoot",
    "overallStatus",
    "checkpoint",
    "baselineMaturity",
    "targetMaturity",
    "finalMaturity",
    "acceptedEvidencePreserved",
    "requiredReportCount",
    "missingReportCount",
    "failedReportCount",
    "schemaInvalidReportCount",
    "hashManifestedReportCount",
    "currentRoadmapBlockerCount",
    "newRoadmapCreated",
    "windowsCiPreserved",
    "linuxCiPreserved",
    "linuxTestcontainersCoveragePreserved",
    "gradleCachingConfigured",
    "npmCachingConfigured",
    "reusableActionsVerifiedOrScoped",
    "gettingStartedPresent",
    "makefileOrJustfilePresent",
    "sampleSetupCommandsVerifiedOrScoped",
    "optionalTagCommandPrepared",
    "optionalTagCommandExecuted",
    "beta0RetagActionTaken",
    "reports",
    "commands",
    "findings",
    "doesNotSolve"
  ],
  "properties": {
    "schemaVersion": { "const": "npdev-maturity-max-final-closure-report.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scriptPath": { "const": "scripts/quality/run-maturity-max-final-closure-check.ps1" },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "overallStatus": { "enum": ["passed", "failed"] },
    "checkpoint": { "const": "CP15" },
    "baselineMaturity": { "const": "7.8/10 (~78%)" },
    "targetMaturity": { "const": "9.2-9.5/10 (~92-95%)" },
    "finalMaturity": { "type": "string", "minLength": 1 },
    "acceptedEvidencePreserved": { "type": "boolean" },
    "requiredReportCount": { "type": "integer", "minimum": 21 },
    "missingReportCount": { "type": "integer", "minimum": 0 },
    "failedReportCount": { "type": "integer", "minimum": 0 },
    "schemaInvalidReportCount": { "type": "integer", "minimum": 0 },
    "hashManifestedReportCount": { "type": "integer", "minimum": 21 },
    "currentRoadmapBlockerCount": { "type": "integer", "minimum": 0 },
    "newRoadmapCreated": { "type": "boolean" },
    "windowsCiPreserved": { "type": "boolean" },
    "linuxCiPreserved": { "type": "boolean" },
    "linuxTestcontainersCoveragePreserved": { "type": "boolean" },
    "gradleCachingConfigured": { "type": "boolean" },
    "npmCachingConfigured": { "type": "boolean" },
    "reusableActionsVerifiedOrScoped": { "type": "boolean" },
    "gettingStartedPresent": { "type": "boolean" },
    "makefileOrJustfilePresent": { "type": "boolean" },
    "sampleSetupCommandsVerifiedOrScoped": { "type": "boolean" },
    "optionalTagCommandPrepared": { "type": "boolean" },
    "optionalTagCommandExecuted": { "type": "boolean" },
    "beta0RetagActionTaken": { "type": "boolean" },
    "reports": { "type": "array", "items": { "type": "object" } },
    "commands": { "type": "array", "items": { "type": "object" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "doesNotSolve": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "overallStatus": { "const": "passed" } }, "required": ["overallStatus"] },
      "then": {
        "properties": {
          "acceptedEvidencePreserved": { "const": true },
          "missingReportCount": { "const": 0 },
          "failedReportCount": { "const": 0 },
          "schemaInvalidReportCount": { "const": 0 },
          "currentRoadmapBlockerCount": { "const": 0 },
          "newRoadmapCreated": { "const": false },
          "windowsCiPreserved": { "const": true },
          "linuxCiPreserved": { "const": true },
          "linuxTestcontainersCoveragePreserved": { "const": true },
          "gradleCachingConfigured": { "const": true },
          "npmCachingConfigured": { "const": true },
          "reusableActionsVerifiedOrScoped": { "const": true },
          "gettingStartedPresent": { "const": true },
          "makefileOrJustfilePresent": { "const": true },
          "sampleSetupCommandsVerifiedOrScoped": { "const": true },
          "optionalTagCommandPrepared": { "const": true },
          "optionalTagCommandExecuted": { "const": false },
          "beta0RetagActionTaken": { "const": false }
        }
      }
    }
  ]
}
