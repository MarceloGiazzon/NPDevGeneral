{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.dev/schemas/ai/load-proof-baseline.schema.json",
  "title": "NPDev load proof baseline",
  "description": "LOAD-4: the recorded latency of a consumer sample under scripts/load/run_load.py, kept in scripts/policy/load-proof-baseline.json as the regression reference for one class of machine and one database engine.",
  "type": "object",
  "required": ["schemaVersion", "description", "environment", "targets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "npdev-load-proof-baseline.v1" },
    "description": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "required": ["machine", "engine", "engineMode", "notEvidenceFor"],
      "additionalProperties": false,
      "properties": {
        "machine": { "type": "string", "minLength": 1 },
        "engine": { "enum": ["h2", "postgres", "sqlserver", "mysql"] },
        "engineMode": { "type": "string", "minLength": 1 },
        "notEvidenceFor": {
          "description": "What these numbers must not be quoted as proof of.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": ["sample", "rows", "workload", "runs", "findings", "thresholds"],
      "additionalProperties": false,
      "properties": {
        "sample": { "type": "string", "minLength": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "workload": { "type": "string", "minLength": 1 },
        "runs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/run" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "thresholds": {
          "type": "object",
          "required": ["profile", "errorRate", "p95Ms"],
          "additionalProperties": false,
          "properties": {
            "profile": { "type": "string", "minLength": 1 },
            "errorRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "p95Ms": {
              "type": "object",
              "required": ["default"],
              "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["label", "recordedAt", "users", "seconds", "calls", "throughputPerSec", "errorRate", "scenarios"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "users": { "type": "integer", "minimum": 1 },
        "seconds": { "type": "integer", "minimum": 1 },
        "calls": { "type": "integer", "minimum": 0 },
        "throughputPerSec": { "type": "number", "minimum": 0 },
        "errorRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "scenarios": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/scenarioResult" }
        }
      }
    },
    "scenarioResult": {
      "type": "object",
      "required": ["calls", "errors", "p50Ms", "p95Ms", "p99Ms"],
      "additionalProperties": false,
      "properties": {
        "calls": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "p50Ms": { "type": "number", "minimum": 0 },
        "p95Ms": { "type": "number", "minimum": 0 },
        "p99Ms": { "type": "number", "minimum": 0 }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "scenario", "cause", "fix", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "scenario": { "type": "string", "minLength": 1 },
        "cause": { "type": "string", "minLength": 1 },
        "fix": { "type": "string", "minLength": 1 },
        "status": { "enum": ["fixed", "open", "recorded"] }
      }
    }
  }
}
