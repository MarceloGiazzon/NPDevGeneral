{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/docker-linux-parity-report.schema.json",
  "title": "NPDev Docker/Linux Parity Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "scriptPath",
    "overallStatus",
    "platform",
    "ciCompatibility",
    "timeoutPolicy",
    "commands",
    "exitCodes",
    "durations",
    "artifacts",
    "failures"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "npdev-docker-linux-parity-report.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "scriptPath": {
      "type": "string",
      "const": "scripts/quality/run-docker-linux-proof.ps1"
    },
    "overallStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped"
      ],
      "description": "passed = the Linux-container proof ran and succeeded. failed = it ran and failed. skipped = NOT APPLICABLE on this host: the Docker daemon is not in Linux-container mode, so a Linux image cannot be built at all. 'skipped' is deliberately distinct from 'passed' -- a proof that never ran must never read as evidence that it succeeded."
    },
    "platform": {
      "type": "object"
    },
    "ciCompatibility": {
      "type": "object",
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "checks": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "timeoutPolicy": {
      "type": "object",
      "required": [
        "dockerVersionTimeoutSeconds",
        "dockerBuildTimeoutSeconds",
        "dockerRunTimeoutSeconds"
      ]
    },
    "commands": {
      "type": "array"
    },
    "exitCodes": {
      "type": "array"
    },
    "durations": {
      "type": "object"
    },
    "artifacts": {
      "type": "array"
    },
    "failures": {
      "type": "array"
    },
    "skipped": {
      "type": "boolean",
      "description": "True only when overallStatus is 'skipped'."
    },
    "skipReason": {
      "type": "string",
      "minLength": 1,
      "description": "Required when overallStatus is 'skipped': why this host cannot run the proof."
    },
    "dockerServerOs": {
      "type": "string",
      "description": "The Docker daemon's reported OS (docker version --format {{.Server.Os}})."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overallStatus": {
            "const": "skipped"
          }
        },
        "required": [
          "overallStatus"
        ]
      },
      "then": {
        "required": [
          "skipReason",
          "skipped"
        ]
      }
    }
  ]
}
