{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/script-inventory-report.schema.json",
  "title": "NPDev Script Inventory Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "scriptPath",
    "workspaceRoot",
    "overallStatus",
    "policyPath",
    "invocationDeclarationsPath",
    "scriptCount",
    "classificationCounts",
    "invocationCounts",
    "unknownScripts",
    "releaseCriticalViolations",
    "unknownInvocationScripts",
    "invocationMismatchScripts",
    "scripts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "npdev-script-inventory-report.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "scriptPath": {
      "const": "scripts/quality/run-script-inventory-check.ps1"
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "overallStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "policyPath": {
      "const": "scripts/policy/script-inventory-policy.json"
    },
    "invocationDeclarationsPath": {
      "type": "string",
      "minLength": 1
    },
    "scriptCount": {
      "type": "integer",
      "minimum": 0
    },
    "classificationCounts": {
      "type": "object"
    },
    "invocationCounts": {
      "type": "object"
    },
    "unknownScripts": {
      "type": "array"
    },
    "releaseCriticalViolations": {
      "type": "array"
    },
    "unknownInvocationScripts": {
      "type": "array"
    },
    "invocationMismatchScripts": {
      "type": "array"
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "path",
          "classification",
          "validClassification",
          "invocation",
          "validInvocationValue",
          "invocationMatchesReality",
          "invocationEvidence"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "classification": { "type": "string", "minLength": 1 },
          "validClassification": { "type": "boolean" },
          "releaseCritical": { "type": "boolean" },
          "releaseCriticalAllowedClassification": { "type": "boolean" },
          "invocation": {
            "type": "string",
            "enum": ["ci-gate", "manual-runbook", "orchestrated", "retired", "unknown"]
          },
          "validInvocationValue": { "type": "boolean" },
          "invocationMatchesReality": { "type": "boolean" },
          "invocationEvidence": { "type": "string" }
        }
      }
    }
  }
}
