{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schemas/ai/custom-panel.schema.json",
  "title": "NPDev AI Custom Panel",
  "type": "object",
  "required": [
    "schemaVersion",
    "panelId",
    "route",
    "dataSources",
    "visibleFields",
    "actions",
    "layout"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ai-custom-panel.v1"
    },
    "panelId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
    },
    "route": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9/_-]+$"
    },
    "requiredRole": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
    },
    "tenantScoped": {
      "type": "boolean",
      "default": true
    },
    "dataSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
          },
          "concept": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "procedure": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
          },
          "workflow": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
          }
        },
        "oneOf": [
          {
            "required": [
              "concept"
            ]
          },
          {
            "required": [
              "procedure"
            ]
          },
          {
            "required": [
              "workflow"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "visibleFields": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9]*$"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "binding"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
          },
          "binding": {
            "enum": [
              "procedure",
              "query",
              "workflow"
            ]
          },
          "procedure": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
          },
          "query": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "workflow": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
          },
          "requiredRole": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
          }
        },
        "additionalProperties": false
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "table",
            "detail",
            "form",
            "summary",
            "workflowTask"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "validationHints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "text",
              "integer",
              "date",
              "email",
              "boolean",
              "table",
              "detail-card",
              "form",
              "action",
              "status",
              "workflow-status-badge",
              "procedure-result-block"
            ]
          },
          "field": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "action": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "implementation": {
      "type": "object",
      "required": [
        "mode",
        "language",
        "entrypoint"
      ],
      "properties": {
        "mode": {
          "const": "trustedSource"
        },
        "language": {
          "enum": [
            "html+javascript",
            "html",
            "javascript"
          ]
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+\\.(html|js)$",
          "not": {
            "pattern": "(^/|^[A-Za-z]:|\\.\\.)"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "script"
        ]
      },
      {
        "required": [
          "customHtml"
        ]
      },
      {
        "required": [
          "externalUrl"
        ]
      }
    ]
  },
  "additionalProperties": false
}
