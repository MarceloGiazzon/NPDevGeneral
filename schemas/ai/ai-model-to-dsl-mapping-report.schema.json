{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schemas/ai/ai-model-to-dsl-mapping-report.schema.json",
  "title": "NPDev AI Model To DSL Mapping Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "scriptPath",
    "workspaceRoot",
    "overallStatus",
    "fieldCoveragePercent",
    "unmappedFieldCount",
    "goldenScenarioCoveragePercent",
    "rejectionRuleCoveragePercent",
    "fieldCoverage",
    "goldenScenarioCoverage",
    "rejectionRuleCoverage",
    "findings",
    "doesNotSolve"
  ],
  "properties": {
    "schemaVersion": { "const": "npdev-ai-model-to-dsl-mapping-report.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scriptPath": { "const": "scripts/quality/run-ai-contract-normalizer-tests.ps1" },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "overallStatus": { "enum": [ "passed", "failed" ] },
    "fieldCoveragePercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "unmappedFieldCount": { "type": "integer", "minimum": 0 },
    "goldenScenarioCoveragePercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "rejectionRuleCoveragePercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "fieldCoverage": {
      "type": "object",
      "required": [ "schemaPath", "policyPath", "schemaFieldCount", "classifiedFieldCount", "unmappedFields", "stalePolicyFields" ],
      "properties": {
        "schemaPath": { "type": "string", "minLength": 1 },
        "policyPath": { "type": "string", "minLength": 1 },
        "schemaFieldCount": { "type": "integer", "minimum": 1 },
        "classifiedFieldCount": { "type": "integer", "minimum": 1 },
        "unmappedFields": { "type": "array", "items": { "type": "string" } },
        "stalePolicyFields": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "goldenScenarioCoverage": {
      "type": "object",
      "required": [ "scenarioRoot", "aiModelScenarioCount", "coveredAiModelScenarioCount", "unclassifiedScenarioFields", "positiveMappingProofs", "negativeDiagnosticProofs" ],
      "properties": {
        "scenarioRoot": { "type": "string", "minLength": 1 },
        "aiModelScenarioCount": { "type": "integer", "minimum": 1 },
        "coveredAiModelScenarioCount": { "type": "integer", "minimum": 0 },
        "unclassifiedScenarioFields": { "type": "array", "items": { "type": "object" } },
        "positiveMappingProofs": { "type": "array", "items": { "type": "object" } },
        "negativeDiagnosticProofs": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "rejectionRuleCoverage": {
      "type": "object",
      "required": [ "policyRuleCount", "coveredRuleCount", "uncoveredRules" ],
      "properties": {
        "policyRuleCount": { "type": "integer", "minimum": 1 },
        "coveredRuleCount": { "type": "integer", "minimum": 0 },
        "uncoveredRules": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [ "id", "classification", "status", "summary" ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": [
              "current-roadmap-blocker",
              "known-risk",
              "post-roadmap-backlog",
              "human-decision-required",
              "invalid-or-duplicate"
            ]
          },
          "status": { "enum": [ "open", "resolved", "accepted" ] },
          "summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "doesNotSolve": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "validation": { "type": "object" }
  },
  "additionalProperties": false
}
