{
  "database": {
    "engine": "InMemory",
    "createInternalTables": true,
    "createBusinessTables": true
  },
  "schemaLifecycle": {
    "strategy": "Ephemeral",
    "allowDestructiveRecreate": true,
    "destructiveRecreateConfirmation": "I_UNDERSTAND_INMEMORY_DATA_IS_EPHEMERAL",
    "scope": "NpdevOwnedLogicalStoresOnly"
  }
}
