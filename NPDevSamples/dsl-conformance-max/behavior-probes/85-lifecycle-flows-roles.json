        {
          "name": "cleanup",
          "method": "DELETE",
          "path": "/api/widget_order_lines/0e0f1000-0000-4000-8000-000000000002",
          "always": true
        },
        {
          "name": "cleanup",
          "method": "DELETE",
          "path": "/api/widget_order_lines/0e0f1000-0000-4000-8000-000000000003",
          "always": true
        },
        {
          "name": "cleanup",
          "method": "DELETE",
          "path": "/api/widget_order_lines/0e0f1000-0000-4000-8000-000000000004",
          "always": true
        },
        {
          "name": "cleanup",
          "method": "DELETE",
          "path": "/api/widget_orders/${oid}",
          "always": true
        },
        {
          "name": "cleanup",
          "method": "DELETE",
          "path": "/api/widget_order_audits/${oid}",
