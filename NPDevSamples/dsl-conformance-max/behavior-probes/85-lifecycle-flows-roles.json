    {
      "id": "agg-collection-concept-and-owned-children",
      "keywords": [
        "aggregateCollection.concept",
        "aggregateCollection.ownership"
      ],
      "description": "WidgetOrderAggregate.lines is an owned collection of WidgetOrderLine. Committing the tree stores each line as a WidgetOrderLine row pointing at the root; re-committing the tree without one line deletes that line's row (owned children follow the tree) while the kept line stays.",
      "steps": [
        {
          "name": "audit row (onCommit patches it)",
          "method": "POST",
          "path": "/api/widget_order_audits",
          "body": {
            "quantity": 0,
            "lastSyncedStatus": "x"
          },
          "expect": {
            "status": 201
          },
          "save": {
            "oid": "$.id"
          }
        },
        {
          "name": "commit two lines",
          "method": "POST",
          "path": "/api/runtime/aggregate/WidgetOrderAggregate",
          "body": {
            "id": "${oid}",
            "customerEmail": "developer",
            "status": "open",
            "lineCount": 2,
            "lines": [
              {
                "id": "0e0f1000-0000-4000-8000-000000000005",
                "sku": "aa",
                "quantity": 1,
                "unitPrice": 2
              },
              {
                "id": "0e0f1000-0000-4000-8000-000000000006",
                "sku": "bb",
                "quantity": 1,
                "unitPrice": 2
              }
            ]
          },
          "expect": {
            "status": 200,
            "json": {
              "$.lines": {
                "len": 2
              }
            }
          }
        },
        {
          "name": "children are WidgetOrderLine rows",
          "method": "GET",
          "path": "/api/widget_order_lines/0e0f1000-0000-4000-8000-000000000006",
          "expect": {
            "status": 200,
            "json": {
              "$.sku": "bb",
              "$.widgetOrderId": "${oid}"
            }
          }
        },
        {
          "name": "recommit without bb",
          "method": "POST",
          "path": "/api/runtime/aggregate/WidgetOrderAggregate",
          "body": {
            "id": "${oid}",
            "customerEmail": "developer",
            "status": "open",
            "lineCount": 1,
            "lines": [
              {
                "id": "0e0f1000-0000-4000-8000-000000000005",
                "sku": "aa",
                "quantity": 1,
                "unitPrice": 2
              }
            ]
          },
          "expect": {
            "status": 200,
            "json": {
              "$.lines": {
                "len": 1
              }
            }
          }
        },
        {
          "name": "dropped child row is gone",
          "method": "GET",
          "path": "/api/widget_order_lines/0e0f1000-0000-4000-8000-000000000006",
          "expect": {
            "status": 404
          }
        },
        {
          "name": "kept child row stays",
          "method": "GET",
          "path": "/api/widget_order_lines/0e0f1000-0000-4000-8000-000000000005",
          "expect": {
            "status": 200
          }
        },
        {
          "name": "cleanup",
          "method": "DELETE",
          "path": "/api/widget_order_lines/0e0f1000-0000-4000-8000-000000000005",
          "always": true
        },
        {
          "name": "cleanup",
          "method": "DELETE",
          "path": "/api/widget_orders/${oid}",
          "always": true
        },
        {
          "name": "cleanup",
          "method": "DELETE",
          "path": "/api/widget_order_audits/${oid}",
          "always": true
        }
      ]
    },
