    {
      "id": "field-file-upload-enforces-content-type-and-size",
      "keywords": [
        "field.file"
      ],
      "description": "WidgetOrder.purchaseOrderFile declares file {contentTypes [application/pdf], maxSizeBytes 5242880} and companyLogo {image/png|image/jpeg, 1048576}. The multipart upload endpoint accepts a PDF, refuses text/plain with 415, refuses 5242881 bytes with 413 and a 1048577-byte logo with 413, and refuses a field that is not a file field with 400.",
      "steps": [
        {
          "name": "pdf accepted",
          "method": "POST",
          "path": "/api/files/WidgetOrder/purchaseOrderFile",
          "multipart": {
            "file": {
              "field": "file",
              "filename": "po.pdf",
              "contentType": "application/pdf",
              "content": "%PDF-1.4 probe"
            }
          },
          "expect": {
            "status": 200,
            "json": {
              "$.contentType": "application/pdf",
              "$.sizeBytes": 14
            }
          }
        },
        {
          "name": "wrong content type",
          "method": "POST",
          "path": "/api/files/WidgetOrder/purchaseOrderFile",
          "multipart": {
            "file": {
              "field": "file",
              "filename": "po.txt",
              "contentType": "text/plain",
              "content": "nope"
            }
          },
          "expect": {
            "status": 415
          }
        },
        {
          "name": "pdf over limit",
          "method": "POST",
          "path": "/api/files/WidgetOrder/purchaseOrderFile",
          "multipart": {
            "file": {
              "field": "file",
              "filename": "big.pdf",
              "contentType": "application/pdf",
              "repeatBytes": 5242881
            }
          },
          "expect": {
            "status": 413
          }
        },
        {
          "name": "logo over its own smaller limit",
          "method": "POST",
          "path": "/api/files/WidgetOrder/companyLogo",
          "multipart": {
            "file": {
              "field": "file",
              "filename": "big.png",
              "contentType": "image/png",
              "repeatBytes": 1048577
            }
          },
          "expect": {
            "status": 413
          }
        },
        {
          "name": "logo within limit",
          "method": "POST",
          "path": "/api/files/WidgetOrder/companyLogo",
          "multipart": {
            "file": {
              "field": "file",
              "filename": "ok.png",
              "contentType": "image/png",
              "content": "png"
            }
          },
          "expect": {
            "status": 200
          }
        },
        {
          "name": "not a file field",
          "method": "POST",
          "path": "/api/files/WidgetOrder/customerEmail",
          "multipart": {
            "file": {
              "field": "file",
              "filename": "x.png",
              "contentType": "image/png",
              "content": "x"
            }
          },
          "expect": {
            "status": 400
          }
        }
      ]
    },
    {
      "id": "orch-condition-gates-rule-and-capability-action-fires",
      "keywords": [
        "orchestrationRule.condition",
        "orchestrationAction.capability",
        "orchestrationAction.operation"
      ],
      "description": "Rule AuditSubmittedReview triggers on WidgetReviewSubmitted with condition reviewer == 'auditor' and one callCapability action (capability webhook, operation post). Publishing the event with reviewer auditor starts the rule and the action runs (the webhook target is not served in the probe environment, so the runtime records OrchestrationCapabilityFailed naming capability webhook and operation post for that source event); the same event with reviewer bob is skipped with OrchestrationConditionSkipped (reason condition_false) and neither starts the rule nor runs the action.",
      "steps": [
        {
          "name": "publish auditor event",
          "method": "POST",
          "path": "/api/events/publish",
          "body": {
            "eventName": "WidgetReviewSubmitted",
            "correlationId": "orch-${rand}",
            "payload": {
              "id": "${uuid}",
              "reviewer": "auditor"
            }
          },
          "expect": {
            "status": 202
          },
          "save": {
            "eidA": "$.eventId"
          }
        },
        {
          "name": "publish bob event",
          "method": "POST",
          "path": "/api/events/publish",
          "body": {
            "eventName": "WidgetReviewSubmitted",
            "correlationId": "orch-${rand}",
            "payload": {
              "id": "${uuid}",
              "reviewer": "bob"
            }
          },
          "expect": {
            "status": 202
          },
          "save": {
            "eidB": "$.eventId"
          }
        },
        {
          "name": "rule started for auditor only",
          "method": "GET",
          "path": "/api/events/by-name/OrchestrationStarted?limit=20",
          "expect": {
            "status": 200,
            "text": [
              "\"sourceEventId\":\"${eidA}\""
            ],
            "notText": "${eidB}"
          },
          "retry": {
            "attempts": 5,
            "delaySeconds": 1
          }
        },
        {
          "name": "condition skipped for bob only",
          "method": "GET",
          "path": "/api/events/by-name/OrchestrationConditionSkipped?limit=20",
          "expect": {
            "status": 200,
            "text": [
              "\"sourceEventId\":\"${eidB}\"",
              "condition_false"
            ],
            "notText": "${eidA}"
          },
          "retry": {
            "attempts": 5,
            "delaySeconds": 1
          }
        },
        {
          "name": "action evidence names capability and operation",
          "method": "GET",
          "path": "/api/events/by-name/OrchestrationCapabilityFailed?limit=20",
          "expect": {
            "status": 200,
            "text": [
              "\"sourceEventId\":\"${eidA}\"",
              "\"capability\":\"webhook\"",
              "\"operation\":\"post\""
            ],
            "notText": "${eidB}"
          },
          "retry": {
            "attempts": 5,
            "delaySeconds": 1
          }
        }
      ]
    },
