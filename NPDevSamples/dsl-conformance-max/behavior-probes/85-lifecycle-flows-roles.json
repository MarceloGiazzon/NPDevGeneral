    {
      "id": "fl-human-task-assignee-sees-and-completes-the-task",
      "keywords": [
        "humanTask.title",
        "humanTask.description",
        "humanTask.record",
        "humanTask.fields",
        "humanTask.outcomes",
        "humanTask.outcomeField"
      ],
      "description": "The awaitEvent step AwaitCatalogEntryApproval carries a humanTask for role WarehouseManager. As a WarehouseManager key: the task detail has the interpolated title ('Approve catalog entry <id>'), the declared description, recordId = the flow input's id, the comment field (required false, maxLength 500), both outcomes and outcomeField 'decision'; an outcome outside the declared set is 400 TASK_OUTCOME_INVALID, an over-long comment 400 TASK_FIELD_INVALID, and a valid completion finishes the execution (COMPLETED).",
      "steps": [
        {
          "name": "park",
          "method": "POST",
          "path": "/api/flows/AwaitCatalogEntryApproval/execute",
          "body": {
            "id": "${uuid}",
            "sku": "HT-${rand}"
          },
          "expect": {
            "status": 202,
            "json": {
              "$.status": "WAITING_EVENT"
            }
          },
          "save": {
            "execId": "$.executionId"
          },
          "apiKey": "${key_warehousemanager}"
        },
        {
          "name": "detail",
          "method": "GET",
          "path": "/api/tasks/${execId}",
          "expect": {
            "status": 200,
            "json": {
              "$.title": {
                "matches": "^Approve catalog entry [0-9a-f-]{36}$"
              },
              "$.description": "Approve or reject the submitted widget catalog entry.",
              "$.recordId": {
                "matches": "^[0-9a-f-]{36}$"
              },
              "$.fields[?name=comment].maxLength": 500,
              "$.fields[?name=comment].required": false,
              "$.outcomes[?value=APPROVED].label": "Approve",
              "$.outcomes[?value=REJECTED].label": "Reject",
              "$.outcomeField": "decision"
            }
          },
          "apiKey": "${key_warehousemanager}"
        },
        {
          "name": "listed in the inbox",
          "method": "GET",
          "path": "/api/tasks",
          "expect": {
            "status": 200,
            "json": {
              "$.items[?executionId=${execId}].flowName": "AwaitCatalogEntryApproval"
            }
          },
          "apiKey": "${key_warehousemanager}"
        },
        {
          "name": "unknown outcome",
          "method": "POST",
          "path": "/api/tasks/${execId}/complete",
          "body": {
