          "path": "/api/runtime/aggregate/WidgetOrderAggregate",
          "body": {
            "id": "${oid}",
            "customerEmail": "developer",
            "status": "open",
            "lineCount": 4,
            "lines": [
              {
                "id": "0e0f1000-0000-4000-8000-000000000001",
                "sku": "zz",
                "quantity": 1,
                "unitPrice": 2
              },
              {
                "id": "0e0f1000-0000-4000-8000-000000000002",
                "sku": "mm",
                "quantity": 1,
                "unitPrice": 2
              },
              {
                "id": "0e0f1000-0000-4000-8000-000000000003",
                "sku": "bb",
                "quantity": 1,
                "unitPrice": 2
              },
              {
                "id": "0e0f1000-0000-4000-8000-000000000004",
                "sku": "aa",
                "quantity": 1,
                "unitPrice": 2
              }
            ]
          },
          "expect": {
            "status": 200,
            "json": {
              "$.lines[0].sku": "aa",
