{
  "probes": [
    {
      "id": "live1-add-optional-field-to-running-app",
      "keywords": ["field.type", "field.ui"],
      "requires": ["superUser"],
      "description": "LIVE-1: an optional scalar field added to an EXISTING concept by a second model revision becomes usable with NO restart. On the old model a POST carrying the new field is rejected; after POST /model-reload (revision 2) the same POST is accepted, a GET returns the field, an update changes it, a where filter on it works, the served UI manifest lists the field node and list column, and the typed integer field round-trips as a number. Only the generic /api/concepts/<table> endpoints are claimed live -- the typed /api/<route> controllers bind baked DTOs and are not asserted here.",
      "steps": [
        { "name": "old model rejects the unknown field", "method": "POST", "path": "/api/concepts/widget_suppliers",
          "body": { "supplierCode": "LIVE1-${rand}", "displayName": "before reload", "liveNote": "hello" },
          "expect": { "status": 400, "text": ["Unknown field for WidgetSupplier: liveNote"] } },
        { "name": "reload revision 2 (adds liveNote + liveRank) -- no restart", "method": "POST", "auth": "superUser",
          "path": "/api/admin/runtime/metadata-hotswap/model-reload",
          "reloadRevision": { "file": "live1-add-field.json", "revision": "addOptionalFields" },
          "expect": { "status": 200, "json": {
            "$.ok": true,
            "$.fieldsProvisioned": { "contains": "WidgetSupplier.liveNote" },
            "$.uiManifestFieldsRefreshed": { "contains": "WidgetSupplier.liveNote" },
            "$.uiManifestFieldsFailed": { "len": 0 } } } },
        { "name": "new model accepts the field", "method": "POST", "path": "/api/concepts/widget_suppliers",
          "body": { "supplierCode": "LIVE1-${rand}", "displayName": "after reload", "liveNote": "hello", "liveRank": 7 },
          "expect": { "status": [200, 201], "json": { "$.liveNote": "hello", "$.liveRank": 7 } },
          "save": { "entryId": "$.id" } },
        { "name": "GET returns the field", "method": "GET", "path": "/api/concepts/widget_suppliers/${entryId}",
          "expect": { "status": 200, "json": { "$.liveNote": "hello", "$.liveRank": 7 } } },
        { "name": "update changes the field and keeps the other", "method": "PUT", "path": "/api/concepts/widget_suppliers/${entryId}",
          "body": { "liveNote": "changed" },
          "expect": { "status": 200, "json": { "$.liveNote": "changed", "$.liveRank": 7 } } },
        { "name": "GET after update", "method": "GET", "path": "/api/concepts/widget_suppliers/${entryId}",
          "expect": { "status": 200, "json": { "$.liveNote": "changed", "$.liveRank": 7 } } },
        { "name": "where filter on the new column", "method": "GET", "path": "/api/concepts/widget_suppliers?where=liveNote:eq:changed&size=5",
          "expect": { "status": 200, "text": ["\"liveNote\":\"changed\""] } },
        { "name": "served UI manifest lists the field node", "method": "GET", "auth": "none",
          "path": "/npdev-business-ui/generated-ui-manifest.json",
          "expect": { "status": 200, "json": {
            "$.concepts[?conceptName=WidgetSupplier].fields[?name=liveNote].label": "Live note",
            "$.concepts[?conceptName=WidgetSupplier].list.columns": { "contains": "liveNote" } } } },
        { "name": "a required new field is refused (old model keeps serving)", "method": "POST", "auth": "superUser",
          "path": "/api/admin/runtime/metadata-hotswap/model-reload",
          "reloadRevision": { "file": "live1-add-field.json", "revision": "refusedRequiredField" },
          "expect": { "status": 422, "json": { "$.ok": false, "$.code": "RELOAD_UNSUPPORTED_FIELD_CHANGES" },
                      "text": ["WidgetSupplier.liveMust"], "notText": ["WidgetSupplier.liveNote"] } },
        { "name": "a field removal is refused (old model keeps serving)", "method": "POST", "auth": "superUser",
          "path": "/api/admin/runtime/metadata-hotswap/model-reload",
          "reloadRevision": { "file": "live1-add-field.json", "revision": "refusedFieldRemoval" },
          "expect": { "status": 422, "json": { "$.ok": false, "$.code": "RELOAD_UNSUPPORTED_FIELD_CHANGES" },
                      "text": ["WidgetSupplier.displayName"], "notText": ["WidgetSupplier.liveNote"] } },
        { "name": "the refused revisions left the previous model serving", "method": "GET", "path": "/api/concepts/widget_suppliers/${entryId}",
          "expect": { "status": 200, "json": { "$.liveNote": "changed" } } },
        { "name": "the refused required field was never accepted", "method": "POST", "path": "/api/concepts/widget_suppliers",
          "body": { "supplierCode": "LIVE1-${rand}", "displayName": "refused field", "liveMust": "x" },
          "expect": { "status": 400, "text": ["Unknown field for WidgetSupplier: liveMust"] } },
        { "name": "a column the database refuses: reload fails, nothing is swapped", "method": "POST", "auth": "superUser",
          "path": "/api/admin/runtime/metadata-hotswap/model-reload",
          "reloadRevision": { "file": "live1-add-field.json", "revision": "failingAlter" },
          "expect": { "status": 500, "json": { "$.ok": false, "$.code": "LIVE_COLUMN_PROVISIONING_FAILED", "$.swapped": false, "$.failedField": "WidgetSupplier.liveBig" } } },
        { "name": "the failed ALTER left the previous model serving (liveBig is unknown, liveNote still works)", "method": "POST", "path": "/api/concepts/widget_suppliers",
          "body": { "supplierCode": "LIVE1-${rand}", "displayName": "after failed alter", "liveBig": "x" },
          "expect": { "status": 400, "text": ["Unknown field for WidgetSupplier: liveBig"] } },
        { "name": "cleanup", "always": true, "method": "DELETE", "path": "/api/concepts/widget_suppliers/${entryId}" }
      ]
    }
  ]
}
