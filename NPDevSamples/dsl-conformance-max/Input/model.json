{
  "$schema": "..\\..\\NPDevContract\\schemas\\model.schema.json",
  "namespace": "trial.dslconformancemax",
  "dslVersion": "1.0.0",
  "version": "1.0",

  "externalAi": {
    "egress": "denied"
  },

  "settings": {
    "locale": "en-US",
    "strings": {
      "workbench.saved": "Order saved"
    },
    "ui": {
      "pageRows": 25,
      "dateFormat": "yyyy-MM-dd"
    }
  },

  "roles": [
    {
      "name": "WarehouseManager",
      "grants": ["EXECUTE_FLOW", "READ_EXECUTIONS", "READ_FLOW_DEFINITIONS"]
    }
  ],

  "propertyScopes": [
    { "name": "user", "from": "$user.id" },
    { "name": "tenant" }
  ],

  "properties": [
    { "name": "pageRows", "type": "int", "default": 25,
      "settableAt": ["tenant", "user"], "label": "Rows per page" },
    { "name": "requireConferenciaDupla", "type": "boolean", "default": false,
      "settableAt": ["tenant"], "securityRelevant": true,
      "label": "Require double-check on receipt" },
    { "name": "locale", "type": "string", "default": "en-US",
      "settableAt": ["tenant", "user"], "label": "Locale" },
    { "name": "dateFormat", "type": "string", "default": "yyyy-MM-dd",
      "settableAt": ["tenant", "user"], "label": "Date format" }
  ],

  "packs": [
    { "$ref": "packs/labeling/pack.json", "as": "labeling" }
  ],

  "fragments": [
    { "$ref": "fragments/auditLog.json" }
  ],

  "contexts": [
    { "name": "billing", "$ref": "contexts/billing.json" },
    { "name": "shipping", "$ref": "contexts/shipping.json" },
    { "name": "isolated-a", "$ref": "contexts/isolated-a.json", "physicallyIsolate": true },
    { "name": "isolated-b", "$ref": "contexts/isolated-b.json", "physicallyIsolate": true }
  ],

  "domainTypes": [
    {
      "name": "Sku",
      "baseType": "string",
      "format": "sku",
      "examples": [
        "WID-0001",
        "WID-9999"
      ],
      "ui": {
        "label": "SKU",
        "placeholder": "WID-0000"
      }
    }
  ],

  "concepts": [
    {
      "name": "WidgetOrder",
      "truthLevel": "T2",
      "ui": {
        "label": "Widget order"
      },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        {
          "name": "customerEmail",
          "renamedFrom": "email",
          "type": "string",
          "required": true,
          "sensitive": true,
          "ui": { "label": "Customer email" }
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "ui": { "label": "Status" }
        },
        {
          "name": "lineCount",
          "type": "integer",
          "required": true,
          "ui": { "label": "Line count" }
        },
        {
          "name": "purchaseOrderFile",
          "type": "file",
          "required": false,
          "file": {
            "contentTypes": ["application/pdf"],
            "maxSizeBytes": 5242880
          },
          "ui": { "label": "Purchase order (PDF)" }
        },
        {
          "name": "requestedShipDate",
          "type": "date",
          "required": false,
          "ui": { "label": "Requested ship date" }
        }
      ],
      "invariants": [
        {
          "name": "CustomerEmailRequired",
          "expr": "customerEmail != null && customerEmail != ''"
        },
        {
          "name": "LineCountNotNegative",
          "expr": "lineCount != null && lineCount >= 0"
        }
      ],
      "access": {
        "read": "customerEmail == $user.id",
        "write": "customerEmail == $user.id"
      }
    },
    {
      "name": "WidgetOrderLine",
      "truthLevel": "T2",
      "ui": {
        "label": "Widget order line"
      },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        {
          "name": "widgetOrderId",
          "type": "uuid",
          "required": true,
          "ui": { "label": "Order" },
          "picker": {
            "filter": "$row.status == 'Open'",
            "multiSelect": false
          }
        },
        {
          "name": "sku",
          "type": "string",
          "required": true,
          "domainType": "Sku",
          "ui": { "label": "SKU" }
        },
        {
          "name": "quantity",
          "type": "integer",
          "required": true,
          "ui": { "label": "Quantity" }
        }
      ],
      "invariants": [
        {
          "name": "PositiveQuantity",
          "expr": "quantity != null && quantity > 0"
        }
      ],
      "indexes": [
        {
          "name": "ux_widget_order_line_sku",
          "fields": ["widgetOrderId", "sku"],
          "unique": true
        }
      ]
    },
    {
      "name": "WidgetOrderLineNote",
      "truthLevel": "T2",
      "ui": {
        "label": "Widget order line note"
      },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        {
          "name": "widgetOrderLineId",
          "type": "uuid",
          "required": true,
          "ui": { "label": "Line" }
        },
        {
          "name": "text",
          "type": "string",
          "required": true,
          "ui": { "label": "Note" }
        }
      ]
    },
    {
      "name": "WidgetOrderAudit",
      "truthLevel": "T2",
      "ui": {
        "label": "Widget order audit"
      },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "quantity", "type": "integer", "required": true, "ui": { "label": "Quantity" } },
        { "name": "lastSyncedStatus", "type": "string", "required": false, "ui": { "label": "Last synced status" } }
      ]
    },
    {
      "name": "WidgetCatalogEntry",
      "truthLevel": "T2",
      "ui": {
        "label": "Widget catalog entry"
      },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        {
          "name": "sku",
          "type": "string",
          "required": true,
          "domainType": "Sku",
          "ui": { "label": "SKU" }
        },
        {
          "name": "displayName",
          "type": "string",
          "required": true,
          "ui": { "label": "Name" }
        },
        {
          "name": "discontinued",
          "type": "boolean",
          "required": true,
          "ui": { "label": "Discontinued" }
        },
        {
          "name": "unitPrice",
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "required": true,
          "ui": { "label": "Unit price" }
        }
      ],
      "invariants": [
        {
          "name": "CatalogSkuRequired",
          "expr": "sku != null && sku != ''"
        }
      ]
    },
    {
      "name": "PromotedWidgetCatalogEntry",
      "extends": "WidgetCatalogEntry",
      "truthLevel": "T2",
      "ui": {
        "label": "Promoted widget catalog entry"
      },
      "fields": [
        {
          "name": "promotionLabel",
          "type": "string",
          "required": true,
          "ui": { "label": "Promotion label" }
        }
      ]
    },
    {
      "name": "WidgetShipmentEvent",
      "truthLevel": "T2",
      "ui": {
        "label": "Widget shipment event"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "warehouseId",
          "type": "string",
          "required": true,
          "ui": { "label": "Warehouse" }
        },
        {
          "name": "shippedAt",
          "type": "date",
          "required": true,
          "ui": { "label": "Shipped at" }
        },
        {
          "name": "unitsShipped",
          "type": "integer",
          "required": true,
          "ui": { "label": "Units shipped" }
        }
      ]
    },
    {
      "name": "ConversionDemoCustomer",
      "truthLevel": "T2",
      "ui": { "label": "Conversion Demo Customer" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "fullName", "type": "string", "ui": { "label": "Full name (legacy)" } },
        { "name": "firstName", "type": "string", "required": true, "ui": { "label": "First name" } },
        { "name": "lastName", "type": "string", "required": true, "ui": { "label": "Last name" } },
        { "name": "displayName", "type": "string", "ui": { "label": "Display name" } }
      ]
    },
    {
      "name": "ConversionDemoOrder",
      "truthLevel": "T2",
      "ui": { "label": "Conversion Demo Order" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "legacyCode", "type": "string", "ui": { "label": "Legacy code" } },
        { "name": "externalRef", "type": "string", "required": true, "ui": { "label": "External reference" } },
        { "name": "priorityText", "type": "string", "ui": { "label": "Priority (legacy text)" } },
        { "name": "priorityNumber", "type": "integer", "ui": { "label": "Priority" } }
      ]
    },
    {
      "name": "ConversionDemoProduct",
      "truthLevel": "T2",
      "ui": { "label": "Conversion Demo Product" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "sku", "type": "string", "required": true, "ui": { "label": "SKU" } }
      ]
    },
    {
      "name": "ConversionDemoOrderLine",
      "truthLevel": "T2",
      "ui": { "label": "Conversion Demo Order Line" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "productSku", "type": "string", "ui": { "label": "Product SKU (legacy)" } },
        { "name": "productId", "type": "uuid", "required": true, "ui": { "label": "Product" } }
      ]
    }
  ],

  "conversions": [
    { "id": "0001-split-customer-name", "concept": "ConversionDemoCustomer", "op": "split",
      "from": "fullName",
      "into": [ { "field": "firstName", "take": "before-first-space" },
                { "field": "lastName", "take": "after-first-space" } ] },
    { "id": "0002-copy-order-code", "concept": "ConversionDemoOrder", "op": "copy",
      "from": "legacyCode", "to": "externalRef" },
    { "id": "0003-lookup-orderline-product", "concept": "ConversionDemoOrderLine", "op": "lookup",
      "match": { "concept": "ConversionDemoProduct", "on": "sku", "equals": "productSku" },
      "set": "productId" },
    { "id": "0004-merge-customer-display-name", "concept": "ConversionDemoCustomer", "op": "merge",
      "from": [ "firstName", "lastName" ], "to": "displayName", "with": " " },
    { "id": "0005-convert-order-priority", "concept": "ConversionDemoOrder", "op": "convert",
      "from": "priorityText", "to": "priorityNumber" }
  ],

  "capabilities": [
    {
      "name": "persistence",
      "type": "PersistenceCapability",
      "operations": [ "save", "findById" ]
    },
    {
      "name": "notification",
      "type": "NotificationCapability",
      "operations": [ "send" ]
    }
  ],

  "bindings": [
    { "capability": "persistence", "adapter": "repository" },
    { "capability": "notification", "adapter": "notification-inproc" },
    { "capability": "eventBus", "adapter": "inproc" }
  ],

  "events": [
    {
      "name": "WidgetOrderPlaced",
      "payload": [
        { "name": "id", "type": "uuid" },
        { "name": "status", "type": "string" }
      ]
    },
    {
      "name": "WidgetOrderLineRecorded",
      "payload": [
        { "name": "widgetOrderId", "type": "uuid" },
        { "name": "sku", "type": "string" }
      ]
    },
    {
      "name": "WidgetOrderReviewDue",
      "payload": [
        { "name": "widgetOrderId", "type": "uuid" }
      ]
    },
    {
      "name": "WidgetOrderLineApproved",
      "payload": [
        { "name": "sku", "type": "string" }
      ]
    },
    {
      "name": "WidgetOrderLineApprovalRecorded",
      "payload": [
        { "name": "sku", "type": "string" }
      ]
    }
  ],

  "ruleProfiles": [
    {
      "name": "always",
      "description": "Concept Gateway rules for the conformance fixture's concepts.",
      "appliesTo": [ "WidgetOrder", "WidgetOrderLine", "WidgetCatalogEntry" ],
      "enabled": true,
      "metadata": {
        "invariants": [
          "CustomerEmailRequired",
          "LineCountNotNegative",
          "PositiveQuantity",
          "CatalogSkuRequired"
        ]
      }
    }
  ],

  "queries": [
    {
      "name": "ActiveCatalogEntries",
      "concept": "WidgetCatalogEntry",
      "where": "discontinued == false",
      "orderBy": [ "sku" ]
    },
    {
      "name": "ShippedUnitsByWarehouseMonth",
      "concept": "WidgetShipmentEvent",
      "where": "unitsShipped > 0",
      "groupBy": [
        "warehouseId",
        { "field": "shippedAt", "bucket": "month" }
      ],
      "aggregates": [
        { "name": "totalUnits", "fn": "sum", "field": "unitsShipped" },
        { "name": "avgUnits", "fn": "avg", "field": "unitsShipped" },
        { "name": "minUnits", "fn": "min", "field": "unitsShipped" },
        { "name": "maxUnits", "fn": "max", "field": "unitsShipped" },
        { "name": "eventCount", "fn": "count" }
      ],
      "having": "totalUnits > 0",
      "orderBy": [ "totalUnits desc" ],
      "limit": 500,
      "metadata": {
        "purpose": "Coverage for query.groupBy/aggregates/having (Move 10 B1, LC-B1): plain-field groupBy + one bucketed date field (month), all five aggregate fn values, a having clause, orderBy and limit in one declaration."
      }
    }
  ],

  "selectors": [
    {
      "name": "WidgetCatalogPicker",
      "concept": "WidgetCatalogEntry",
      "multiSelect": true,
      "filters": [ "sku", "displayName" ],
      "columns": [ "sku", "displayName", "discontinued" ],
      "returnMapping": {
        "sku": "sku"
      },
      "metadata": {
        "purpose": "Coverage for selectors[]: no other corpus model declares one."
      }
    }
  ],

  "aggregates": [
    {
      "name": "WidgetOrderAggregate",
      "root": "WidgetOrder",
      "onCommit": "AuditWidgetOrderProcedure",
      "onValidate": "ValidateWidgetOrderProcedure",
      "collections": [
        {
          "name": "lines",
          "concept": "WidgetOrderLine",
          "childField": "widgetOrderId",
          "ownership": "owned",
          "orderBy": "sku",
          "collections": [
            {
              "name": "notes",
              "concept": "WidgetOrderLineNote",
              "childField": "widgetOrderLineId",
              "ownership": "owned"
            }
          ]
        }
      ],
      "metadata": {
        "purpose": "Second independent aggregate in the corpus; WmsOffice and its clone were the only ones. Depth-2 via lines->notes (REG-72, docs/MOVE3_AGGREGATE_WORKBENCH_PLAN.md)."
      }
    }
  ],

  "autoPanels": [
    {
      "name": "WidgetOrderWorkbench",
      "aggregate": "WidgetOrderAggregate",
      "route": "/widget-orders",
      "metadata": {
        "purpose": "Coverage for autoPanels[] outside WmsOffice."
      },
      "transaction": {
        "hooks": {
          "onLoad": "SeedWidgetOrderContextProcedure",
          "onFieldChange": "RecalculateWidgetOrderTotalsProcedure",
          "beforeAction": "ValidateWidgetOrderProcedure"
        },
        "derivedFields": {
          "totalQuantity": {
            "expression": "sum(lines[].quantity)",
            "label": "Total quantity"
          },
          "auditedQuantity": {
            "tier": "server",
            "procedure": "SummarizeWidgetOrderProcedure",
            "label": "Audited quantity"
          }
        },
        "regions": {
          "lines.notes": {
            "render": "component",
            "component": "widget-order-notes"
          }
        },
        "metadata": {
          "visibleWhen": {
            "lines": "$root.status != 'CANCELLED'"
          },
          "actions": [
            {
              "label": "Apply status",
              "procedure": "RenameOrderStatusProcedure",
              "inputFields": ["newStatus"],
              "metadata": {
                "purpose": "Coverage for workbench transaction.metadata.actions[].inputFields (G3, docs/MOVE3_AGGREGATE_WORKBENCH_PLAN.md): a workbench action collects this field via an inline mini-form and merges it into the draft posted to invoke(), so a 'propose' procedure can seed input the current draft has no field for."
              }
            },
            {
              "label": "Suggest line",
              "procedure": "SuggestLineProcedure",
              "applyTo": {
                "collection": "lines",
                "mode": "appendRow",
                "map": { "sku": "$resultado.id", "quantity": "1" }
              },
              "visibleWhen": "$root.status == 'DRAFT'",
              "metadata": {
                "purpose": "Coverage for the Workbench applyTo action mapping (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 2A) -- without applyTo, invoking a pure-computation action replaces the WHOLE draft with its raw result (invokeAction's other branch, store.patch); applyTo instead extracts named fields and appends one new row to a declared collection. map values follow patchConcept's own literal-by-default / $-ref convention -- quantity here is a literal, sku is a $ref into the raw invoke() result. Also covers action-level visibleWhen (Wave 2C / Gap 2) -- only offered while the order is still a DRAFT."
              }
            },
            {
              "label": "Suggest and fold line",
              "procedure": "SuggestLineProcedure",
              "afterAction": "ApplySuggestedLineProcedure",
              "metadata": {
                "purpose": "Coverage for Move 6 Move B's per-action afterAction (docs/MOVE6_TYPED_SURFACE_PLAN.md §B.4), which subsumes applyTo: instead of a static client-side field mapping, a procedure receiving {draft, result} and returning a patched draft -- declared per-action (like applyTo always has been) because different actions fold their results differently."
              }
            }
          ]
        }
      }
    },
    {
      "name": "WidgetOrderTypedActionsWorkbench",
      "aggregate": "WidgetOrderAggregate",
      "route": "/widget-orders-typed",
      "metadata": {
        "purpose": "Move 7 W1 (docs/MOVE7_IMPLEMENTATION_SPEC.md): dsl-conformance-max witness for the TYPED transaction.actions/.visibleWhen/.bandPickers, alongside WidgetOrderWorkbench's existing coverage of the untyped, deprecated transaction.metadata equivalents just above -- both spellings still work this release, but a typo in this typed form now fails at schema time instead of silently doing nothing."
      },
      "transaction": {
        "actions": [
          {
            "procedure": "RenameOrderStatusProcedure",
            "label": "Apply status (typed)",
            "inputFields": ["newStatus"]
          },
          {
            "procedure": "SuggestLineProcedure",
            "label": "Suggest line (typed)",
            "applyTo": {
              "collection": "lines",
              "mode": "appendRow",
              "map": { "sku": "$resultado.id", "quantity": "1" }
            },
            "visibleWhen": "$root.status == 'DRAFT'"
          },
          {
            "procedure": "SuggestLineProcedure",
            "label": "Suggest and fold line (typed)",
            "afterAction": "ApplySuggestedLineProcedure"
          }
        ],
        "uiState": {
          "recordKind": {
            "label": "Record kind",
            "values": ["INBOUND", "OUTBOUND"],
            "default": "INBOUND"
          }
        },
        "visibleWhen": {
          "lines": "$root.status != 'CANCELLED'",
          "lines.notes": "$ui.recordKind == 'INBOUND'"
        },
        "bandPickers": {
          "notes": {
            "panel": "WidgetOrderReviewPanel",
            "label": "Pick a note",
            "columns": ["id"],
            "filter": "$row.text != ''",
            "multiSelect": true
          }
        }
      }
    },
    {
      "name": "WidgetCatalogEntryBrowser",
      "concept": "WidgetCatalogEntry",
      "route": "/widget-catalog-entries",
      "metadata": {
        "purpose": "Move 8 D3 (item G6, docs/MOVE8_CLOSE_TABLE_SPEC.md / Move 6 §B.7): coverage for a concept-bound AutoPanel's Selection surface having its generated row source REPLACED by a procedure (the produce disposition PanelRuntime already executes for hand-authored panels), instead of the bound concept's own table."
      },
      "selection": {
        "dataSource": {
          "procedure": "ListActiveWidgetCatalogEntriesProcedure"
        }
      }
    }
  ],

  "panels": [
    {
      "name": "WidgetOrderReviewPanel",
      "route": "/widget-order-review",
      "title": "Widget order review",
      "dataSources": [
        {
          "name": "orders",
          "concept": "WidgetOrder",
          "onRowLoad": "EnrichWidgetOrderRowsProcedure"
        }
      ],
      "actions": [
        {
          "name": "place",
          "label": "Place order",
          "binding": "flow",
          "flow": "PlaceWidgetOrder",
          "metadata": {
            "purpose": "Coverage for panelAction.inputFields (G3, docs/MOVE2_PANEL_ACTIONS_PLAN.md): a panel-scoped create action collects these fields from the user before invoking the flow."
          },
          "inputFields": ["customerEmail", "status", "lineCount"]
        },
        {
          "name": "listCatalog",
          "label": "List catalog entries",
          "binding": "conceptQuery",
          "concept": "WidgetCatalogEntry",
          "metadata": {
            "purpose": "Coverage for panelAction.binding=conceptQuery (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 5): lists every record of a concept through the same governed ConceptGateway every other binding uses. Zero declarations AND zero test coverage anywhere before this."
          }
        },
        {
          "name": "confirm",
          "label": "Confirm order",
          "binding": "flow",
          "flow": "ConfirmWidgetOrder",
          "scope": "row",
          "dataSource": "orders",
          "visibleWhen": "status == 'pending'",
          "metadata": {
            "purpose": "Coverage for panelAction.scope=row (G2, docs/MOVE2_PANEL_ACTIONS_PLAN.md): rendered once per row of \"orders\", invoked with that row's id, visible only while status is pending."
          }
        },
        {
          "name": "exportCsv",
          "label": "Export CSV",
          "binding": "procedure",
          "procedure": "GenerateOrderExportProcedure",
          "resultAs": "download",
          "filename": "widget-orders.csv",
          "contentType": "text/csv",
          "metadata": {
            "purpose": "Coverage for panelAction.resultAs=download (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 4 / Gap 7): 'produce a file, stream it, persist nothing' -- PanelRuntime.executeAction returns the procedure's return value as a real file download instead of a JSON result."
          }
        }
      ]
    }
  ],

  "documents": [
    {
      "name": "WidgetOrderSummary",
      "concept": "WidgetOrder",
      "title": "Widget order summary",
      "pageSize": "A4",
      "marginMm": 18,
      "metadata": {
        "purpose": "Coverage for documents[]: only superuser-admin-console declared one."
      }
    }
  ],

  "guidePages": [
    {
      "name": "WidgetOrderGuide",
      "default": true
    }
  ],

  "procedures": [
    {
      "name": "RecountOrderLines",
      "description": "Procedure-over-aggregate shape: recompute the order's line count.",
      "parameters": [
        { "name": "widgetOrderId", "type": "uuid" }
      ],
      "steps": [
        {
          "name": "return-count",
          "type": "return",
          "value": "$widgetOrderId"
        }
      ]
    },
    {
      "name": "RenameOrderStatusProcedure",
      "description": "Coverage for a workbench action's inputFields (G3, docs/MOVE3_AGGREGATE_WORKBENCH_PLAN.md): reads the client-collected 'newStatus' input and maps it onto the draft's real 'status' field via mapValue's dotted-path/direct-ref resolution -- the same shape ParseNfeProcedure uses in WmsOffice for its bigger propose->review->commit composition.",
      "steps": [
        { "name": "map-status", "type": "mapValue", "value": "$newStatus", "target": "status" },
        { "name": "return-status", "type": "return", "value": "$status" }
      ]
    },
    {
      "name": "SuggestLineProcedure",
      "description": "Coverage for the Workbench applyTo action mapping (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 2A) -- a pure-computation-style suggestion (here: just echoing $input back, standing in for a real capabilityCall like WmsOffice's AllocationCapability.sugerirDestino) whose result the client folds into a NEW row via the action's declared applyTo, instead of invoke()'s other path (store.patch) which would replace the whole draft.",
      "steps": [
        { "name": "echo-input", "type": "mapValue", "value": "$input", "target": "resultado" },
        { "name": "return-resultado", "type": "return", "value": "$resultado" }
      ]
    },
    {
      "name": "GenerateOrderExportProcedure",
      "description": "Coverage for panelAction.resultAs=download (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 4 / Gap 7) -- a pure-generation procedure standing in for a real one like WmsOffice's GerarTemplateContagemProcedure. The client-facing action's resultAs/filename/contentType turn this return value into a real streamed file instead of a JSON result.",
      "steps": [
        { "name": "echo-input", "type": "mapValue", "value": "$input", "target": "exportPayload" },
        { "name": "return-export", "type": "return", "value": "$exportPayload" }
      ]
    },
    {
      "name": "MapImportedLinesProcedure",
      "description": "Coverage for mapList (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 3A / Gap 6): the produtosConhecidos/chavesJaImportadas auto-match shape from conferencia-fiscal.html's Romaneio Import -- forEach can iterate but cannot PRODUCE a collection, so parsing an external list into a properly-shaped one had no procedure step until now. select resolves per-item via the SAME literal-vs-$ref convention as patchConcept's set (sku is a $ref into the current loop item bound by 'as'; source is a fixed literal).",
      "steps": [
        { "name": "map-lines", "type": "mapList", "items": "$input.itens", "as": "linha",
          "select": { "sku": "$linha.codigo", "quantity": "$linha.qtd", "source": "import" },
          "target": "mappedLines" },
        { "name": "return-mapped", "type": "return", "value": "$mappedLines" }
      ]
    },
    {
      "name": "ValidateWidgetOrderProcedure",
      "description": "Coverage for aggregate.onValidate (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 3B / Gap 8): a pre-commit guard run BEFORE the root upsert (a sibling of onCommit, not a flag on it -- different timing, different contract: a non-ok result aborts with NO writes at all). This one is a trivial pass-through, standing in for a real guard like WmsOffice's ValidateMovimentoProcedure, which rejects a commit outright via readConcept's own CONCEPT_NOT_FOUND when a foreign reference is dangling.",
      "steps": [
        { "name": "echo-linecount", "type": "mapValue", "value": "$lineCount", "target": "validated" },
        { "name": "return-validated", "type": "return", "value": "$validated" }
      ]
    },
    {
      "name": "SeedWidgetOrderContextProcedure",
      "description": "Coverage for Move 6 Move B's transaction.hooks.onLoad (docs/MOVE6_TYPED_SURFACE_PLAN.md §B.2): invoked once against the freshly loaded draft, before the first render. A trivial pass-through here, standing in for a real onLoad that seeds computed defaults a brand-new draft has no field for yet.",
      "steps": [
        { "name": "echo-input", "type": "mapValue", "value": "$input", "target": "seeded" },
        { "name": "return-seeded", "type": "return", "value": "$seeded" }
      ]
    },
    {
      "name": "RecalculateWidgetOrderTotalsProcedure",
      "description": "Coverage for Move 6 Move B's transaction.hooks.onFieldChange (docs/MOVE6_TYPED_SURFACE_PLAN.md §B.4), the typed spelling of the retired transaction.metadata.recompute -- invoked (debounced) on every cell edit. A trivial pass-through here, standing in for a real recompute that patches derived totals as the user types.",
      "steps": [
        { "name": "echo-input", "type": "mapValue", "value": "$input", "target": "recalculated" },
        { "name": "return-recalculated", "type": "return", "value": "$recalculated" }
      ]
    },
    {
      "name": "SummarizeWidgetOrderProcedure",
      "description": "Coverage for Move 6 Move B's server-tier derivedFields (docs/MOVE6_TYPED_SURFACE_PLAN.md §B.4): unlike a client-tier expression, a server-tier derived field invokes this procedure over the current draft and reads its result state under the SAME key as the field's own name ('auditedQuantity' here) -- the same state-object convention every other invoke() consumer (recompute, actions) already relies on.",
      "steps": [
        { "name": "echo-linecount", "type": "mapValue", "value": "$lineCount", "target": "auditedQuantity" },
        { "name": "return-summary", "type": "return", "value": "$auditedQuantity" }
      ]
    },
    {
      "name": "ApplySuggestedLineProcedure",
      "description": "Coverage for Move 6 Move B's per-action afterAction (docs/MOVE6_TYPED_SURFACE_PLAN.md §B.4), which subsumes applyTo -- receives {draft, result} and returns the patched draft. A trivial pass-through here (echoes the draft back unchanged), standing in for a real fold like SuggestLineProcedure's applyTo sibling above.",
      "steps": [
        { "name": "echo-draft", "type": "mapValue", "value": "$input.draft", "target": "folded" },
        { "name": "return-folded", "type": "return", "value": "$folded" }
      ]
    },
    {
      "name": "EnrichWidgetOrderRowsProcedure",
      "description": "Coverage for Move 6 Move C's panelDataSource.onRowLoad (docs/MOVE6_TYPED_SURFACE_PLAN.md §4): enriches the rows a data source produced -- adds fields, never reorders/adds/drops rows (PanelRuntime enforces this batch guarantee in code, not just here). A trivial pass-through here (echoes rows back unchanged), standing in for a real enrichment that adds a computed field per row.",
      "steps": [
        { "name": "echo-rows", "type": "mapValue", "value": "$input.rows", "target": "rows" },
        { "name": "return-rows", "type": "return", "value": "$rows" }
      ]
    },
    {
      "name": "AuditWidgetOrderProcedure",
      "description": "Coverage for aggregate.onCommit + the patchConcept procedure step (Move 4, docs/MOVE4_CROSS_RECORD_WRITE_PLAN.md). Runs after WidgetOrderAggregate commits (input is the freshly reloaded tree) and patches a SIBLING record -- WidgetOrderAudit, outside the aggregate's own tree -- with the order's current lineCount/status, preserving every other field on that audit row. set values resolve like every other *Ref field: a literal by default, a leading '$' resolves against procedure state.",
      "steps": [
        { "name": "sync-audit", "type": "patchConcept", "concept": "WidgetOrderAudit", "id": "$input.id",
          "set": { "quantity": "$input.lineCount", "lastSyncedStatus": "$input.status" }, "target": "audited" },
        { "name": "return-audited", "type": "return", "value": "$audited" }
      ]
    },
    {
      "name": "EnsureWidgetOrderAuditProcedure",
      "description": "Coverage for patchConcept's createIfMissing flag (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 1B) -- the create half of REG-77. Unlike AuditWidgetOrderProcedure (which patches an audit row that always already exists, created alongside its order), this one tolerates the row not existing yet: id references a key nothing populates, so on the resulting CONCEPT_NOT_FOUND miss patchConcept builds a brand-new WidgetOrderAudit from set alone with a freshly generated id, rather than failing.",
      "steps": [
        { "name": "ensure-audit", "type": "patchConcept", "concept": "WidgetOrderAudit", "id": "$existingAuditId",
          "set": { "quantity": 0, "lastSyncedStatus": "Unsynced" }, "target": "ensured", "createIfMissing": true },
        { "name": "return-ensured", "type": "return", "value": "$ensured" }
      ]
    },
    {
      "name": "IncrementOrderAuditQuantityProcedure",
      "description": "Coverage for computeValue (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md, final item / REG-78): the arithmetic primitive procedures previously had none of -- patchConcept's set can copy or overwrite a value, never compute one AS A FUNCTION of the current value. This is the exact shape WmsOffice's SyncOcupacaoProcedure needs (find an occupancy row, then increment its quantity by a signed delta) instead of only ever copying or replacing a value outright: readConcept the existing row, computeValue the new total, patchConcept it back.",
      "steps": [
        { "name": "read-audit", "type": "readConcept", "concept": "WidgetOrderAudit", "id": "$existingAuditId", "target": "existingAudit" },
        { "name": "increment-quantity", "type": "computeValue", "operation": "add",
          "left": "$existingAudit.quantity", "right": "$delta", "target": "newQuantity" },
        { "name": "apply-increment", "type": "patchConcept", "concept": "WidgetOrderAudit", "id": "$existingAuditId",
          "set": { "quantity": "$newQuantity" }, "target": "incremented" },
        { "name": "return-incremented", "type": "return", "value": "$incremented" }
      ]
    },
    {
      "name": "ListActiveWidgetCatalogEntriesProcedure",
      "description": "Move 8 D3 (item G6, docs/MOVE8_CLOSE_TABLE_SPEC.md / Move 6 §B.7): the produce-disposition witness -- returns a bare list, which PanelRuntime's loadDataSource takes directly as the Selection surface's rows (result.state().get(\"return\")), replacing the row source the bound concept's table would otherwise supply.",
      "steps": [
        { "name": "list-entries", "type": "listConcepts", "concept": "WidgetCatalogEntry", "target": "entries" },
        { "name": "return-entries", "type": "return", "value": "$entries" }
      ]
    },
    {
      "name": "ReturnLiteralCatalogSummaryProcedure",
      "description": "Coverage for REG-86 (Move 9 C3, found during Move 8 D3): before this fix, mapValue/return forced their value through a String ref-only path, so a literal array/object was impossible -- only a $ref into procedure state survived. This procedure returns a literal array of objects directly, no capabilityCall round-trip needed to construct it (the same literal-vs-$ref convention patchConcept's set already established, reused here).",
      "steps": [
        { "name": "map-summary", "type": "mapValue",
          "value": [ { "sku": "WIDGET-1", "status": "active" }, { "sku": "WIDGET-2", "status": "active" } ],
          "target": "summary" },
        { "name": "return-summary", "type": "return", "value": "$summary" }
      ]
    }
  ],

  "flows": [
    {
      "name": "RenameOrderStatusViaFlow",
      "input": { "concept": "WidgetOrder", "mode": "update" },
      "steps": [
        { "name": "call-rename", "type": "callProcedure", "procedure": "RenameOrderStatusProcedure", "input": "$input", "output": "$renamed" },
        { "name": "return-renamed", "type": "return", "value": "$renamed" }
      ]
    },
    {
      "name": "PlaceWidgetOrder",
      "startEndpoint": true,
      "input": {
        "concept": "WidgetOrder",
        "mode": "create"
      },
      "inputSchema": {
        "type": "object",
        "required": ["customerEmail", "status", "lineCount"],
        "properties": {
          "customerEmail": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "lineCount": { "type": "integer" }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "customerEmail": { "type": "string" },
          "status": { "type": "string" },
          "lineCount": { "type": "integer" }
        }
      },
      "steps": [
        {
          "name": "validate-order",
          "type": "invariantCheck",
          "scope": "WidgetOrder",
          "invariants": [
            "CustomerEmailRequired",
            "LineCountNotNegative"
          ]
        },
        {
          "name": "save-order",
          "type": "createConcept",
          "scope": "WidgetOrder",
          "input": "$input",
          "output": "$saved",
          "onFailure": [
            {
              "name": "compensate-notify",
              "type": "capabilityCall",
              "capability": "notification",
              "operation": "send",
              "args": [ "$input" ],
              "output": "$compensationNotice",
              "policy": {
                "retryCount": 3,
                "retryDelayMs": 250,
                "timeoutMs": 5000,
                "circuitOpenAfterFailures": 3,
                "circuitOpenMs": 15000,
                "bulkheadMaxConcurrent": 5,
                "idempotencyKeyField": "input.id",
                "failureClassification": "transient"
              }
            }
          ]
        },
        {
          "name": "capture-order-id",
          "type": "map",
          "input": "$saved.id",
          "output": "$orderId"
        },
        {
          "name": "score-order-risk",
          "type": "generatedAction",
          "actionName": "ScoreWidgetOrderRisk",
          "input": "$saved",
          "output": "$riskScore"
        },
        {
          "name": "schedule-review",
          "type": "scheduleEvent",
          "event": "WidgetOrderReviewDue",
          "from": "$saved",
          "delaySeconds": 3600
        },
        {
          "name": "return-order",
          "type": "return",
          "value": "$saved"
        }
      ]
    },
    {
      "name": "PlaceWidgetOrderAudited",
      "specializes": "PlaceWidgetOrder",
      "hooks": [
        {
          "position": "after",
          "targetStep": "save-order",
          "steps": [
            {
              "name": "hook-emit-placed",
              "type": "emitEvent",
              "event": "WidgetOrderPlaced",
              "from": "$saved"
            }
          ]
        }
      ]
    },
    {
      "name": "RecordOrderLines",
      "input": {
        "concept": "WidgetOrderLine",
        "mode": "create"
      },
      "steps": [
        {
          "name": "validate-line",
          "type": "invariantCheck",
          "scope": "WidgetOrderLine",
          "invariants": [ "PositiveQuantity" ]
        },
        {
          "name": "save-line",
          "type": "createConcept",
          "scope": "WidgetOrderLine",
          "input": "$input",
          "output": "$savedLine"
        },
        {
          "name": "emit-line-recorded",
          "type": "emitEvent",
          "event": "WidgetOrderLineRecorded",
          "from": "$savedLine"
        },
        {
          "name": "return-line",
          "type": "return",
          "value": "$savedLine"
        }
      ]
    },
    {
      "name": "UpdateOrderLineQuantity",
      "input": {
        "concept": "WidgetOrderLine",
        "mode": "update"
      },
      "steps": [
        {
          "name": "validate-line",
          "type": "invariantCheck",
          "checkpoint": "pre",
          "scope": "WidgetOrderLine",
          "invariants": [ "PositiveQuantity" ]
        },
        {
          "name": "apply-quantity",
          "type": "updateConcept",
          "scope": "WidgetOrderLine",
          "input": "$input",
          "output": "$updatedLine"
        },
        {
          "name": "validate-line-post",
          "type": "invariantCheck",
          "checkpoint": "post",
          "scope": "WidgetOrderLine",
          "input": "$updatedLine",
          "invariants": [ "PositiveQuantity" ]
        },
        {
          "name": "emit-line-updated",
          "type": "emitEvent",
          "event": "WidgetOrderLineRecorded",
          "from": "$updatedLine"
        },
        {
          "name": "return-line",
          "type": "return",
          "value": "$updatedLine"
        }
      ]
    },
    {
      "name": "ConfirmWidgetOrder",
      "input": {
        "concept": "WidgetOrder",
        "mode": "update"
      },
      "steps": [
        {
          "name": "apply-confirmed",
          "type": "updateConcept",
          "scope": "WidgetOrder",
          "input": "$input",
          "output": "$confirmed"
        },
        {
          "name": "return-confirmed",
          "type": "return",
          "value": "$confirmed"
        }
      ]
    },
    {
      "name": "SweepDiscontinuedCatalog",
      "concept": "WidgetCatalogEntry",
      "schedule": {
        "cron": "0 15 3 * * *"
      },
      "steps": [
        {
          "name": "sweep-entries",
          "type": "forEach",
          "collection": "$input.entries",
          "itemKey": "entry",
          "maxLoopIterations": 500,
          "steps": [
            {
              "name": "flag-entry",
              "type": "capabilityCall",
              "capability": "notification",
              "operation": "send",
              "args": [ "$entry" ],
              "output": "$flagged"
            }
          ]
        },
        {
          "name": "return-sweep",
          "type": "return",
          "value": "$input"
        }
      ]
    },
    {
      "name": "ProcessWidgetOrderLineApprovals",
      "concept": "WidgetOrder",
      "steps": [
        {
          "name": "await-line-approvals",
          "type": "forEach",
          "collection": "$input.skus",
          "itemKey": "sku",
          "maxLoopIterations": 50,
          "steps": [
            {
              "name": "await-line-approved",
              "type": "awaitEvent",
              "awaitEvent": "WidgetOrderLineApproved",
              "match": {
                "correlation": true
              },
              "awaitRef": "lineApproval"
            }
          ]
        },
        {
          "name": "return-processed",
          "type": "return",
          "value": "$input"
        }
      ]
    },
    {
      "name": "ProcessParallelWidgetOrderLineApprovals",
      "concept": "WidgetOrder",
      "steps": [
        {
          "name": "await-line-approvals-parallel",
          "type": "forEach",
          "collection": "$input.skus",
          "itemKey": "sku",
          "maxLoopIterations": 50,
          "parallelAwait": true,
          "steps": [
            {
              "name": "capture-sku-parallel",
              "type": "map",
              "input": "$sku",
              "output": "$skuSeen"
            },
            {
              "name": "await-line-approved-parallel",
              "type": "awaitEvent",
              "awaitEvent": "WidgetOrderLineApproved",
              "match": {
                "correlation": true
              },
              "awaitRef": "lineApproval"
            },
            {
              "name": "notify-line-approved-parallel",
              "type": "emitEvent",
              "event": "WidgetOrderLineApprovalRecorded",
              "payload": "$lineApproval"
            }
          ]
        },
        {
          "name": "return-processed-parallel",
          "type": "return",
          "value": "$input"
        }
      ]
    }
  ]
}
