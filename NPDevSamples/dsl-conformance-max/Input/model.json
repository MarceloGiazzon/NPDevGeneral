{
  "$schema": "..\\..\\NPDevContract\\schemas\\model.schema.json",
  "namespace": "trial.dslconformancemax",
  "dslVersion": "1.0.0",
  "version": "1.0",

  "externalAi": {
    "egress": "denied"
  },

  "packs": [
    { "$ref": "packs/labeling/pack.json", "as": "labeling" }
  ],

  "fragments": [
    { "$ref": "fragments/auditLog.json" }
  ],

  "domainTypes": [
    {
      "name": "Sku",
      "baseType": "string",
      "format": "sku",
      "examples": [
        "WID-0001",
        "WID-9999"
      ],
      "ui": {
        "label": "SKU",
        "placeholder": "WID-0000"
      }
    }
  ],

  "concepts": [
    {
      "name": "WidgetOrder",
      "ui": {
        "label": "Widget order"
      },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        {
          "name": "customerEmail",
          "type": "string",
          "required": true,
          "ui": { "label": "Customer email" }
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "ui": { "label": "Status" }
        },
        {
          "name": "lineCount",
          "type": "integer",
          "required": true,
          "ui": { "label": "Line count" }
        }
      ],
      "invariants": [
        {
          "name": "CustomerEmailRequired",
          "expr": "customerEmail != null && customerEmail != ''"
        },
        {
          "name": "LineCountNotNegative",
          "expr": "lineCount != null && lineCount >= 0"
        }
      ]
    },
    {
      "name": "WidgetOrderLine",
      "ui": {
        "label": "Widget order line"
      },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        {
          "name": "widgetOrderId",
          "type": "uuid",
          "required": true,
          "ui": { "label": "Order" }
        },
        {
          "name": "sku",
          "type": "string",
          "required": true,
          "domainType": "Sku",
          "ui": { "label": "SKU" }
        },
        {
          "name": "quantity",
          "type": "integer",
          "required": true,
          "ui": { "label": "Quantity" }
        }
      ],
      "invariants": [
        {
          "name": "PositiveQuantity",
          "expr": "quantity != null && quantity > 0"
        }
      ]
    },
    {
      "name": "WidgetOrderLineNote",
      "ui": {
        "label": "Widget order line note"
      },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        {
          "name": "widgetOrderLineId",
          "type": "uuid",
          "required": true,
          "ui": { "label": "Line" }
        },
        {
          "name": "text",
          "type": "string",
          "required": true,
          "ui": { "label": "Note" }
        }
      ]
    },
    {
      "name": "WidgetOrderAudit",
      "ui": {
        "label": "Widget order audit"
      },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "quantity", "type": "integer", "required": true, "ui": { "label": "Quantity" } },
        { "name": "lastSyncedStatus", "type": "string", "required": false, "ui": { "label": "Last synced status" } }
      ]
    },
    {
      "name": "WidgetCatalogEntry",
      "ui": {
        "label": "Widget catalog entry"
      },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        {
          "name": "sku",
          "type": "string",
          "required": true,
          "domainType": "Sku",
          "ui": { "label": "SKU" }
        },
        {
          "name": "displayName",
          "type": "string",
          "required": true,
          "ui": { "label": "Name" }
        },
        {
          "name": "discontinued",
          "type": "boolean",
          "required": true,
          "ui": { "label": "Discontinued" }
        }
      ],
      "invariants": [
        {
          "name": "CatalogSkuRequired",
          "expr": "sku != null && sku != ''"
        }
      ]
    }
  ],

  "capabilities": [
    {
      "name": "persistence",
      "type": "PersistenceCapability",
      "operations": [ "save", "findById" ]
    },
    {
      "name": "notification",
      "type": "NotificationCapability",
      "operations": [ "send" ]
    }
  ],

  "bindings": [
    { "capability": "persistence", "adapter": "repository" },
    { "capability": "notification", "adapter": "notification-inproc" },
    { "capability": "eventBus", "adapter": "inproc" }
  ],

  "events": [
    {
      "name": "WidgetOrderPlaced",
      "payload": [
        { "name": "id", "type": "uuid" },
        { "name": "status", "type": "string" }
      ]
    },
    {
      "name": "WidgetOrderLineRecorded",
      "payload": [
        { "name": "widgetOrderId", "type": "uuid" },
        { "name": "sku", "type": "string" }
      ]
    },
    {
      "name": "WidgetOrderReviewDue",
      "payload": [
        { "name": "widgetOrderId", "type": "uuid" }
      ]
    }
  ],

  "ruleProfiles": [
    {
      "name": "always",
      "description": "Concept Gateway rules for the conformance fixture's concepts.",
      "appliesTo": [ "WidgetOrder", "WidgetOrderLine", "WidgetCatalogEntry" ],
      "enabled": true,
      "metadata": {
        "invariants": [
          "CustomerEmailRequired",
          "LineCountNotNegative",
          "PositiveQuantity",
          "CatalogSkuRequired"
        ]
      }
    }
  ],

  "queries": [
    {
      "name": "ActiveCatalogEntries",
      "concept": "WidgetCatalogEntry",
      "where": "discontinued == false",
      "orderBy": [ "sku" ]
    }
  ],

  "selectors": [
    {
      "name": "WidgetCatalogPicker",
      "concept": "WidgetCatalogEntry",
      "multiSelect": true,
      "filters": [ "sku", "displayName" ],
      "columns": [ "sku", "displayName", "discontinued" ],
      "returnMapping": {
        "sku": "sku"
      },
      "metadata": {
        "purpose": "Coverage for selectors[]: no other corpus model declares one."
      }
    }
  ],

  "aggregates": [
    {
      "name": "WidgetOrderAggregate",
      "root": "WidgetOrder",
      "onCommit": "AuditWidgetOrderProcedure",
      "onValidate": "ValidateWidgetOrderProcedure",
      "collections": [
        {
          "name": "lines",
          "concept": "WidgetOrderLine",
          "childField": "widgetOrderId",
          "ownership": "owned",
          "orderBy": "sku",
          "collections": [
            {
              "name": "notes",
              "concept": "WidgetOrderLineNote",
              "childField": "widgetOrderLineId",
              "ownership": "owned"
            }
          ]
        }
      ],
      "metadata": {
        "purpose": "Second independent aggregate in the corpus; WmsOffice and its clone were the only ones. Depth-2 via lines->notes (REG-72, docs/MOVE3_AGGREGATE_WORKBENCH_PLAN.md)."
      }
    }
  ],

  "autoPanels": [
    {
      "name": "WidgetOrderWorkbench",
      "aggregate": "WidgetOrderAggregate",
      "route": "/widget-orders",
      "metadata": {
        "purpose": "Coverage for autoPanels[] outside WmsOffice."
      },
      "transaction": {
        "metadata": {
          "visibleWhen": {
            "lines": "$root.status != 'CANCELLED'"
          },
          "actions": [
            {
              "label": "Apply status",
              "procedure": "RenameOrderStatusProcedure",
              "inputFields": ["newStatus"],
              "metadata": {
                "purpose": "Coverage for workbench transaction.metadata.actions[].inputFields (G3, docs/MOVE3_AGGREGATE_WORKBENCH_PLAN.md): a workbench action collects this field via an inline mini-form and merges it into the draft posted to invoke(), so a 'propose' procedure can seed input the current draft has no field for."
              }
            },
            {
              "label": "Suggest line",
              "procedure": "SuggestLineProcedure",
              "applyTo": {
                "collection": "lines",
                "mode": "appendRow",
                "map": { "sku": "$resultado.id", "quantity": "1" }
              },
              "visibleWhen": "$root.status == 'DRAFT'",
              "metadata": {
                "purpose": "Coverage for the Workbench applyTo action mapping (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 2A) -- without applyTo, invoking a pure-computation action replaces the WHOLE draft with its raw result (invokeAction's other branch, store.patch); applyTo instead extracts named fields and appends one new row to a declared collection. map values follow patchConcept's own literal-by-default / $-ref convention -- quantity here is a literal, sku is a $ref into the raw invoke() result. Also covers action-level visibleWhen (Wave 2C / Gap 2) -- only offered while the order is still a DRAFT."
              }
            }
          ],
          "derived": [
            {
              "name": "totalQuantity",
              "expression": "sum(lines[].quantity)",
              "label": "Total quantity"
            }
          ]
        }
      }
    }
  ],

  "panels": [
    {
      "name": "WidgetOrderReviewPanel",
      "route": "/widget-order-review",
      "title": "Widget order review",
      "dataSources": [
        {
          "name": "orders",
          "concept": "WidgetOrder"
        }
      ],
      "actions": [
        {
          "name": "place",
          "label": "Place order",
          "binding": "flow",
          "flow": "PlaceWidgetOrder",
          "metadata": {
            "purpose": "Coverage for panelAction.inputFields (G3, docs/MOVE2_PANEL_ACTIONS_PLAN.md): a panel-scoped create action collects these fields from the user before invoking the flow."
          },
          "inputFields": ["customerEmail", "status", "lineCount"]
        },
        {
          "name": "confirm",
          "label": "Confirm order",
          "binding": "flow",
          "flow": "ConfirmWidgetOrder",
          "scope": "row",
          "dataSource": "orders",
          "visibleWhen": "status == 'pending'",
          "metadata": {
            "purpose": "Coverage for panelAction.scope=row (G2, docs/MOVE2_PANEL_ACTIONS_PLAN.md): rendered once per row of \"orders\", invoked with that row's id, visible only while status is pending."
          }
        }
      ]
    }
  ],

  "documents": [
    {
      "name": "WidgetOrderSummary",
      "concept": "WidgetOrder",
      "title": "Widget order summary",
      "pageSize": "A4",
      "marginMm": 18,
      "metadata": {
        "purpose": "Coverage for documents[]: only superuser-admin-console declared one."
      }
    }
  ],

  "guidePages": [
    {
      "name": "WidgetOrderGuide",
      "default": true
    }
  ],

  "procedures": [
    {
      "name": "RecountOrderLines",
      "description": "Procedure-over-aggregate shape: recompute the order's line count.",
      "parameters": [
        { "name": "widgetOrderId", "type": "uuid" }
      ],
      "steps": [
        {
          "name": "return-count",
          "type": "return",
          "value": "$widgetOrderId"
        }
      ]
    },
    {
      "name": "RenameOrderStatusProcedure",
      "description": "Coverage for a workbench action's inputFields (G3, docs/MOVE3_AGGREGATE_WORKBENCH_PLAN.md): reads the client-collected 'newStatus' input and maps it onto the draft's real 'status' field via mapValue's dotted-path/direct-ref resolution -- the same shape ParseNfeProcedure uses in WmsOffice for its bigger propose->review->commit composition.",
      "steps": [
        { "name": "map-status", "type": "mapValue", "value": "$newStatus", "target": "status" },
        { "name": "return-status", "type": "return", "value": "$status" }
      ]
    },
    {
      "name": "SuggestLineProcedure",
      "description": "Coverage for the Workbench applyTo action mapping (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 2A) -- a pure-computation-style suggestion (here: just echoing $input back, standing in for a real capabilityCall like WmsOffice's AllocationCapability.sugerirDestino) whose result the client folds into a NEW row via the action's declared applyTo, instead of invoke()'s other path (store.patch) which would replace the whole draft.",
      "steps": [
        { "name": "echo-input", "type": "mapValue", "value": "$input", "target": "resultado" },
        { "name": "return-resultado", "type": "return", "value": "$resultado" }
      ]
    },
    {
      "name": "MapImportedLinesProcedure",
      "description": "Coverage for mapList (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 3A / Gap 6): the produtosConhecidos/chavesJaImportadas auto-match shape from conferencia-fiscal.html's Romaneio Import -- forEach can iterate but cannot PRODUCE a collection, so parsing an external list into a properly-shaped one had no procedure step until now. select resolves per-item via the SAME literal-vs-$ref convention as patchConcept's set (sku is a $ref into the current loop item bound by 'as'; source is a fixed literal).",
      "steps": [
        { "name": "map-lines", "type": "mapList", "items": "$input.itens", "as": "linha",
          "select": { "sku": "$linha.codigo", "quantity": "$linha.qtd", "source": "import" },
          "target": "mappedLines" },
        { "name": "return-mapped", "type": "return", "value": "$mappedLines" }
      ]
    },
    {
      "name": "ValidateWidgetOrderProcedure",
      "description": "Coverage for aggregate.onValidate (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 3B / Gap 8): a pre-commit guard run BEFORE the root upsert (a sibling of onCommit, not a flag on it -- different timing, different contract: a non-ok result aborts with NO writes at all). This one is a trivial pass-through, standing in for a real guard like WmsOffice's ValidateMovimentoProcedure, which rejects a commit outright via readConcept's own CONCEPT_NOT_FOUND when a foreign reference is dangling.",
      "steps": [
        { "name": "echo-linecount", "type": "mapValue", "value": "$lineCount", "target": "validated" },
        { "name": "return-validated", "type": "return", "value": "$validated" }
      ]
    },
    {
      "name": "AuditWidgetOrderProcedure",
      "description": "Coverage for aggregate.onCommit + the patchConcept procedure step (Move 4, docs/MOVE4_CROSS_RECORD_WRITE_PLAN.md). Runs after WidgetOrderAggregate commits (input is the freshly reloaded tree) and patches a SIBLING record -- WidgetOrderAudit, outside the aggregate's own tree -- with the order's current lineCount/status, preserving every other field on that audit row. set values resolve like every other *Ref field: a literal by default, a leading '$' resolves against procedure state.",
      "steps": [
        { "name": "sync-audit", "type": "patchConcept", "concept": "WidgetOrderAudit", "id": "$input.id",
          "set": { "quantity": "$input.lineCount", "lastSyncedStatus": "$input.status" }, "target": "audited" },
        { "name": "return-audited", "type": "return", "value": "$audited" }
      ]
    },
    {
      "name": "EnsureWidgetOrderAuditProcedure",
      "description": "Coverage for patchConcept's createIfMissing flag (Move 5, docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md Wave 1B) -- the create half of REG-77. Unlike AuditWidgetOrderProcedure (which patches an audit row that always already exists, created alongside its order), this one tolerates the row not existing yet: id references a key nothing populates, so on the resulting CONCEPT_NOT_FOUND miss patchConcept builds a brand-new WidgetOrderAudit from set alone with a freshly generated id, rather than failing.",
      "steps": [
        { "name": "ensure-audit", "type": "patchConcept", "concept": "WidgetOrderAudit", "id": "$existingAuditId",
          "set": { "quantity": 0, "lastSyncedStatus": "Unsynced" }, "target": "ensured", "createIfMissing": true },
        { "name": "return-ensured", "type": "return", "value": "$ensured" }
      ]
    }
  ],

  "flows": [
    {
      "name": "RenameOrderStatusViaFlow",
      "input": { "concept": "WidgetOrder", "mode": "update" },
      "steps": [
        { "name": "call-rename", "type": "callProcedure", "procedure": "RenameOrderStatusProcedure", "input": "$input", "output": "$renamed" },
        { "name": "return-renamed", "type": "return", "value": "$renamed" }
      ]
    },
    {
      "name": "PlaceWidgetOrder",
      "input": {
        "concept": "WidgetOrder",
        "mode": "create"
      },
      "steps": [
        {
          "name": "validate-order",
          "type": "invariantCheck",
          "scope": "WidgetOrder",
          "invariants": [
            "CustomerEmailRequired",
            "LineCountNotNegative"
          ]
        },
        {
          "name": "save-order",
          "type": "createConcept",
          "scope": "WidgetOrder",
          "input": "$input",
          "output": "$saved",
          "onFailure": [
            {
              "name": "compensate-notify",
              "type": "capabilityCall",
              "capability": "notification",
              "operation": "send",
              "args": [ "$input" ],
              "output": "$compensationNotice"
            }
          ]
        },
        {
          "name": "capture-order-id",
          "type": "map",
          "input": "$saved.id",
          "output": "$orderId"
        },
        {
          "name": "score-order-risk",
          "type": "generatedAction",
          "actionName": "ScoreWidgetOrderRisk",
          "input": "$saved",
          "output": "$riskScore"
        },
        {
          "name": "schedule-review",
          "type": "scheduleEvent",
          "event": "WidgetOrderReviewDue",
          "from": "$saved",
          "delaySeconds": 3600
        },
        {
          "name": "return-order",
          "type": "return",
          "value": "$saved"
        }
      ]
    },
    {
      "name": "PlaceWidgetOrderAudited",
      "specializes": "PlaceWidgetOrder",
      "hooks": [
        {
          "position": "after",
          "targetStep": "save-order",
          "steps": [
            {
              "name": "hook-emit-placed",
              "type": "emitEvent",
              "event": "WidgetOrderPlaced",
              "from": "$saved"
            }
          ]
        }
      ]
    },
    {
      "name": "RecordOrderLines",
      "input": {
        "concept": "WidgetOrderLine",
        "mode": "create"
      },
      "steps": [
        {
          "name": "validate-line",
          "type": "invariantCheck",
          "scope": "WidgetOrderLine",
          "invariants": [ "PositiveQuantity" ]
        },
        {
          "name": "save-line",
          "type": "createConcept",
          "scope": "WidgetOrderLine",
          "input": "$input",
          "output": "$savedLine"
        },
        {
          "name": "emit-line-recorded",
          "type": "emitEvent",
          "event": "WidgetOrderLineRecorded",
          "from": "$savedLine"
        },
        {
          "name": "return-line",
          "type": "return",
          "value": "$savedLine"
        }
      ]
    },
    {
      "name": "UpdateOrderLineQuantity",
      "input": {
        "concept": "WidgetOrderLine",
        "mode": "update"
      },
      "steps": [
        {
          "name": "validate-line",
          "type": "invariantCheck",
          "scope": "WidgetOrderLine",
          "invariants": [ "PositiveQuantity" ]
        },
        {
          "name": "apply-quantity",
          "type": "updateConcept",
          "scope": "WidgetOrderLine",
          "input": "$input",
          "output": "$updatedLine"
        },
        {
          "name": "emit-line-updated",
          "type": "emitEvent",
          "event": "WidgetOrderLineRecorded",
          "from": "$updatedLine"
        },
        {
          "name": "return-line",
          "type": "return",
          "value": "$updatedLine"
        }
      ]
    },
    {
      "name": "ConfirmWidgetOrder",
      "input": {
        "concept": "WidgetOrder",
        "mode": "update"
      },
      "steps": [
        {
          "name": "apply-confirmed",
          "type": "updateConcept",
          "scope": "WidgetOrder",
          "input": "$input",
          "output": "$confirmed"
        },
        {
          "name": "return-confirmed",
          "type": "return",
          "value": "$confirmed"
        }
      ]
    },
    {
      "name": "SweepDiscontinuedCatalog",
      "concept": "WidgetCatalogEntry",
      "schedule": {
        "cron": "0 15 3 * * *"
      },
      "steps": [
        {
          "name": "sweep-entries",
          "type": "forEach",
          "collection": "$input.entries",
          "itemKey": "entry",
          "maxLoopIterations": 500,
          "steps": [
            {
              "name": "flag-entry",
              "type": "capabilityCall",
              "capability": "notification",
              "operation": "send",
              "args": [ "$entry" ],
              "output": "$flagged"
            }
          ]
        },
        {
          "name": "return-sweep",
          "type": "return",
          "value": "$input"
        }
      ]
    }
  ]
}
