{
  "$schema": "../../../../../NPDevContract/schemas/pack.schema.json",
  "dslVersion": "1.0.0",
  "pack": "labeling",
  "version": "1.0.0",
  "namespace": "com.npdev.labeling",
  "description": "docs/FAIL_OPEN_PLAN.md R2: minimal, fully in-git example of a top-level `packs` entry -- a self-contained, reusable domain module composed into the model via $ref, same mechanism AppGen/apps/_official/WmsOffice's identity/workspace packs use, with no out-of-tree asset dependency.",
  "category": "other",
  "author": "NPDev",
  "concepts": [
    {
      "name": "Label",
      "truthLevel": "T2",
      "ui": {
        "label": "Label"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "text",
          "type": "string",
          "required": true,
          "maxLength": 80,
          "ui": {
            "label": "Text"
          }
        },
        {
          "name": "color",
          "type": "string",
          "required": false,
          "maxLength": 20,
          "ui": {
            "label": "Color"
          }
        }
      ]
    }
  ],
  "autoPanels": [
    {
      "name": "LabelAdmin",
      "concept": "Label",
      "route": "/labeling/labels",
      "surfaces": [
        "selection",
        "detail"
      ],
      "selection": {
        "columns": [
          "text",
          "color"
        ],
        "filters": [
          "text"
        ]
      },
      "detail": {
        "fields": [
          "text",
          "color"
        ]
      },
      "metadata": {
        "purpose": "PACK-11 coverage: a pack-contributed autoPanel. Before PACK-11 the key was missing from BOTH ModelSourceResolver.MODEL_ARRAY_KEYS and pack.schema.json, so this declaration was refused outright."
      }
    }
  ],
  "guidePages": [
    {
      "name": "LabelingOverview",
      "gadgets": [
        {
          "name": "labelCount",
          "type": "kpi",
          "title": "Labels",
          "query": "LabelsByColor",
          "y": "labelCount"
        }
      ]
    }
  ],
  "queries": [
    {
      "name": "LabelsByColor",
      "concept": "Label",
      "groupBy": [
        "color"
      ],
      "aggregates": [
        {
          "name": "labelCount",
          "fn": "count"
        }
      ]
    }
  ]
}
