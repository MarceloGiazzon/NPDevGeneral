{
  "$schema": "../../schemas/pack.schema.json",
  "dslVersion": "1.0.0",
  "pack": "sales",
  "version": "1.0.0",
  "namespace": "com.npdev.sales",
  "description": "NPDev sales pack: customers, a price list, sales orders with lines, and invoices. A person with the 'salesRep' role drafts orders and adds lines; 'salesManager' also confirms orders, maintains customers and the price list and may do anything an accountant can; 'accountant' issues invoices and records payment. An order is DRAFT, then CONFIRMED, then INVOICED (or CANCELLED); an invoice is ISSUED, then PAID (or VOID). Order totals and the amount owed per customer are derived by queries, never typed in. The three roles are logical: the importing app binds them with provides.roleBindings { \"salesRep\": ..., \"salesManager\": ..., \"accountant\": ... } (composition refuses when one is unbound) and grants them read/create/update on the pack's concepts in its own roles[] (see the dom-sales sample). Numeric bounds are declared as invariants (enforced today) beside field min, because field.min/max are not yet enforced by the platform (REG-255).",
  "category": "other",
  "author": "NPDev",
  "metadata": {
    "summary": "Sells to customers. A customer buys items from a price list; a sales order lists what they want, line by line, and moves from draft to confirmed to invoiced. An invoice records how much is owed and when, and is later marked paid. Order totals and what each customer still owes are always calculated from the lines and invoices, never typed in.",
    "reviewNotes": [
      "No discounts and no tax: a line total is quantity times unit price. Say which discounts and which taxes your business applies, and whether prices include tax.",
      "The pack does not stop an invoice being raised for an order that is not confirmed, or for an amount different from the order total; it records what the accountant enters. Say whether the invoice amount must equal the order total.",
      "One invoice per order is not enforced; partial and repeated invoicing are therefore possible. Say which you want.",
      "Moving an order to INVOICED is a separate step from raising the invoice; nothing links them automatically.",
      "Credit limit is stored but not checked: an order for a customer over the limit is accepted.",
      "A line copies the unit price when it is entered (so later price-list changes do not rewrite old orders), but nothing checks it against the price list.",
      "Stock is not reserved or reduced by a sale. Linking sales to the inventory pack is a decision for the first app that needs both.",
      "A confirmed order may still be cancelled; cancelling an order that already has an invoice does not void the invoice.",
      "Today numeric bounds are enforced through the rules above; the field-level min/max declarations are repeated for documentation only because the platform does not enforce them yet."
    ]
  },
  "concepts": [
    {
      "name": "Customer",
      "truthLevel": "T2",
      "ui": {
        "label": "Customer"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "code",
          "type": "string",
          "ui": {
            "label": "Code"
          },
          "required": true,
          "unique": true,
          "maxLength": 30
        },
        {
          "name": "name",
          "type": "string",
          "ui": {
            "label": "Name"
          },
          "required": true,
          "maxLength": 200
        },
        {
          "name": "taxId",
          "type": "string",
          "ui": {
            "label": "Tax id"
          },
          "required": false,
          "maxLength": 40
        },
        {
          "name": "email",
          "type": "string",
          "ui": {
            "label": "Email"
          },
          "required": false,
          "maxLength": 254
        },
        {
          "name": "creditLimit",
          "type": "decimal",
          "ui": {
            "label": "Credit limit"
          },
          "required": false,
          "precision": 14,
          "scale": 2,
          "min": 0
        },
        {
          "name": "active",
          "type": "boolean",
          "ui": {
            "label": "Active"
          },
          "required": true,
          "default": true
        }
      ],
      "invariants": [
        {
          "name": "CreditLimitNotNegative",
          "type": "expression",
          "expr": "creditLimit == null || creditLimit >= 0"
        }
      ],
      "access": {
        "read": "$user.roles.contains('ADMIN') || $user.roles.contains(role('salesManager')) || $user.roles.contains(role('salesRep')) || $user.roles.contains(role('accountant'))",
        "write": "$user.roles.contains('ADMIN') || $user.roles.contains(role('salesManager'))"
      }
    },
    {
      "name": "SalesItem",
      "truthLevel": "T2",
      "ui": {
        "label": "Price list item"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "sku",
          "type": "string",
          "ui": {
            "label": "SKU"
          },
          "required": true,
          "unique": true,
          "maxLength": 40
        },
        {
          "name": "description",
          "type": "string",
          "ui": {
            "label": "Description"
          },
          "required": true,
          "maxLength": 300
        },
        {
          "name": "unitPrice",
          "type": "decimal",
          "ui": {
            "label": "Unit price"
          },
          "required": true,
          "precision": 14,
          "scale": 2,
          "min": 0
        },
        {
          "name": "active",
          "type": "boolean",
          "ui": {
            "label": "Active"
          },
          "required": true,
          "default": true
        }
      ],
      "invariants": [
        {
          "name": "UnitPriceNotNegative",
          "type": "expression",
          "expr": "unitPrice >= 0"
        }
      ],
      "access": {
        "read": "$user.roles.contains('ADMIN') || $user.roles.contains(role('salesManager')) || $user.roles.contains(role('salesRep')) || $user.roles.contains(role('accountant'))",
        "write": "$user.roles.contains('ADMIN') || $user.roles.contains(role('salesManager'))"
      }
    },
    {
      "name": "SalesOrder",
      "truthLevel": "T2",
      "ui": {
        "label": "Sales order"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "orderNumber",
          "type": "string",
          "ui": {
            "label": "Order number"
          },
          "required": true,
          "unique": true,
          "maxLength": 30
        },
        {
          "name": "customerId",
          "type": "reference",
          "ui": {
            "label": "Customer"
          },
          "required": true,
          "reference": {
            "target": "Customer",
            "displayField": "name"
          }
        },
        {
          "name": "status",
          "type": "enum",
          "ui": {
            "label": "Status"
          },
          "required": true,
          "default": "DRAFT",
          "enumValues": [
            "DRAFT",
            "CONFIRMED",
            "INVOICED",
            "CANCELLED"
          ]
        },
        {
          "name": "orderDate",
          "type": "datetime",
          "ui": {
            "label": "Order date"
          },
          "required": false,
          "defaultExpression": "now()"
        },
        {
          "name": "notes",
          "type": "string",
          "ui": {
            "label": "Notes"
          },
          "required": false,
          "maxLength": 1000
        }
      ],
      "lifecycle": {
        "statusField": "status",
        "states": [
          {
            "value": "DRAFT",
            "label": "Draft",
            "initial": true
          },
          {
            "value": "CONFIRMED",
            "label": "Confirmed"
          },
          {
            "value": "INVOICED",
            "label": "Invoiced",
            "terminal": true
          },
          {
            "value": "CANCELLED",
            "label": "Cancelled",
            "terminal": true
          }
        ],
        "transitions": [
          {
            "from": "DRAFT",
            "to": "CONFIRMED",
            "event": "SalesOrderConfirmed",
            "actionLabel": "Confirm"
          },
          {
            "from": "DRAFT",
            "to": "CANCELLED",
            "event": "SalesOrderCancelled",
            "actionLabel": "Cancel"
          },
          {
            "from": "CONFIRMED",
            "to": "INVOICED",
            "event": "SalesOrderInvoiced",
            "actionLabel": "Mark invoiced"
          },
          {
            "from": "CONFIRMED",
            "to": "CANCELLED",
            "event": "SalesOrderCancelled",
            "actionLabel": "Cancel"
          }
        ]
      },
      "indexes": [
        {
          "name": "idx_sales_order_customer",
          "fields": [
            "customerId",
            "status"
          ]
        }
      ],
      "access": {
        "read": "$user.roles.contains('ADMIN') || $user.roles.contains(role('salesManager')) || $user.roles.contains(role('salesRep')) || $user.roles.contains(role('accountant'))",
        "write": "$user.roles.contains('ADMIN') || $user.roles.contains(role('salesManager')) || $user.roles.contains(role('salesRep'))"
      }
    },
    {
      "name": "SalesOrderLine",
      "truthLevel": "T2",
      "ui": {
        "label": "Order line"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "orderId",
          "type": "reference",
          "ui": {
            "label": "Order"
          },
          "required": true,
          "reference": {
            "target": "SalesOrder",
            "displayField": "orderNumber",
            "onDelete": "cascade"
          }
        },
        {
          "name": "itemId",
          "type": "reference",
          "ui": {
            "label": "Item"
          },
          "required": true,
          "reference": {
            "target": "SalesItem",
            "displayField": "sku"
          }
        },
        {
          "name": "quantity",
          "type": "decimal",
          "ui": {
            "label": "Quantity"
          },
          "required": true,
          "precision": 14,
          "scale": 3,
          "min": 0.001
        },
        {
          "name": "unitPrice",
          "type": "decimal",
          "ui": {
            "label": "Unit price"
          },
          "required": true,
          "precision": 14,
          "scale": 2,
          "min": 0
        },
        {
          "name": "lineTotal",
          "type": "decimal",
          "ui": {
            "label": "Line total"
          },
          "required": false,
          "precision": 16,
          "scale": 2,
          "derivedExpression": "quantity * unitPrice"
        }
      ],
      "invariants": [
        {
          "name": "QuantityPositive",
          "type": "expression",
          "expr": "quantity > 0"
        },
        {
          "name": "UnitPriceNotNegative",
          "type": "expression",
          "expr": "unitPrice >= 0"
        }
      ],
      "indexes": [
        {
          "name": "idx_sales_line_order",
          "fields": [
            "orderId"
          ]
        }
      ],
      "access": {
        "read": "$user.roles.contains('ADMIN') || $user.roles.contains(role('salesManager')) || $user.roles.contains(role('salesRep')) || $user.roles.contains(role('accountant'))",
        "write": "$user.roles.contains('ADMIN') || $user.roles.contains(role('salesManager')) || $user.roles.contains(role('salesRep'))"
      }
    },
    {
      "name": "Invoice",
      "truthLevel": "T2",
      "ui": {
        "label": "Invoice"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "invoiceNumber",
          "type": "string",
          "ui": {
            "label": "Invoice number"
          },
          "required": true,
          "unique": true,
          "maxLength": 30
        },
        {
          "name": "orderId",
          "type": "reference",
          "ui": {
            "label": "Order"
          },
          "required": true,
          "reference": {
            "target": "SalesOrder",
            "displayField": "orderNumber"
          }
        },
        {
          "name": "customerId",
          "type": "reference",
          "ui": {
            "label": "Customer"
          },
          "required": true,
          "reference": {
            "target": "Customer",
            "displayField": "name"
          }
        },
        {
          "name": "amount",
          "type": "decimal",
          "ui": {
            "label": "Amount"
          },
          "required": true,
          "precision": 16,
          "scale": 2,
          "min": 0.01
        },
        {
          "name": "issueDate",
          "type": "datetime",
          "ui": {
            "label": "Issued"
          },
          "required": false,
          "defaultExpression": "now()"
        },
        {
          "name": "dueDate",
          "type": "datetime",
          "ui": {
            "label": "Due"
          },
          "required": true
        },
        {
          "name": "status",
          "type": "enum",
          "ui": {
            "label": "Status"
          },
          "required": true,
          "default": "ISSUED",
          "enumValues": [
            "ISSUED",
            "PAID",
            "VOID"
          ]
        }
      ],
      "invariants": [
        {
          "name": "AmountPositive",
          "type": "expression",
          "expr": "amount > 0"
        }
      ],
      "lifecycle": {
        "statusField": "status",
        "states": [
          {
            "value": "ISSUED",
            "label": "Issued",
            "initial": true
          },
          {
            "value": "PAID",
            "label": "Paid",
            "terminal": true
          },
          {
            "value": "VOID",
            "label": "Void",
            "terminal": true
          }
        ],
        "transitions": [
          {
            "from": "ISSUED",
            "to": "PAID",
            "event": "InvoicePaid",
            "actionLabel": "Record payment"
          },
          {
            "from": "ISSUED",
            "to": "VOID",
            "event": "InvoiceVoided",
            "actionLabel": "Void"
          }
        ]
      },
      "indexes": [
        {
          "name": "idx_sales_invoice_customer",
          "fields": [
            "customerId",
            "status"
          ]
        }
      ],
      "access": {
        "read": "$user.roles.contains('ADMIN') || $user.roles.contains(role('salesManager')) || $user.roles.contains(role('salesRep')) || $user.roles.contains(role('accountant'))",
        "write": "$user.roles.contains('ADMIN') || $user.roles.contains(role('salesManager')) || $user.roles.contains(role('accountant'))"
      }
    }
  ],
  "events": [
    {
      "name": "SalesOrderConfirmed",
      "payload": [
        "customerId"
      ]
    },
    {
      "name": "SalesOrderCancelled",
      "payload": [
        "customerId"
      ]
    },
    {
      "name": "SalesOrderInvoiced",
      "payload": [
        "customerId"
      ]
    },
    {
      "name": "InvoicePaid",
      "payload": [
        "customerId",
        "amount"
      ]
    },
    {
      "name": "InvoiceVoided",
      "payload": [
        "customerId",
        "amount"
      ]
    }
  ],
  "queries": [
    {
      "name": "ActiveCustomers",
      "concept": "Customer",
      "where": "active == true",
      "orderBy": [
        "name"
      ]
    },
    {
      "name": "OpenOrders",
      "concept": "SalesOrder",
      "where": "status == 'DRAFT'",
      "orderBy": [
        "orderDate desc"
      ]
    },
    {
      "name": "OrderTotals",
      "concept": "SalesOrderLine",
      "groupBy": [
        "orderId"
      ],
      "aggregates": [
        {
          "name": "total",
          "fn": "sum",
          "field": "lineTotal"
        },
        {
          "name": "lines",
          "fn": "count"
        }
      ]
    },
    {
      "name": "AmountOwedByCustomer",
      "concept": "Invoice",
      "where": "status == 'ISSUED'",
      "groupBy": [
        "customerId"
      ],
      "aggregates": [
        {
          "name": "owed",
          "fn": "sum",
          "field": "amount"
        },
        {
          "name": "openInvoices",
          "fn": "count"
        }
      ],
      "lookups": [
        {
          "name": "paid",
          "concept": "Invoice",
          "fn": "sum",
          "field": "amount",
          "on": {
            "customerId": "customerId"
          },
          "where": "status == 'PAID'"
        }
      ],
      "orderBy": [
        "owed desc"
      ]
    }
  ],
  "autoPanels": [
    {
      "name": "Customers",
      "concept": "Customer",
      "route": "/customers",
      "surfaces": [
        "selection",
        "detail",
        "transaction"
      ],
      "selection": {
        "columns": [
          "code",
          "name",
          "email",
          "creditLimit",
          "active"
        ]
      }
    },
    {
      "name": "PriceList",
      "concept": "SalesItem",
      "route": "/price-list",
      "surfaces": [
        "selection",
        "detail",
        "transaction"
      ],
      "selection": {
        "columns": [
          "sku",
          "description",
          "unitPrice",
          "active"
        ]
      }
    },
    {
      "name": "SalesOrders",
      "concept": "SalesOrder",
      "route": "/sales-orders",
      "surfaces": [
        "selection",
        "detail",
        "transaction"
      ],
      "selection": {
        "columns": [
          "orderNumber",
          "customerId",
          "orderDate",
          "status"
        ]
      }
    },
    {
      "name": "SalesOrderLines",
      "concept": "SalesOrderLine",
      "route": "/sales-order-lines",
      "surfaces": [
        "selection",
        "detail",
        "transaction"
      ],
      "selection": {
        "columns": [
          "orderId",
          "itemId",
          "quantity",
          "unitPrice",
          "lineTotal"
        ]
      }
    },
    {
      "name": "Invoices",
      "concept": "Invoice",
      "route": "/invoices",
      "surfaces": [
        "selection",
        "detail",
        "transaction"
      ],
      "selection": {
        "columns": [
          "invoiceNumber",
          "customerId",
          "amount",
          "dueDate",
          "status"
        ]
      }
    }
  ]
}
