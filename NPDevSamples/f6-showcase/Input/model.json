{
  "$schema": "..\\..\\..\\NPDevContract\\schemas\\model.schema.json",
  "namespace": "sample.f6showcase",
  "dslVersion": "1.0.0",
  "version": "1.0",
  "metadata": {
    "purpose": "F6 showcase: one small app demonstrating every frontend coverage feature, one section per feature."
  },
  "concepts": [
    {
      "name": "Ticket",
      "ui": {
        "label": "Ticket"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "ui": {
            "label": "Title"
          }
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "ui": {
            "label": "Status"
          }
        },
        {
          "name": "priority",
          "type": "integer",
          "required": true,
          "ui": {
            "label": "Priority"
          }
        }
      ],
      "invariants": [
        {
          "name": "TicketTitleRequired",
          "expr": "title != null && title != ''"
        }
      ]
    },
    {
      "name": "Project",
      "ui": {
        "label": "Project"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "ui": {
            "label": "Name"
          }
        },
        {
          "name": "rate",
          "type": "integer",
          "ui": {
            "label": "Hourly rate"
          }
        }
      ]
    },
    {
      "name": "Phase",
      "ui": {
        "label": "Phase"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "projectId",
          "type": "uuid"
        },
        {
          "name": "title",
          "type": "string",
          "ui": {
            "label": "Title"
          }
        }
      ]
    },
    {
      "name": "Task",
      "ui": {
        "label": "Task"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "phaseId",
          "type": "uuid"
        },
        {
          "name": "title",
          "type": "string",
          "ui": {
            "label": "Title"
          }
        }
      ]
    },
    {
      "name": "Subtask",
      "ui": {
        "label": "Subtask"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "taskId",
          "type": "uuid"
        },
        {
          "name": "title",
          "type": "string",
          "ui": {
            "label": "Title"
          }
        },
        {
          "name": "hours",
          "type": "integer",
          "ui": {
            "label": "Hours"
          }
        }
      ]
    }
  ],
  "capabilities": [
    {
      "name": "persistence",
      "type": "PersistenceCapability",
      "operations": [
        "save",
        "findById"
      ]
    }
  ],
  "bindings": [
    {
      "capability": "persistence",
      "adapter": "repository"
    },
    {
      "capability": "eventBus",
      "adapter": "inproc"
    }
  ],
  "seeds": [
    {
      "concept": "Ticket",
      "alias": "t1",
      "data": {
        "title": "Printer on floor 2 is offline",
        "status": "OPEN",
        "priority": 2
      }
    },
    {
      "concept": "Ticket",
      "alias": "t2",
      "data": {
        "title": "New hire laptop request",
        "status": "OPEN",
        "priority": 1
      }
    },
    {
      "concept": "Ticket",
      "alias": "t3",
      "data": {
        "title": "VPN drops every hour",
        "status": "IN_PROGRESS",
        "priority": 3
      }
    },
    {
      "concept": "Ticket",
      "alias": "t4",
      "data": {
        "title": "Reset shared mailbox password",
        "status": "DONE",
        "priority": 1
      }
    },
    {
      "concept": "Project",
      "alias": "pr1",
      "data": {
        "name": "Website relaunch",
        "rate": 50
      }
    },
    {
      "concept": "Phase",
      "alias": "ph1",
      "data": {
        "projectId": "$ref:pr1",
        "title": "Design"
      }
    },
    {
      "concept": "Phase",
      "alias": "ph2",
      "data": {
        "projectId": "$ref:pr1",
        "title": "Build"
      }
    },
    {
      "concept": "Task",
      "alias": "tk1",
      "data": {
        "phaseId": "$ref:ph1",
        "title": "Wireframes"
      }
    },
    {
      "concept": "Task",
      "alias": "tk2",
      "data": {
        "phaseId": "$ref:ph2",
        "title": "Checkout page"
      }
    },
    {
      "concept": "Subtask",
      "alias": "st1",
      "data": {
        "taskId": "$ref:tk1",
        "title": "Home wireframe",
        "hours": 4
      }
    },
    {
      "concept": "Subtask",
      "alias": "st2",
      "data": {
        "taskId": "$ref:tk1",
        "title": "Cart wireframe",
        "hours": 6
      }
    },
    {
      "concept": "Subtask",
      "alias": "st3",
      "data": {
        "taskId": "$ref:tk2",
        "title": "Payment form",
        "hours": 4
      }
    },
    {
      "concept": "Subtask",
      "alias": "st4",
      "data": {
        "taskId": "$ref:tk2",
        "title": "Order summary",
        "hours": 6
      }
    }
  ],
  "panels": [
    {
      "name": "TicketBoard",
      "route": "/f6/ticket-board",
      "title": "Ticket board (layoutSlot)",
      "layout": {
        "type": "table",
        "fields": [
          "title",
          "status",
          "priority"
        ],
        "slots": [
          {
            "placement": "above",
            "component": "ticket-kpis",
            "label": "Ticket KPIs"
          },
          {
            "placement": "below",
            "component": "ticket-timeline",
            "label": "Ticket timeline"
          }
        ]
      },
      "dataSources": [
        {
          "name": "tickets",
          "concept": "Ticket"
        }
      ],
      "fieldBindings": [
        {
          "field": "title",
          "source": "tickets.title"
        },
        {
          "field": "status",
          "source": "tickets.status"
        },
        {
          "field": "priority",
          "source": "tickets.priority"
        }
      ],
      "explainability": {
        "governedDataAccess": "ConceptGateway",
        "ruleProfile": "always"
      }
    },
    {
      "name": "TicketConsole",
      "route": "/f6/ticket-console",
      "title": "Ticket console (operator console)",
      "layout": {
        "type": "console",
        "widgets": [
          {
            "kind": "tile",
            "title": "Tickets",
            "dataSource": "tickets"
          },
          {
            "kind": "tile",
            "title": "Open",
            "dataSource": "tickets",
            "filter": {
              "field": "status",
              "equals": "OPEN"
            }
          },
          {
            "kind": "tile",
            "title": "In progress",
            "dataSource": "tickets",
            "filter": {
              "field": "status",
              "equals": "IN_PROGRESS"
            }
          },
          {
            "kind": "tile",
            "title": "Total priority",
            "dataSource": "tickets",
            "aggregate": "sum",
            "field": "priority"
          },
          {
            "kind": "actions",
            "title": "Operations"
          },
          {
            "kind": "history",
            "title": "Recent runs"
          },
          {
            "kind": "table",
            "title": "All tickets",
            "dataSource": "tickets"
          }
        ]
      },
      "dataSources": [
        {
          "name": "tickets",
          "concept": "Ticket"
        }
      ],
      "actions": [
        {
          "name": "open",
          "label": "Open ticket",
          "binding": "flow",
          "flow": "OpenTicket",
          "inputFields": [
            "title",
            "status",
            "priority"
          ]
        }
      ],
      "explainability": {
        "governedDataAccess": "ConceptGateway",
        "ruleProfile": "always"
      }
    },
    {
      "name": "TicketDashboard",
      "route": "/f6/ticket-dashboard",
      "title": "Ticket dashboard (dashboard)",
      "layout": {
        "type": "dashboard",
        "widgets": [
          {
            "kind": "tile",
            "title": "Tickets",
            "dataSource": "tickets",
            "span": 2
          },
          {
            "kind": "tile",
            "title": "Average priority",
            "dataSource": "tickets",
            "aggregate": "avg",
            "field": "priority",
            "span": 2
          },
          {
            "kind": "chart",
            "title": "Tickets by status",
            "dataSource": "tickets",
            "chart": "bar",
            "groupBy": "status"
          },
          {
            "kind": "chart",
            "title": "Priority by status",
            "dataSource": "tickets",
            "chart": "donut",
            "groupBy": "status",
            "aggregate": "sum",
            "field": "priority"
          },
          {
            "kind": "chart",
            "title": "Highest priority by status",
            "dataSource": "tickets",
            "chart": "line",
            "groupBy": "status",
            "aggregate": "max",
            "field": "priority",
            "span": 4
          }
        ]
      },
      "dataSources": [
        {
          "name": "tickets",
          "concept": "Ticket"
        }
      ],
      "explainability": {
        "governedDataAccess": "ConceptGateway",
        "ruleProfile": "always"
      }
    }
  ],
  "flows": [
    {
      "name": "OpenTicket",
      "input": {
        "concept": "Ticket",
        "mode": "create"
      },
      "steps": [
        {
          "name": "validate-ticket",
          "type": "invariantCheck",
          "scope": "Ticket",
          "invariants": [
            "TicketTitleRequired"
          ]
        },
        {
          "name": "save-ticket",
          "type": "createConcept",
          "scope": "Ticket",
          "input": "$input",
          "output": "$saved"
        },
        {
          "name": "return-ticket",
          "type": "return",
          "value": "$saved"
        }
      ]
    }
  ],
  "aggregates": [
    {
      "name": "Project",
      "root": "Project",
      "collections": [
        {
          "name": "phases",
          "concept": "Phase",
          "childField": "projectId",
          "ownership": "owned",
          "collections": [
            {
              "name": "tasks",
              "concept": "Task",
              "childField": "phaseId",
              "ownership": "owned",
              "collections": [
                {
                  "name": "subtasks",
                  "concept": "Subtask",
                  "childField": "taskId",
                  "ownership": "owned"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "autoPanels": [
    {
      "aggregate": "Project",
      "transaction": {
        "computed": [
          {
            "col": "cost",
            "expr": "hours * $root.rate",
            "collection": "phases.tasks.subtasks"
          },
          {
            "col": "doubled",
            "expr": "hours * 2",
            "collection": "phases.tasks.subtasks"
          }
        ],
        "derivedFields": {
          "totalHours": {
            "label": "Total hours",
            "expression": "sum(phases.tasks.subtasks.hours)"
          },
          "totalCost": {
            "label": "Total cost",
            "expression": "sum(phases.tasks.subtasks.hours) * rate"
          },
          "hasWork": {
            "label": "Has work",
            "expression": "count(phases.tasks.subtasks) > 0"
          }
        }
      }
    }
  ]
}
