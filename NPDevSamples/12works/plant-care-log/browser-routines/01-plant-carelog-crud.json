{
  "scenarioName": "plant-care-log-crud",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "plantName": "UITEST-PLANT-PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "dev-key" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-Plant\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Plant\"]", "label": "Open the Plant concept" },
    { "action": "waitForSelector", "selector": "#concept-Plant", "state": "visible" },
    { "action": "click", "selector": "#concept-Plant .panel-actions button:has-text(\"New\")", "label": "Open the Plant create form" },
    { "action": "waitForSelector", "selector": "#concept-Plant form", "state": "visible" },
    { "action": "fill", "selector": "#concept-Plant [name=\"name\"]", "valueFromVariable": "plantName" },
    { "action": "fill", "selector": "#concept-Plant [name=\"species\"]", "value": "Monstera deliciosa" },
    { "action": "fill", "selector": "#concept-Plant .object-group-editor input[data-prop=\"wateringIntervalDays\"]", "value": "7", "label": "Nested careNeeds.wateringIntervalDays leaf input" },
    { "action": "fill", "selector": "#concept-Plant .object-group-editor input[data-prop=\"sunlight\"]", "value": "Bright indirect", "label": "Nested careNeeds.sunlight leaf input" },
    { "action": "screenshot", "name": "plant_form_filled" },
    { "action": "click", "selector": "#concept-Plant button:has-text(\"Create\")", "label": "Submit the Plant create form" },
    { "action": "waitForSelector", "selector": "#concept-Plant form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Plant", "text": "UITEST-PLANT", "label": "New Plant row visible in the grid" },

    { "action": "click", "selector": "#concept-Plant tbody tr:has-text(\"UITEST-PLANT-\") button:has-text(\"Edit\")", "label": "Re-open the Plant row to verify careNeeds round-tripped" },
    { "action": "waitForSelector", "selector": "#concept-Plant form", "state": "visible" },
    { "action": "waitForTimeout", "timeoutMs": 600 },
    { "action": "assertCount", "selector": "#concept-Plant .object-group-editor input[data-prop=\"wateringIntervalDays\"]", "operator": "=", "count": 1, "label": "Nested careNeeds editor present after reload (value verified visually via screenshot evidence)" },
    { "action": "screenshot", "name": "plant_reopened_careneeds" },
    { "action": "click", "selector": "#concept-Plant button:has-text(\"Cancel\")" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-CareLogEntry\"]", "label": "Open the Care log entry concept" },
    { "action": "waitForSelector", "selector": "#concept-CareLogEntry", "state": "visible" },
    { "action": "click", "selector": "#concept-CareLogEntry .panel-actions button:has-text(\"New\")", "label": "Open the Care log entry create form" },
    { "action": "waitForSelector", "selector": "#concept-CareLogEntry form", "state": "visible" },
    { "action": "click", "selector": "#concept-CareLogEntry .lookup-browse", "label": "Open the Plant search-dialog picker" },
    { "action": "waitForSelector", "selector": "#pickerModalRoot .picker-row", "state": "visible" },
    { "action": "click", "selector": "#pickerModalRoot .picker-row:has-text(\"UITEST-PLANT-\")", "label": "Pick this run's Plant from the picker" },
    { "action": "waitForSelector", "selector": "#pickerModalRoot .picker-row", "state": "detached" },
    { "action": "fill", "selector": "#concept-CareLogEntry [name=\"wateredAt\"]", "value": "2026-06-25T08:00" },
    { "action": "click", "selector": "#concept-CareLogEntry [name=\"fed\"]", "label": "Check the fed checkbox" },
    { "action": "screenshot", "name": "carelog_form_filled" },
    { "action": "click", "selector": "#concept-CareLogEntry button:has-text(\"Create\")", "label": "Submit the Care log entry create form" },
    { "action": "waitForSelector", "selector": "#concept-CareLogEntry form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-CareLogEntry", "text": "UITEST-PLANT", "label": "New Care log entry row shows the resolved Plant reference label" },
    { "action": "collect", "what": ["domText", "url"] },
    { "action": "screenshot", "name": "carelog_created" }
  ]
}
