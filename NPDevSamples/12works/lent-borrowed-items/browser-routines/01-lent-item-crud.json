{
  "scenarioName": "lent-borrowed-items-crud",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "contactName": "UITEST-CONTACT-PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "dev-key" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-Contact\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Contact\"]", "label": "Open the Contact concept" },
    { "action": "waitForSelector", "selector": "#concept-Contact", "state": "visible" },
    { "action": "click", "selector": "#concept-Contact .panel-actions button:has-text(\"New\")", "label": "Open the Contact create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "fill", "selector": "#modalRoot [name=\"name\"]", "valueFromVariable": "contactName" },
    { "action": "screenshot", "name": "contact_form_filled" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Create\")", "label": "Submit the Contact create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Contact", "text": "UITEST-CONTACT", "label": "New Contact row visible in the grid" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-LentItem\"]", "label": "Open the Lent item concept" },
    { "action": "waitForSelector", "selector": "#concept-LentItem", "state": "visible" },
    { "action": "click", "selector": "#concept-LentItem .panel-actions button:has-text(\"New\")", "label": "Open the Lent item create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "fill", "selector": "#modalRoot [name=\"itemName\"]", "value": "Cordless drill" },
    { "action": "waitForSelector", "selector": "#modalRoot select[name=\"contactRef\"] option:nth-child(2)", "state": "attached", "label": "Contact select options loaded (field.widget=select is now honored on reference fields)" },
    { "action": "selectOption", "selector": "#modalRoot select[name=\"contactRef\"]", "value": { "index": 1 }, "label": "Select this run's Contact -- the only real option besides the placeholder, since Contact was wiped and recreated once above" },
    { "action": "fill", "selector": "#modalRoot [name=\"lentDate\"]", "value": "2026-06-26" },
    { "action": "selectOption", "selector": "#modalRoot select[name=\"status\"]", "value": "Lent", "label": "Required status enum (has a default but still must be selected explicitly)" },
    { "action": "screenshot", "name": "lentitem_form_filled" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Create\")", "label": "Submit the Lent item create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-LentItem", "text": "UITEST-CONTACT", "label": "New Lent item row shows the resolved Contact reference label" },
    { "action": "assertTextContains", "selector": "#concept-LentItem", "text": "Lent", "label": "Default status is Lent" },

    { "action": "click", "selector": "#concept-LentItem tbody tr:has-text(\"Cordless drill\") button:has-text(\"Edit\")", "label": "Re-open the Lent item row to mark it Returned" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "selectOption", "selector": "#modalRoot select[name=\"status\"]", "value": "Returned", "label": "Run the MarkReturned update Flow via the status enum select" },
    { "action": "screenshot", "name": "lentitem_marked_returned" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Save\")", "label": "Submit the update Flow" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "detached", "label": "Modal closes only on a successful update" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-LentItem", "text": "Returned", "label": "Status updated to Returned via the Flow-CRUD update wrapper" },
    { "action": "collect", "what": ["domText", "url"] },
    { "action": "screenshot", "name": "lentitem_returned_confirmed" }
  ]
}
