{
  "$schema": "..\\..\\..\\..\\NPDevContract\\schemas\\model.schema.json",
  "namespace": "sample.twelveworks.reading.list",
  "dslVersion": "1.0.0",
  "version": "1.0",
  "metadata": {
    "purpose": "12works sample #1: enum/array-of-objects CRUD plus a concept-scoped ui.frame.mode=minimal override, exercised on a brand-new model."
  },
  "concepts": [
    {
      "name": "Book",
      "ui": {
        "label": "Book",
        "description": "A book you want to read, are reading, or finished, with quotes captured along the way.",
        "group": "Library",
        "order": 10
      },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "ui": { "label": "Title", "widget": "text" }
        },
        {
          "name": "author",
          "type": "string",
          "required": true,
          "ui": { "label": "Author", "widget": "text" }
        },
        {
          "name": "genre",
          "type": "enum",
          "enumValues": ["Fiction", "NonFiction", "Science", "Biography", "Other"],
          "required": true,
          "ui": { "label": "Genre", "widget": "select" }
        },
        {
          "name": "status",
          "type": "enum",
          "enumValues": ["ToRead", "Reading", "Finished"],
          "required": true,
          "default": "ToRead",
          "ui": { "label": "Status", "widget": "select" }
        },
        {
          "name": "rating",
          "type": "integer",
          "ui": { "label": "Rating (1-5)" }
        },
        {
          "name": "quotes",
          "type": "array",
          "description": "Captured quotes with the page they appear on.",
          "ui": { "label": "Quotes", "showInDefaultWebUi": true },
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "page": { "type": "integer" }
            }
          }
        }
      ],
      "invariants": [
        { "name": "BookTitleRequired", "expr": "title != null && title != ''" },
        { "name": "BookAuthorRequired", "expr": "author != null && author != ''" }
      ]
    }
  ],
  "capabilities": [
    { "name": "persistence", "type": "PersistenceCapability", "operations": ["save", "findById", "unique"] },
    { "name": "notification", "type": "NotificationCapability", "operations": ["send"] }
  ],
  "bindings": [
    { "capability": "persistence", "adapter": "repository" },
    { "capability": "notification", "adapter": "notification-inproc" },
    { "capability": "eventBus", "adapter": "inproc" }
  ]
}
