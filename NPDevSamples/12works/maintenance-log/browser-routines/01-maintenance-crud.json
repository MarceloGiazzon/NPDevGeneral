{
  "scenarioName": "maintenance-log-crud",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "assetName": "UITEST-ASSET-PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "dev-key" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-Asset\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Asset\"]", "label": "Open the Asset concept" },
    { "action": "waitForSelector", "selector": "#concept-Asset", "state": "visible" },
    { "action": "click", "selector": "#concept-Asset .panel-actions button:has-text(\"New\")", "label": "Open the Asset create form" },
    { "action": "waitForSelector", "selector": "#concept-Asset form", "state": "visible" },
    { "action": "fill", "selector": "#concept-Asset [name=\"name\"]", "valueFromVariable": "assetName" },
    { "action": "selectOption", "selector": "#concept-Asset [name=\"type\"]", "value": "Vehicle", "label": "Required type enum" },
    { "action": "screenshot", "name": "asset_form_filled" },
    { "action": "click", "selector": "#concept-Asset button:has-text(\"Create\")", "label": "Submit the Asset create form" },
    { "action": "waitForSelector", "selector": "#concept-Asset form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Asset", "text": "UITEST-ASSET", "label": "New Asset row visible in the grid" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-ServiceEntry\"]", "label": "Open the Service entry concept" },
    { "action": "waitForSelector", "selector": "#concept-ServiceEntry", "state": "visible" },
    { "action": "click", "selector": "#concept-ServiceEntry .panel-actions button:has-text(\"New\")", "label": "Open the Service entry create form" },
    { "action": "waitForSelector", "selector": "#concept-ServiceEntry form", "state": "visible" },
    { "action": "click", "selector": "#concept-ServiceEntry .lookup-browse", "label": "Open the Asset search-dialog picker" },
    { "action": "waitForSelector", "selector": "#pickerModalRoot .picker-row", "state": "visible" },
    { "action": "click", "selector": "#pickerModalRoot .picker-row:has-text(\"UITEST-ASSET-\")", "label": "Pick this run's Asset from the picker" },
    { "action": "waitForSelector", "selector": "#pickerModalRoot .picker-row", "state": "detached" },
    { "action": "fill", "selector": "#concept-ServiceEntry [name=\"serviceDate\"]", "value": "2026-06-25" },
    { "action": "selectOption", "selector": "#concept-ServiceEntry [name=\"serviceType\"]", "value": "Routine", "label": "Required serviceType enum" },
    { "action": "fill", "selector": "#concept-ServiceEntry [name=\"notes\"]", "value": "Oil change and filter replacement." },
    { "action": "screenshot", "name": "serviceentry_form_filled" },
    { "action": "click", "selector": "#concept-ServiceEntry button:has-text(\"Create\")", "label": "Submit the Service entry create form" },
    { "action": "waitForSelector", "selector": "#concept-ServiceEntry form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-ServiceEntry", "text": "UITEST-ASSET", "label": "New Service entry row shows the resolved Asset reference label" },
    { "action": "collect", "what": ["domText", "url"] },
    { "action": "screenshot", "name": "serviceentry_created" }
  ]
}
