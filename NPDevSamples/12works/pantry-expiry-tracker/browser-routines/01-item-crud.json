{
  "scenarioName": "pantry-expiry-tracker-crud",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "itemName": "UITEST-ITEM-PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "dev-key" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-Item\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Item\"]", "label": "Open the Item concept" },
    { "action": "waitForSelector", "selector": "#concept-Item", "state": "visible" },
    { "action": "click", "selector": "#concept-Item .panel-actions button:has-text(\"New\")", "label": "Open the Item create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "fill", "selector": "#modalRoot [name=\"name\"]", "valueFromVariable": "itemName" },
    { "action": "selectOption", "selector": "#modalRoot [name=\"category\"]", "value": "Produce", "label": "Required category enum" },
    { "action": "fill", "selector": "#modalRoot [name=\"expiryDate\"]", "value": "2026-07-01" },
    { "action": "fill", "selector": "#modalRoot .object-group-editor input[data-prop=\"area\"]", "value": "Fridge", "label": "Nested location.area leaf input" },
    { "action": "fill", "selector": "#modalRoot .object-group-editor input[data-prop=\"shelf\"]", "value": "Top", "label": "Nested location.shelf leaf input" },
    { "action": "screenshot", "name": "item_form_filled" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Create\")", "label": "Submit the Item create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Item", "text": "UITEST-ITEM", "label": "New Item row visible in the grid" },

    { "action": "click", "selector": "#concept-Item tbody tr:has-text(\"UITEST-ITEM-\") button:has-text(\"Edit\")", "label": "Re-open the Item row to verify location round-tripped" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "waitForTimeout", "timeoutMs": 600 },
    { "action": "assertCount", "selector": "#modalRoot .object-group-editor input[data-prop=\"area\"]", "operator": "=", "count": 1, "label": "Nested location editor present after reload (value verified visually via screenshot evidence)" },
    { "action": "screenshot", "name": "item_reopened_location" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Cancel\")" },
    { "action": "collect", "what": ["domText", "url"] }
  ]
}
