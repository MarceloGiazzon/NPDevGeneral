{
  "$schema": "..\\..\\..\\..\\NPDevContract\\schemas\\model.schema.json",
  "namespace": "sample.twelveworks.pantry.expiry.tracker",
  "dslVersion": "1.0.0",
  "version": "1.0",
  "metadata": {
    "purpose": "12works sample #4: nested location object plus a Flow that emits a custom event consumed by an orchestration rule, on a brand-new model."
  },
  "concepts": [
    {
      "name": "Item",
      "ui": { "label": "Item", "description": "A pantry item with where it's stored and when it expires.", "group": "Pantry", "order": 10 },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "name", "type": "string", "required": true, "ui": { "label": "Name", "widget": "text" } },
        {
          "name": "category",
          "type": "enum",
          "enumValues": ["Produce", "Dairy", "Pantry", "Frozen", "Other"],
          "required": true,
          "ui": { "label": "Category", "widget": "select" }
        },
        { "name": "expiryDate", "type": "date", "required": true, "ui": { "label": "Expiry date", "widget": "date" } },
        {
          "name": "location",
          "type": "object",
          "ui": { "label": "Location", "showInDefaultWebUi": true },
          "properties": {
            "area": { "type": "string" },
            "shelf": { "type": "string" }
          }
        }
      ],
      "invariants": [
        { "name": "ItemNameRequired", "expr": "name != null && name != ''" }
      ]
    }
  ],
  "capabilities": [
    { "name": "persistence", "type": "PersistenceCapability", "operations": ["save", "findById", "unique"] },
    { "name": "notification", "type": "NotificationCapability", "operations": ["send"] }
  ],
  "bindings": [
    { "capability": "persistence", "adapter": "repository" },
    { "capability": "notification", "adapter": "notification-inproc" },
    { "capability": "eventBus", "adapter": "inproc" }
  ],
  "events": [
    {
      "name": "ItemAddedNearExpiry",
      "payload": [
        { "name": "id", "type": "uuid" },
        { "name": "name", "type": "string" },
        { "name": "expiryDate", "type": "date" }
      ]
    }
  ],
  "flows": [
    {
      "name": "AddItem",
      "input": { "concept": "Item", "mode": "create" },
      "steps": [
        { "name": "validate-item", "type": "validate", "scope": "Item", "invariants": ["ItemNameRequired"] },
        { "name": "save-item", "type": "createConcept", "scope": "Item", "input": "$input", "out": "$saved" },
        { "name": "emit-near-expiry", "type": "emitEvent", "event": "ItemAddedNearExpiry", "from": "$saved" },
        { "name": "return-item", "type": "return", "value": "$saved" }
      ]
    }
  ],
  "orchestrationRules": [
    {
      "name": "NotifyOnNearExpiryItemAdded",
      "trigger": { "type": "event", "event": "ItemAddedNearExpiry" },
      "condition": "$event.name != null",
      "actions": [
        {
          "type": "callCapability",
          "capability": "notification",
          "operation": "send",
          "action": {
            "label": "Send expiry-watch notification",
            "successMessage": "Expiry-watch notification sent.",
            "failureHint": "Check the notification capability binding if delivery fails.",
            "dangerLevel": "low",
            "permissionHint": "notifications.send",
            "inputFormHint": "item-near-expiry-notification"
          },
          "map": {
            "itemId": "$event.id",
            "name": "$event.name",
            "expiryDate": "$event.expiryDate"
          }
        }
      ]
    }
  ]
}
