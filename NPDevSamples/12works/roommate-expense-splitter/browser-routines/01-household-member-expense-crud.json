{
  "scenarioName": "roommate-expense-splitter-crud",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "householdName": "UITEST-HOUSEHOLD-PLACEHOLDER", "payerName": "UITEST-PAYER-PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "dev-key" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-Household\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Household\"]", "label": "Open the Household concept" },
    { "action": "waitForSelector", "selector": "#concept-Household", "state": "visible" },
    { "action": "click", "selector": "#concept-Household .panel-actions button:has-text(\"New\")", "label": "Open the Household create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "fill", "selector": "#modalRoot [name=\"name\"]", "valueFromVariable": "householdName" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Create\")", "label": "Submit the Household create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "assertTextContains", "selector": "#concept-Household", "text": "UITEST-HOUSEHOLD", "label": "New Household row visible in the grid", "timeoutMs": 5000 },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Member\"]", "label": "Open the Member concept" },
    { "action": "waitForSelector", "selector": "#concept-Member", "state": "visible" },
    { "action": "click", "selector": "#concept-Member .panel-actions button:has-text(\"New\")", "label": "Open the payer Member create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "waitForSelector", "selector": "#modalRoot select[name=\"householdRef\"] option:nth-child(2)", "state": "attached", "label": "Household select options loaded (field.widget=select is now honored on reference fields)" },
    { "action": "selectOption", "selector": "#modalRoot select[name=\"householdRef\"]", "value": { "index": 1 }, "label": "Select this run's Household -- the only real option besides the placeholder" },
    { "action": "fill", "selector": "#modalRoot [name=\"name\"]", "valueFromVariable": "payerName" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Create\")", "label": "Submit the payer Member create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "assertTextContains", "selector": "#concept-Member", "text": "UITEST-PAYER", "label": "New payer Member row visible in the grid", "timeoutMs": 5000 },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Expense\"]", "label": "Open the Expense concept" },
    { "action": "waitForSelector", "selector": "#concept-Expense", "state": "visible" },
    { "action": "click", "selector": "#concept-Expense .panel-actions button:has-text(\"New\")", "label": "Open the Expense create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "waitForSelector", "selector": "#modalRoot select[name=\"householdRef\"] option:nth-child(2)", "state": "attached", "label": "Household select options loaded for the Expense" },
    { "action": "selectOption", "selector": "#modalRoot select[name=\"householdRef\"]", "value": { "index": 1 }, "label": "Select this run's Household -- the only real option besides the placeholder" },
    { "action": "fill", "selector": "#modalRoot [name=\"description\"]", "value": "UITEST-EXPENSE-GROCERIES" },
    { "action": "fill", "selector": "#modalRoot [name=\"amount\"]", "value": "100" },
    { "action": "waitForSelector", "selector": "#modalRoot select[name=\"payerRef\"] option:nth-child(2)", "state": "attached", "label": "Payer Member select options loaded" },
    { "action": "selectOption", "selector": "#modalRoot select[name=\"payerRef\"]", "value": { "index": 1 }, "label": "Select this run's payer Member -- the only real option besides the placeholder" },
    { "action": "waitForSelector", "selector": "#modalRoot .multiselect-control .multiselect-item", "state": "visible", "label": "Split-with multiselect options loaded" },
    { "action": "click", "selector": "#modalRoot .multiselect-item:has-text(\"UITEST-PAYER-\") input[type=\"checkbox\"]", "label": "Select this run's Member (also the payer) via the multiselect split-with checkbox" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Create\")", "label": "Submit the Expense create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "assertTextContains", "selector": "#concept-Expense", "text": "UITEST-EXPENSE-GROCERIES", "label": "New Expense row visible in the grid", "timeoutMs": 5000 },
    { "action": "assertTextContains", "selector": "#concept-Expense", "text": "UITEST-PAYER", "label": "Expense row shows the resolved payer Member reference label", "timeoutMs": 5000 },
    { "action": "collect", "what": ["domText", "url"] }
  ]
}
