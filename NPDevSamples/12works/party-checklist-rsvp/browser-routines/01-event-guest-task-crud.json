{
  "scenarioName": "party-checklist-rsvp-crud",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "eventName": "UITEST-EVENT-PLACEHOLDER", "guestName": "UITEST-GUEST-PLACEHOLDER", "taskTitle": "UITEST-TASK-PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "dev-key" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-PartyEvent\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-PartyEvent\"]", "label": "Open the Event concept" },
    { "action": "waitForSelector", "selector": "#concept-PartyEvent", "state": "visible" },
    { "action": "click", "selector": "#concept-PartyEvent .panel-actions button:has-text(\"New\")", "label": "Open the Event create form" },
    { "action": "waitForSelector", "selector": "#concept-PartyEvent form", "state": "visible" },
    { "action": "fill", "selector": "#concept-PartyEvent [name=\"name\"]", "valueFromVariable": "eventName" },
    { "action": "fill", "selector": "#concept-PartyEvent [name=\"eventDate\"]", "value": "2026-09-12" },
    { "action": "click", "selector": "#concept-PartyEvent button:has-text(\"Create\")", "label": "Submit the Event create form" },
    { "action": "waitForSelector", "selector": "#concept-PartyEvent form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-PartyEvent", "text": "UITEST-EVENT", "label": "New Event row visible in the grid" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Guest\"]", "label": "Open the Guest concept" },
    { "action": "waitForSelector", "selector": "#concept-Guest", "state": "visible" },
    { "action": "click", "selector": "#concept-Guest .panel-actions button:has-text(\"New\")", "label": "Open the Guest create form" },
    { "action": "waitForSelector", "selector": "#concept-Guest form", "state": "visible" },
    { "action": "waitForSelector", "selector": "#concept-Guest select[name=\"eventRef\"] option:nth-child(2)", "state": "attached", "label": "Event select options loaded (field.widget=select is now honored on reference fields)" },
    { "action": "selectOption", "selector": "#concept-Guest select[name=\"eventRef\"]", "value": { "index": 1 }, "label": "Select this run's Event -- the only real option besides the placeholder" },
    { "action": "fill", "selector": "#concept-Guest [name=\"name\"]", "valueFromVariable": "guestName" },
    { "action": "selectOption", "selector": "#concept-Guest select[name=\"rsvpStatus\"]", "value": "Invited", "label": "Required RSVP status enum (has a default but still must be selected explicitly)" },
    { "action": "click", "selector": "#concept-Guest button:has-text(\"Create\")", "label": "Submit the Guest create form" },
    { "action": "waitForSelector", "selector": "#concept-Guest form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Guest", "text": "UITEST-GUEST", "label": "New Guest row visible in the grid" },

    { "action": "click", "selector": "#concept-Guest tbody tr:has-text(\"UITEST-GUEST\") button:has-text(\"Edit\")", "label": "Re-open the Guest row to run the RSVP update Flow" },
    { "action": "waitForSelector", "selector": "#concept-Guest form", "state": "visible" },
    { "action": "selectOption", "selector": "#concept-Guest select[name=\"rsvpStatus\"]", "value": "Yes", "label": "Run the UpdateRsvp Flow via the rsvpStatus select" },
    { "action": "click", "selector": "#concept-Guest button:has-text(\"Save\")", "label": "Submit the UpdateRsvp update Flow" },
    { "action": "waitForSelector", "selector": "#concept-Guest form", "state": "detached", "label": "Modal closes only on a successful update" },
    { "action": "assertTextContains", "selector": "#concept-Guest", "text": "Yes", "label": "RSVP status updated to Yes via the UpdateRsvp Flow", "timeoutMs": 5000 },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Task\"]", "label": "Open the Task concept" },
    { "action": "waitForSelector", "selector": "#concept-Task", "state": "visible" },
    { "action": "click", "selector": "#concept-Task .panel-actions button:has-text(\"New\")", "label": "Open the Task create form" },
    { "action": "waitForSelector", "selector": "#concept-Task form", "state": "visible" },
    { "action": "waitForSelector", "selector": "#concept-Task select[name=\"eventRef\"] option:nth-child(2)", "state": "attached", "label": "Event select options loaded" },
    { "action": "selectOption", "selector": "#concept-Task select[name=\"eventRef\"]", "value": { "index": 1 }, "label": "Select this run's Event -- the only real option besides the placeholder" },
    { "action": "fill", "selector": "#concept-Task [name=\"title\"]", "valueFromVariable": "taskTitle" },
    { "action": "selectOption", "selector": "#concept-Task select[name=\"status\"]", "value": "Todo", "label": "Required Task status enum" },
    { "action": "click", "selector": "#concept-Task button:has-text(\"Create\")", "label": "Submit the Task create form" },
    { "action": "waitForSelector", "selector": "#concept-Task form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Task", "text": "UITEST-TASK", "label": "New Task row visible in the grid" },
    { "action": "collect", "what": ["domText", "url"] }
  ]
}
