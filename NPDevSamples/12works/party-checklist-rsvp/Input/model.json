{
  "$schema": "..\\..\\..\\..\\NPDevContract\\schemas\\model.schema.json",
  "namespace": "sample.twelveworks.party.checklist.rsvp",
  "dslVersion": "1.0.0",
  "version": "1.0",
  "metadata": {
    "purpose": "12works sample #11: two separate concepts (Guest, Task) each referencing the same parent (Event), plus an RSVP-update Flow emitting a custom event."
  },
  "concepts": [
    {
      "name": "PartyEvent",
      "ui": { "label": "Event", "description": "A party being planned.", "group": "Party", "order": 10 },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "name", "type": "string", "required": true, "ui": { "label": "Name", "widget": "text" } },
        { "name": "eventDate", "type": "date", "required": true, "ui": { "label": "Date", "widget": "date" } }
      ],
      "invariants": [
        { "name": "EventNameRequired", "expr": "name != null && name != ''" }
      ]
    },
    {
      "name": "Guest",
      "ui": { "label": "Guest", "description": "An invitee, with RSVP status.", "group": "Party", "order": 20 },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        {
          "name": "eventRef",
          "type": "reference",
          "required": true,
          "reference": { "target": "PartyEvent", "displayField": "name", "searchFields": ["name"], "inlineCreate": "deny" },
          "ui": { "label": "Event", "widget": "select" }
        },
        { "name": "name", "type": "string", "required": true, "ui": { "label": "Name", "widget": "text" } },
        {
          "name": "rsvpStatus",
          "type": "enum",
          "enumValues": ["Invited", "Yes", "No", "Maybe"],
          "required": true,
          "default": "Invited",
          "ui": { "label": "RSVP", "widget": "select" }
        }
      ],
      "invariants": [
        { "name": "GuestEventRequired", "expr": "eventRef != null" },
        { "name": "GuestNameRequired", "expr": "name != null && name != ''" }
      ]
    },
    {
      "name": "Task",
      "ui": { "label": "Task", "description": "A to-do item for the event.", "group": "Party", "order": 30 },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        {
          "name": "eventRef",
          "type": "reference",
          "required": true,
          "reference": { "target": "PartyEvent", "displayField": "name", "searchFields": ["name"], "inlineCreate": "deny" },
          "ui": { "label": "Event", "widget": "select" }
        },
        { "name": "title", "type": "string", "required": true, "ui": { "label": "Title", "widget": "text" } },
        {
          "name": "status",
          "type": "enum",
          "enumValues": ["Todo", "Done"],
          "required": true,
          "default": "Todo",
          "ui": { "label": "Status", "widget": "select" }
        }
      ],
      "invariants": [
        { "name": "TaskEventRequired", "expr": "eventRef != null" },
        { "name": "TaskTitleRequired", "expr": "title != null && title != ''" }
      ]
    }
  ],
  "capabilities": [
    { "name": "persistence", "type": "PersistenceCapability", "operations": ["save", "findById", "unique"] },
    { "name": "notification", "type": "NotificationCapability", "operations": ["send"] }
  ],
  "bindings": [
    { "capability": "persistence", "adapter": "repository" },
    { "capability": "notification", "adapter": "notification-inproc" },
    { "capability": "eventBus", "adapter": "inproc" }
  ],
  "events": [
    {
      "name": "GuestRsvpUpdated",
      "payload": [
        { "name": "id", "type": "uuid" },
        { "name": "eventRef", "type": "uuid" },
        { "name": "rsvpStatus", "type": "string" }
      ]
    }
  ],
  "flows": [
    {
      "name": "UpdateRsvp",
      "input": { "concept": "Guest", "mode": "update" },
      "steps": [
        { "name": "update-guest", "type": "updateConcept", "scope": "Guest", "input": "$input", "out": "$updated" },
        { "name": "emit-rsvp-updated", "type": "emitEvent", "event": "GuestRsvpUpdated", "from": "$updated" },
        { "name": "return-guest", "type": "return", "value": "$updated" }
      ]
    }
  ]
}
