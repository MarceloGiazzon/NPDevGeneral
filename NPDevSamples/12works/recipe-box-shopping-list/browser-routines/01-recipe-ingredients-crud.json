{
  "scenarioName": "recipe-box-shopping-list-crud",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "recipeName": "UITEST-RECIPE-PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "dev-key" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-Recipe\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Recipe\"]", "label": "Open the Recipe concept" },
    { "action": "waitForSelector", "selector": "#concept-Recipe", "state": "visible" },
    { "action": "click", "selector": "#concept-Recipe .panel-actions button:has-text(\"New\")", "label": "Open the Recipe create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "fill", "selector": "#modalRoot [name=\"name\"]", "valueFromVariable": "recipeName" },
    { "action": "selectOption", "selector": "#modalRoot select[name=\"cuisine\"]", "value": "Italian", "label": "Required cuisine enum" },
    { "action": "click", "selector": "#modalRoot .array-table-editor button:has-text(\"Add\")", "label": "Add first ingredient row" },
    { "action": "fill", "selector": "#modalRoot .array-row:nth-of-type(1) input[data-prop=\"name\"]", "value": "Flour" },
    { "action": "fill", "selector": "#modalRoot .array-row:nth-of-type(1) input[data-prop=\"quantity\"]", "value": "2" },
    { "action": "fill", "selector": "#modalRoot .array-row:nth-of-type(1) input[data-prop=\"unit\"]", "value": "cups" },
    { "action": "click", "selector": "#modalRoot .array-table-editor button:has-text(\"Add\")", "label": "Add second ingredient row" },
    { "action": "fill", "selector": "#modalRoot .array-row:nth-of-type(2) input[data-prop=\"name\"]", "value": "Eggs" },
    { "action": "fill", "selector": "#modalRoot .array-row:nth-of-type(2) input[data-prop=\"quantity\"]", "value": "3" },
    { "action": "fill", "selector": "#modalRoot .array-row:nth-of-type(2) input[data-prop=\"unit\"]", "value": "each" },
    { "action": "screenshot", "name": "recipe_form_filled" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Create\")", "label": "Submit the Recipe create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Recipe", "text": "UITEST-RECIPE", "label": "New Recipe row visible in the grid" },

    { "action": "click", "selector": "#concept-Recipe tbody tr:has-text(\"UITEST-RECIPE\") button:has-text(\"Edit\")", "label": "Re-open the Recipe row to verify persisted ingredients" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "assertVisible", "selector": "#modalRoot .array-row:nth-of-type(1) input[data-prop=\"name\"]", "label": "First ingredient row persisted" },
    { "action": "assertVisible", "selector": "#modalRoot .array-row:nth-of-type(2) input[data-prop=\"name\"]", "label": "Second ingredient row persisted" },
    { "action": "screenshot", "name": "recipe_ingredients_reopened" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Cancel\")", "label": "Close the reopened form" },
    { "action": "collect", "what": ["domText", "url"] },
    { "action": "screenshot", "name": "recipe_confirmed" }
  ]
}
