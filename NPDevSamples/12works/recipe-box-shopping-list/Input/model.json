{
  "$schema": "..\\..\\..\\..\\NPDevContract\\schemas\\model.schema.json",
  "namespace": "sample.twelveworks.recipe.box",
  "dslVersion": "1.0.0",
  "version": "1.0",
  "metadata": {
    "purpose": "12works sample #9: a fresh, heavier exercise of the array-of-objects editor (ingredients), the area that surfaced 5 real bugs in the prior session's first live exercise."
  },
  "concepts": [
    {
      "name": "Recipe",
      "ui": { "label": "Recipe", "description": "A recipe with a list of ingredients.", "group": "Recipes", "order": 10 },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "name", "type": "string", "required": true, "ui": { "label": "Name", "widget": "text" } },
        {
          "name": "cuisine",
          "type": "enum",
          "enumValues": ["Italian", "Mexican", "Indian", "American", "Other"],
          "required": true,
          "ui": { "label": "Cuisine", "widget": "select" }
        },
        {
          "name": "ingredients",
          "type": "array",
          "description": "Each ingredient's name, quantity, and unit.",
          "ui": { "label": "Ingredients", "showInDefaultWebUi": true },
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "quantity": { "type": "integer" },
              "unit": { "type": "string" }
            }
          }
        }
      ],
      "invariants": [
        { "name": "RecipeNameRequired", "expr": "name != null && name != ''" }
      ]
    }
  ],
  "capabilities": [
    { "name": "persistence", "type": "PersistenceCapability", "operations": ["save", "findById", "unique"] },
    { "name": "notification", "type": "NotificationCapability", "operations": ["send"] }
  ],
  "bindings": [
    { "capability": "persistence", "adapter": "repository" },
    { "capability": "notification", "adapter": "notification-inproc" },
    { "capability": "eventBus", "adapter": "inproc" }
  ]
}
