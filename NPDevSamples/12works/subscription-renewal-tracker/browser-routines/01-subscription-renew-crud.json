{
  "scenarioName": "subscription-renewal-tracker-crud",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "subName": "UITEST-SUB-PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "dev-key" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-Subscription\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Subscription\"]", "label": "Open the Subscription concept" },
    { "action": "waitForSelector", "selector": "#concept-Subscription", "state": "visible" },
    { "action": "click", "selector": "#concept-Subscription .panel-actions button:has-text(\"New\")", "label": "Open the Subscription create form" },
    { "action": "waitForSelector", "selector": "#concept-Subscription form", "state": "visible" },
    { "action": "fill", "selector": "#concept-Subscription [name=\"name\"]", "valueFromVariable": "subName" },
    { "action": "fill", "selector": "#concept-Subscription [name=\"cost\"]", "value": "15" },
    { "action": "selectOption", "selector": "#concept-Subscription select[name=\"cycle\"]", "value": "Monthly", "label": "Required billing cycle enum" },
    { "action": "fill", "selector": "#concept-Subscription [name=\"renewalDate\"]", "value": "2026-07-15" },
    { "action": "selectOption", "selector": "#concept-Subscription select[name=\"status\"]", "value": "Active", "label": "Required status enum (has a default but still must be selected explicitly)" },
    { "action": "screenshot", "name": "subscription_form_filled" },
    { "action": "click", "selector": "#concept-Subscription button:has-text(\"Create\")", "label": "Submit the Subscription create form" },
    { "action": "waitForSelector", "selector": "#concept-Subscription form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Subscription", "text": "UITEST-SUB", "label": "New Subscription row visible in the grid" },
    { "action": "assertTextContains", "selector": "#concept-Subscription", "text": "Active", "label": "Status is Active" },

    { "action": "click", "selector": "#concept-Subscription tbody tr:has-text(\"UITEST-SUB\") button:has-text(\"Edit\")", "label": "Re-open the Subscription row to renew it" },
    { "action": "waitForSelector", "selector": "#concept-Subscription form", "state": "visible" },
    { "action": "fill", "selector": "#concept-Subscription [name=\"renewalDate\"]", "value": "2026-08-15" },
    { "action": "screenshot", "name": "subscription_renewed_form" },
    { "action": "click", "selector": "#concept-Subscription button:has-text(\"Save\")", "label": "Submit the RenewSubscription update Flow" },
    { "action": "waitForSelector", "selector": "#concept-Subscription form", "state": "detached", "label": "Modal closes only on a successful update" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Subscription", "text": "2026-08-15", "label": "Renewal date updated via the RenewSubscription update Flow" },
    { "action": "collect", "what": ["domText", "url"] },
    { "action": "screenshot", "name": "subscription_renewed_confirmed" }
  ]
}
