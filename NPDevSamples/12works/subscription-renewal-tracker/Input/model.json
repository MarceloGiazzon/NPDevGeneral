{
  "$schema": "..\\..\\..\\..\\NPDevContract\\schemas\\model.schema.json",
  "namespace": "sample.twelveworks.subscription.renewal.tracker",
  "dslVersion": "1.0.0",
  "version": "1.0",
  "metadata": {
    "purpose": "12works sample #8: decimal/date CRUD plus an UPDATE-mode Flow emitting a custom event consumed by an orchestration rule."
  },
  "concepts": [
    {
      "name": "Subscription",
      "ui": { "label": "Subscription", "description": "A recurring subscription.", "group": "Subscriptions", "order": 10 },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "name", "type": "string", "required": true, "ui": { "label": "Name", "widget": "text" } },
        { "name": "cost", "type": "integer", "required": true, "ui": { "label": "Cost" } },
        {
          "name": "cycle",
          "type": "enum",
          "enumValues": ["Monthly", "Yearly", "Weekly"],
          "required": true,
          "ui": { "label": "Billing cycle", "widget": "select" }
        },
        { "name": "renewalDate", "type": "date", "required": true, "ui": { "label": "Renewal date", "widget": "date" } },
        {
          "name": "status",
          "type": "enum",
          "enumValues": ["Active", "Cancelled"],
          "required": true,
          "default": "Active",
          "ui": { "label": "Status", "widget": "select" }
        }
      ],
      "invariants": [
        { "name": "SubscriptionNameRequired", "expr": "name != null && name != ''" },
        { "name": "SubscriptionCostPositive", "expr": "cost != null && cost > 0" }
      ]
    }
  ],
  "capabilities": [
    { "name": "persistence", "type": "PersistenceCapability", "operations": ["save", "findById", "unique"] },
    { "name": "notification", "type": "NotificationCapability", "operations": ["send"] }
  ],
  "bindings": [
    { "capability": "persistence", "adapter": "repository" },
    { "capability": "notification", "adapter": "notification-inproc" },
    { "capability": "eventBus", "adapter": "inproc" }
  ],
  "events": [
    {
      "name": "SubscriptionRenewed",
      "payload": [
        { "name": "id", "type": "uuid" },
        { "name": "name", "type": "string" },
        { "name": "cost", "type": "integer" }
      ]
    }
  ],
  "flows": [
    {
      "name": "RenewSubscription",
      "input": { "concept": "Subscription", "mode": "update" },
      "steps": [
        { "name": "update-subscription", "type": "updateConcept", "scope": "Subscription", "input": "$input", "out": "$updated" },
        { "name": "emit-renewed", "type": "emitEvent", "event": "SubscriptionRenewed", "from": "$updated" },
        { "name": "return-subscription", "type": "return", "value": "$updated" }
      ]
    }
  ],
  "orchestrationRules": [
    {
      "name": "NotifyOnSubscriptionRenewed",
      "trigger": { "type": "event", "event": "SubscriptionRenewed" },
      "condition": "$event.name != null",
      "actions": [
        {
          "type": "callCapability",
          "capability": "notification",
          "operation": "send",
          "action": {
            "label": "Send renewal notification",
            "successMessage": "Renewal notification sent.",
            "failureHint": "Check the notification capability binding if delivery fails.",
            "dangerLevel": "low",
            "permissionHint": "notifications.send",
            "inputFormHint": "subscription-renewed-notification"
          },
          "map": {
            "subscriptionId": "$event.id",
            "name": "$event.name",
            "cost": "$event.cost"
          }
        }
      ]
    }
  ]
}
