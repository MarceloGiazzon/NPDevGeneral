{
  "scenarioName": "habit-streak-tracker-crud",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "habitName": "UITEST-HABIT-PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "dev-key" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-Habit\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Habit\"]", "label": "Open the Habit concept" },
    { "action": "waitForSelector", "selector": "#concept-Habit", "state": "visible" },
    { "action": "click", "selector": "#concept-Habit .panel-actions button:has-text(\"New\")", "label": "Open the Habit create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "fill", "selector": "#modalRoot [name=\"name\"]", "valueFromVariable": "habitName" },
    { "action": "selectOption", "selector": "#modalRoot [name=\"frequency\"]", "value": "Daily", "label": "Required frequency enum" },
    { "action": "screenshot", "name": "habit_form_filled" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Create\")", "label": "Submit the Habit create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Habit", "text": "UITEST-HABIT", "label": "New Habit row visible in the grid" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-CheckIn\"]", "label": "Open the Check-in concept" },
    { "action": "waitForSelector", "selector": "#concept-CheckIn", "state": "visible" },
    { "action": "click", "selector": "#concept-CheckIn .panel-actions button:has-text(\"New\")", "label": "Open the Check-in create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "click", "selector": "#modalRoot .lookup-browse", "label": "Open the Habit search-dialog picker" },
    { "action": "waitForSelector", "selector": "#pickerModalRoot .picker-row", "state": "visible" },
    { "action": "click", "selector": "#pickerModalRoot .picker-row:has-text(\"UITEST-HABIT-\")", "label": "Pick this run's Habit from the picker" },
    { "action": "waitForSelector", "selector": "#pickerModalRoot .picker-row", "state": "detached" },
    { "action": "fill", "selector": "#modalRoot [name=\"checkInDate\"]", "value": "2026-06-25" },
    { "action": "screenshot", "name": "checkin_form_filled" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Create\")", "label": "Submit the Check-in create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-CheckIn", "text": "UITEST-HABIT", "label": "New Check-in row shows the resolved Habit reference label" },
    { "action": "collect", "what": ["domText", "url"] },
    { "action": "screenshot", "name": "checkin_created" }
  ]
}
