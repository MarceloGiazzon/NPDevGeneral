{
  "scenarioName": "home-inventory-crud",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "roomName": "UITEST-ROOM-PLACEHOLDER", "tagName": "UITEST-TAG-PLACEHOLDER", "itemName": "UITEST-ITEM-PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "dev-key" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-Room\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Room\"]", "label": "Open the Room concept" },
    { "action": "waitForSelector", "selector": "#concept-Room", "state": "visible" },
    { "action": "click", "selector": "#concept-Room .panel-actions button:has-text(\"New\")", "label": "Open the Room create form" },
    { "action": "waitForSelector", "selector": "#concept-Room form", "state": "visible" },
    { "action": "fill", "selector": "#concept-Room [name=\"name\"]", "valueFromVariable": "roomName" },
    { "action": "click", "selector": "#concept-Room button:has-text(\"Create\")", "label": "Submit the Room create form" },
    { "action": "waitForSelector", "selector": "#concept-Room form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Room", "text": "UITEST-ROOM", "label": "New Room row visible in the grid" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Tag\"]", "label": "Open the Tag concept" },
    { "action": "waitForSelector", "selector": "#concept-Tag", "state": "visible" },
    { "action": "click", "selector": "#concept-Tag .panel-actions button:has-text(\"New\")", "label": "Open the Tag create form" },
    { "action": "waitForSelector", "selector": "#concept-Tag form", "state": "visible" },
    { "action": "fill", "selector": "#concept-Tag [name=\"name\"]", "valueFromVariable": "tagName" },
    { "action": "click", "selector": "#concept-Tag button:has-text(\"Create\")", "label": "Submit the Tag create form" },
    { "action": "waitForSelector", "selector": "#concept-Tag form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Tag", "text": "UITEST-TAG", "label": "New Tag row visible in the grid" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Item\"]", "label": "Open the Item concept" },
    { "action": "waitForSelector", "selector": "#concept-Item", "state": "visible" },
    { "action": "click", "selector": "#concept-Item .panel-actions button:has-text(\"New\")", "label": "Open the Item create form" },
    { "action": "waitForSelector", "selector": "#concept-Item form", "state": "visible" },
    { "action": "fill", "selector": "#concept-Item [name=\"name\"]", "valueFromVariable": "itemName" },
    { "action": "click", "selector": "#concept-Item .lookup-browse", "label": "Open the Room search-dialog picker" },
    { "action": "waitForSelector", "selector": "#pickerModalRoot .picker-row", "state": "visible" },
    { "action": "click", "selector": "#pickerModalRoot .picker-row:has-text(\"UITEST-ROOM-\")", "label": "Pick this run's Room from the picker" },
    { "action": "waitForSelector", "selector": "#pickerModalRoot .picker-row", "state": "detached" },
    { "action": "fill", "selector": "#concept-Item [name=\"estimatedValue\"]", "value": "250" },
    { "action": "fill", "selector": "#concept-Item input[data-prop=\"provider\"]", "value": "AcmeWarranty Co" },
    { "action": "fill", "selector": "#concept-Item input[data-prop=\"years\"]", "value": "2" },
    { "action": "fill", "selector": "#concept-Item input[data-prop=\"coverage\"]", "value": "Full replacement" },
    { "action": "waitForSelector", "selector": "#concept-Item .multiselect-control .multiselect-item", "state": "visible", "label": "Tag multiselect options loaded" },
    { "action": "click", "selector": "#concept-Item .multiselect-item:has-text(\"UITEST-TAG-\") input[type=\"checkbox\"]", "label": "Select this run's Tag via the multiselect checkbox" },
    { "action": "click", "selector": "#concept-Item button:has-text(\"Create\")", "label": "Submit the Item create form" },
    { "action": "waitForSelector", "selector": "#concept-Item form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Item", "text": "UITEST-ITEM", "label": "New Item row visible in the grid" },
    { "action": "assertTextContains", "selector": "#concept-Item", "text": "UITEST-ROOM", "label": "Item row shows the resolved Room reference label" },

    { "action": "click", "selector": "#concept-Item tbody tr:has-text(\"UITEST-ITEM\") button:has-text(\"Edit\")", "label": "Re-open the Item row to verify the nested warranty + tag persisted" },
    { "action": "waitForSelector", "selector": "#concept-Item form", "state": "visible" },
    { "action": "assertVisible", "selector": "#concept-Item input[data-prop=\"provider\"]", "label": "Warranty provider field re-rendered" },
    { "action": "waitForSelector", "selector": "#concept-Item .multiselect-control .multiselect-item", "state": "visible", "label": "Tag multiselect options re-loaded on edit" },
    { "action": "click", "selector": "#concept-Item button:has-text(\"Cancel\")", "label": "Close the reopened form" },
    { "action": "collect", "what": ["domText", "url"] },
    { "action": "screenshot", "name": "item_confirmed" }
  ]
}
