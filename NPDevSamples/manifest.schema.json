{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/sample-manifest.schema.json",
  "title": "NPDev Sample Manifest",
  "type": "object",
  "required": ["id", "title", "complexity", "purpose", "features", "walkthrough", "expectedOutcomes"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "complexity": { "type": "string", "minLength": 1 },
    "mainFlow": { "type": "string" },
    "purpose": { "type": "string", "minLength": 1 },
    "businessStory": { "type": "string" },
    "features": { "type": "array", "items": { "type": "string" } },
    "inputFiles": { "type": "array", "items": { "type": "string" } },
    "walkthrough": { "type": "array", "items": { "type": "string" } },
    "expectedOutcomes": { "type": "array", "items": { "type": "string" } }
  }
}
