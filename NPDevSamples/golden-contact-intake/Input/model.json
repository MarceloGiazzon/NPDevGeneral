{
  "namespace": "trial.contactintake",
  "dslVersion": "3.0.0",
  "version": "1.0",
  "concepts": [
    {
      "name": "ContactMessage",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "unique": true
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "maxLength": 2000
        }
      ]
    }
  ],
  "flows": [
    {
      "name": "SubmitContactMessage",
      "input": {
        "concept": "ContactMessage",
        "mode": "create"
      },
      "steps": [
        {
          "name": "save",
          "type": "createConcept",
          "scope": "ContactMessage",
          "input": "$input",
          "output": "$saved"
        },
        {
          "name": "notify",
          "type": "notify",
          "to": "$saved.email",
          "message": "$saved.message"
        },
        {
          "name": "done",
          "type": "return",
          "value": "$saved"
        }
      ]
    }
  ]
}
