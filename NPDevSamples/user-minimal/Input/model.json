{
  "namespace": "demo",
  "dslVersion": "1.0.0",
  "version": "v1",
  "concepts": [
    {
      "name": "User",
      "ui": {
        "label": "User"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "ui": {
            "label": "Name"
          }
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "ui": {
            "label": "Email"
          }
        }
      ],
      "invariants": [
        {
          "name": "EmailRequired",
          "expr": "email != null && email != ''"
        },
        {
          "name": "NameRequired",
          "expr": "name != null && name != ''"
        },
        {
          "name": "EmailUnique",
          "type": "unique",
          "fields": [
            "email"
          ]
        }
      ]
    }
  ],
  "capabilities": [
    {
      "name": "persistence",
      "type": "PersistenceCapability",
      "operations": [
        "save",
        "unique",
        "findById"
      ]
    }
  ],
  "bindings": [
    {
      "capability": "persistence",
      "adapter": "repository"
    },
    {
      "capability": "eventBus",
      "adapter": "inproc"
    }
  ],
  "events": [
    {
      "name": "UserCreated",
      "payload": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "email",
          "type": "string"
        }
      ]
    },
    {
      "name": "UserUpdated"
    },
    {
      "name": "UserDeleted"
    },
    {
      "name": "SomethingHappened",
      "payload": [
        {
          "name": "status",
          "type": "string"
        }
      ]
    }
  ],
  "flows": [
    {
      "name": "CreateUser",
      "input": {
        "concept": "User",
        "mode": "create"
      },
      "steps": [
        {
          "name": "validate-user",
          "type": "invariantCheck",
          "scope": "User",
          "invariants": [
            "EmailRequired",
            "NameRequired",
            "EmailUnique"
          ]
        },
        {
          "name": "save-user",
          "type": "capabilityCall",
          "args": [
            "$input"
          ],
          "capability": "persistence",
          "operation": "save",
          "output": "$saved"
        },
        {
          "name": "emit-user-created",
          "type": "emitEvent",
          "event": "UserCreated",
          "from": "$saved"
        },
        {
          "name": "return-user",
          "type": "return",
          "value": "$saved"
        }
      ]
    },
    {
      "name": "CreateUserMissingEmail",
      "input": {
        "concept": "User",
        "mode": "create"
      },
      "steps": [
        {
          "name": "validate-user",
          "type": "invariantCheck",
          "scope": "User",
          "invariants": [
            "EmailRequired",
            "NameRequired"
          ]
        },
        {
          "name": "save-user",
          "type": "capabilityCall",
          "args": [
            "$input"
          ],
          "capability": "persistence",
          "operation": "save",
          "output": "$saved"
        },
        {
          "name": "return-user",
          "type": "return",
          "value": "$saved"
        }
      ]
    },
    {
      "name": "AwaitDemo",
      "input": {
        "concept": "User",
        "mode": "update"
      },
      "steps": [
        {
          "name": "await-something",
          "type": "awaitEvent",
          "awaitEvent": "SomethingHappened",
          "awaitRef": "$awaited"
        },
        {
          "name": "return-await",
          "type": "return",
          "value": "$awaited"
        }
      ]
    }
  ]
}
