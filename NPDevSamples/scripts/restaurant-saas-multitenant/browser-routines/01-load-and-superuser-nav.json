{
  "scenarioName": "restaurant-load-and-superuser-nav",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "steps": [
    { "action": "goto", "url": "$targetUrl", "label": "Open the generated business UI" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible", "label": "Shell rendered" },
    { "action": "fill", "selector": "#apiKey", "valueFromCredential": "apiKey", "label": "Enter the dev super-user API key" },
    { "action": "reload", "label": "Reload so the persisted key authenticates on bootstrap" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-__store__\"]", "state": "visible", "label": "Super-user nav rendered (Store link only exists for super-users)" },
    { "action": "assertVisible", "selector": "#sideNav", "label": "Side nav visible" },
    { "action": "assertTextContains", "selector": "#sideNav", "text": "ADMIN", "label": "Admin nav group present (header is CSS-uppercased, so innerText is ADMIN)" },
    { "action": "assertTextContains", "selector": "#sideNav", "text": "Store", "label": "Store surface present" },
    { "action": "assertTextContains", "selector": "#sideNav", "text": "Box View", "label": "Box View surface present" },
    { "action": "assertTextContains", "selector": "#sideNav", "text": "Staff member", "label": "Business concept nav present" },
    { "action": "assertTextContains", "selector": "#sideNav", "text": "Tenant", "label": "Tenant concept nav present" },
    { "action": "screenshot", "name": "superuser_nav", "label": "Capture the authenticated super-user shell" },
    { "action": "collect", "what": ["domText", "url"], "label": "Snapshot rendered nav for evidence" }
  ]
}
