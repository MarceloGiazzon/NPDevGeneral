{
  "scenarioName": "restaurant-store-panel",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "api-dev" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-__store__\"]", "state": "visible", "label": "Super-user nav ready" },
    { "action": "click", "selector": "#sideNav a[href=\"#concept-__store__\"]", "label": "Open the Store (pack catalog) surface" },
    { "action": "waitForSelector", "selector": "#concept-__store__", "state": "visible", "label": "Store panel rendered" },
    { "action": "assertVisible", "selector": "#concept-__store__ table.records", "label": "Store renders the pack catalog table (served from /api/admin/packs)" },
    { "action": "screenshot", "name": "store_panel" },
    { "action": "collect", "what": ["domText", "url"] }
  ]
}
