{
  "scenarioName": "superuser-console-link-identity-user-role",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "roleName": "UITEST-ROLE-PLACEHOLDER", "userName": "uitest-user-placeholder" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "api-dev" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-identity--UserRole\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-identity--UserRole\"]", "label": "Open the composed Identity UserRole bond concept (requires 05 to have run first with the same variables)" },
    { "action": "waitForSelector", "selector": "#concept-identity--UserRole", "state": "visible" },
    { "action": "click", "selector": "#concept-identity--UserRole .panel-actions button:has-text(\"New\")", "label": "Open the UserRole create form" },
    { "action": "waitForSelector", "selector": "#concept-identity--UserRole form", "state": "visible" },

    { "action": "click", "selector": "#concept-identity--UserRole .lookup-control:has([name=\"userId\"]) .lookup-browse", "label": "Open the User lookup picker (the bond/pack composition's reference write path)" },
    { "action": "waitForSelector", "selector": ".picker-dialog .picker-search", "state": "visible" },
    { "action": "fill", "selector": ".picker-dialog .picker-search", "valueFromVariable": "userName", "label": "Filter the picker to the User created by 05-create-identity-role-and-user" },
    { "action": "waitForTimeout", "timeoutMs": 600, "label": "Let the picker's 250ms search debounce + reload settle (its first render is the unfiltered list)" },
    { "action": "assertCount", "selector": ".picker-records tbody tr.picker-row", "operator": "=", "count": 1, "label": "Exactly one User matches the unique filter" },
    { "action": "click", "selector": ".picker-records tbody tr.picker-row", "label": "Select the filtered User row" },
    { "action": "waitForSelector", "selector": "#concept-identity--UserRole .lookup-control:has([name=\"userId\"]) .lookup-display", "state": "visible" },

    { "action": "click", "selector": "#concept-identity--UserRole .lookup-control:has([name=\"roleId\"]) .lookup-browse", "label": "Open the Role lookup picker" },
    { "action": "waitForSelector", "selector": ".picker-dialog .picker-search", "state": "visible" },
    { "action": "fill", "selector": ".picker-dialog .picker-search", "valueFromVariable": "roleName", "label": "Filter the picker to the Role created by 05-create-identity-role-and-user" },
    { "action": "waitForTimeout", "timeoutMs": 600, "label": "Let the picker's 250ms search debounce + reload settle (its first render is the unfiltered list)" },
    { "action": "assertCount", "selector": ".picker-records tbody tr.picker-row", "operator": "=", "count": 1, "label": "Exactly one Role matches the unique filter" },
    { "action": "click", "selector": ".picker-records tbody tr.picker-row", "label": "Select the filtered Role row" },
    { "action": "waitForSelector", "selector": "#concept-identity--UserRole .lookup-control:has([name=\"roleId\"]) .lookup-display", "state": "visible" },

    { "action": "screenshot", "name": "userrole_form_linked" },
    { "action": "click", "selector": "#concept-identity--UserRole button:has-text(\"Create\")", "label": "Submit the UserRole create form" },
    { "action": "waitForSelector", "selector": "#concept-identity--UserRole form", "state": "detached", "label": "Modal closes only on a successful create -- proves the composed bond write path works end to end through the rendered UI" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "screenshot", "name": "userrole_created" },
    { "action": "collect", "what": ["domText", "url"] }
  ]
}
