{
  "scenarioName": "superuser-console-my-preferences-panel",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "prefKey": "uitest-pref-placeholder" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "api-dev" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-__preferences__\"]", "state": "visible" },
    { "action": "click", "selector": "#sideNav a[href=\"#concept-__preferences__\"]", "label": "Open the My Preferences panel (scoped to the current actor, not generic CRUD)" },
    { "action": "waitForSelector", "selector": "#concept-__preferences__", "state": "visible", "label": "Preferences panel rendered" },
    { "action": "fill", "selector": "#concept-__preferences__ input[placeholder=\"Category\"]", "value": "uitest" },
    { "action": "fill", "selector": "#concept-__preferences__ input[placeholder=\"Key\"]", "valueFromVariable": "prefKey", "label": "Unique key (avoids relying on row dedup across reruns)" },
    { "action": "fill", "selector": "#concept-__preferences__ input[placeholder=\"Value\"]", "value": "uitest-value" },
    { "action": "click", "selector": "#concept-__preferences__ button:has-text(\"Add\")", "label": "Add the preference (POST as the current actor)" },
    { "action": "waitForTimeout", "timeoutMs": 800, "label": "Let the panel reload after the mutation" },
    { "action": "assertTextContains", "selector": "#concept-__preferences__", "text": "uitest-pref", "label": "New preference row appears, scoped to this actor" },
    { "action": "screenshot", "name": "preference_added" },
    { "action": "collect", "what": ["domText", "url"] }
  ]
}
