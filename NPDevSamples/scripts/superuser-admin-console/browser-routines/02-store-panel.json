{
  "scenarioName": "superuser-console-store-panel",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "api-dev" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-__store__\"]", "state": "visible" },
    { "action": "click", "selector": "#sideNav a[href=\"#concept-__store__\"]", "label": "Open the Store (pack catalog) surface" },
    { "action": "waitForSelector", "selector": "#concept-__store__", "state": "visible", "label": "Store panel rendered" },
    { "action": "assertVisible", "selector": "#concept-__store__ table.records", "label": "Store renders the pack catalog table (served from /api/admin/packs)" },
    { "action": "assertTextContains", "selector": "#concept-__store__", "text": "identity", "label": "Identity pack listed in the catalog" },
    { "action": "assertTextContains", "selector": "#concept-__store__", "text": "workspace", "label": "Workspace pack listed in the catalog" },
    { "action": "assertTextContains", "selector": "#concept-__store__ table.records", "text": "security", "label": "Category badge rendered for the identity pack (author-ecosystem MVP)" },
    { "action": "assertHidden", "selector": "#concept-__store__ tr.pack-detail-row:has-text(\"User, Role, UserRole\")", "label": "Identity pack's drill-down detail row starts collapsed" },
    { "action": "click", "selector": "#concept-__store__ table.records tbody tr:has-text(\"security\") button", "label": "Expand the identity pack's drill-down (matched by its unique category badge, since 'identity' also appears in the workspace pack's description text)" },
    { "action": "assertVisible", "selector": "#concept-__store__ tr.pack-detail-row:has-text(\"User, Role, UserRole\")", "label": "Identity pack's drill-down detail row is now visible" },
    { "action": "assertTextContains", "selector": "#concept-__store__", "text": "Concepts: User, Role, UserRole", "label": "Drill-down shows the identity pack's actual concept names, not just a count" },
    { "action": "assertTextContains", "selector": "#concept-__store__", "text": "Author: NPDev", "label": "Drill-down shows real author attribution" },
    { "action": "screenshot", "name": "store_panel_drilldown" },
    { "action": "collect", "what": ["domText", "url"] }
  ]
}
