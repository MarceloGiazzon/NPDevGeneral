{
  "scenarioName": "superuser-console-store-panel",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "valueFromCredential": "apiKey" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-__store__\"]", "state": "visible" },
    { "action": "click", "selector": "#sideNav a[href=\"#concept-__store__\"]", "label": "Open the Store (pack catalog) surface" },
    { "action": "waitForSelector", "selector": "#concept-__store__", "state": "visible", "label": "Store panel rendered" },
    { "action": "assertVisible", "selector": "#concept-__store__ table.records", "label": "Store renders the pack catalog table (served from /api/admin/packs)" },
    { "action": "assertTextContains", "selector": "#concept-__store__", "text": "identity", "label": "Identity pack listed in the catalog" },
    { "action": "assertTextContains", "selector": "#concept-__store__", "text": "workspace", "label": "Workspace pack listed in the catalog" },
    { "action": "assertTextContains", "selector": "#concept-__store__ table.records", "text": "security", "label": "Category badge rendered for the identity pack (author-ecosystem MVP)" },
    { "action": "assertHidden", "selector": "#concept-__store__ tr.pack-detail-row >> nth=0", "label": "Identity pack's drill-down detail row starts collapsed (identity sorts first alphabetically)" },
    { "action": "click", "selector": "#concept-__store__ table.records tbody tr:has-text(\"security\") button", "label": "Expand the identity pack's drill-down (matched by its unique category badge, since 'identity' also appears in the workspace pack's description text)" },
    { "action": "assertVisible", "selector": "#concept-__store__ tr.pack-detail-row >> nth=0", "label": "Identity pack's drill-down detail row is now visible" },
    { "action": "assertTextContains", "selector": "#concept-__store__ tr.pack-detail-row >> nth=0", "text": "Concepts (click to see fields)", "label": "Drill-down header present" },
    { "action": "assertTextContains", "selector": "#concept-__store__ tr.pack-detail-row >> nth=0", "text": "▶ User", "label": "Drill-down lists the identity pack's actual concept names as further-expandable rows, not just a count" },
    { "action": "assertTextContains", "selector": "#concept-__store__ tr.pack-detail-row >> nth=0", "text": "▶ Role", "label": "Drill-down lists the Role concept" },
    { "action": "assertTextContains", "selector": "#concept-__store__ tr.pack-detail-row >> nth=0", "text": "▶ UserRole", "label": "Drill-down lists the UserRole concept" },
    { "action": "assertTextContains", "selector": "#concept-__store__ tr.pack-detail-row >> nth=0", "text": "Author: NPDev", "label": "Drill-down shows real author attribution" },
    { "action": "click", "selector": "#concept-__store__ tr.pack-detail-row >> nth=0 >> .pack-concept-row button >> nth=0", "label": "Expand the User concept's own field-level drill-down (box-authoring layered browsing)" },
    { "action": "assertTextContains", "selector": "#concept-__store__ tr.pack-detail-row >> nth=0", "text": "id (uuid)", "label": "Field-level drill-down shows the User concept's real field names/types" },
    { "action": "fill", "selector": "#concept-__store__ .picker-search", "value": "zzz-no-such-pack", "label": "Filter the catalog to a term that matches nothing" },
    { "action": "waitForTimeout", "timeoutMs": 200 },
    { "action": "assertCount", "selector": "#concept-__store__ table.records tbody tr", "operator": "=", "count": 0, "label": "Free-text filter narrows the catalog (down to zero rows for a non-matching term)" },
    { "action": "fill", "selector": "#concept-__store__ .picker-search", "value": "", "label": "Clear the filter" },
    { "action": "waitForTimeout", "timeoutMs": 200 },
    { "action": "assertCount", "selector": "#concept-__store__ table.records tbody tr", "operator": ">", "count": 0, "label": "Clearing the filter restores the full catalog" },
    { "action": "screenshot", "name": "store_panel_drilldown" },
    { "action": "collect", "what": ["domText", "url"] }
  ]
}
