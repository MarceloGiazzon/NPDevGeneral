{
  "scenarioName": "superuser-console-create-project-and-note",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "projectName": "UITEST-PROJECT-PLACEHOLDER", "noteBody": "UITEST-NOTE-PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "valueFromCredential": "apiKey" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-Project\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Project\"]", "label": "Open the Project concept" },
    { "action": "waitForSelector", "selector": "#concept-Project", "state": "visible" },
    { "action": "click", "selector": "#concept-Project .panel-actions button:has-text(\"New\")", "label": "Open the Project create form" },
    { "action": "waitForSelector", "selector": "#concept-Project form", "state": "visible" },
    { "action": "fill", "selector": "#concept-Project [name=\"name\"]", "valueFromVariable": "projectName", "label": "Unique project name (avoids the unique-constraint collision on reruns)" },
    { "action": "selectOption", "selector": "#concept-Project [name=\"status\"]", "value": "Active", "label": "Required status enum" },
    { "action": "fill", "selector": "#concept-Project [name=\"ownerEmail\"]", "value": "uitest@example.com" },
    { "action": "screenshot", "name": "project_form_filled" },
    { "action": "click", "selector": "#concept-Project button:has-text(\"Create\")", "label": "Submit the Project create form" },
    { "action": "waitForSelector", "selector": "#concept-Project form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Project", "text": "UITEST", "label": "New Project row visible in the grid" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Note\"]", "label": "Open the Note concept" },
    { "action": "waitForSelector", "selector": "#concept-Note", "state": "visible" },
    { "action": "click", "selector": "#concept-Note .panel-actions button:has-text(\"New\")", "label": "Open the Note create form" },
    { "action": "waitForSelector", "selector": "#concept-Note form", "state": "visible" },
    { "action": "waitForSelector", "selector": "#concept-Note select[name=\"projectRef\"]", "state": "visible", "label": "projectRef permanently overridden to field.widget=select -- renders a real select, not the lookup picker" },
    { "action": "waitForTimeout", "timeoutMs": 600, "label": "Let the select's async option-loading fetch complete" },
    { "action": "assertCount", "selector": "#concept-Note select[name=\"projectRef\"] option", "operator": ">", "count": 1, "label": "Select has the placeholder plus at least one real Project option" },
    { "action": "click", "selector": "#concept-Note select[name=\"projectRef\"]", "label": "Focus the select" },
    { "action": "press", "selector": "#concept-Note select[name=\"projectRef\"]", "key": "ArrowDown", "label": "Move onto the first real option (any valid option proves the round-trip)" },
    { "action": "fill", "selector": "#concept-Note [name=\"body\"]", "valueFromVariable": "noteBody" },
    { "action": "screenshot", "name": "note_form_filled" },
    { "action": "click", "selector": "#concept-Note button:has-text(\"Create\")", "label": "Submit the Note create form (proves the reference/lookup write path)" },
    { "action": "waitForSelector", "selector": "#concept-Note form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Note", "text": "UI test note", "label": "New Note row visible in the grid (asserted on the note's own body, not the project name)" },
    { "action": "fill", "selector": "#concept-Note .filters input[type=\"search\"]", "valueFromVariable": "noteBody", "label": "Filter the Note grid to just this run's unique row (the table accumulates rows across reruns)" },
    { "action": "click", "selector": "#concept-Note .filters button:has-text(\"Search\")" },
    { "action": "waitForTimeout", "timeoutMs": 500 },
    { "action": "assertCount", "selector": "#concept-Note tbody tr", "operator": "=", "count": 1, "label": "Exactly one Note matches the unique filter" },
    { "action": "click", "selector": "#concept-Note tbody tr button:has-text(\"Edit\")", "label": "Re-open this run's Note to verify the projectRef value itself round-tripped" },
    { "action": "waitForSelector", "selector": "#concept-Note form", "state": "visible" },
    { "action": "waitForTimeout", "timeoutMs": 600 },
    { "action": "assertHidden", "selector": "#concept-Note select[name=\"projectRef\"] option[value=\"\"]:checked", "label": "The placeholder option is no longer selected -- the value genuinely persisted and reloaded" },
    { "action": "click", "selector": "#concept-Note button:has-text(\"Cancel\")" },
    { "action": "screenshot", "name": "note_created" },
    { "action": "collect", "what": ["domText", "url"] }
  ]
}
