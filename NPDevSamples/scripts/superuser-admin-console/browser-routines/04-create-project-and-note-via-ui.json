{
  "scenarioName": "superuser-console-create-project-and-note",
  "targetPath": "/npdev-business-ui/",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "variables": { "projectName": "UITEST-PROJECT-PLACEHOLDER", "noteBody": "UITEST-NOTE-PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "value": "api-dev" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-Project\"]", "state": "visible" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Project\"]", "label": "Open the Project concept" },
    { "action": "waitForSelector", "selector": "#concept-Project", "state": "visible" },
    { "action": "click", "selector": "#concept-Project .panel-actions button:has-text(\"New\")", "label": "Open the Project create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "fill", "selector": "#modalRoot [name=\"name\"]", "valueFromVariable": "projectName", "label": "Unique project name (avoids the unique-constraint collision on reruns)" },
    { "action": "selectOption", "selector": "#modalRoot [name=\"status\"]", "value": "Active", "label": "Required status enum" },
    { "action": "fill", "selector": "#modalRoot [name=\"ownerEmail\"]", "value": "uitest@example.com" },
    { "action": "screenshot", "name": "project_form_filled" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Create\")", "label": "Submit the Project create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Project", "text": "UITEST", "label": "New Project row visible in the grid" },

    { "action": "click", "selector": "#sideNav a[href=\"#concept-Note\"]", "label": "Open the Note concept" },
    { "action": "waitForSelector", "selector": "#concept-Note", "state": "visible" },
    { "action": "click", "selector": "#concept-Note .panel-actions button:has-text(\"New\")", "label": "Open the Note create form" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "visible" },
    { "action": "click", "selector": "#modalRoot .lookup-control:has([name=\"projectRef\"]) .lookup-browse", "label": "Open the Project lookup picker for the reference field" },
    { "action": "waitForSelector", "selector": ".picker-dialog .picker-search", "state": "visible" },
    { "action": "fill", "selector": ".picker-dialog .picker-search", "valueFromVariable": "projectName", "label": "Filter the picker to the Project just created" },
    { "action": "waitForTimeout", "timeoutMs": 600, "label": "Let the picker's 250ms search debounce + reload settle (its first render is the unfiltered list)" },
    { "action": "assertCount", "selector": ".picker-records tbody tr.picker-row", "operator": "=", "count": 1, "label": "Exactly one Project matches the unique filter (the project name is timestamp-unique per run)" },
    { "action": "click", "selector": ".picker-records tbody tr.picker-row", "label": "Select the filtered Project row (closes the picker)" },
    { "action": "waitForSelector", "selector": "#modalRoot .lookup-control:has([name=\"projectRef\"]) .lookup-display", "state": "visible" },
    { "action": "fill", "selector": "#modalRoot [name=\"body\"]", "valueFromVariable": "noteBody" },
    { "action": "screenshot", "name": "note_form_filled" },
    { "action": "click", "selector": "#modalRoot button:has-text(\"Create\")", "label": "Submit the Note create form (proves the reference/lookup write path)" },
    { "action": "waitForSelector", "selector": "#modalRoot form", "state": "detached", "label": "Modal closes only on a successful create" },
    { "action": "waitForTimeout", "timeoutMs": 800 },
    { "action": "assertTextContains", "selector": "#concept-Note", "text": "UITEST", "label": "New Note row visible in the grid" },
    { "action": "screenshot", "name": "note_created" },
    { "action": "collect", "what": ["domText", "url"] }
  ]
}
