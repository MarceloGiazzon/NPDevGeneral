{
  "scenarioName": "move1-crossdocking-panel-verify",
  "targetPath": "/login.html",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "steps": [
    { "action": "goto", "url": "$targetUrl", "label": "Open the real login page" },
    { "action": "waitForSelector", "selector": "#username", "state": "visible", "label": "Login form rendered" },
    { "action": "fill", "selector": "#base", "value": "http://127.0.0.1:8100", "label": "Point the login form at the same origin the browser is on (avoid cross-origin fetch)" },
    { "action": "fill", "selector": "#username", "value": "admin" },
    { "action": "fill", "selector": "#password", "value": "admin123" },
    { "action": "fill", "selector": "#tenant", "value": "trial" },
    { "action": "click", "selector": "#loginBtn", "label": "Submit real login" },
    { "action": "waitForSelector", "selector": "#tokenBox", "state": "visible", "label": "Login succeeded, token stored in localStorage" },
    { "action": "goto", "url": "http://127.0.0.1:8100/npdev-business-ui/", "label": "Navigate to the generic business UI, now authenticated via localStorage token" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-__panel-CrossDockingConsolePanel__\"]", "state": "visible", "label": "Declared Panel nav entry rendered" },
    { "action": "screenshot", "name": "shot_nav", "label": "Nav with Panels group visible" },
    { "action": "click", "selector": "#sideNav a[href=\"#concept-__panel-CrossDockingConsolePanel__\"]", "label": "Open the CrossDockingConsolePanel" },
    { "action": "waitForSelector", "selector": "#concept-__panel-CrossDockingConsolePanel__ h2", "state": "visible", "label": "Panel section rendered" },
    { "action": "waitForSelector", "selector": "#concept-__panel-CrossDockingConsolePanel__ .declared-panel-datasource:has-text(\"crossDockings\")", "state": "visible", "label": "The crossDockings dataSource block loaded" },
    { "action": "assertCount", "selector": "#concept-__panel-CrossDockingConsolePanel__ .declared-panel-datasource", "operator": "=", "count": 4, "label": "All 4 declared dataSources rendered a block" },
    { "action": "waitForTimeout", "timeoutMs": 1200, "label": "Let all 4 dataSource fetches settle" },
    { "action": "screenshot", "name": "shot_panel_loaded", "label": "Panel with its 4 data sources rendered" },
    { "action": "collect", "what": ["domText", "console"] },
    {
      "action": "evaluate", "name": "click_ativar",
      "script": "var sec = document.querySelector('#concept-__panel-CrossDockingConsolePanel__'); var btns = Array.from(sec.querySelectorAll('button')); var btn = btns.find(function(b){ return b.textContent.indexOf('Ativar') !== -1; }); if (!btn) return 'NOT_FOUND:' + btns.map(function(b){return b.textContent;}).join('|'); btn.click(); return 'clicked:' + btn.textContent;",
      "label": "Click the flow-bound Ativar Cross-Docking action button"
    },
    { "action": "waitForTimeout", "timeoutMs": 1500, "label": "Let the action call + panel reload settle" },
    { "action": "screenshot", "name": "shot_after_ativar", "label": "Panel state after clicking the flow-bound action" },
    { "action": "collect", "what": ["domText", "console"] }
  ]
}
