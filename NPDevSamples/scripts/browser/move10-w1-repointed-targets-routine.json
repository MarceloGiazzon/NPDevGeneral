{
  "scenarioName": "move10-w1-conferencia-fiscal-repointed-targets",
  "targetPath": "/login.html",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "steps": [
    { "action": "goto", "url": "$targetUrl", "label": "Open the real login page" },
    { "action": "waitForSelector", "selector": "#username", "state": "visible" },
    { "action": "fill", "selector": "#base", "value": "http://127.0.0.1:8100" },
    { "action": "fill", "selector": "#username", "value": "admin" },
    { "action": "fill", "selector": "#password", "value": "admin123" },
    { "action": "fill", "selector": "#tenant", "value": "trial" },
    { "action": "click", "selector": "#loginBtn" },
    { "action": "waitForSelector", "selector": "#tokenBox", "state": "visible", "label": "Login succeeded" },

    { "action": "goto", "url": "http://127.0.0.1:8100/conferencia-fiscal.html", "label": "The DELETED console is really gone (expect the 404 page, not the console)" },
    { "action": "waitForTimeout", "timeoutMs": 1200 },
    { "action": "screenshot", "name": "shot_repoint_0_deleted_404", "label": "conferencia-fiscal.html no longer served" },

    { "action": "goto", "url": "http://127.0.0.1:8100/npdev-business-ui/", "label": "Open the generated business UI" },
    { "action": "waitForTimeout", "timeoutMs": 2500 },
    { "action": "click", "selector": "#sideNav >> text=Conferencia Fiscal - NF-e", "label": "Re-point target 2: ConferenciaFiscalNfePanel" },
    { "action": "waitForTimeout", "timeoutMs": 2000 },
    { "action": "screenshot", "name": "shot_repoint_2_nfe_historico", "label": "NF-e Historico panel renders" },
    { "action": "click", "selector": "#sideNav >> text=Conferencia Fiscal - Romaneio", "label": "Re-point target 4: ConferenciaFiscalRomaneioPanel" },
    { "action": "waitForTimeout", "timeoutMs": 2000 },
    { "action": "screenshot", "name": "shot_repoint_4_romaneio_historico", "label": "Romaneio Historico panel renders, with the ROM-M10-001 row imported via the new aggregate" },

    { "action": "goto", "url": "http://127.0.0.1:8100/npdev-workbench/DocumentoFiscalAggregateWorkbench.html?id=new", "label": "Re-point target 1: NF-e Importar" },
    { "action": "waitForTimeout", "timeoutMs": 1800 },
    { "action": "screenshot", "name": "shot_repoint_1_nfe_importar", "label": "NF-e Import workbench renders" },

    { "action": "goto", "url": "http://127.0.0.1:8100/npdev-workbench/RomaneioAggregateWorkbench.html?id=new", "label": "Re-point target 3: Romaneio Importar" },
    { "action": "waitForTimeout", "timeoutMs": 1800 },
    { "action": "screenshot", "name": "shot_repoint_3_romaneio_importar", "label": "Romaneio Import workbench renders" },

    { "action": "collect", "what": ["domText", "console", "url"] }
  ]
}
