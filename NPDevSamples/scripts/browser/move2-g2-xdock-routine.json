{
  "scenarioName": "move2-g2-crossdocking-row-scoped-actions",
  "targetPath": "/login.html",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "steps": [
    { "action": "goto", "url": "$targetUrl", "label": "Open the real login page" },
    { "action": "waitForSelector", "selector": "#username", "state": "visible", "label": "Login form rendered" },
    { "action": "fill", "selector": "#base", "value": "http://127.0.0.1:8100", "label": "Same-origin base" },
    { "action": "fill", "selector": "#username", "value": "admin" },
    { "action": "fill", "selector": "#password", "value": "admin123" },
    { "action": "fill", "selector": "#tenant", "value": "trial" },
    { "action": "click", "selector": "#loginBtn", "label": "Submit real login" },
    { "action": "waitForSelector", "selector": "#tokenBox", "state": "visible", "label": "Login succeeded" },
    { "action": "goto", "url": "http://127.0.0.1:8100/npdev-business-ui/", "label": "Navigate to the business UI" },
    { "action": "waitForSelector", "selector": "#sideNav a[href=\"#concept-__panel-CrossDockingConsolePanel__\"]", "state": "visible", "label": "Panel nav entry rendered" },
    { "action": "click", "selector": "#sideNav a[href=\"#concept-__panel-CrossDockingConsolePanel__\"]", "label": "Open the CrossDockingConsolePanel" },
    { "action": "waitForSelector", "selector": "#concept-__panel-CrossDockingConsolePanel__ h2", "state": "visible", "label": "Panel rendered" },
    { "action": "waitForTimeout", "timeoutMs": 1200, "label": "Let dataSources settle" },
    { "action": "screenshot", "name": "shot_g2_row_scoped_buttons", "label": "Per-row Concluir/Cancelar buttons, header no longer has them" },
    { "action": "collect", "what": ["domText", "console"] }
  ]
}
