{
  "scenarioName": "move3-g4-crossdocking-concluir-transition",
  "targetPath": "/login.html",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "steps": [
    { "action": "goto", "url": "$targetUrl", "label": "Open the real login page" },
    { "action": "waitForSelector", "selector": "#username", "state": "visible", "label": "Login form rendered" },
    { "action": "fill", "selector": "#base", "value": "http://127.0.0.1:8100", "label": "Same-origin base" },
    { "action": "fill", "selector": "#username", "value": "admin" },
    { "action": "fill", "selector": "#password", "value": "admin123" },
    { "action": "fill", "selector": "#tenant", "value": "trial" },
    { "action": "click", "selector": "#loginBtn", "label": "Submit real login" },
    { "action": "waitForSelector", "selector": "#tokenBox", "state": "visible", "label": "Login succeeded" },
    { "action": "goto", "url": "http://127.0.0.1:8100/npdev-business-ui/#concept-__panel-CrossDockingConsolePanel__", "label": "Open the CrossDockingConsolePanel" },
    { "action": "waitForTimeout", "timeoutMs": 1800, "label": "Let the panel load real data" },
    { "action": "screenshot", "name": "shot_g4_before_concluir", "label": "Cross-dockings table with a real Ativo row and its Concluir/Cancelar buttons" },
    { "action": "click", "selector": "text=Concluir", "label": "Click Concluir on the first Ativo row -- the procedure-bound action" },
    { "action": "waitForTimeout", "timeoutMs": 1500, "label": "Let the action run and the panel reload" },
    { "action": "screenshot", "name": "shot_g4_after_concluir", "label": "Row should now show situacao=Concluido, no more Concluir/Cancelar buttons" },
    { "action": "collect", "what": ["domText", "console", "url"] }
  ]
}
