{
  "scenarioName": "move10-w1-romaneio-aggregate-workbench-parse",
  "targetPath": "/login.html",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "steps": [
    { "action": "goto", "url": "$targetUrl", "label": "Open the real login page" },
    { "action": "waitForSelector", "selector": "#username", "state": "visible", "label": "Login form rendered" },
    { "action": "fill", "selector": "#base", "value": "http://127.0.0.1:8100", "label": "Same-origin base" },
    { "action": "fill", "selector": "#username", "value": "admin" },
    { "action": "fill", "selector": "#password", "value": "admin123" },
    { "action": "fill", "selector": "#tenant", "value": "trial" },
    { "action": "click", "selector": "#loginBtn", "label": "Submit real login" },
    { "action": "waitForSelector", "selector": "#tokenBox", "state": "visible", "label": "Login succeeded" },
    { "action": "goto", "url": "http://127.0.0.1:8100/npdev-workbench/RomaneioAggregateWorkbench.html?id=new", "label": "Open a brand-new empty Romaneio draft (W1.1's new aggregate)" },
    { "action": "waitForTimeout", "timeoutMs": 1500, "label": "Let the empty draft render" },
    { "action": "screenshot", "name": "shot_w11_empty_draft", "label": "Empty draft with the Importar (Parse Romaneio) action + its numero/texto inline inputs" },
    { "action": "fill", "selector": "textarea[placeholder='numero']", "value": "ROM-BROWSER-777", "label": "Type the operator-supplied romaneio number" },
    { "action": "fill", "selector": "textarea[placeholder='texto']", "value": "Produto Demo 1;12\nProduto Demo 4;6", "label": "Paste the multi-line pipe-delimited romaneio body" },
    { "action": "click", "selector": "text=Importar (Parse Romaneio)", "label": "Click the propose action -- invoke() ParseRomaneioProcedure over the draft" },
    { "action": "waitForTimeout", "timeoutMs": 2000, "label": "Let invoke() return and store.patch() apply the parsed draft" },
    { "action": "screenshot", "name": "shot_w11_after_parse", "label": "Draft populated with numero/dataEmissao + two auto-matched itens rows" },
    { "action": "collect", "what": ["domText", "console", "url"] }
  ]
}
