{
  "scenarioName": "journeys-set-password-golden-scenario",
  "targetPath": "/reset-password.html",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true, "viewport": { "width": 1000, "height": 800 } },
  "variables": { "password": "PLACEHOLDER" },
  "steps": [
    { "action": "goto", "url": "$targetUrl", "label": "Open the link exactly as it was mailed (runner overrides targetPath with it)" },
    { "action": "waitForSelector", "selector": "#confirmForm", "state": "visible", "label": "A mailed link opens straight on the choose-a-password form" },
    { "action": "assertCount", "selector": "#codeLabel.hidden", "operator": "=", "count": 1, "label": "The one-time code came from the link's token=, the person never types it" },
    { "action": "fill", "selector": "#newPassword", "valueFromVariable": "password" },
    { "action": "fill", "selector": "#confirmPassword", "value": "A-different-pass-9" },
    { "action": "click", "selector": "#confirmBtn", "label": "Mismatched confirmation" },
    { "action": "waitForSelector", "selector": "#errorBanner", "state": "visible" },
    { "action": "assertTextContains", "selector": "#errorBanner", "text": "do not match", "label": "A mismatch is caught before anything is sent" },
    { "action": "fill", "selector": "#confirmPassword", "valueFromVariable": "password" },
    { "action": "click", "selector": "#confirmBtn", "label": "Set the password" },
    { "action": "waitForSelector", "selector": "#okBanner", "state": "visible" },
    { "action": "screenshot", "name": "password_set" },
    { "action": "assertTextContains", "selector": "#okBanner", "text": "Password changed" },
    { "action": "collect", "what": ["console", "pageErrors"] }
  ]
}
