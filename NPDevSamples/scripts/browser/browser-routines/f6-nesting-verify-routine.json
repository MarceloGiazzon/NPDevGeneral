{
  "scenarioName": "f6-third-nesting-level-project-workbench",
  "targetPath": "/npdev-business-ui/",
  "options": {
    "headless": true,
    "screenshots": "always",
    "collectDomOnFailure": true,
    "viewport": { "width": 1400, "height": 900 }
  },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "valueFromCredential": "apiKey" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav", "state": "visible", "label": "Auth landed (localStorage token now set)" },
    { "action": "goto", "url": "http://127.0.0.1:8110/npdev-workbench/ProjectWorkbench.html", "label": "Open the standalone Project workbench page" },
    { "action": "waitForSelector", "selector": ".master", "state": "visible", "label": "The root list shows the seeded project" },
    { "action": "click", "selector": ".master", "label": "Open the seeded project" },
    { "action": "waitForSelector", "selector": ".r-items", "state": "visible", "label": "Level 1: the phases section rendered" },
    { "action": "assertCount", "selector": ".r-items tr.master", "operator": "=", "count": 2, "label": "Two phases" },
    { "action": "click", "selector": ".r-items tr.master >> nth=0", "label": "Select the first phase" },
    { "action": "waitForSelector", "selector": ".r-band", "state": "visible", "label": "Level 2: the tasks band appears" },
    { "action": "assertCount", "selector": ".r-band tr.bandrow", "operator": "=", "count": 1, "label": "The phase has one task" },
    { "action": "assertCount", "selector": ".r-subband", "operator": "=", "count": 0, "label": "No sub-band region until a task row is selected" },
    { "action": "click", "selector": ".r-band tr.bandrow >> nth=0", "label": "Select that task" },
    { "action": "waitForSelector", "selector": ".r-subband", "state": "visible", "label": "Level 3: the subtasks sub-band appears" },
    { "action": "assertTextContains", "selector": ".r-subband", "text": "subtasks", "label": "The sub-band grid is titled by its collection" },
    { "action": "assertCount", "selector": ".r-subband table tr", "operator": "=", "count": 3, "label": "Header plus the task's two seeded subtasks" },
    { "action": "screenshot", "name": "f6_nesting_level3" },
    { "action": "click", "selector": ".r-subband button.addrow", "label": "Add a third-level row" },
    { "action": "waitForTimeout", "timeoutMs": 400 },
    { "action": "assertCount", "selector": ".r-subband table tr", "operator": "=", "count": 4, "label": "The new subtask row is staged" },
    { "action": "fill", "selector": ".r-subband table tr:last-child input.cell[aria-label=\"title\"]", "value": "Checkout wireframe" },
    { "action": "fill", "selector": ".r-subband table tr:last-child input.cell[aria-label=\"hours\"]", "value": "5" },
    { "action": "click", "selector": "button.btn:has-text(\"Save\")", "label": "Save the whole aggregate tree in one commit" },
    { "action": "waitForSelector", "selector": ".msg.ok", "state": "visible", "label": "The server accepted the three-level tree" },
    { "action": "goto", "url": "http://127.0.0.1:8110/npdev-workbench/ProjectWorkbench.html", "label": "Reopen the page from scratch" },
    { "action": "waitForSelector", "selector": ".master", "state": "visible" },
    { "action": "click", "selector": ".master" },
    { "action": "waitForSelector", "selector": ".r-items", "state": "visible" },
    { "action": "click", "selector": ".r-items tr.master >> nth=0", "label": "First phase again" },
    { "action": "waitForSelector", "selector": ".r-band tr.bandrow", "state": "visible" },
    { "action": "click", "selector": ".r-band tr.bandrow >> nth=0", "label": "Same task again" },
    { "action": "waitForSelector", "selector": ".r-subband", "state": "visible" },
    { "action": "assertCount", "selector": ".r-subband table tr", "operator": "=", "count": 4, "label": "The third-level row persisted and reloads (header plus three subtasks)" },
    { "action": "click", "selector": ".r-subband table tr:last-child button.rowbtn", "label": "Remove the new third-level row" },
    { "action": "assertCount", "selector": ".r-subband table tr", "operator": "=", "count": 3, "label": "Back to two subtasks, staged" },
    { "action": "click", "selector": "button.btn:has-text(\"Save\")" },
    { "action": "waitForSelector", "selector": ".msg.ok", "state": "visible", "label": "Deleting a third-level row also commits" },
    { "action": "screenshot", "name": "f6_nesting_done" },
    { "action": "collect", "what": ["console", "pageErrors"] }
  ]
}
