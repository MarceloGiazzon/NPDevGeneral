{
  "scenarioName": "f6-client-expression-engine-project-workbench",
  "targetPath": "/npdev-business-ui/",
  "options": {
    "headless": true,
    "screenshots": "always",
    "collectDomOnFailure": true,
    "viewport": { "width": 1400, "height": 900 }
  },
  "steps": [
    { "action": "goto", "url": "$targetUrl" },
    { "action": "waitForSelector", "selector": "#apiKey", "state": "visible" },
    { "action": "fill", "selector": "#apiKey", "valueFromCredential": "apiKey" },
    { "action": "reload" },
    { "action": "waitForSelector", "selector": "#sideNav", "state": "visible", "label": "Auth landed (localStorage token now set)" },
    { "action": "goto", "url": "http://127.0.0.1:8110/npdev-workbench/ProjectWorkbench.html" },
    { "action": "waitForSelector", "selector": ".master", "state": "visible" },
    { "action": "click", "selector": ".master", "label": "Open the seeded project" },
    { "action": "waitForSelector", "selector": ".derived", "state": "visible", "label": "The derived banner rendered" },
    { "action": "assertTextContains", "selector": ".derived .val[data-derived=\"totalHours\"]", "text": "20", "label": "totalHours = sum(phases.tasks.subtasks.hours) = 4+6+4+6, evaluated in the browser" },
    { "action": "assertTextContains", "selector": ".derived .val[data-derived=\"totalCost\"]", "text": "1000", "label": "totalCost = sum(...) * rate = 20 * 50 -- the full expression language, not just sum()" },
    { "action": "assertTextContains", "selector": ".derived .val[data-derived=\"hasWork\"]", "text": "true", "label": "hasWork = count(...) > 0" },
    { "action": "click", "selector": ".r-items tr.master >> nth=0", "label": "Select the first phase" },
    { "action": "waitForSelector", "selector": ".r-band tr.bandrow", "state": "visible" },
    { "action": "click", "selector": ".r-band tr.bandrow >> nth=0", "label": "Select its task" },
    { "action": "waitForSelector", "selector": ".r-subband", "state": "visible" },
    { "action": "assertCount", "selector": ".r-subband .computed-cell[data-col=\"cost\"]", "operator": "=", "count": 2, "label": "A live 'cost' column cell per subtask row" },
    { "action": "assertCount", "selector": ".r-subband .computed-cell[data-col=\"doubled\"]", "operator": "=", "count": 2, "label": "A second computed column, 'doubled'" },
    { "action": "assertTextContains", "selector": ".r-subband", "text": "200", "label": "cost = hours * $root.rate = 4 * 50" },
    { "action": "assertTextContains", "selector": ".r-subband", "text": "300", "label": "cost = 6 * 50" },
    { "action": "screenshot", "name": "f6_computed_before" },
    { "action": "fill", "selector": ".r-subband table tr:nth-child(2) input.cell[aria-label=\"hours\"]", "value": "10", "label": "Edit hours on the first subtask" },
    { "action": "fill", "selector": ".r-subband table tr:nth-child(3) input.cell[aria-label=\"hours\"]", "value": "20", "label": "Edit hours on the second subtask" },
    { "action": "assertTextContains", "selector": ".r-subband", "text": "500", "label": "cost recomputed on the keystroke: 10 * 50, with no server round trip" },
    { "action": "assertTextContains", "selector": ".r-subband", "text": "1000", "label": "cost recomputed: 20 * 50" },
    { "action": "assertTextContains", "selector": ".r-subband", "text": "40", "label": "doubled recomputed: 20 * 2" },
    { "action": "assertTextContains", "selector": ".derived .val[data-derived=\"totalHours\"]", "text": "40", "label": "The derived banner followed the edit: 10 + 20 + the other task's 4 + 6" },
    { "action": "assertTextContains", "selector": ".derived .val[data-derived=\"totalCost\"]", "text": "2000", "label": "totalCost followed the edit: 40 * 50" },
    { "action": "fill", "selector": "input.cell[data-fkey=\"h:rate\"]", "value": "100", "label": "Edit the HEADER rate that $root.rate reads" },
    { "action": "assertTextContains", "selector": ".r-subband", "text": "2000", "label": "cost recomputed from the header edit: 20 * 100" },
    { "action": "assertTextContains", "selector": ".derived .val[data-derived=\"totalCost\"]", "text": "4000", "label": "totalCost followed the header edit: 40 * 100" },
    { "action": "screenshot", "name": "f6_computed_after" },
    { "action": "collect", "what": ["console", "pageErrors"] }
  ]
}
