{
  "scenarioName": "move3-g3-documentofiscal-workbench-parse-nfe",
  "targetPath": "/login.html",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "steps": [
    { "action": "goto", "url": "$targetUrl", "label": "Open the real login page" },
    { "action": "waitForSelector", "selector": "#username", "state": "visible", "label": "Login form rendered" },
    { "action": "fill", "selector": "#base", "value": "http://127.0.0.1:8100", "label": "Same-origin base" },
    { "action": "fill", "selector": "#username", "value": "admin" },
    { "action": "fill", "selector": "#password", "value": "admin123" },
    { "action": "fill", "selector": "#tenant", "value": "trial" },
    { "action": "click", "selector": "#loginBtn", "label": "Submit real login" },
    { "action": "waitForSelector", "selector": "#tokenBox", "state": "visible", "label": "Login succeeded" },
    { "action": "goto", "url": "http://127.0.0.1:8100/npdev-workbench/DocumentoFiscalAggregateWorkbench.html?id=new", "label": "Open a brand-new empty DocumentoFiscal draft" },
    { "action": "waitForTimeout", "timeoutMs": 1200, "label": "Let the empty draft render" },
    { "action": "screenshot", "name": "shot_g3_empty_draft", "label": "Empty draft with the Importar (Parse NF-e) action + its xml inline input" },
    { "action": "fill", "selector": "input[placeholder='xml']", "value": "<nfe><numero>555</numero><chave>NFE-BROWSER-555</chave><dataEmissao>2026-07-29</dataEmissao><emitente><cnpj>99988877000166</cnpj></emitente><item><codigo>Widget B</codigo><descricao>Widget B desc</descricao><quantidade>4</quantidade><valorUnitario>7.00</valorUnitario></item></nfe>", "label": "Paste sample NF-e XML into the action's inline input" },
    { "action": "click", "selector": "text=Importar (Parse NF-e)", "label": "Click the Importar (Parse NF-e) action -- invoke() the propose step" },
    { "action": "waitForTimeout", "timeoutMs": 1500, "label": "Let invoke() return and store.patch() apply the parsed draft" },
    { "action": "screenshot", "name": "shot_g3_after_parse", "label": "Draft populated with parsed numero/chave/dataEmissao/emitenteCnpj + itens row" },
    { "action": "collect", "what": ["domText", "console", "url"] }
  ]
}
