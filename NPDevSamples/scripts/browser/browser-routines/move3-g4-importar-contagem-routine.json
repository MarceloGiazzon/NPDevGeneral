{
  "scenarioName": "move3-g4-inventario-workbench-importar-contagem",
  "targetPath": "/login.html",
  "options": { "headless": true, "screenshots": "always", "collectDomOnFailure": true },
  "steps": [
    { "action": "goto", "url": "$targetUrl", "label": "Open the real login page" },
    { "action": "waitForSelector", "selector": "#username", "state": "visible", "label": "Login form rendered" },
    { "action": "fill", "selector": "#base", "value": "http://127.0.0.1:8100", "label": "Same-origin base" },
    { "action": "fill", "selector": "#username", "value": "admin" },
    { "action": "fill", "selector": "#password", "value": "admin123" },
    { "action": "fill", "selector": "#tenant", "value": "trial" },
    { "action": "click", "selector": "#loginBtn", "label": "Submit real login" },
    { "action": "waitForSelector", "selector": "#tokenBox", "state": "visible", "label": "Login succeeded" },
    { "action": "goto", "url": "http://127.0.0.1:8100/npdev-workbench/InventarioArquivoAggregateWorkbench.html?id=new", "label": "Open a brand-new empty InventarioArquivo draft" },
    { "action": "waitForTimeout", "timeoutMs": 1200, "label": "Let the empty draft render" },
    { "action": "fill", "selector": "textarea[placeholder='texto']", "value": "localArmazenagemId;produtoId;loteId;quantidadeEsperada;quantidadeContada\n00290f07-2582-4ace-bd42-9c2b9d4f2fe5;47a83a5c-96c2-4fe8-99df-84d052e90806;37096eaa-c5a8-41ff-a243-a4ce19d3ccac;10;9", "label": "Paste pipe-delimited count text into the action's inline textarea" },
    { "action": "screenshot", "name": "shot_g4_before_click", "label": "Confirm the textarea actually holds the pasted text before clicking" },
    { "action": "click", "selector": "text=Importar Contagem (Parse)", "label": "Click the Importar Contagem action -- invoke() the propose step" },
    { "action": "waitForTimeout", "timeoutMs": 1500, "label": "Let invoke() return and store.patch() apply the parsed draft" },
    { "action": "screenshot", "name": "shot_g4_after_import_parse", "label": "Draft populated with a real parsed linhas row" },
    { "action": "collect", "what": ["domText", "console", "url"] }
  ]
}
