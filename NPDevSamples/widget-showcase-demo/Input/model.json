{
  "$schema": "..\\..\\..\\NPDevContract\\schemas\\model.schema.json",
  "namespace": "sample.widget.showcase.demo",
  "dslVersion": "1.0.0",
  "version": "1.0",
  "metadata": {
    "purpose": "Live proof-of-concept for the expanded widget catalog: color picker, enum image-select, closed-enum array multiselect, and a custom (trusted-source) field widget."
  },
  "concepts": [
    {
      "name": "Product",
      "ui": { "label": "Product", "description": "A catalog product exercising the new widget catalog." },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "name", "type": "string", "required": true, "ui": { "label": "Name", "widget": "text" } },
        { "name": "accentColor", "type": "string", "ui": { "label": "Accent color", "widget": "color" } },
        {
          "name": "category",
          "type": "enum",
          "enumValues": [
            { "value": "Electronics", "iconHint": "💻" },
            { "value": "Furniture", "iconHint": "🪩" },
            { "value": "Clothing", "iconHint": "👕" }
          ],
          "required": true,
          "default": "Electronics",
          "ui": { "label": "Category", "widget": "image-select" }
        },
        {
          "name": "tags",
          "type": "array",
          "items": { "type": "enum", "enumValues": ["red", "green", "blue", "yellow"] },
          "ui": { "label": "Tags", "widget": "multiselect" }
        },
        {
          "name": "rating",
          "type": "int",
          "ui": { "label": "Rating", "widget": "custom", "customWidgetRef": "widgets/star-rating.js" }
        }
      ],
      "invariants": [
        { "name": "ProductNameRequired", "expr": "name != null && name != ''" }
      ]
    }
  ],
  "capabilities": [
    { "name": "persistence", "type": "PersistenceCapability", "operations": ["save", "findById", "unique"] }
  ],
  "bindings": [
    { "capability": "persistence", "adapter": "repository" },
    { "capability": "eventBus", "adapter": "inproc" }
  ]
}
