{
  "$schema": "..\\..\\..\\NPDevContract\\schemas\\model.schema.json",
  "namespace": "sample.domhelpdesk",
  "dslVersion": "1.0.0",
  "version": "1.0",
  "metadata": {
    "purpose": "DOM-4: a consumer of the built-in helpdesk pack. Binds its three logical roles to REQUESTER, HD_AGENT and HD_MGR and grants them the pack's concepts; probe/helpdesk_probe.py drives the pack's rules against the booted app (role enforcement, the assigned-agent rule, the ticket lifecycle, derived counts)."
  },
  "packs": [
    {
      "$ref": "packs/helpdesk/pack.json",
      "as": "helpdesk"
    }
  ],
  "provides": {
    "roleBindings": {
      "requester": "REQUESTER",
      "helpdeskAgent": "HD_AGENT",
      "helpdeskManager": "HD_MGR"
    }
  },
  "roles": [
    {
      "name": "HD_MGR",
      "concepts": {
        "helpdesk::HelpdeskAgent": [
          "read",
          "create",
          "update",
          "delete"
        ],
        "helpdesk::TicketCategory": [
          "read",
          "create",
          "update",
          "delete"
        ],
        "helpdesk::Ticket": [
          "read",
          "create",
          "update",
          "delete"
        ],
        "helpdesk::TicketComment": [
          "read",
          "create",
          "update",
          "delete"
        ]
      }
    },
    {
      "name": "HD_AGENT",
      "concepts": {
        "helpdesk::HelpdeskAgent": [
          "read"
        ],
        "helpdesk::TicketCategory": [
          "read"
        ],
        "helpdesk::Ticket": [
          "read",
          "update"
        ],
        "helpdesk::TicketComment": [
          "read",
          "create"
        ]
      }
    },
    {
      "name": "REQUESTER",
      "concepts": {
        "helpdesk::TicketCategory": [
          "read"
        ],
        "helpdesk::Ticket": [
          "create"
        ],
        "helpdesk::TicketComment": [
          "create"
        ]
      }
    }
  ]
}
