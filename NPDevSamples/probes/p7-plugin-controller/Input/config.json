{
  "$schema": "..\\\\..\\\\..\\\\..\\\\NPDevContract\\\\schemas\\\\config.schema.json",
  "configVersion": "1.0",
  "scenario": {
    "name": "p7-plugin-controller",
    "description": "R10 probe: plugin:java-controller mount + the D9 security wrapper. Two mounted @RestControllers, gated ADMIN and SUPERUSER respectively, so one probe proves both the mount serves a real request AND minimumRole enforcement genuinely rejects an under-privileged caller.",
    "outputRoot": "..\\\\Output"
  },
  "generator": {
    "failIfModelMissing": true,
    "failIfConfigMissing": true,
    "cleanOutputBeforeGenerate": true,
    "emitPluginAssets": true,
    "emitRuntimeAssets": true,
    "emitUiAssets": false
  },
  "bootstrap": {
    "root": "..\\\\..\\\\..\\\\..\\\\NPDevRuntimeHost",
    "mergeStrategy": "clean-copy"
  },
  "artifact": {
    "root": "..\\\\Output\\\\ArtifactNP",
    "generatedFolderName": "npdev-generated",
    "libsFolderName": "libs",
    "metaFolderName": "npdev-meta"
  },
  "finalExec": {
    "root": "..\\\\Output\\\\App",
    "deleteBeforeMount": true
  },
  "database": {
    "provider": "h2-local",
    "database": "p7_plugin_controller",
    "resetMode": "reset"
  },
  "runtime": {
    "springProfile": "dev,trial",
    "serverPort": 8321,
    "javaArgs": [],
    "gradleTask": "bootRun"
  },
  "trialDefaults": {
    "apiKey": "dev-key",
    "recommendedProfiles": "dev,trial",
    "runtimeUrl": "http://localhost:8321/",
    "databaseMode": "h2-local",
    "notes": [
      "R10 plugin:java-controller probe. Deliberately h2-local: this proves the mount + security wrapper mechanism, not a dialect."
    ]
  },
  "build": {
    "javaVersion": 17
  }
}
