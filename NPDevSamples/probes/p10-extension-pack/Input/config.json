{
  "$schema": "..\\..\\..\\..\\NPDevContract\\schemas\\config.schema.json",
  "configVersion": "1.0",
  "scenario": {
    "name": "p10-extension-pack",
    "description": "PACK-10 probe: clinicbase composed with a throwaway 'clinicext' extension pack using the first-class `extends` keyword to additively contribute a field onto clinicbase::Patient.",
    "outputRoot": "..\\Output"
  },
  "generator": {
    "failIfModelMissing": true,
    "failIfConfigMissing": true,
    "cleanOutputBeforeGenerate": true,
    "emitPluginAssets": false,
    "emitRuntimeAssets": true,
    "emitUiAssets": true
  },
  "bootstrap": {
    "root": "..\\..\\..\\..\\NPDevRuntimeHost",
    "mergeStrategy": "clean-copy"
  },
  "artifact": {
    "root": "..\\Output\\ArtifactNP",
    "generatedFolderName": "npdev-generated",
    "libsFolderName": "libs",
    "metaFolderName": "npdev-meta"
  },
  "finalExec": {
    "root": "..\\Output\\App",
    "deleteBeforeMount": true
  },
  "database": {
    "provider": "h2-local",
    "database": "p10_extension_pack",
    "resetMode": "reset"
  },
  "runtime": {
    "springProfile": "dev,trial",
    "serverPort": 8176,
    "javaArgs": [],
    "gradleTask": "bootRun"
  },
  "trialDefaults": {
    "apiKey": "dev-key",
    "recommendedProfiles": "dev,trial",
    "runtimeUrl": "http://localhost:8176/",
    "databaseMode": "h2-local",
    "notes": [
      "Storage/pack probe for PACK-10 (first-class extends). Do not add features."
    ]
  }
}
