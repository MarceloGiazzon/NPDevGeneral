{
  "$schema": "..\\..\\NPDevContract\\schemas\\model.schema.json",
  "namespace": "trial.userregistry",
  "dslVersion": "1.0.0",
  "version": "1.0",
  "concepts": [
    {
      "name": "User",
      "ui": {
        "label": {
          "default": "User",
          "en": "User"
        }
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "ui": {
            "label": {
              "default": "Name",
              "en": "Name"
            }
          }
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "ui": {
            "label": {
              "default": "Email",
              "en": "Email"
            }
          }
        },
        {
          "name": "active",
          "type": "boolean",
          "required": true,
          "ui": {
            "label": {
              "default": "Active",
              "en": "Active"
            }
          }
        }
      ],
      "invariants": [
        {
          "name": "EmailRequired",
          "expr": "email != null && email != ''"
        },
        {
          "name": "NameRequired",
          "expr": "name != null && name != ''"
        },
        {
          "name": "EmailUnique",
          "type": "unique",
          "fields": [
            "email"
          ]
        }
      ]
    }
  ],
  "capabilities": [
    {
      "name": "persistence",
      "type": "PersistenceCapability",
      "operations": [
        "save",
        "unique",
        "findById"
      ]
    }
  ],
  "bindings": [
    {
      "capability": "persistence",
      "adapter": "repository"
    },
    {
      "capability": "eventBus",
      "adapter": "inproc"
    }
  ],
  "events": [
    {
      "name": "UserCreated",
      "payload": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "email",
          "type": "string"
        }
      ]
    }
  ],
  "flows": [
    {
      "name": "CreateUser",
      "input": {
        "concept": "User",
        "mode": "create"
      },
      "steps": [
        {
          "name": "validate-user",
          "type": "invariantCheck",
          "scope": "User",
          "invariants": [
            "EmailRequired",
            "NameRequired",
            "EmailUnique"
          ]
        },
        {
          "name": "save-user",
          "type": "capabilityCall",
          "args": [
            "$input"
          ],
          "capability": "persistence",
          "operation": "save",
          "output": "$saved"
        },
        {
          "name": "emit-user-created",
          "type": "emitEvent",
          "event": "UserCreated",
          "from": "$saved"
        },
        {
          "name": "return-user",
          "type": "return",
          "value": "$saved"
        }
      ]
    }
  ]
}
