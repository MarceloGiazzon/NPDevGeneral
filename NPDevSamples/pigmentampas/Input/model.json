{
  "$schema": "..\\..\\NPDevContract\\schemas\\model.schema.json",
  "namespace": "pigmentampas",
  "dslVersion": "1.0.0",
  "version": "2.0",
  "metadata": {
    "purpose": "Pigmentampas -- paint with beer caps. A cap catalogue (curated), personal cap collections, hex cap mosaics (20x33 cells, edited as one aggregate), a gallery and a dashboard. Rebuilt 2026-10-07 from the original PHP Tampas app as the NPDev demo + maturity evaluation for non-CRUD, visual apps. jwt-mode auth (Google + username/password via Credential -> identity::User); row-level access keys on ownerUsername == $user.id."
  },
  "settings": {
    "locale": "en-US",
    "ui": { "pageRows": 25, "dateFormat": "yyyy-MM-dd" }
  },
  "appShell": {
    "defaultRoute": "Mosaic",
    "navigation": [
      { "label": "Mosaics", "target": "Mosaic", "group": "Studio" },
      { "label": "My collection", "target": "CollectionItem", "group": "Studio" },
      { "label": "Cap catalogue", "target": "Cap", "group": "Catalogue" },
      { "label": "Breweries", "target": "Brewery", "group": "Catalogue" },
      { "label": "Members", "target": "Member", "group": "Community" },
      { "label": "Trades", "target": "Trade", "group": "Community" },
      { "label": "Likes", "target": "Like", "group": "Community" },
      { "label": "Challenges", "target": "Challenge", "group": "Community" }
    ]
  },
  "roles": [
    { "name": "Member", "grants": ["EXECUTE_FLOW"] },
    { "name": "Curator", "grants": ["EXECUTE_FLOW", "READ_EXECUTIONS"] }
  ],
  "propertyScopes": [
    { "name": "user", "from": "$user.id" },
    { "name": "tenant" }
  ],
  "properties": [
    { "name": "aiCallsPerUserPerDay", "type": "int", "default": 20,
      "settableAt": ["tenant", "user"], "label": "AI calls per member per day" },
    { "name": "aiMonthlyBudgetUsd", "type": "string", "default": "2.00",
      "settableAt": ["tenant"], "label": "Monthly AI budget (USD)" }
  ],
  "externalAi": {
    "egress": "apiEnabled",
    "vendors": ["gemini"],
    "prompts": [
      {
        "name": "PaintMosaic",
        "description": "Describe it, AI paints it: a cell layout using only approved caps, folded into the open DRAFT for review.",
        "vendor": "gemini",
        "template": "You design beer-cap mosaics on a hex grid of {{rows}} rows by {{cols}} columns (row 0 is the top, col 0 the left; odd rows are shifted half a cell right). Paint this: {{aiPrompt}}. Fill EVERY cell (row 0..{{rows}}-1, col 0..{{cols}}-1) -- return exactly {{cellCount}} cells, one per row/col pair, never stop early -- with one cap from this palette, matching colours as closely as you can; use a background cap for areas outside the motif. Palette (use only these ids): {{palette}}",
        "outputSchema": {
          "type": "object",
          "required": ["cells"],
          "properties": {
            "cells": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["row", "col", "capId"],
                "properties": {
                  "row": { "type": "integer", "minimum": 0 },
                  "col": { "type": "integer", "minimum": 0 },
                  "capId": { "type": "string" }
                }
              }
            }
          }
        },
        "maxOutputTokens": 60000
      },
      {
        "name": "IdentifyCap",
        "description": "Snap a cap, AI identifies it: vision suggests colours, finish and tags for a SUBMITTED cap; the Curator reviews and saves.",
        "vendor": "gemini",
        "template": "This is a photo of a beer bottle cap labelled '{{label}}'. Identify its dominant and accent colours as #RRGGBB hex, its finish, and up to 6 short lowercase tags (colours, motifs, brewery or brand words you can read). Return tags as one comma-separated string.",
        "image": "image",
        "outputSchema": {
          "type": "object",
          "required": ["dominantColor", "finish", "tags"],
          "properties": {
            "dominantColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "finish": { "type": "string", "enum": ["GLOSSY", "MATTE", "METALLIC", "PRINTED"] },
            "tags": { "type": "string", "maxLength": 200 }
          }
        },
        "maxOutputTokens": 2048
      }
    ],
    "limits": {
      "callsPerUserPerDay": "aiCallsPerUserPerDay",
      "monthlyCostCapUsd": "aiMonthlyBudgetUsd"
    }
  },
  "agentAccess": {
    "assistant": {
      "name": "Pigmentampas Assistant",
      "instructions": "You help beer-cap collectors who design cap mosaics. You can browse the cap catalogue and breweries, read and update the user's own cap collection, and read the user's mosaics. Reply in the user's language. When adding to a collection, set ownerUsername to the user's own username. A mosaic is a 20x33 hex grid of cells, each cell holding one cap (or empty).",
      "language": "en"
    },
    "channels": {
      "mcp": { "enabled": true },
      "telegram": { "enabled": true },
      "whatsapp": { "enabled": true }
    },
    "expose": [
      {
        "concept": "Cap",
        "operations": ["list", "get"],
        "description": "The cap catalogue: label, brewery, dominant colour (#hex), finish, rarity, approval status."
      },
      {
        "concept": "Brewery",
        "operations": ["list", "get"],
        "description": "Breweries whose caps are in the catalogue."
      },
      {
        "concept": "CollectionItem",
        "operations": ["list", "get", "create", "update"],
        "description": "The caps a member owns: which cap, how many, condition, whether it is up for trade. Members only ever see and change their own.",
        "confirmWrites": true
      },
      {
        "concept": "Mosaic",
        "operations": ["list", "get"],
        "description": "Cap mosaics: code, title, owner, size, status (DRAFT, PUBLISHED, BUILT)."
      }
    ]
  },
  "bindings": [
    { "adapter": "repository", "capability": "persistence" },
    { "adapter": "inproc", "capability": "eventBus" },
    { "adapter": "externalAi", "capability": "externalAi" },
    { "adapter": "fileStore", "capability": "fileStore" },
    { "adapter": "plugin:java-source", "capability": "mosaicPainter" },
    { "adapter": "mail-smtp", "capability": "mail" }
  ],
  "capabilities": [
    {
      "name": "persistence",
      "operations": ["save", "findById"],
      "type": "PersistenceCapability"
    },
    {
      "name": "externalAi",
      "operations": ["generate"],
      "type": "ExternalAiCapability"
    },
    {
      "name": "fileStore",
      "operations": ["readImage"],
      "type": "FileStoreCapability"
    },
    {
      "name": "mail",
      "operations": ["send"],
      "type": "EmailCapability"
    }
  ],
  "customCapabilities": [
    {
      "name": "mosaicPainter",
      "operations": ["paintFromPhoto", "capColors"],
      "type": "MosaicPainterCapability"
    }
  ],
  "packs": [
    { "from": "git+file:///D:/WorkSpace/NPDev/Build/npdev-pack-repo//packs/identity@identity-1.2.0", "as": "identity" },
    { "from": "git+file:///D:/WorkSpace/NPDev/Build/npdev-pack-repo//packs/tracing@tracing-1.0.2", "as": "tracing" },
    { "from": "git+file:///D:/WorkSpace/NPDev/Build/npdev-pack-repo//packs/workspace@workspace-1.1.0", "as": "workspace" }
  ],
  "sequences": [
    { "name": "mosaicCode", "format": "PTM-{year}-{seq:4}", "scope": "tenant" },
    { "name": "tradeCode", "format": "TRD-{year}-{seq:4}", "scope": "tenant" }
  ],
  "concepts": [
    {
      "name": "Member",
      "ui": { "label": "Member" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "username", "type": "string", "required": true, "maxLength": 120, "unique": true,
          "ui": { "label": "Username" } },
        { "name": "displayName", "type": "string", "required": true, "maxLength": 120,
          "ui": { "label": "Display name" } },
        { "name": "email", "type": "string", "required": false, "maxLength": 200,
          "ui": { "label": "Email (trade notifications)" } },
        { "name": "city", "type": "string", "required": false, "maxLength": 80,
          "ui": { "label": "City" } },
        { "name": "country", "type": "string", "required": false, "maxLength": 80,
          "ui": { "label": "Country" } },
        { "name": "avatar", "type": "file", "required": false,
          "file": { "contentTypes": ["image/png", "image/jpeg"], "maxSizeBytes": 204800 },
          "ui": { "label": "Avatar" } },
        { "name": "bio", "type": "string", "required": false, "maxLength": 500,
          "ui": { "label": "Bio" } }
      ],
      "access": {
        "write": "$user.roles.contains('Curator') || username == $user.id"
      }
    },
    {
      "name": "Brewery",
      "ui": { "label": "Brewery" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "name", "type": "string", "required": true, "maxLength": 120, "unique": true,
          "ui": { "label": "Name" } },
        { "name": "country", "type": "string", "required": false, "maxLength": 80,
          "ui": { "label": "Country" } },
        { "name": "website", "type": "string", "required": false, "maxLength": 200,
          "ui": { "label": "Website" } }
      ]
    },
    {
      "name": "Cap",
      "ui": { "label": "Cap" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "label", "type": "string", "required": true, "maxLength": 120, "unique": true,
          "ui": { "label": "Label" } },
        { "name": "breweryId", "type": "reference", "required": false,
          "ui": { "label": "Brewery" },
          "reference": { "target": "Brewery", "displayField": "name" } },
        { "name": "image", "type": "file", "required": false,
          "file": { "contentTypes": ["image/png", "image/jpeg"], "maxSizeBytes": 204800 },
          "ui": { "label": "Image" } },
        { "name": "dominantColor", "type": "string", "required": true, "maxLength": 9,
          "ui": { "label": "Dominant colour" } },
        { "name": "accentColor", "type": "string", "required": false, "maxLength": 9,
          "ui": { "label": "Accent colour" } },
        { "name": "finish", "type": "enum", "required": true,
          "enumValues": ["GLOSSY", "MATTE", "METALLIC", "PRINTED"],
          "ui": { "label": "Finish" } },
        { "name": "rarity", "type": "enum", "required": true,
          "enumValues": ["COMMON", "UNCOMMON", "RARE"],
          "ui": { "label": "Rarity" } },
        { "name": "tags", "type": "string", "required": false, "maxLength": 200,
          "ui": { "label": "Tags" } },
        { "name": "status", "type": "enum", "required": true,
          "enumValues": ["SUBMITTED", "APPROVED", "REJECTED"],
          "ui": { "label": "Status" } },
        { "name": "submittedBy", "type": "string", "required": false, "maxLength": 120,
          "ui": { "label": "Submitted by" } }
      ],
      "lifecycle": {
        "statusField": "status",
        "states": [
          { "value": "SUBMITTED", "label": "Submitted", "initial": true },
          { "value": "APPROVED", "label": "Approved" },
          { "value": "REJECTED", "label": "Rejected", "terminal": true }
        ],
        "transitions": [
          { "from": "SUBMITTED", "to": "APPROVED", "event": "approve", "actionLabel": "Approve",
            "guard": "$user.roles.contains('Curator')" },
          { "from": "SUBMITTED", "to": "REJECTED", "event": "reject", "actionLabel": "Reject",
            "guard": "$user.roles.contains('Curator')" }
        ]
      },
      "indexes": [
        { "name": "idx_cap_brewery", "fields": ["breweryId"] }
      ],
      "access": {
        "public": {
          "where": "status == 'APPROVED'",
          "fields": ["label", "dominantColor", "accentColor", "finish", "image"]
        }
      }
    },
    {
      "name": "CollectionItem",
      "ui": { "label": "Collection item" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "ownerUsername", "type": "string", "required": true, "maxLength": 120,
          "ui": { "label": "Owner" } },
        { "name": "capId", "type": "reference", "required": true,
          "ui": { "label": "Cap" },
          "reference": { "target": "Cap", "displayField": "label" } },
        { "name": "quantity", "type": "integer", "required": true, "min": 0,
          "ui": { "label": "Quantity" } },
        { "name": "condition", "type": "enum", "required": true,
          "enumValues": ["MINT", "USED", "BENT"],
          "ui": { "label": "Condition" } },
        { "name": "forTrade", "type": "boolean", "required": true,
          "ui": { "label": "For trade" } }
      ],
      "indexes": [
        { "name": "ux_collection_owner_cap", "fields": ["ownerUsername", "capId"], "unique": true }
      ],
      "access": {
        "read": "ownerUsername == $user.id || forTrade == true",
        "write": "ownerUsername == $user.id"
      }
    },
    {
      "name": "Mosaic",
      "ui": { "label": "Mosaic" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "code", "type": "string", "required": false, "maxLength": 20, "unique": true,
          "defaultExpression": "nextNumber('mosaicCode')",
          "ui": { "label": "Code" } },
        { "name": "title", "type": "string", "required": true, "maxLength": 120,
          "ui": { "label": "Title" } },
        { "name": "ownerUsername", "type": "string", "required": true, "maxLength": 120,
          "ui": { "label": "Owner" } },
        { "name": "rows", "type": "integer", "required": true, "min": 1, "max": 60,
          "ui": { "label": "Rows" } },
        { "name": "cols", "type": "integer", "required": true, "min": 1, "max": 60,
          "ui": { "label": "Columns" } },
        { "name": "layout", "type": "enum", "required": true,
          "enumValues": ["HEX_OFFSET", "SQUARE"],
          "ui": { "label": "Layout" } },
        { "name": "cellCount", "type": "integer", "required": false,
          "derivedExpression": "rows * cols",
          "ui": { "label": "Cells" } },
        { "name": "likeCount", "type": "integer", "required": false,
          "ui": { "label": "Likes" } },
        { "name": "sourceImage", "type": "file", "required": false,
          "file": { "contentTypes": ["image/png", "image/jpeg"], "maxSizeBytes": 2097152 },
          "ui": { "label": "Source image" } },
        { "name": "onlyOwnedCaps", "type": "boolean", "required": false,
          "ui": { "label": "Paint from photo with only caps I own" } },
        { "name": "builtPhoto", "type": "file", "required": false,
          "file": { "contentTypes": ["image/png", "image/jpeg"], "maxSizeBytes": 2097152 },
          "ui": { "label": "Photo of the built piece" } },
        { "name": "description", "type": "string", "required": false, "maxLength": 1000,
          "ui": { "label": "Description" } },
        { "name": "status", "type": "enum", "required": true,
          "enumValues": ["DRAFT", "PUBLISHED", "BUILT"],
          "ui": { "label": "Status" } }
      ],
      "rollups": [
        { "field": "likeCount", "from": "Like", "via": "mosaicId", "fn": "count" }
      ],
      "lifecycle": {
        "statusField": "status",
        "states": [
          { "value": "DRAFT", "label": "Draft", "initial": true },
          { "value": "PUBLISHED", "label": "Published" },
          { "value": "BUILT", "label": "Built", "terminal": true }
        ],
        "transitions": [
          { "from": "DRAFT", "to": "PUBLISHED", "event": "publish", "actionLabel": "Publish" },
          { "from": "PUBLISHED", "to": "DRAFT", "event": "unpublish", "actionLabel": "Back to draft" },
          { "from": "PUBLISHED", "to": "BUILT", "event": "markBuilt", "actionLabel": "Mark as built" }
        ]
      },
      "access": {
        "read": "ownerUsername == $user.id || status != 'DRAFT'",
        "write": "ownerUsername == $user.id",
        "public": {
          "where": "status != 'DRAFT'",
          "fields": ["code", "title", "rows", "cols", "layout", "description", "status", "builtPhoto", "likeCount"]
        }
      }
    },
    {
      "name": "MosaicCell",
      "ui": { "label": "Mosaic cell" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "mosaicId", "type": "reference", "required": true,
          "ui": { "label": "Mosaic" },
          "reference": { "target": "Mosaic", "displayField": "title", "onDelete": "cascade" } },
        { "name": "row", "type": "integer", "required": true, "min": 0,
          "ui": { "label": "Row" } },
        { "name": "col", "type": "integer", "required": true, "min": 0,
          "ui": { "label": "Column" } },
        { "name": "capId", "type": "reference", "required": false,
          "ui": { "label": "Cap" },
          "reference": { "target": "Cap", "displayField": "label" } }
      ],
      "indexes": [
        { "name": "ux_mosaic_cell_pos", "fields": ["mosaicId", "row", "col"], "unique": true },
        { "name": "idx_mosaic_cell_cap", "fields": ["capId"] }
      ],
      "access": {
        "public": { "fields": ["row", "col", "capId"], "scope": "aggregate" }
      }
    },
    {
      "name": "Credential",
      "ui": { "label": "Credential" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "userId", "type": "reference", "required": true, "unique": true,
          "ui": { "label": "Identity user" },
          "reference": { "target": "identity::User", "onDelete": "cascade" } },
        { "name": "passwordHash", "type": "string", "required": true, "maxLength": 200,
          "ui": { "label": "Password hash" } }
      ]
    },
    {
      "name": "Trade",
      "ui": { "label": "Trade" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "code", "type": "string", "required": false, "maxLength": 20, "unique": true,
          "defaultExpression": "nextNumber('tradeCode')", "ui": { "label": "Code" } },
        { "name": "proposerUsername", "type": "string", "required": true, "maxLength": 120,
          "ui": { "label": "Proposed by" } },
        { "name": "recipientId", "type": "reference", "required": true, "ui": { "label": "Proposed to" },
          "reference": { "target": "Member", "displayField": "displayName" } },
        { "name": "recipientUsername", "type": "string", "required": false, "maxLength": 120,
          "ui": { "label": "Recipient username" } },
        { "name": "offeredCapId", "type": "reference", "required": true, "ui": { "label": "I offer" },
          "reference": { "target": "Cap", "displayField": "label" } },
        { "name": "requestedCapId", "type": "reference", "required": true, "ui": { "label": "I want" },
          "reference": { "target": "Cap", "displayField": "label" } },
        { "name": "message", "type": "string", "required": false, "maxLength": 500,
          "ui": { "label": "Message" } },
        { "name": "status", "type": "enum", "required": true, "default": "PROPOSED",
          "enumValues": ["PROPOSED", "ACCEPTED", "DECLINED", "EXPIRED"], "ui": { "label": "Status" } }
      ],
      "lifecycle": {
        "statusField": "status",
        "states": [
          { "value": "PROPOSED", "label": "Proposed", "initial": true },
          { "value": "ACCEPTED", "label": "Accepted", "terminal": true },
          { "value": "DECLINED", "label": "Declined", "terminal": true },
          { "value": "EXPIRED", "label": "Expired", "terminal": true }
        ],
        "transitions": [
          { "from": "PROPOSED", "to": "ACCEPTED", "event": "TradeAnswered", "actionLabel": "Accept" },
          { "from": "PROPOSED", "to": "DECLINED", "event": "TradeAnswered", "actionLabel": "Decline" },
          { "from": "PROPOSED", "to": "EXPIRED", "event": "TradeExpired" }
        ]
      },
      "access": {
        "read": "proposerUsername == $user.id || recipientUsername == $user.id || $user.roles.contains('Curator')",
        "write": "proposerUsername == $user.id || recipientUsername == $user.id"
      }
    },
    {
      "name": "Like",
      "ui": { "label": "Like" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "mosaicId", "type": "reference", "required": true, "ui": { "label": "Mosaic" },
          "reference": { "target": "Mosaic", "displayField": "title" } },
        { "name": "memberUsername", "type": "string", "required": true, "maxLength": 120,
          "ui": { "label": "Liked by" } }
      ],
      "indexes": [
        { "name": "ux_like_mosaic_member", "fields": ["mosaicId", "memberUsername"], "unique": true }
      ],
      "access": { "write": "memberUsername == $user.id" }
    },
    {
      "name": "Challenge",
      "ui": { "label": "Challenge" },
      "fields": [
        { "name": "id", "type": "uuid", "id": true, "required": true },
        { "name": "title", "type": "string", "required": true, "maxLength": 120, "ui": { "label": "Title" } },
        { "name": "theme", "type": "string", "required": false, "maxLength": 500, "ui": { "label": "Theme" } },
        { "name": "month", "type": "string", "required": true, "maxLength": 7, "ui": { "label": "Month (YYYY-MM)" } },
        { "name": "status", "type": "enum", "required": true, "default": "OPEN",
          "enumValues": ["OPEN", "CLOSED"], "ui": { "label": "Status" } }
      ],
      "lifecycle": {
        "statusField": "status",
        "states": [
          { "value": "OPEN", "label": "Open", "initial": true },
          { "value": "CLOSED", "label": "Closed", "terminal": true }
        ],
        "transitions": [
          { "from": "OPEN", "to": "CLOSED", "event": "ChallengeClosed", "actionLabel": "Close",
            "guard": "$user.roles.contains('Curator') || $user.id == 'system:scheduler'" }
        ]
      },
      "access": { "write": "$user.roles.contains('Curator') || $user.id == 'system:scheduler'" }
    }
  ],
  "aggregates": [
    {
      "name": "MosaicAggregate",
      "root": "Mosaic",
      "collections": [
        { "name": "cells", "concept": "MosaicCell", "childField": "mosaicId", "ownership": "owned", "orderBy": "row" }
      ]
    },
    {
      "name": "CapAggregate",
      "root": "Cap",
      "collections": []
    }
  ],
  "events": [
    { "name": "TradeAnswered", "payload": ["tradeId", "status"] },
    { "name": "TradeExpired", "payload": ["tradeId", "status"] }
  ],
  "flows": [
    {
      "name": "ProposeTrade",
      "input": { "concept": "Trade", "mode": "create" },
      "steps": [
        { "name": "save-trade", "type": "createConcept", "scope": "Trade", "input": "$input", "output": "$saved" },
        { "name": "notify-recipient", "type": "callProcedure", "procedure": "NotifyTradeRecipient",
          "input": "$saved", "output": "$notified" },
        { "name": "await-answer", "type": "awaitEvent", "awaitEvent": "TradeAnswered", "awaitRef": "answer",
          "match": { "correlation": false, "payload": { "tradeId": "$saved.id" } },
          "timeout": 604800,
          "onTimeout": [
            { "name": "expire-trade", "type": "callProcedure", "procedure": "ExpireTrade",
              "input": "$saved", "output": "$expired" }
          ] },
        { "name": "return-trade", "type": "return", "value": "$saved" }
      ]
    },
    {
      "name": "CloseMonthlyChallenges",
      "concept": "Challenge",
      "schedule": { "cron": "0 0 0 1 * *", "tenantScope": ["dev"] },
      "steps": [
        { "name": "close-open", "type": "callProcedure", "procedure": "CloseOpenChallenges",
          "input": "$input", "output": "$closed" },
        { "name": "return-closed", "type": "return", "value": "$closed" }
      ]
    }
  ],
  "procedures": [
    {
      "name": "CloseOpenChallenges",
      "description": "P7: run by the CloseMonthlyChallenges cron flow at 00:00 on the 1st of each month -- every challenge still OPEN moves to CLOSED.",
      "steps": [
        { "name": "open-challenges", "type": "runQuery", "query": "OpenChallenges", "concept": "Challenge", "target": "open" },
        { "name": "close-each", "type": "forEach", "items": "$open", "as": "challenge",
          "steps": [
            { "name": "close", "type": "patchConcept", "concept": "Challenge", "id": "$challenge.id",
              "set": { "status": "CLOSED" }, "target": "closedChallenge" }
          ] },
        { "name": "return-open", "type": "return", "value": "$open" }
      ]
    },
    {
      "name": "NotifyTradeRecipient",
      "description": "P7: stamps the recipient's username on the new trade (so the row-access rule lets them see and answer it) and emails them through the mail capability when they have an address. A procedure's capabilityCall args are passed positionally in ALPHABETICAL key order (ModelCompiler.sortObjectMap), hence the arg1_..arg4_ keys for mail.send(to, subject, body, templateVars).",
      "steps": [
        { "name": "read-recipient", "type": "readConcept", "concept": "Member", "id": "$input.recipientId", "target": "recipient" },
        { "name": "stamp-recipient", "type": "patchConcept", "concept": "Trade", "id": "$input.id",
          "set": { "recipientUsername": "$recipient.username" }, "target": "trade" },
        { "name": "has-email", "type": "if", "condition": "$recipient.email",
          "then": [
            { "name": "send-mail", "type": "capabilityCall", "capability": "mail", "operation": "send",
              "args": {
                "arg1_to": "$recipient.email",
                "arg2_subject": "Pigmentampas: new trade proposal ${code}",
                "arg3_body": "Hi! ${proposerUsername} proposed trade ${code} to you. Open Pigmentampas, Community > Trades, to accept or decline it within 7 days.",
                "arg4_templateVars": "$trade"
              },
              "target": "mailDelivery" }
          ] },
        { "name": "return-trade", "type": "return", "value": "$trade" }
      ]
    },
    {
      "name": "ExpireTrade",
      "description": "P7: the ProposeTrade flow's awaitEvent timeout path -- a trade still PROPOSED when its 7 days run out moves to EXPIRED.",
      "steps": [
        { "name": "read-trade", "type": "readConcept", "concept": "Trade", "id": "$input.id", "target": "trade" },
        { "name": "still-open", "type": "if", "condition": "$trade.status == 'PROPOSED'",
          "then": [
            { "name": "expire", "type": "patchConcept", "concept": "Trade", "id": "$input.id",
              "set": { "status": "EXPIRED" }, "target": "trade" }
          ] },
        { "name": "return-trade", "type": "return", "value": "$trade" }
      ]
    },
    {
      "name": "PaintMosaicFromPhoto",
      "description": "P5: turns the mosaic's source image into a hex mosaic -- fileStore.readImage hands the photo to the app's own Java (customCapabilities mosaicPainter), which samples each cell and picks the nearest approved cap in CIELAB; with onlyOwnedCaps it uses only caps in the owner's collection. Returns {cells}, folded into the open draft; nothing is saved until Save.",
      "steps": [
        { "name": "read-photo", "type": "capabilityCall", "capability": "fileStore", "operation": "readImage",
          "args": { "file": "$input.sourceImage" }, "target": "photo" },
        { "name": "approved-caps", "type": "runQuery", "query": "ApprovedCaps", "concept": "Cap", "target": "approvedCaps" },
        { "name": "palette", "type": "mapList", "items": "$approvedCaps", "as": "cap",
          "select": { "id": "$cap.id", "color": "$cap.dominantColor" }, "target": "palette" },
        { "name": "collection", "type": "runQuery", "query": "CollectionInStock", "concept": "CollectionItem", "target": "collection" },
        { "name": "owned", "type": "mapList", "items": "$collection", "as": "item",
          "select": { "capId": "$item.capId", "ownerUsername": "$item.ownerUsername", "quantity": "$item.quantity" }, "target": "owned" },
        { "name": "paint", "type": "capabilityCall", "capability": "mosaicPainter", "operation": "paintFromPhoto",
          "args": { "input": "$input", "owned": "$owned", "palette": "$palette", "photo": "$photo" }, "target": "painted" },
        { "name": "return-painted", "type": "return", "value": "$painted" }
      ]
    },
    {
      "name": "ExtractCapColors",
      "description": "P5: reads the cap's image and returns its dominant and accent colours (#RRGGBB) computed by the app's own Java -- deterministic, offline, no AI; folded into the open cap for review.",
      "steps": [
        { "name": "read-image", "type": "capabilityCall", "capability": "fileStore", "operation": "readImage",
          "args": { "file": "$input.image" }, "target": "photo" },
        { "name": "colours", "type": "capabilityCall", "capability": "mosaicPainter", "operation": "capColors",
          "args": { "photo": "$photo" }, "target": "colours" },
        { "name": "return-colours", "type": "return", "value": "$colours" }
      ]
    },
    {
      "name": "PaintMosaicWithAi",
      "description": "P4 (G3): reads the approved-cap palette, asks the PaintMosaic prompt for a full cell layout, and returns {cells} -- the workbench folds it into the open draft for review; nothing is saved until the member clicks Save.",
      "steps": [
        { "name": "approved-caps", "type": "runQuery", "query": "ApprovedCaps", "concept": "Cap", "target": "approvedCaps" },
        { "name": "palette", "type": "mapList", "items": "$approvedCaps", "as": "cap",
          "select": { "id": "$cap.id", "label": "$cap.label", "color": "$cap.dominantColor" }, "target": "palette" },
        { "name": "paint", "type": "capabilityCall", "capability": "externalAi", "operation": "generate",
          "args": { "prompt": "PaintMosaic", "input": "$input" }, "target": "painted" },
        { "name": "return-painted", "type": "return", "value": "$painted" }
      ]
    },
    {
      "name": "IdentifyCapWithAi",
      "description": "P4 (G3): sends the cap's image to the IdentifyCap prompt and returns suggested dominantColor/accentColor/finish/tags -- folded into the open cap for the Curator to review and save.",
      "steps": [
        { "name": "identify", "type": "capabilityCall", "capability": "externalAi", "operation": "generate",
          "args": { "prompt": "IdentifyCap", "input": "$input" }, "target": "suggestion" },
        { "name": "return-suggestion", "type": "return", "value": "$suggestion" }
      ]
    }
  ],
  "queries": [
    { "name": "ApprovedCaps", "concept": "Cap", "where": "status == 'APPROVED'", "orderBy": ["label"] },
    { "name": "OpenChallenges", "concept": "Challenge", "where": "status == 'OPEN'", "orderBy": ["month"] },
    { "name": "MostLikedMosaics", "concept": "Mosaic", "where": "status != 'DRAFT'", "orderBy": ["likeCount desc", "title"], "limit": 20 },
    { "name": "LikesPerMosaic", "concept": "Like", "groupBy": ["mosaicId.code", "mosaicId.title"],
      "aggregates": [{ "name": "likes", "fn": "count" }], "orderBy": ["likes desc"], "limit": 50 },
    { "name": "CollectionInStock", "concept": "CollectionItem", "where": "quantity > 0",
      "metadata": { "purpose": "P5 photo-to-mosaic 'only caps I own': CollectionItem's row access already limits this to the caller's rows plus others' for-trade rows; the plugin keeps the mosaic owner's." } },
    { "name": "CapsAwaitingReview", "concept": "Cap", "where": "status == 'SUBMITTED'", "orderBy": ["label"] },
    { "name": "PublishedMosaics", "concept": "Mosaic", "where": "status != 'DRAFT'", "orderBy": ["code desc"] },
    { "name": "TotalCaps", "concept": "Cap", "where": "status == 'APPROVED'",
      "aggregates": [{ "name": "total", "fn": "count" }] },
    { "name": "TotalMembers", "concept": "Member",
      "aggregates": [{ "name": "total", "fn": "count" }] },
    { "name": "TotalPublishedMosaics", "concept": "Mosaic", "where": "status != 'DRAFT'",
      "aggregates": [{ "name": "total", "fn": "count" }] },
    { "name": "TopBreweriesInMosaics", "concept": "MosaicCell", "where": "capId != null",
      "groupBy": ["capId.breweryId.name"],
      "aggregates": [{ "name": "caps", "fn": "count" }],
      "orderBy": ["caps desc"], "limit": 10 },
    { "name": "CapsNeededPerMosaic", "concept": "MosaicCell", "where": "capId != null",
      "groupBy": ["mosaicId.code", "capId.label"],
      "aggregates": [{ "name": "needed", "fn": "count" }],
      "orderBy": ["needed desc"], "limit": 500,
      "metadata": { "purpose": "The 'beers to drink' half that NPDev can express today: caps needed per mosaic. needed - owned needs a cross-concept subtraction -- friction log. Mosaic's row scope (drafts private) is pushed into the GROUP BY per caller." } }
  ],
  "autoPanels": [
    { "name": "Mosaics", "aggregate": "MosaicAggregate", "route": "/mosaics",
      "surfaces": ["selection", "detail", "transaction"],
      "selection": { "columns": ["code", "title", "ownerUsername", "rows", "cols", "status"] },
      "transaction": {
        "regions": {
          "cells": {
            "render": "cellGrid",
            "cellGrid": {
              "rowField": "row", "colField": "col", "valueField": "capId",
              "rowsField": "rows", "colsField": "cols", "defaultRows": 20, "defaultCols": 33,
              "layout": "hexOffset",
              "palette": { "query": "ApprovedCaps", "labelField": "label", "imageField": "image", "colorField": "dominantColor" }
            }
          }
        },
        "actions": [
          { "procedure": "PaintMosaicWithAi", "label": "Paint with AI", "inputFields": ["aiPrompt"],
            "visibleWhen": "$root.status == 'DRAFT'" },
          { "procedure": "PaintMosaicFromPhoto", "label": "Paint from photo",
            "visibleWhen": "$root.status == 'DRAFT'" }
        ]
      } },
    { "name": "Collection", "concept": "CollectionItem", "route": "/collection",
      "surfaces": ["selection", "detail", "transaction"] },
    { "name": "Caps", "aggregate": "CapAggregate", "route": "/caps",
      "surfaces": ["selection", "detail", "transaction"],
      "selection": { "columns": ["image", "label", "breweryId", "dominantColor", "finish", "rarity", "status"] },
      "transaction": {
        "actions": [
          { "procedure": "IdentifyCapWithAi", "label": "Identify with AI",
            "visibleWhen": "$root.status == 'SUBMITTED'" },
          { "procedure": "ExtractCapColors", "label": "Read colours from image" }
        ]
      } },
    { "name": "Breweries", "concept": "Brewery", "route": "/breweries",
      "surfaces": ["selection", "detail", "transaction"] },
    { "name": "Members", "concept": "Member", "route": "/members",
      "surfaces": ["selection", "detail", "transaction"] }
  ],
  "documents": [
    {
      "name": "MosaicAssemblySheet",
      "concept": "Mosaic",
      "aggregate": "MosaicAggregate",
      "title": "Mosaic assembly sheet",
      "pageSize": "A4",
      "marginMm": 15,
      "bands": [
        { "name": "header", "kind": "header", "label": "Mosaic",
          "fields": [
            { "field": "code", "ui": { "label": "Code" } },
            { "field": "title", "ui": { "label": "Title" } },
            { "field": "rows", "ui": { "label": "Rows" } },
            { "field": "cols", "ui": { "label": "Columns" } }
          ] },
        { "name": "cells", "kind": "lineItems", "collection": "cells", "label": "Cells, row by row",
          "fields": [
            { "field": "row", "ui": { "label": "Row" } },
            { "field": "col", "ui": { "label": "Col" } },
            { "field": "capId", "ui": { "label": "Cap" } }
          ] }
      ]
    }
  ],
  "guidePages": [
    {
      "name": "Dashboard",
      "default": true,
      "theme": { "mode": "light", "accent": "#b5651d", "logoText": "Pigmentampas", "density": "comfortable" },
      "gadgets": [
        { "name": "kpiCaps", "type": "kpi", "title": "Caps catalogued", "query": "TotalCaps", "y": "total" },
        { "name": "kpiMosaics", "type": "kpi", "title": "Mosaics published", "query": "TotalPublishedMosaics", "y": "total" },
        { "name": "kpiMembers", "type": "kpi", "title": "Members", "query": "TotalMembers", "y": "total" },
        { "name": "topBreweries", "type": "bar", "title": "Top breweries in mosaics", "query": "TopBreweriesInMosaics", "x": "capId.breweryId.name", "y": "caps" },
        { "name": "capsNeeded", "type": "table", "title": "Caps needed per mosaic", "query": "CapsNeededPerMosaic" }
      ]
    }
  ],
