{
  "schema": "npdev-support-intents.v1",
  "description": "What the user was trying to do, in plain language, for every Manager operation that can fail. The support report quotes `intent` verbatim, so a stranger's AI knows the goal before it reads the log. `operation` is the id the Rust run recorder stores; `commands` are the #[tauri::command] names in NPDevManager/src/main.rs that record under it (verified 2026-10-31 against main.rs at fc4ff17e). `glossary` links to help-glossary.json ids. `label` is the short, plain name Home's activity list shows (en/pt).",
  "intents": [
    {
      "operation": "install-java",
      "intent": "install Java (JDK 17), the runtime generated apps run on",
      "commands": [
        "install_jdk"
      ],
      "glossary": [
        "java"
      ],
      "commonCauses": [
        "no internet or a proxy blocks the download",
        "antivirus quarantined the archive",
        "no write permission to the install folder"
      ],
      "label": {
        "en": "Install Java",
        "pt": "Instalar o Java"
      }
    },
