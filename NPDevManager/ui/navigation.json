{
  "schema": "npdev-manager-navigation.v1",
  "description": "The Manager's navigation as data (NAV-1). nav.js renders the main bar and each place's strip of screens from this file; nothing indexes screens by position. Every <section id=\"screen-X\"> in index.html must be reached from at least one place -- there is no developer mode (owner decision D5, 2026-11-03), so a screen missing here is a screen nobody can open. main.rs's `every_screen_is_reachable_from_the_navigation` test enforces that. Every user-visible string is an object keyed by language id; a language missing from one string falls back to English.",
  "languages": [
    { "id": "en", "label": "English" },
    { "id": "pt", "label": "Português" }
  ],
  "places": [
    {
      "id": "home",
      "icon": "⌂",
      "label": { "en": "Home", "pt": "Início" },
      "summary": {
        "en": "What to do next, in one card.",
        "pt": "O que fazer a seguir, num cartão só."
      },
      "screens": [
        { "screen": "home", "label": { "en": "Home", "pt": "Início" } }
      ]
    },
    {
      "id": "setup",
      "showWhen": "machineNotReady",
      "icon": "🔧",
      "label": { "en": "Set up", "pt": "Preparar" },
      "summary": {
        "en": "Get this computer ready to build apps. You do this once.",
        "pt": "Deixe este computador pronto para criar apps. Você faz isso uma vez só."
      },
      "screens": [
        { "screen": "ready", "label": { "en": "Check my computer", "pt": "Verificar o computador" } },
        { "screen": "install", "label": { "en": "Install what is missing", "pt": "Instalar o que falta" } }
      ]
    },
    {
      "id": "apps",
      "icon": "▦",
      "label": { "en": "My apps", "pt": "Meus apps" },
      "summary": {
        "en": "Create an app, start it, change it, share it.",
        "pt": "Crie um app, inicie, altere e compartilhe."
      },
      "screens": [
        { "screen": "apps", "label": { "en": "All apps", "pt": "Todos os apps" } },
        { "screen": "run", "label": { "en": "Start & stop", "pt": "Iniciar e parar" }, "workspace": true },
        { "screen": "studio", "label": { "en": "Edit", "pt": "Editar" }, "workspace": true },
        { "screen": "prompter", "label": { "en": "Ask AI", "pt": "Perguntar à IA" }, "workspace": true },
        { "screen": "dbio", "label": { "en": "Data", "pt": "Dados" }, "workspace": true },
        { "screen": "hosting", "label": { "en": "Share", "pt": "Compartilhar" }, "workspace": true },
        { "screen": "scrap", "label": { "en": "Browser checks", "pt": "Testes no navegador" }, "group": "checks", "workspace": true },
        { "screen": "gpuchecks", "label": { "en": "Data-rule checks", "pt": "Testes de regras" }, "group": "checks", "workspace": true },
        { "screen": "provenance", "label": { "en": "Impact", "pt": "Impacto" }, "group": "advanced", "workspace": true },
        { "screen": "packs", "label": { "en": "Packs", "pt": "Pacotes" }, "group": "advanced", "workspace": true }
      ]
    },
    {
      "id": "activity",
      "icon": "◉",
      "label": { "en": "Activity", "pt": "Atividade" },
      "summary": {
        "en": "Everything running on this computer, at a glance.",
        "pt": "Tudo o que está rodando neste computador, num relance."
      },
      "screens": [
        { "screen": "monitor", "label": { "en": "Running apps", "pt": "Apps em execução" } },
        { "screen": "jobs", "label": { "en": "Tasks", "pt": "Tarefas" } }
      ]
    },
    {
      "id": "settings",
      "icon": "⚙",
      "label": { "en": "Settings", "pt": "Configurações" },
      "summary": {
        "en": "AI providers, passwords, NPDev versions. You set these once.",
        "pt": "Provedores de IA, senhas, versões do NPDev. Você ajusta isso uma vez."
      },
      "screens": [
        { "screen": "providers", "label": { "en": "AI providers", "pt": "Provedores de IA" } },
        { "screen": "secrets", "label": { "en": "Passwords & keys", "pt": "Senhas e chaves" } },
        { "screen": "appearance", "label": { "en": "Appearance & accessibility", "pt": "Aparência e acessibilidade" } },
        { "screen": "versions", "label": { "en": "NPDev versions", "pt": "Versões do NPDev" } },
        { "screen": "ready", "label": { "en": "This computer", "pt": "Este computador" }, "showWhen": "machineReady" },
        { "screen": "install", "label": { "en": "Install & folders", "pt": "Instalação e pastas" }, "showWhen": "machineReady" },
        { "screen": "verification", "label": { "en": "Platform checks", "pt": "Verificações da plataforma" }, "group": "advanced" },
        { "screen": "evals", "label": { "en": "AI evaluations", "pt": "Avaliações de IA" }, "group": "advanced" }
      ]
    }
  ],
  "homeDecisions": [
    {
      "when": "doctorNeverRun",
      "card": { "en": "Let's check your computer", "pt": "Vamos verificar o seu computador" },
      "detail": {
        "en": "NPDev needs Java and a few other things. One click finds out what is already there.",
        "pt": "O NPDev precisa de Java e de mais algumas coisas. Um clique descobre o que já existe."
      },
      "action": { "screen": "ready", "label": { "en": "Check now", "pt": "Verificar agora" } }
    },
    {
      "when": "doctorHasFailures",
      "card": {
        "en": "{n} things are missing before you can build apps",
        "pt": "Faltam {n} coisas para você poder criar apps"
      },
      "detail": {
        "en": "The next screen installs them for you; nothing else on your computer is touched.",
        "pt": "A próxima tela instala tudo para você; nada mais no seu computador é alterado."
      },
      "action": { "screen": "install", "label": { "en": "Install them", "pt": "Instalar" } }
    },
    {
      "when": "noApps",
      "card": {
        "en": "Your computer is ready. Create your first app",
        "pt": "Seu computador está pronto. Crie o seu primeiro app"
      },
      "detail": {
        "en": "Give it a name and pick where to keep it. You can change everything later.",
        "pt": "Dê um nome e escolha onde guardá-lo. Você pode mudar tudo depois."
      },
      "action": { "screen": "apps", "intent": "create", "label": { "en": "Create an app", "pt": "Criar um app" } }
    },
    {
      "when": "lastOperationFailed",
      "card": { "en": "Something went wrong: {operation}", "pt": "Algo deu errado: {operation}" },
      "detail": {
        "en": "One button prepares a report you can paste into any AI chat. Nothing is sent for you.",
        "pt": "Um botão prepara um relatório que você cola em qualquer chat de IA. Nada é enviado por você."
      },
      "action": { "kind": "supportReport", "label": { "en": "Get help with this error", "pt": "Pedir ajuda com este erro" } }
    },
    {
      "when": "appsAllStopped",
      "card": { "en": "{app} is stopped", "pt": "{app} está parado" },
      "action": { "workspace": "overview", "label": { "en": "Start it", "pt": "Iniciar" } }
    },
    {
      "when": "appRunning",
      "card": { "en": "{app} is running at {url}", "pt": "{app} está rodando em {url}" },
      "action": { "kind": "openUrl", "label": { "en": "Open it", "pt": "Abrir" } }
    }
  ],
  "groups": {
    "checks": { "en": "Checks", "pt": "Testes" },
    "advanced": { "en": "Advanced", "pt": "Avançado" }
  },
  "fixTargets": {
    "description": "Ready's Fix button: which step of the Install screen repairs a failing check, as the CSS selector of the step's own button. A check not listed here has no automatic fix and shows no button.",
    "label": { "en": "Fix", "pt": "Corrigir" },
    "checks": {
      "java-present": "#jdk-install-btn",
      "java-version": "#jdk-install-btn",
      "java-home-agreement": "#jdk-install-btn",
      "python-version": "#python-install-btn",
      "runtimehost-jars": "#setup-run-btn",
      "ai-knowledge-index": "#setup-run-btn"
    }
  },
  "chrome": {
    "skipToContent": { "en": "Skip to content", "pt": "Pular para o conteúdo" },
    "language": { "en": "Language", "pt": "Idioma" },
    "mainNav": { "en": "Main", "pt": "Principal" }
  }
}
