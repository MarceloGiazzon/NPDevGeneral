{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NPDev Manager",
  "version": "0.1.0",
  "identifier": "com.npdev.manager",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NPDev Manager",
        "width": 1080,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/_ops/exploration-runs/blobs/*",
          "**/npdev-explorations/**/blobs/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
