NPDev_General__OutsideRepo/
ai-times-workbench/
# Required Gradle wrapper artifacts for CI
!**/gradle/wrapper/gradle-wrapper.jar
!**/gradlew
!**/gradlew.bat
# Local rebuildable caches and generated sample outputs
/.npdev-gradle/
/.npdev-cache/
/NPDevSamples/**/Output/


# Do not ignore Java source packages named output
!/NPDevGenerator/generator/src/main/java/com/npdev/generator/output/
!/NPDevGenerator/generator/src/main/java/com/npdev/generator/output/**







# Generated evidence and local script caches
/scripts/reports/

# Local Claude Code session state (auto-accumulated permission log, not shared config).
# Ignore everything under .claude/ EXCEPT shared, tracked project skills.
.claude/*
!.claude/skills/
**/__pycache__/



