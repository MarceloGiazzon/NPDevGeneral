// Template only. NPDevGenerator materializes this file as build.gradle in an assembled FinalExec app.
// Do not build directly from NPDevRuntimeHost; build from the generated final app root.

import groovy.json.JsonSlurper

plugins {
    id 'org.springframework.boot' version '3.3.2'
    id 'io.spring.dependency-management' version '1.1.6'
    id 'java'
    id 'org.flywaydb.flyway' version '10.10.0'
}

group = 'com.finalexec'
version = '0.1.0'

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(17)
    }
}

repositories {
    mavenCentral()
}

def resolveNpdevRuntimeLibsDir = {
    def configured = providers.gradleProperty('npdevRuntimeHostLibsDir')
            .orElse(providers.environmentVariable('NPDEV_RUNTIMEHOST_LIBS_DIR'))
            .orNull
    if (configured != null && !configured.toString().trim().isEmpty()) {
        return file(configured.toString().trim())
    }

    def current = projectDir
    while (current != null) {
        if (new File(current, '.npdev-root').isFile()) {
            return new File(current.parentFile, "${current.name}__OutsideRepo/runtimehost-libs")
        }
        current = current.parentFile
    }

    return file("${rootProject.projectDir.name}__OutsideRepo/runtimehost-libs")
}

def npdevRuntimeHostLibsDir = resolveNpdevRuntimeLibsDir()

dependencies {
    implementation 'org.springframework.boot:spring-boot-starter-web'
    implementation 'org.springframework.boot:spring-boot-starter-data-jpa'
    implementation 'org.springframework.boot:spring-boot-starter-thymeleaf'

    implementation 'org.flywaydb:flyway-core'
    implementation 'org.flywaydb:flyway-database-postgresql'
    implementation 'org.postgresql:postgresql:42.7.4'

    implementation 'org.springframework.boot:spring-boot-starter-actuator'
    implementation 'com.networknt:json-schema-validator:1.5.6'

    testImplementation 'org.springframework.boot:spring-boot-starter-test'
    testImplementation 'com.tngtech.archunit:archunit-junit5:1.3.0'
    testImplementation 'org.testcontainers:junit-jupiter:1.19.0'
    testImplementation 'org.testcontainers:postgresql:1.19.0'
    testImplementation 'org.springframework.boot:spring-boot-testcontainers'
    testImplementation 'org.awaitility:awaitility:4.2.0'
    runtimeOnly 'com.h2database:h2'
    testRuntimeOnly 'com.h2database:h2'

    // Runtime extension jars are staged outside the source/evidence workspace.
    implementation fileTree(dir: npdevRuntimeHostLibsDir, include: ['*.jar'])
}

tasks.register('verifyNpdevRuntimeHostLibs') {
    group = 'verification'
    description = 'Checks that local RuntimeHost jars were staged outside the workspace before compilation.'

    doLast {
        def requiredJars = ['dsl-0.1.0.jar', 'kernel-0.1.0.jar', 'expression-cel-0.1.0.jar']
        def missing = requiredJars.findAll { !new File(npdevRuntimeHostLibsDir, it).isFile() }
        if (!missing.isEmpty()) {
            throw new GradleException("Missing NPDev RuntimeHost jars in ${npdevRuntimeHostLibsDir}: ${missing}. Run scripts/runtimehost/sync-runtimehost-libs.ps1 -BuildLocalJars.")
        }
    }
}

tasks.named('compileJava') {
    dependsOn tasks.named('verifyNpdevRuntimeHostLibs')
}

