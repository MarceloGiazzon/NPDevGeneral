def resolveNpdevRuntimeLibsDir = {
    def configured = providers.gradleProperty('npdevRuntimeHostLibsDir')
            .orElse(providers.environmentVariable('NPDEV_RUNTIMEHOST_LIBS_DIR'))
            .orNull
    if (configured != null && !configured.toString().trim().isEmpty()) {
        return file(configured.toString().trim())
    }

    def current = projectDir
    while (current != null) {
        if (new File(current, '.npdev-root').isFile()) {
            return new File(current.parentFile, "${current.name}__OutsideRepo/runtimehost-libs")
        }
        current = current.parentFile
    }

    return file("${rootProject.projectDir.name}__OutsideRepo/runtimehost-libs")
}

def npdevRuntimeHostLibsDir = resolveNpdevRuntimeLibsDir()
def javaSourceRoot = file('src/main/java').canonicalFile
def testJavaSourceRoot = file('src/test/java').canonicalFile
def generatedRuntimeRequiredFiles = [
        'npdev-generated/src/main/java/com/npdev/generated/runtime/service/RuntimeContextService.java',
        'npdev-generated/src/main/java/com/npdev/generated/runtime/service/KernelFacade.java',
        'npdev-generated/src/main/java/com/npdev/generated/runtime/config/RuntimeApiKeyAuthFilter.java'
]

def generatedRuntimeMountPresent = {
    generatedRuntimeRequiredFiles.every { file(it).isFile() }
}

def relativeJavaSourcePath = { File root, File sourceFile ->
    sourceFile.canonicalPath
            .substring(root.path.length() + 1)
            .replace(File.separator, '/')
}

