def runtimeSurfaceManifest = new JsonSlurper().parse(file('src/main/resources/npdev/runtime-supported-controllers.json'))
def supportedCoreControllerNames = (runtimeSurfaceManifest.allowedControllers ?: []).collect { it.toString().trim() }.findAll { !it.isEmpty() }
def supportedCoreServiceNames = (runtimeSurfaceManifest.supportedCoreServiceComponents ?: []).collect { it.toString().trim() }.findAll { !it.isEmpty() }
def supportedCoreServicePatterns = (runtimeSurfaceManifest.supportedCoreServicePatterns ?: []).collect { it.toString().trim() }.findAll { !it.isEmpty() }

def toRelativeSourcePath = { File sourceFile ->
    relativeJavaSourcePath(javaSourceRoot, sourceFile)
}

def generatedRuntimeDependentMainSources = fileTree('src/main/java') {
    include '**/*.java'
}.files.findAll { sourceFile ->
    sourceFile.text.contains('com.npdev.generated.')
}.collect(toRelativeSourcePath)

def generatedRuntimeDependentTestSources = fileTree('src/test/java') {
    include '**/*.java'
}.files.findAll { sourceFile ->
    sourceFile.text.contains('com.npdev.generated.')
}.collect { sourceFile -> relativeJavaSourcePath(testJavaSourceRoot, sourceFile) }

/**
 * Move 11 W1. Tests that reference a MAIN class which is itself excluded when the generated-runtime
 * mount is absent. Those tests contain no `com.npdev.generated.` text of their own, so
 * generatedRuntimeDependentTestSources cannot see them -- they simply fail compileTestJava with
 * "cannot find symbol", breaking `gradlew test` for the whole bare template (the documented
 * GATE-H2/GATE-PG workflow in docs/SCHEMA_ENGINE_REBUILD_PLAN.md).
 *
 * This was previously a hand-maintained list of two names below. It went stale the moment Panel/
 * Workbench runtime tests were added (6 files, none listed), and a hand-list of a transitively
 * DERIVABLE fact will go stale again. So derive it: any test source naming an excluded main class,
 * matched on the class's simple name at a word boundary. Deliberately conservative in the
 * over-exclusion direction -- this applies ONLY when the mount is absent, and the assembled-app gate
 * (mount present, run-runtimehost-gate.ps1) compiles and runs every one of them exactly as before.
 */
def excludedMainSimpleNames = generatedRuntimeDependentMainSources
        .collect { it.tokenize('/').last().replace('.java', '') }
        .toSet()

def testsReferencingExcludedMainSources = fileTree('src/test/java') {
    include '**/*.java'
}.files.findAll { sourceFile ->
    String text = sourceFile.text
    excludedMainSimpleNames.any { simpleName -> text =~ /\b${java.util.regex.Pattern.quote(simpleName)}\b/ }
}.collect { sourceFile -> relativeJavaSourcePath(testJavaSourceRoot, sourceFile) }

def matchesSupportedPattern = { String simpleName, List<String> patterns ->
    patterns.any { pattern ->
        StringBuilder regex = new StringBuilder()
        pattern.each { ch ->
            if (ch == '*') {
                regex.append('.*')
            } else {
                regex.append(java.util.regex.Pattern.quote(String.valueOf(ch)))
            }
        }
        simpleName ==~ regex.toString()
    }
}

def unsupportedRuntimeHostControllerSources = fileTree('src/main/java/com/finalexec/api') {
    include '**/*Controller.java'
}.files.collect(toRelativeSourcePath)
        .findAll { sourcePath ->
            String simpleName = sourcePath.tokenize('/').last().replace('.java', '')
            !supportedCoreControllerNames.contains(simpleName)
        }

def unsupportedRuntimeHostServiceSources = fileTree('src/main/java/com/finalexec/npdev/service') {
    include '**/*.java'
}.files.collect(toRelativeSourcePath)
        .findAll { sourcePath ->
            String simpleName = sourcePath.tokenize('/').last().replace('.java', '')
            !supportedCoreServiceNames.contains(simpleName) &&
                    !matchesSupportedPattern(simpleName, supportedCoreServicePatterns)
        }

sourceSets {
    main {
        java {
            srcDir 'src/main/java'
            srcDir 'npdev-generated/src/main/java'
            exclude 'com/finalexec/HelloController.java'
            unsupportedRuntimeHostControllerSources.each { exclude it }
            unsupportedRuntimeHostServiceSources.each { exclude it }
            if (!generatedRuntimeMountPresent()) {
                generatedRuntimeDependentMainSources.each { exclude it }
            }
        }
        resources {
            srcDir 'src/main/resources'
            srcDir 'npdev-generated/src/main/resources'
        }
    }
    test {
        java {
            modelSpecificGeneratedAppTests.each { exclude it }
            generatedRuntimeDependentTestSources.each { exclude it }
            // LNCH-1 Phase 7 (task 7.2): Docker-dependent (Testcontainers Postgres) -- must not run,
            // or even compile, as part of the plain `test` task (no com.npdev.generated. reference,
            // so generatedRuntimeDependentTestSources' auto-exclusion would not otherwise catch it;
            // see generatedRuntimeIntegrationTestSources above for the integrationTest inclusion).
            // Docker-dependent (Testcontainers Postgres): excluded from the default `test` so a plain
            // run never needs Docker. It is mount-INDEPENDENT (pure schema-lifecycle, no generated
            // runtime), so it can be run directly against a bare template on demand via
            // `-PincludePostgresMatrix` -- this is GATE-PG in docs/SCHEMA_ENGINE_REBUILD_PLAN.md:
            //   gradlew test --tests com.finalexec.db.SchemaLifecycleExecutorPostgresProofMatrixTest -PincludePostgresMatrix
            if (!providers.gradleProperty('includePostgresMatrix').present) {
                exclude 'com/finalexec/db/SchemaLifecycleExecutorPostgresProofMatrixTest.java'
                // Same rule for the schema-engine-rebuild Postgres golden tests (Testcontainers):
                // excluded from the default `test`, included on demand via -PincludePostgresMatrix.
                exclude 'com/finalexec/db/schemastate/CurrentSchemaReaderPostgresTest.java'
                // SER-P7.5: the conversion-hook Postgres twin (Testcontainers) -- same rule.
                exclude 'com/finalexec/db/ConversionHookRunnerPostgresTest.java'
                // Move 9 A4: the H2->Postgres data-promotion proof -- same rule (real Testcontainers
                // Postgres container, must not run or compile as part of the plain `test` task).
                exclude 'com/finalexec/db/CrossEngineDataPromotionTest.java'
            }
            // Tests that exercise MAIN classes excluded when the generated-runtime mount is absent (a
            // bare-template checkout, e.g. running GATE-H2/GATE-PG directly per
            // docs/SCHEMA_ENGINE_REBUILD_PLAN.md). They contain no com.npdev.generated. text, so the
            // generatedRuntimeDependentTestSources heuristic above cannot catch them, and they fail
            // compileTestJava with "cannot find symbol" -- a transitive-dependency gap the text heuristic
            // can't see. Excluded ONLY when the mount is absent, so the assembled-app gate (mount present)
            // still compiles and runs them exactly as before.
            if (!generatedRuntimeMountPresent()) {
                // Derived (Move 11 W1) -- see testsReferencingExcludedMainSources above.
                testsReferencingExcludedMainSources.each { exclude it }
                // Second-order, and therefore NOT derivable from the rule above: these two name main
                // classes that are themselves fine, but which transitively import an excluded one
                // (ConceptQueryController -> RuntimeContextService; ActuatorAdminGuardFilter).
                exclude 'com/finalexec/api/ConceptQueryControllerTest.java'
                exclude 'com/finalexec/config/ActuatorAdminGuardFilterTest.java'
            }
        }
    }
    integrationTest {
        java {
            srcDir 'src/test/java'
            generatedRuntimeIntegrationTestSources.each { include it }
        }
        resources {
            srcDir 'src/test/resources'
        }
        compileClasspath += sourceSets.main.output + sourceSets.test.output + configurations.testRuntimeClasspath
        runtimeClasspath += output + compileClasspath
    }
}

