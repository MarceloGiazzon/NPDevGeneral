// Template only. NPDevGenerator materializes this file as build.gradle in an assembled FinalExec app.
// Do not build directly from NPDevRuntimeHost; build from the generated final app root.

import groovy.json.JsonSlurper

plugins {
    id 'org.springframework.boot' version '3.3.2'
    id 'io.spring.dependency-management' version '1.1.6'
    id 'java'
    id 'org.flywaydb.flyway' version '10.10.0'
}

group = 'com.finalexec'
version = '0.1.0'

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(17)
    }
}

repositories {
    mavenCentral()
}

def resolveNpdevRuntimeLibsDir = {
    // REG-137: NPDEV_RUNTIMEHOST_LIBS_DIR is checked BEFORE the gradle property on purpose.
    // FinalAppAssembler#appendRuntimeHostLibsDirDefault (REG-128) always bakes a resolved
    // npdevRuntimeHostLibsDir into every generated app's gradle.properties at generation time --
    // if gradleProperty were checked first, that baked-in generation-time value would permanently
    // shadow a build-time env var override (e.g. a test pointing bootJar at its own freshly-built
    // jar set), since providers.gradleProperty() reads the file with no way to tell "explicit -P"
    // apart from "value came from the properties file". Checking the env var first restores that
    // override path. An explicit -PnpdevRuntimeHostLibsDir=... still wins whenever no env var is
    // set (it feeds this same gradleProperty() call); the only case this reorders is the unusual
    // one where both an env var AND -P are set simultaneously, which no caller in this repo does.
    def configured = providers.environmentVariable('NPDEV_RUNTIMEHOST_LIBS_DIR')
            .orElse(providers.gradleProperty('npdevRuntimeHostLibsDir'))
            .orNull
    if (configured != null && !configured.toString().trim().isEmpty()) {
        return file(configured.toString().trim())
    }

    // REG-128: a freshly-assembled app has npdevRuntimeHostLibsDir baked into its OWN
    // gradle.properties by FinalAppAssembler#appendRuntimeHostLibsDirDefault, so the first
    // branch above already covers the normal case -- everything below is a last-resort fallback
    // for an app assembled before that existed, or with gradle.properties hand-edited away.
    def current = projectDir
    while (current != null) {
        if (new File(current, '.npdev-root').isFile()) {
            // Matches scripts/npdev-common.ps1's Get-NPDevRuntimeHostLibsDir convention
            // (<repo's parent>/Build/runtimehost-libs) -- NOT the old __OutsideRepo path, which
            // sync-runtimehost-libs.ps1/Build-NpdevApp.ps1 stopped writing to after LC-C4/Wave 1.4.
            return new File(current.parentFile, "Build/runtimehost-libs")
        }
        current = current.parentFile
    }

    return file("${rootProject.projectDir.name}__OutsideRepo/runtimehost-libs")
}

