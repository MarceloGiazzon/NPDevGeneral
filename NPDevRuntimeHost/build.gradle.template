def runtimeSurfaceManifest = new JsonSlurper().parse(file('src/main/resources/npdev/runtime-supported-controllers.json'))
def supportedCoreControllerNames = (runtimeSurfaceManifest.allowedControllers ?: []).collect { it.toString().trim() }.findAll { !it.isEmpty() }
def supportedCoreServiceNames = (runtimeSurfaceManifest.supportedCoreServiceComponents ?: []).collect { it.toString().trim() }.findAll { !it.isEmpty() }
def supportedCoreServicePatterns = (runtimeSurfaceManifest.supportedCoreServicePatterns ?: []).collect { it.toString().trim() }.findAll { !it.isEmpty() }

def toRelativeSourcePath = { File sourceFile ->
    relativeJavaSourcePath(javaSourceRoot, sourceFile)
}

def generatedRuntimeDependentMainSources = fileTree('src/main/java') {
    include '**/*.java'
}.files.findAll { sourceFile ->
    sourceFile.text.contains('com.npdev.generated.')
}.collect(toRelativeSourcePath)

def generatedRuntimeDependentTestSources = fileTree('src/test/java') {
    include '**/*.java'
}.files.findAll { sourceFile ->
    sourceFile.text.contains('com.npdev.generated.')
}.collect { sourceFile -> relativeJavaSourcePath(testJavaSourceRoot, sourceFile) }

def matchesSupportedPattern = { String simpleName, List<String> patterns ->
    patterns.any { pattern ->
        StringBuilder regex = new StringBuilder()
        pattern.each { ch ->
            if (ch == '*') {
                regex.append('.*')
            } else {
                regex.append(java.util.regex.Pattern.quote(String.valueOf(ch)))
            }
        }
        simpleName ==~ regex.toString()
    }
}

def unsupportedRuntimeHostControllerSources = fileTree('src/main/java/com/finalexec/api') {
    include '**/*Controller.java'
}.files.collect(toRelativeSourcePath)
        .findAll { sourcePath ->
            String simpleName = sourcePath.tokenize('/').last().replace('.java', '')
            !supportedCoreControllerNames.contains(simpleName)
        }

def unsupportedRuntimeHostServiceSources = fileTree('src/main/java/com/finalexec/npdev/service') {
    include '**/*.java'
}.files.collect(toRelativeSourcePath)
        .findAll { sourcePath ->
            String simpleName = sourcePath.tokenize('/').last().replace('.java', '')
            !supportedCoreServiceNames.contains(simpleName) &&
                    !matchesSupportedPattern(simpleName, supportedCoreServicePatterns)
        }

sourceSets {
    main {
        java {
            srcDir 'src/main/java'
            srcDir 'npdev-generated/src/main/java'
            exclude 'com/finalexec/HelloController.java'
            unsupportedRuntimeHostControllerSources.each { exclude it }
            unsupportedRuntimeHostServiceSources.each { exclude it }
            if (!generatedRuntimeMountPresent()) {
                generatedRuntimeDependentMainSources.each { exclude it }
            }
        }
        resources {
            srcDir 'src/main/resources'
            srcDir 'npdev-generated/src/main/resources'
        }
    }
    test {
        java {
            modelSpecificGeneratedAppTests.each { exclude it }
            generatedRuntimeDependentTestSources.each { exclude it }
        }
    }
    integrationTest {
        java {
            srcDir 'src/test/java'
            generatedRuntimeIntegrationTestSources.each { include it }
        }
        resources {
            srcDir 'src/test/resources'
        }
        compileClasspath += sourceSets.main.output + sourceSets.test.output + configurations.testRuntimeClasspath
        runtimeClasspath += output + compileClasspath
    }
}

configurations {
    integrationTestImplementation.extendsFrom testImplementation
    integrationTestRuntimeOnly.extendsFrom testRuntimeOnly
}

tasks.register('reportRuntimeSupportedSurface') {
    group = 'verification'
    description = 'Prints the supported-core RuntimeHost source allowlist used for packaging.'

    doLast {
        println "Allowed supported-core controllers: ${supportedCoreControllerNames.sort(false)}"
        println "Supported-core service components: ${supportedCoreServiceNames.sort(false)}"
        println "Supported-core service patterns: ${supportedCoreServicePatterns.sort(false)}"
        println "Excluded controller sources: ${unsupportedRuntimeHostControllerSources.sort(false)}"
        println "Excluded service sources: ${unsupportedRuntimeHostServiceSources.sort(false)}"
    }
}

/**
 * Runtime resource policy:
 * - application.* must come only from src/main/resources
 * - generated resources may provide npdev metadata/static assets/templates
 * - runtime schema-realization SQL comes from db/schema-realization
 * - schema-realization analysis artifacts must never go into runtime classpath
 * - stateful upgrade management remains unsupported in the generated app
 */
tasks.named('processResources', Copy) {
    duplicatesStrategy = DuplicatesStrategy.EXCLUDE

    doFirst {
        delete(destinationDir)
    }

    // Generated resources first, including generated schema-realization artifacts.
    from('npdev-generated/src/main/resources') {
        exclude('**/application.yml')
        exclude('**/application.yaml')
        exclude('**/application.properties')
        exclude('db/schema-snapshots/**')
    }

    // Handwritten resources last and authoritative.
    from('src/main/resources') {
        exclude('db/schema-snapshots/**')
    }
}

tasks.register('enforceSingleSchemaRealizationSource') {
    group = 'verification'
    description = 'Ensures generated apps contain schema-realization artifacts.'

    doLast {
        def migrationJars = fileTree(dir: 'libs', include: ['npdev-migrations-*.jar']).files
        if (!migrationJars.isEmpty()) {
            throw new GradleException(
                    "Schema-realization helper jar(s) found in libs/: ${migrationJars}. " +
                        "Canonical runtime source is src/main/resources/db/schema-realization, so stateful upgrade tooling must not be packaged into FinalExec."
            )
        }

        File realizationDir = file('npdev-generated/src/main/resources/db/schema-realization')
        if (!realizationDir.exists()) {
            throw new GradleException(
                    "Generated schema-realization directory not found: ${realizationDir}"
            )
        }

        def realizationFiles = fileTree(realizationDir).matching {
            include('**/*.sql')
            include('**/*.json')
        }.files

        if (realizationFiles.isEmpty()) {
            throw new GradleException(
                    "No generated schema-realization artifacts found in ${realizationDir}"
            )
        }

        println "Generated schema-realization source: npdev-generated/src/main/resources/db/schema-realization"
        println "Generated schema-realization artifacts found: ${realizationFiles.size()}"
    }
}

tasks.named('bootRun') {
    dependsOn 'enforceSingleSchemaRealizationSource'
}

tasks.named('test') {
    dependsOn 'enforceSingleSchemaRealizationSource'
    useJUnitPlatform()
    def activeProfiles = providers.gradleProperty('spring.profiles.active')
            .orElse(providers.environmentVariable('SPRING_PROFILES_ACTIVE'))
            .orNull
    if (activeProfiles != null && !activeProfiles.toString().trim().isEmpty()) {
        systemProperty 'spring.profiles.active', activeProfiles.toString().trim()
    }
    if (System.getProperty('os.name', '').toLowerCase().contains('win')
            && System.getenv('DOCKER_HOST') == null) {
        environment 'DOCKER_HOST', 'npipe:////./pipe/dockerDesktopLinuxEngine'
        systemProperty 'docker.host', 'npipe:////./pipe/dockerDesktopLinuxEngine'
        systemProperty 'docker.client.strategy', 'org.testcontainers.dockerclient.NpipeSocketClientProviderStrategy'
    }
}

tasks.register('verifyGeneratedRuntimeMount') {
    group = 'verification'
    description = 'Fails clearly when the generated runtime mount required by integrationTest is missing.'

    doLast {
        def missing = generatedRuntimeRequiredFiles.findAll { !file(it).isFile() }
        if (!missing.isEmpty()) {
            throw new GradleException(
                    "generated-runtime-mount missing: integrationTest requires generated runtime sources under npdev-generated. " +
                            "Missing required file(s): ${missing}. Generate a final app with NPDevGenerator, then run ./gradlew integrationTest from the generated app root."
            )
        }
    }
}

tasks.register('integrationTest', Test) {
    group = 'verification'
    description = 'Runs generated-runtime-dependent RuntimeHost integration tests.'
    testClassesDirs = sourceSets.integrationTest.output.classesDirs
    classpath = sourceSets.integrationTest.runtimeClasspath
    shouldRunAfter tasks.named('test')
    dependsOn tasks.named('verifyGeneratedRuntimeMount')
    useJUnitPlatform {
        includeTags 'integration'
    }
    def activeProfiles = providers.gradleProperty('spring.profiles.active')
            .orElse(providers.environmentVariable('SPRING_PROFILES_ACTIVE'))
            .orElse('test,postgres')
            .get()
    systemProperty 'spring.profiles.active', activeProfiles.toString().trim()
    if (System.getProperty('os.name', '').toLowerCase().contains('win')
            && System.getenv('DOCKER_HOST') == null) {
        environment 'DOCKER_HOST', 'npipe:////./pipe/dockerDesktopLinuxEngine'
        systemProperty 'docker.host', 'npipe:////./pipe/dockerDesktopLinuxEngine'
        systemProperty 'docker.client.strategy', 'org.testcontainers.dockerclient.NpipeSocketClientProviderStrategy'
    }
}

tasks.named('compileIntegrationTestJava') {
    dependsOn tasks.named('verifyGeneratedRuntimeMount')
}

tasks.register('runtimeSchemaRealizationPreflight') {
    group = 'verification'
    description = 'Preflights schema-realization SQL assets before runtime startup.'

    doLast {
        def realizationDir = file('npdev-generated/src/main/resources/db/schema-realization')
        if (!realizationDir.isDirectory()) {
            throw new GradleException("Missing schema-realization directory: ${realizationDir}")
        }
        def sqlFiles = fileTree(realizationDir) { include '*.sql' }.files.sort { it.name }
        if (sqlFiles.isEmpty()) {
            throw new GradleException("No schema-realization SQL files found in ${realizationDir}")
        }
        def destructivePattern = ~/(?i)\b(drop|truncate|delete\s+from|alter\s+table\s+\S+\s+drop)\b/
        def destructiveHits = sqlFiles.findAll { file ->
            file.getText('UTF-8') =~ destructivePattern
        }
        if (!destructiveHits.isEmpty()) {
            throw new GradleException("Runtime schema-realization preflight rejected destructive SQL: ${destructiveHits*.name}")
        }
        println "Runtime schema-realization preflight OK. SQL files checked: ${sqlFiles.size()}"
    }
}

