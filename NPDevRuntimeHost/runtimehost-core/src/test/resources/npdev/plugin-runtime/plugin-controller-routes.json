{
  "manifestVersion": "1.0.0",
  "controllerPlugins": [
    {
      "capability": "sampleController",
      "controllerClassName": "com.npdev.generated.plugin.SampleControllerForHandlerTest",
      "basePath": "/api/plugins/sample",
      "routes": [
        { "httpMethod": "GET", "path": "/api/plugins/sample/ping", "methodName": "ping" },
        { "httpMethod": "GET", "path": "/api/plugins/sample/users/{id}", "methodName": "getUser" },
        { "httpMethod": "POST", "path": "/api/plugins/sample/users", "methodName": "createUser" }
      ]
    }
  ]
}
