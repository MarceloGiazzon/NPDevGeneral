{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npdev.local/schema/npdev-plugin-package-v1.schema.json",
  "title": "NPDev Plugin Package Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packageFormatVersion",
    "packageId",
    "displayName",
    "version",
    "description",
    "provider",
    "compatibility",
    "trust",
    "artifacts",
    "pluginManifest",
    "capabilities"
  ],
  "properties": {
    "packageFormatVersion": {
      "type": "string",
      "const": "1.0"
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "trust": {
      "$ref": "#/$defs/trust"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "pluginManifest": {
      "$ref": "#/$defs/pluginManifest"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capabilityBinding"
      }
    }
  },
  "$defs": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npdevRuntimeApiVersion",
        "minBootstrapVersion"
      ],
      "properties": {
        "npdevRuntimeApiVersion": {
          "type": "string",
          "minLength": 1
        },
        "minBootstrapVersion": {
          "type": "string",
          "minLength": 1
        },
        "maxBootstrapVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source",
        "level"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest",
        "status"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "verifiedBy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "sourceLocation"
      ],
      "properties": {
        "sourceType": {
          "type": "string",
          "minLength": 1
        },
        "sourceLocation": {
          "type": "string",
          "minLength": 1
        },
        "publishedAt": {
          "type": "string",
          "minLength": 1
        },
        "attestation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pluginManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "operation",
        "adapterId"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "adapterId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
