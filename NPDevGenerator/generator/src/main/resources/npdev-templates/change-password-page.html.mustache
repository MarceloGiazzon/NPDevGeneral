<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Change password — {{appName}}</title>
<style>
  :root {
    --bg: #f4f5f7; --card: #ffffff; --ink: #1f2430; --muted: #6b7280;
    --accent: #2563eb; --accent-ink: #ffffff; --line: #e2e5ea;
    --error: #b91c1c; --error-bg: #fef2f2; --ok: #15803d; --ok-bg: #f0fdf4;
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
         background: var(--bg); color: var(--ink);
         font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .card { width: 22rem; max-width: calc(100vw - 2rem); background: var(--card);
          border: 1px solid var(--line); border-radius: 10px; padding: 1.5rem 1.5rem 1.75rem;
          box-shadow: 0 6px 24px rgba(16, 24, 40, .07); }
  h1 { font-size: 1.15rem; margin: 0 0 1.1rem; font-weight: 600; }
  label { display: block; margin-bottom: .85rem; font-size: .85rem; color: var(--muted); }
  input { width: 100%; margin-top: .3rem; padding: .55rem .6rem; border: 1px solid var(--line);
          border-radius: 7px; font-size: .95rem; }
  input:focus { outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); border-color: var(--accent); }
  .primary { width: 100%; padding: .6rem; border: 0; border-radius: 7px; background: var(--accent);
             color: var(--accent-ink); font-size: .95rem; cursor: pointer; }
  .primary:hover { filter: brightness(1.05); }
  .primary:disabled { opacity: .6; cursor: not-allowed; }
  .note { font-size: .85rem; color: var(--muted); margin: 0 0 1rem; line-height: 1.45; }
  .banner { margin-top: 1rem; padding: .6rem .7rem; border-radius: 7px; font-size: .85rem; line-height: 1.4; }
  .banner.error { background: var(--error-bg); color: var(--error); }
  .banner.ok { background: var(--ok-bg); color: var(--ok); }
  .hidden { display: none; }
</style>
</head>
<body>
<main class="card">
  <h1>Alterar senha</h1>
  <p class="note">Muda a senha da sua conta. Voce continua logado nesta sessao; outras sessoes ativas sao encerradas.</p>

  <form id="changeForm" autocomplete="off">
    <label>Senha atual
      <input id="oldPassword" name="oldPassword" type="password" autocomplete="current-password" required>
    </label>
    <label>Nova senha
      <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="8" required>
    </label>
    <label>Confirmar nova senha
      <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required>
    </label>
    <button class="primary" id="submitBtn" type="submit">Alterar senha</button>
  </form>

  <p id="errorBanner" class="banner error hidden"></p>
  <p id="okBanner" class="banner ok hidden"></p>
</main>

<script>
(function () {
  "use strict";
  var TOKEN_KEYS = ["npdev.shell.token", "npdev.businessUi.apiKey"];

  function currentToken() {
    for (var i = 0; i < TOKEN_KEYS.length; i++) {
      var v = localStorage.getItem(TOKEN_KEYS[i]);
      if (v) { return v; }
    }
    return null;
  }
  function storeToken(token) {
    TOKEN_KEYS.forEach(function (key) { localStorage.setItem(key, token); });
  }

  var errorBanner = document.getElementById("errorBanner");
  var okBanner = document.getElementById("okBanner");
  var submitBtn = document.getElementById("submitBtn");

  var MESSAGES = {
    unauthenticated: "Sua sessao expirou. Faca login novamente.",
    invalid_request: "Preencha a senha atual e uma nova senha com pelo menos 8 caracteres.",
    invalid_old_password: "Senha atual incorreta.",
    identity_pack_not_composed: "Este aplicativo nao tem autenticacao configurada.",
    token_issuance_unavailable: "Este ambiente nao permite alterar senha (sem chave de assinatura)."
  };
  function showError(code) {
    errorBanner.textContent = MESSAGES[code] || "Nao foi possivel alterar a senha (" + code + ").";
    errorBanner.classList.remove("hidden");
    okBanner.classList.add("hidden");
  }

  var token = currentToken();
  if (!token) {
    showError("unauthenticated");
    submitBtn.disabled = true;
  }

  document.getElementById("changeForm").addEventListener("submit", function (ev) {
    ev.preventDefault();
    errorBanner.classList.add("hidden");
    okBanner.classList.add("hidden");
    var oldPassword = document.getElementById("oldPassword").value;
    var newPassword = document.getElementById("newPassword").value;
    var confirmPassword = document.getElementById("confirmPassword").value;
    if (!oldPassword || !newPassword) { return; }
    if (newPassword !== confirmPassword) {
      showError("invalid_request");
      errorBanner.textContent = "As senhas novas nao coincidem.";
      return;
    }
    submitBtn.disabled = true;
    fetch("/api/auth/change-password", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": "Bearer " + token,
        "X-Api-Key": token
      },
      body: JSON.stringify({ oldPassword: oldPassword, newPassword: newPassword })
    }).then(function (r) {
      return r.json().then(function (body) { return { status: r.status, body: body }; });
    }).then(function (res) {
      submitBtn.disabled = false;
      if (res.status === 200 && res.body.ok && res.body.token) {
        // The endpoint mints a fresh token (its own token_version bump) so this SAME session keeps
        // working -- store it under the same keys shell.js's findToken() reads, same as login.
        storeToken(res.body.token);
        okBanner.textContent = "Senha alterada com sucesso.";
        okBanner.classList.remove("hidden");
        document.getElementById("changeForm").reset();
      } else {
        showError(res.body && res.body.error ? res.body.error : "password_change_failed");
      }
    }).catch(function () {
      submitBtn.disabled = false;
      showError("password_change_failed");
    });
  });
})();
</script>
</body>
</html>
