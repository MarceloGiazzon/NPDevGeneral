<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Change password — {{appName}}</title>
<style>
  /* THM-8: every colour reads the shared --np-* theme variables when a theme is applied (npdev-display.js), and falls
     back to the page's own value otherwise, so an app with the default theme looks exactly as before. */
  :root {
    --bg: var(--np-bg, #f4f5f7); --card: var(--np-surface, #ffffff); --ink: var(--np-text, #1f2430); --muted: var(--np-text-muted, #6b7280);
    --accent: var(--np-accent, #2563eb); --accent-ink: var(--np-on-accent, #ffffff); --line: var(--np-border, #e2e5ea);
    --error: var(--np-negative, #b91c1c); --error-bg: #fef2f2; --ok: var(--np-positive, #15803d); --ok-bg: #f0fdf4;
  }
  html[data-np-theme-name] {
    --error-bg: color-mix(in srgb, var(--np-negative) 12%, var(--np-surface));
    --ok-bg: color-mix(in srgb, var(--np-positive) 12%, var(--np-surface));
  }
  html[data-np-theme-name] .tab { background: var(--bg); }
  html[data-np-theme-name] .oauth-button { background: var(--card); color: var(--ink); }
  html[data-np-theme-name] .oauth-button:hover { background: var(--bg); }
  html[data-np-theme-name] input { background: var(--card); color: var(--ink); }
  html[data-np-theme-name] input:focus { border-color: var(--accent); }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
         background: var(--bg); color: var(--ink);
         font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .card { width: 22rem; max-width: calc(100vw - 2rem); background: var(--card);
          border: 1px solid var(--line); border-radius: 10px; padding: 1.5rem 1.5rem 1.75rem;
          box-shadow: 0 6px 24px rgba(16, 24, 40, .07); }
  h1 { font-size: 1.15rem; margin: 0 0 1.1rem; font-weight: 600; }
  label { display: block; margin-bottom: .85rem; font-size: .85rem; color: var(--muted); }
  input { width: 100%; margin-top: .3rem; padding: .55rem .6rem; border: 1px solid var(--line);
          border-radius: 7px; font-size: .95rem; }
  input:focus { outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); border-color: var(--accent); }
  .primary { width: 100%; padding: .6rem; border: 0; border-radius: 7px; background: var(--accent);
             color: var(--accent-ink); font-size: .95rem; cursor: pointer; }
  .primary:hover { filter: brightness(1.05); }
  .primary:disabled { opacity: .6; cursor: not-allowed; }
  .note { font-size: .85rem; color: var(--muted); margin: 0 0 1rem; line-height: 1.45; }
  .banner { margin-top: 1rem; padding: .6rem .7rem; border-radius: 7px; font-size: .85rem; line-height: 1.4; }
  .banner.error { background: var(--error-bg); color: var(--error); }
  .banner.ok { background: var(--ok-bg); color: var(--ok); }
  .hidden { display: none; }
  .pw-tools { display: flex; justify-content: space-between; align-items: center; gap: .5rem;
              margin: -.55rem 0 .85rem; min-height: 1.75rem; }
  .pw-caps { font-size: .8rem; color: var(--error); }
  .pw-toggle { margin-left: auto; background: none; border: 0; padding: .25rem .45rem; border-radius: 5px;
               color: var(--accent); font-size: .85rem; cursor: pointer; min-height: 1.75rem; }
  .pw-toggle:hover { text-decoration: underline; }
  .pw-toggle:focus-visible { outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); }
  button[aria-busy="true"] { cursor: progress; }
</style>
<script src="/npdev-display.js"></script>
<script>if (window.NPDevDisplay) { NPDevDisplay.boot(); }</script>
</head>
<body>
<main class="card">
  <h1>Alterar senha</h1>
  <p class="note">Muda a senha da sua conta. Voce continua logado nesta sessao; outras sessoes ativas sao encerradas.</p>

  <form id="changeForm" autocomplete="off">
    <label>Senha atual
      <input id="oldPassword" name="oldPassword" type="password" autocomplete="current-password" required>
    </label>
    <label>Nova senha
      <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="8" required>
    </label>
    <label>Confirmar nova senha
      <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required>
    </label>
    <button class="primary" id="submitBtn" type="submit">Alterar senha</button>
  </form>

  <p id="errorBanner" class="banner error hidden"></p>
  <p id="okBanner" class="banner ok hidden"></p>
</main>

<script>
(function () {
  "use strict";
  var TOKEN_KEYS = ["npdev.shell.token", "npdev.businessUi.apiKey"];

  function currentToken() {
    for (var i = 0; i < TOKEN_KEYS.length; i++) {
      var v = localStorage.getItem(TOKEN_KEYS[i]);
      if (v) { return v; }
    }
    return null;
  }
  function storeToken(token) {
    TOKEN_KEYS.forEach(function (key) { localStorage.setItem(key, token); });
  }

  var errorBanner = document.getElementById("errorBanner");
  var okBanner = document.getElementById("okBanner");
  var submitBtn = document.getElementById("submitBtn");
  // UX: show-password toggle + Caps Lock hint for every password input, and an in-flight guard.
  var PW_SHOW = "Mostrar", PW_HIDE = "Ocultar", PW_CAPS = "Caps Lock ativado";
  function enhancePasswordField(input) {
    var anchor = input.closest("label") || input;
    var row = document.createElement("div");
    row.className = "pw-tools";
    var hint = document.createElement("span");
    hint.className = "pw-caps";
    hint.id = input.id + "Caps";
    hint.setAttribute("aria-live", "polite");
    var toggle = document.createElement("button");
    toggle.type = "button";
    toggle.className = "pw-toggle";
    toggle.id = input.id + "Toggle";
    toggle.setAttribute("aria-controls", input.id);
    toggle.setAttribute("aria-pressed", "false");
    toggle.textContent = PW_SHOW;
    toggle.addEventListener("click", function () {
      var reveal = input.type === "password";
      input.type = reveal ? "text" : "password";
      toggle.textContent = reveal ? PW_HIDE : PW_SHOW;
      toggle.setAttribute("aria-pressed", String(reveal));
    });
    function capsCheck(ev) {
      var on = !!(ev.getModifierState && ev.getModifierState("CapsLock"));
      hint.textContent = on ? PW_CAPS : "";
    }
    input.addEventListener("keydown", capsCheck);
    input.addEventListener("keyup", capsCheck);
    input.addEventListener("blur", function () { hint.textContent = ""; });
    input.setAttribute("aria-describedby", hint.id);
    row.appendChild(hint);
    row.appendChild(toggle);
    anchor.parentNode.insertBefore(row, anchor.nextSibling);
  }
  Array.prototype.forEach.call(document.querySelectorAll('input[type="password"]'), enhancePasswordField);

  // Double-submit guard: disable + aria-busy + busy label while a request is in flight.
  function setBusy(btn, busy, busyText) {
    if (busy) {
      btn.setAttribute("data-label", btn.textContent);
      btn.textContent = busyText;
      btn.disabled = true;
      btn.setAttribute("aria-busy", "true");
    } else {
      btn.textContent = btn.getAttribute("data-label") || btn.textContent;
      btn.disabled = false;
      btn.removeAttribute("aria-busy");
    }
  }


  var MESSAGES = {
    unauthenticated: "Sua sessao expirou. Faca login novamente.",
    invalid_request: "Preencha a senha atual e a nova senha.",
    password_too_short: "A nova senha deve ter pelo menos %MIN% caracteres.",
    password_too_long: "A nova senha e longa demais (maximo de 256 caracteres).",
    password_too_common: "Essa senha e muito comum. Escolha outra.",
    password_matches_username: "A senha nao pode ser igual ao nome de usuario.",
    invalid_old_password: "Senha atual incorreta.",
    identity_pack_not_composed: "Este aplicativo nao tem autenticacao configurada.",
    token_issuance_unavailable: "Este ambiente nao permite alterar senha (sem chave de assinatura)."
  };
  function showError(code, minLength) {
    var message = MESSAGES[code] || "Nao foi possivel alterar a senha (" + code + ").";
    errorBanner.textContent = message.replace("%MIN%", String(minLength || 8));
    errorBanner.classList.remove("hidden");
    okBanner.classList.add("hidden");
  }

  var token = currentToken();
  if (!token) {
    showError("unauthenticated");
    submitBtn.disabled = true;
  }

  document.getElementById("changeForm").addEventListener("submit", function (ev) {
    ev.preventDefault();
    errorBanner.classList.add("hidden");
    okBanner.classList.add("hidden");
    var oldPassword = document.getElementById("oldPassword").value;
    var newPassword = document.getElementById("newPassword").value;
    var confirmPassword = document.getElementById("confirmPassword").value;
    if (!oldPassword || !newPassword) { return; }
    if (newPassword !== confirmPassword) {
      showError("invalid_request");
      errorBanner.textContent = "As senhas novas nao coincidem.";
      return;
    }
    if (submitBtn.disabled) { return; }
    setBusy(submitBtn, true, "Salvando\u2026");
    fetch("/api/auth/change-password", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-NPDev-Request": "1",
        "Authorization": "Bearer " + token,
        "X-Api-Key": token
      },
      body: JSON.stringify({ oldPassword: oldPassword, newPassword: newPassword })
    }).then(function (r) {
      return r.json().then(function (body) { return { status: r.status, body: body }; });
    }).then(function (res) {
      if (res.status === 200 && res.body.ok && res.body.token) {
        // The endpoint mints a fresh token (its own token_version bump) so this SAME session keeps
        // working -- store it under the same keys shell.js's findToken() reads, same as login.
        storeToken(res.body.token);
        okBanner.textContent = "Senha alterada com sucesso.";
        okBanner.classList.remove("hidden");
        document.getElementById("changeForm").reset();
      } else {
        showError(res.body && res.body.error ? res.body.error : "password_change_failed", res.body && res.body.minLength);
      }
    }).catch(function () {
      showError("password_change_failed");
    }).then(function () { setBusy(submitBtn, false); });
  });
})();
</script>
</body>
</html>
