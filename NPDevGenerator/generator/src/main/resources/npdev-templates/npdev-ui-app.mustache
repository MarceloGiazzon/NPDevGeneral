    el.executionsTableBody.innerHTML = "";
    rows.forEach(function (row) {
      const tr = document.createElement("tr");
      const cells = [
        row.executionId || "",
        row.status || "",
        row.flowName || "",
        row.correlationId || "",
        row.waitingForEventName || "",
        row.resumeAttemptCount === null || row.resumeAttemptCount === undefined ? "" : String(row.resumeAttemptCount),
        formatEpoch(row.nextEligibleResumeAtEpochMs),
        row.lastResumeErrorCode || "",
        row.lastErrorCode || "",
        formatEpoch(row.failedAtEpochMs),
        formatEpoch(row.updatedAtEpochMs)
      ];
      cells.forEach(function (text) {
        const td = document.createElement("td");
        td.textContent = text;
        tr.appendChild(td);
      });

      const actionCell = document.createElement("td");
      actionCell.className = "actions-cell";
      actionCell.appendChild(makeActionButton("Detail", "", function (event) {
        event.stopPropagation();
        loadExecutionDetails(row.executionId);
      }));
      actionCell.appendChild(makeActionButton("Trace", "", function (event) {
        event.stopPropagation();
        openTrace(row.executionId);
      }));
      if (row.correlationId) {
        actionCell.appendChild(makeActionButton("Correlation", "", function (event) {
          event.stopPropagation();
          openCorrelation(row.correlationId);
        }));
