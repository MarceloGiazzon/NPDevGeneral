(function () {
  "use strict";

  const STORAGE_KEYS = {
    apiKey: "npdev.ui.apiKey",
    apiBase: "npdev.ui.apiBase",
    lastFlow: "npdev.ui.lastFlow",
    executeUseAdvanced: "npdev.ui.execute.useAdvanced",
    executePayload: "npdev.ui.execute.payload",
    traceFilters: "npdev.ui.trace.filters",
    executionFilters: "npdev.ui.execution.filters"
  };

  const DEFAULT_LIMIT = 50;
  const DEFAULT_OFFSET = 0;
  const DEFAULT_DEV_API_KEY = "api-dev";
  const SENSITIVE_KEY_TOKENS = [
    "token",
    "secret",
    "password",
    "authorization",
    "apiKey",
    "api_key",
    "bearer",
    "cookie"
  ];

  const state = {
    flows: [],
    flowDefinitionsByName: {},
    executionsMode: "recent",
    typedControls: [],
    currentTrace: null,
    currentExecution: null,
    adminEnabled: false,
    adminSection: "failures"
  };

  const el = {
    apiKey: document.getElementById("apiKey"),
    apiBase: document.getElementById("apiBase"),
    statusBanner: document.getElementById("statusBanner"),
    tabs: Array.from(document.querySelectorAll(".tab")),
    views: {
      flows: document.getElementById("view-flows"),
      execute: document.getElementById("view-execute"),
      executions: document.getElementById("view-executions"),
      traces: document.getElementById("view-traces"),
      events: document.getElementById("view-events"),
      correlation: document.getElementById("view-correlation"),
      admin: document.getElementById("view-admin")
    },
    reloadFlows: document.getElementById("reloadFlows"),
    flowsList: document.getElementById("flowsList"),
    executeFlowName: document.getElementById("executeFlowName"),
    executeTypedContainer: document.getElementById("executeTypedContainer"),
    executeUseAdvanced: document.getElementById("executeUseAdvanced"),
    executePayload: document.getElementById("executePayload"),
    executeButton: document.getElementById("executeButton"),
    executeValidationErrors: document.getElementById("executeValidationErrors"),
    executeResult: document.getElementById("executeResult"),
    executeLinks: document.getElementById("executeLinks"),
    executionsLimit: document.getElementById("executionsLimit"),
    executionsOffset: document.getElementById("executionsOffset"),
    staleOlderThanMinutes: document.getElementById("staleOlderThanMinutes"),
    executionsStatusFilter: document.getElementById("executionsStatusFilter"),
    loadExecutionsRecent: document.getElementById("loadExecutionsRecent"),
    loadExecutionsWaiting: document.getElementById("loadExecutionsWaiting"),
    loadExecutionsStale: document.getElementById("loadExecutionsStale"),
    executionsPrev: document.getElementById("executionsPrev"),
    executionsNext: document.getElementById("executionsNext"),
    executionsTableBody: document.querySelector("#executionsTable tbody"),
    executionStatusBlock: document.getElementById("executionStatusBlock"),
    executionDetails: document.getElementById("executionDetails"),
    executionAwaitedEventName: document.getElementById("executionAwaitedEventName"),
    executionCorrelationId: document.getElementById("executionCorrelationId"),
    executionEventPayload: document.getElementById("executionEventPayload"),
    executionPublishEventButton: document.getElementById("executionPublishEventButton"),
    executionPublishResult: document.getElementById("executionPublishResult"),
    traceFilterFlowName: document.getElementById("traceFilterFlowName"),
    traceFilterStatus: document.getElementById("traceFilterStatus"),
    traceFilterFrom: document.getElementById("traceFilterFrom"),
    traceFilterTo: document.getElementById("traceFilterTo"),
    traceLimit: document.getElementById("traceLimit"),
    traceOffset: document.getElementById("traceOffset"),
    searchTraces: document.getElementById("searchTraces"),
    tracePrev: document.getElementById("tracePrev"),
    traceNext: document.getElementById("traceNext"),
    traceSearchTableBody: document.querySelector("#traceSearchTable tbody"),
    traceExecutionId: document.getElementById("traceExecutionId"),
    loadTrace: document.getElementById("loadTrace"),
    copyTraceExecutionId: document.getElementById("copyTraceExecutionId"),
    copyTraceCorrelationId: document.getElementById("copyTraceCorrelationId"),
    copyTraceSummary: document.getElementById("copyTraceSummary"),
    copyTraceJson: document.getElementById("copyTraceJson"),
    traceSummary: document.getElementById("traceSummary"),
    traceDetails: document.getElementById("traceDetails"),
    publishEventName: document.getElementById("publishEventName"),
    publishCorrelationId: document.getElementById("publishCorrelationId"),
    publishPayload: document.getElementById("publishPayload"),
    publishEventButton: document.getElementById("publishEventButton"),
    publishResult: document.getElementById("publishResult"),
    timelineCorrelationId: document.getElementById("timelineCorrelationId"),
    timelineLimit: document.getElementById("timelineLimit"),
    timelineOffset: document.getElementById("timelineOffset"),
    loadTimeline: document.getElementById("loadTimeline"),
    timelinePrev: document.getElementById("timelinePrev"),
    timelineNext: document.getElementById("timelineNext"),
    timelineDetails: document.getElementById("timelineDetails"),
    adminTab: document.getElementById("adminTab"),
    adminLimit: document.getElementById("adminLimit"),
    adminOffset: document.getElementById("adminOffset"),
    loadAdminFailures: document.getElementById("loadAdminFailures"),
    loadAdminStuck: document.getElementById("loadAdminStuck"),
    adminSectionFailures: document.getElementById("adminSectionFailures"),
    adminSectionStuck: document.getElementById("adminSectionStuck"),
    adminFailuresPanel: document.getElementById("adminFailuresPanel"),
    adminStuckPanel: document.getElementById("adminStuckPanel"),
    adminFailuresTableBody: document.querySelector("#adminFailuresTable tbody"),
    adminStuckTableBody: document.querySelector("#adminStuckTable tbody"),
    adminResumeResult: document.getElementById("adminResumeResult"),
    adminFailuresResult: document.getElementById("adminFailuresResult"),
    adminCircuitCapability: document.getElementById("adminCircuitCapability"),
    adminCircuitOperation: document.getElementById("adminCircuitOperation"),
    adminCircuitLimit: document.getElementById("adminCircuitLimit"),
    adminCircuitOffset: document.getElementById("adminCircuitOffset"),
    loadAdminCircuits: document.getElementById("loadAdminCircuits"),
    adminCircuitsResult: document.getElementById("adminCircuitsResult"),
    adminIdempotencyKey: document.getElementById("adminIdempotencyKey"),
    adminIdempotencyCapability: document.getElementById("adminIdempotencyCapability"),
    adminIdempotencyOperation: document.getElementById("adminIdempotencyOperation"),
    loadAdminIdempotency: document.getElementById("loadAdminIdempotency"),
    adminIdempotencyResult: document.getElementById("adminIdempotencyResult"),
    buildInfoFooter: document.getElementById("buildInfoFooter")
  };

  function showStatus(message, isError) {
    if (!message) {
      el.statusBanner.classList.add("hidden");
      el.statusBanner.classList.remove("error");
      el.statusBanner.textContent = "";
      return;
    }
    el.statusBanner.classList.remove("hidden");
    el.statusBanner.classList.toggle("error", Boolean(isError));
    el.statusBanner.textContent = message;
  }

  function normalizeText(value) {
    if (value === null || value === undefined) {
      return "";
    }
    return String(value).trim();
  }

  function parseStoredJson(key, fallback) {
    const raw = localStorage.getItem(key);
    if (!raw) {
      return fallback;
    }
    try {
      const parsed = JSON.parse(raw);
      return parsed === null || parsed === undefined ? fallback : parsed;
    } catch (error) {
      return fallback;
    }
  }

  function readStoredInputs() {
    const storedApiKey = localStorage.getItem(STORAGE_KEYS.apiKey);
    el.apiKey.value = storedApiKey === null ? DEFAULT_DEV_API_KEY : storedApiKey;
    if (storedApiKey === null) {
      localStorage.setItem(STORAGE_KEYS.apiKey, DEFAULT_DEV_API_KEY);
    }
    el.apiBase.value = localStorage.getItem(STORAGE_KEYS.apiBase) || "";
    el.executeUseAdvanced.checked = localStorage.getItem(STORAGE_KEYS.executeUseAdvanced) === "true";
    el.executePayload.value = localStorage.getItem(STORAGE_KEYS.executePayload) || "{}";

    const traceFilters = parseStoredJson(STORAGE_KEYS.traceFilters, {});
    el.traceFilterFlowName.value = traceFilters.flowName || "";
    el.traceFilterStatus.value = traceFilters.status || "";
    el.traceFilterFrom.value = traceFilters.from || "";
    el.traceFilterTo.value = traceFilters.to || "";
    el.traceLimit.value = String(toInt(traceFilters.limit, DEFAULT_LIMIT));
    el.traceOffset.value = String(toInt(traceFilters.offset, DEFAULT_OFFSET));

    const executionFilters = parseStoredJson(STORAGE_KEYS.executionFilters, {});
    el.executionsLimit.value = String(toInt(executionFilters.limit, DEFAULT_LIMIT));
    el.executionsOffset.value = String(toInt(executionFilters.offset, DEFAULT_OFFSET));
    el.staleOlderThanMinutes.value = String(toInt(executionFilters.olderThanMinutes, 60));
    el.executionsStatusFilter.value = executionFilters.status || "";
    if (executionFilters.mode === "waiting" || executionFilters.mode === "stale" || executionFilters.mode === "recent") {
      state.executionsMode = executionFilters.mode;
    }
  }

  function persistInput(key, value) {
    if (!key) {
      return;
    }
    const normalized = normalizeText(value);
    if (!normalized) {
      localStorage.removeItem(key);
      return;
    }
    localStorage.setItem(key, normalized);
  }

  function persistJson(key, payload) {
    if (!key) {
      return;
    }
    localStorage.setItem(key, JSON.stringify(payload));
  }

  function persistTraceFilters() {
    persistJson(STORAGE_KEYS.traceFilters, {
      flowName: normalizeText(el.traceFilterFlowName.value),
      status: normalizeText(el.traceFilterStatus.value),
      from: normalizeText(el.traceFilterFrom.value),
      to: normalizeText(el.traceFilterTo.value),
      limit: toInt(el.traceLimit.value, DEFAULT_LIMIT),
      offset: toInt(el.traceOffset.value, DEFAULT_OFFSET)
    });
  }

  function persistExecutionFilters(mode) {
    persistJson(STORAGE_KEYS.executionFilters, {
      mode: mode || state.executionsMode,
      limit: toInt(el.executionsLimit.value, DEFAULT_LIMIT),
      offset: toInt(el.executionsOffset.value, DEFAULT_OFFSET),
      olderThanMinutes: toInt(el.staleOlderThanMinutes.value, 60),
      status: normalizeText(el.executionsStatusFilter.value)
    });
  }

  function headers() {
    const result = { "Content-Type": "application/json" };
    const apiKey = normalizeText(el.apiKey.value);
    if (apiKey) {
      result["X-Api-Key"] = apiKey;
    }
    return result;
  }

  function apiUrl(path) {
    const base = normalizeText(el.apiBase.value);
    if (!base) {
      return path;
    }
    const normalizedBase = base.endsWith("/") ? base.slice(0, -1) : base;
    return normalizedBase + path;
  }

  function mapHttpError(status, payload) {
    if (status === 403) {
      return "Forbidden.";
    }
    if (status === 401) {
      return "Unauthorized (check API key).";
    }
    if (typeof payload === "string" && payload) {
      return payload;
    }
    if (payload && payload.message) {
      return payload.message;
    }
    return "HTTP " + status;
  }

  async function api(path, method, body) {
    const apiKey = normalizeText(el.apiKey.value);
    if (!apiKey) {
      showStatus("API key is empty. Server likely returns 401.", false);
    }
    const response = await fetch(apiUrl(path), {
      method: method || "GET",
      headers: headers(),
      body: body === undefined ? undefined : JSON.stringify(body)
    });
    const responseContentType = response.headers.get("content-type") || "";
    const isJson = responseContentType.includes("application/json");
    const payload = isJson ? await response.json() : await response.text();
    if (!response.ok) {
      throw new Error(mapHttpError(response.status, payload));
    }
    return payload;

  }

  async function apiAllowError(path, method, body) {
  const apiKey = normalizeText(el.apiKey.value);
  if (!apiKey) {
  showStatus("API key is empty. Server likely returns 401.", false);
  }
  const response = await fetch(apiUrl(path), {
  method: method || "GET",
  headers: headers(),
  body: body === undefined ? undefined : JSON.stringify(body)
  });
  const responseContentType = response.headers.get("content-type") || "";
  const isJson = responseContentType.includes("application/json");
  const payload = isJson ? await response.json() : await response.text();
  return {
  ok: response.ok,
  status: response.status,
  contentType: responseContentType,
  payload: payload
  };
  }



  function formatBuildFooter(infoPayload) {
    if (!infoPayload || typeof infoPayload !== "object") {
      return "Version: unknown";
    }
    const version = normalizeText(infoPayload["npdev.version"] || (infoPayload.npdev && infoPayload.npdev.version)) || "unknown";
    const commitRaw = normalizeText(infoPayload["npdev.commit"] || (infoPayload.npdev && infoPayload.npdev.commit)) || "unknown";
    const shortCommit = commitRaw.length > 8 ? commitRaw.slice(0, 8) : commitRaw;
    return "Version: " + version + " (" + shortCommit + ")";
  }

  async function loadBuildInfoFooter() {
    if (!el.buildInfoFooter) {
      return;
    }
    try {
      const response = await fetch(apiUrl("/actuator/info"), {
        method: "GET",
        headers: headers()
      });
      if (!response.ok) {
        el.buildInfoFooter.textContent = "Version: unavailable";
        return;
      }
      const payload = await response.json();
      el.buildInfoFooter.textContent = formatBuildFooter(payload);
    } catch (error) {
      el.buildInfoFooter.textContent = "Version: unavailable";
    }
  }

  function setView(viewName) {
    Object.keys(el.views).forEach(function (key) {
      el.views[key].classList.toggle("active", key === viewName);
    });
    el.tabs.forEach(function (tab) {
      tab.classList.toggle("active", tab.dataset.view === viewName);
    });
  }

  function formatEpoch(epochMs) {
    if (epochMs === null || epochMs === undefined) {
      return "-";
    }
    try {
      return new Date(epochMs).toISOString();
    } catch (error) {
      return String(epochMs);
    }
  }

  function formatDuration(startedAtEpochMs, endedAtEpochMs) {
    if (startedAtEpochMs === null || startedAtEpochMs === undefined || endedAtEpochMs === null || endedAtEpochMs === undefined) {
      return "-";
    }
    const duration = Number(endedAtEpochMs) - Number(startedAtEpochMs);
    if (!Number.isFinite(duration) || duration < 0) {
      return "-";
    }
    return String(duration) + " ms";
  }

  function canResumeNow(row) {
    if (!row || row.status !== "WAITING_EVENT") {
      return false;
    }
    if (row.nextEligibleResumeAtEpochMs === null || row.nextEligibleResumeAtEpochMs === undefined) {
      return true;
    }
    return Number(row.nextEligibleResumeAtEpochMs) <= Date.now();
  }

  function asJson(text, fallback) {
    const value = normalizeText(text);
    if (!value) {
      return fallback;
    }
    return JSON.parse(value);
  }

  function toInt(value, fallback) {
    const parsed = Number.parseInt(value, 10);
    if (Number.isNaN(parsed)) {
      return fallback;
    }
    return parsed;
  }

  function isSensitiveDisplayKey(key) {
    const normalizedKey = normalizeText(key).toLowerCase();
    if (!normalizedKey) {
      return false;
    }
    return SENSITIVE_KEY_TOKENS.some(function (token) {
      return normalizedKey.includes(token.toLowerCase());
    });
  }

  function sanitizeForDisplay(payload, keyHint) {
    if (payload === null || payload === undefined) {
      return payload;
    }
    if (isSensitiveDisplayKey(keyHint)) {
      return "***";
    }
    if (Array.isArray(payload)) {
      return payload.map(function (item) {
        return sanitizeForDisplay(item, keyHint);
      });
    }
    if (typeof payload === "object") {
      const out = {};
      Object.keys(payload).forEach(function (key) {
        out[key] = sanitizeForDisplay(payload[key], key);
      });
      return out;
    }
    return payload;
  }

  function printJson(target, payload) {
    target.textContent = JSON.stringify(sanitizeForDisplay(payload, ""), null, 2);
  }

  function appendStatusRow(container, label, value) {
    const dt = document.createElement("dt");
    dt.textContent = label;
    container.appendChild(dt);
    const dd = document.createElement("dd");
    dd.textContent = normalizeText(value) || "-";
    container.appendChild(dd);
  }

  function isForbiddenMessage(message) {
    return normalizeText(message).toLowerCase().includes("forbidden");
  }

  function setOffset(input, value) {
    input.value = String(Math.max(0, value));
  }

  function makeActionButton(label, className, onClick) {
    const button = document.createElement("button");
    button.textContent = label;
    if (className) {
      button.className = className;
    }
    button.addEventListener("click", onClick);
    return button;
  }

  function schemaType(schema) {
    if (!schema || typeof schema !== "object") {
      return "";
    }
    return normalizeText(schema.type).toLowerCase();
  }

  function selectedFlowDefinition() {
    const flowName = normalizeText(el.executeFlowName.value);
    return state.flowDefinitionsByName[flowName] || null;
  }

  function supportsTypedInput(definition) {
    if (!definition || !definition.inputSchema || typeof definition.inputSchema !== "object") {
      return false;
    }
    const type = schemaType(definition.inputSchema);
    if (type !== "object") {
      return false;
    }
    const properties = definition.inputSchema.properties;
    return Boolean(properties && typeof properties === "object");
  }

  function clearTypedForm(message) {
    el.executeTypedContainer.innerHTML = "";
    state.typedControls = [];
    const info = document.createElement("div");
    info.className = "typed-help";
    info.textContent = message || "No schema available. Use Advanced JSON mode.";
    el.executeTypedContainer.appendChild(info);
  }

  function fieldHelp(schema) {
    if (!schema || typeof schema !== "object") {
      return "";
    }
    const parts = [];
    const type = schemaType(schema);
    if (type) {
      parts.push("type: " + type);
    }
    if (schema.minLength !== null && schema.minLength !== undefined) {
      parts.push("minLength: " + schema.minLength);
    }
    if (schema.maxLength !== null && schema.maxLength !== undefined) {
      parts.push("maxLength: " + schema.maxLength);
    }
    if (schema.min !== null && schema.min !== undefined) {
      parts.push("min: " + schema.min);
    }
    if (schema.max !== null && schema.max !== undefined) {
      parts.push("max: " + schema.max);
    }
    if (schema.regex) {
      parts.push("regex: " + schema.regex);
    }
    return parts.join(" | ");
  }

  function renderTypedForm() {
    const definition = selectedFlowDefinition();
    if (!supportsTypedInput(definition)) {
      clearTypedForm("No object schema found for this flow. Use Advanced JSON mode.");
      return;
    }
    el.executeTypedContainer.innerHTML = "";
    state.typedControls = [];

    const schema = definition.inputSchema;
    const required = new Set(Array.isArray(schema.required) ? schema.required : []);
    const properties = schema.properties || {};
    const names = Object.keys(properties);
    if (names.length === 0) {
      clearTypedForm("Schema has no properties. Use Advanced JSON mode.");
      return;
    }

    names.sort().forEach(function (name) {
      const propSchema = properties[name] || {};
      const type = schemaType(propSchema);
      const wrapper = document.createElement("div");
      wrapper.className = "typed-field";

      const label = document.createElement("label");
      label.textContent = name;
      if (required.has(name)) {
        label.classList.add("typed-required");
      }
      wrapper.appendChild(label);

      let input;
      if (type === "integer" || type === "number") {
        input = document.createElement("input");
        input.type = "number";
        input.step = type === "integer" ? "1" : "any";
      } else if (type === "boolean") {
        input = document.createElement("input");
        input.type = "checkbox";
      } else if (type === "object" || type === "array") {
        input = document.createElement("textarea");
        input.rows = 4;
        input.placeholder = type === "array" ? "[]" : "{}";
      } else {
        input = document.createElement("input");
        input.type = "text";
      }

      if (type !== "boolean") {
        input.placeholder = input.placeholder || name;
      }
      wrapper.appendChild(input);

      if (propSchema.description) {
        const description = document.createElement("div");
        description.className = "typed-help";
        description.textContent = propSchema.description;
        wrapper.appendChild(description);
      }

      const constraints = fieldHelp(propSchema);
      if (constraints) {
        const help = document.createElement("div");
        help.className = "typed-help";
        help.textContent = constraints;
        wrapper.appendChild(help);
      }

      el.executeTypedContainer.appendChild(wrapper);
      state.typedControls.push({
        name: name,
        type: type || "string",
        input: input
      });
    });
  }

  function syncExecuteModeUi() {
    const typedAvailable = supportsTypedInput(selectedFlowDefinition());
    const useAdvanced = !typedAvailable || el.executeUseAdvanced.checked;
    el.executeTypedContainer.style.display = useAdvanced ? "none" : "block";
    el.executePayload.style.display = useAdvanced ? "block" : "none";
  }

  function buildPayloadFromTypedControls() {
    const payload = {};
    state.typedControls.forEach(function (control) {
      const name = control.name;
      const type = control.type;
      const input = control.input;
      if (type === "boolean") {
        payload[name] = Boolean(input.checked);
        return;
      }
      const raw = normalizeText(input.value);
      if (!raw) {
        return;
      }
      if (type === "integer") {
        const parsedInt = Number.parseInt(raw, 10);
        if (Number.isNaN(parsedInt)) {
          throw new Error("Field '" + name + "' must be integer.");
        }
        payload[name] = parsedInt;
        return;
      }
      if (type === "number") {
        const parsedNumber = Number(raw);
        if (!Number.isFinite(parsedNumber)) {
          throw new Error("Field '" + name + "' must be number.");
        }
        payload[name] = parsedNumber;
        return;
      }
      if (type === "object" || type === "array") {
        payload[name] = JSON.parse(raw);
        return;
      }
      payload[name] = raw;
    });
    return payload;
  }

  function renderExecuteValidationErrors(result) {
    el.executeValidationErrors.innerHTML = "";
    if (!result || result.status !== "INPUT_VALIDATION_FAILED") {
      const ok = document.createElement("div");
      ok.className = "typed-help";
      ok.textContent = "No validation errors.";
      el.executeValidationErrors.appendChild(ok);
      return;
    }
    const title = document.createElement("div");
    title.textContent = "Input validation failed";
    el.executeValidationErrors.appendChild(title);

    const errors = Array.isArray(result.inputValidationErrors) ? result.inputValidationErrors : [];
    if (errors.length === 0) {
      const none = document.createElement("div");
      none.className = "typed-help";
      none.textContent = "No detailed field errors returned.";
      el.executeValidationErrors.appendChild(none);
      return;
    }
    const list = document.createElement("ul");
    errors.forEach(function (item) {
      const li = document.createElement("li");
      const fieldPath = normalizeText(item.field);
      const code = normalizeText(item.code);
      const message = normalizeText(item.message);
      li.textContent = (fieldPath || "<root>") + " | " + (code || "VALIDATION_ERROR") + " | " + (message || "validation error");
      list.appendChild(li);
    });
    el.executeValidationErrors.appendChild(list);
  }

  function renderFlows() {
    el.flowsList.innerHTML = "";
    el.executeFlowName.innerHTML = "";
    state.flows.forEach(function (flowName) {
      const definition = state.flowDefinitionsByName[flowName];
      const option = document.createElement("option");
      option.value = flowName;
      option.textContent = definition && definition.inputSchema ? flowName + " (typed)" : flowName;
      el.executeFlowName.appendChild(option);

      const item = document.createElement("li");
      const code = document.createElement("code");
      code.textContent = flowName;
      const action = makeActionButton("Execute", "primary", function () {
        el.executeFlowName.value = flowName;
        persistInput(STORAGE_KEYS.lastFlow, flowName);
        renderTypedForm();
        syncExecuteModeUi();
        setView("execute");
      });
      item.appendChild(code);
      item.appendChild(action);
      el.flowsList.appendChild(item);
    });
  }

  async function loadFlows() {
    try {
      const definitions = await api("/api/v1/flows");
      state.flowDefinitionsByName = {};
      state.flows = Array.isArray(definitions)
        ? definitions
          .map(function (item) {
            if (!item) {
              return "";
            }
            if (typeof item === "string") {
              state.flowDefinitionsByName[item] = { name: item };
              return item;
            }
            const name = normalizeText(item.name);
            if (name) {
              state.flowDefinitionsByName[name] = item;
            }
            return name;
          })
          .filter(function (name) { return Boolean(name); })
        : [];
      renderFlows();
      const storedFlow = normalizeText(localStorage.getItem(STORAGE_KEYS.lastFlow));
      if (storedFlow && state.flowDefinitionsByName[storedFlow]) {
        el.executeFlowName.value = storedFlow;
      } else if (state.flows.length > 0) {
        el.executeFlowName.value = state.flows[0];
      }
      renderTypedForm();
      syncExecuteModeUi();
      showStatus("Loaded flows: " + state.flows.length, false);
    } catch (error) {
      showStatus("Flows load failed: " + error.message, true);
    }
  }

  function openExecution(executionId) {
    if (!executionId) {
      return;
    }
    setView("executions");
    loadExecutionDetails(executionId);
  }

  function openTrace(executionId) {
    if (!executionId) {
      return;
    }
    setView("traces");
    el.traceExecutionId.value = executionId;
    loadTraceDetails(executionId);
