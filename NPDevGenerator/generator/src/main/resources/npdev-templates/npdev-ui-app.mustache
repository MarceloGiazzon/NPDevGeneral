        event.stopPropagation();
        copyText(row.correlationId, "CorrelationId");
      }));
      const resumeButton = makeActionButton("Try Resume", "primary", async function (event) {
        event.stopPropagation();
        try {
          const response = await tryResume(row.executionId, true);
          if (el.adminResumeResult) {
            printJson(el.adminResumeResult, response);
          }
          showStatus("Resume attempted for stuck execution: " + normalizeText(row.executionId), false);
          await loadAdminStuck();
          await loadExecutionDetails(row.executionId);
        } catch (error) {
          if (isForbiddenMessage(error.message)) {
            resumeButton.classList.add("hidden");
          }
          if (el.adminResumeResult) {
            printJson(el.adminResumeResult, { executionId: row.executionId, error: error.message });
          }
          showStatus("Try resume failed: " + error.message, true);
        }
      });
      resumeButton.disabled = !canResumeNow(row);
      actionCell.appendChild(resumeButton);
      tr.appendChild(actionCell);
      el.adminStuckTableBody.appendChild(tr);
    });
  }

  async function loadAdminFailures() {
    if (!state.adminEnabled) {
      showStatus("Admin access not available.", true);
      return;
    }
    const limit = toInt(el.adminLimit.value, DEFAULT_LIMIT);
    const offset = toInt(el.adminOffset.value, DEFAULT_OFFSET);
    try {
      const rows = await api("/api/v1/admin/failures/recent?limit=" + limit + "&offset=" + offset);
      setAdminSection("failures");
      renderAdminFailuresTable(Array.isArray(rows) ? rows : []);
      printJson(el.adminFailuresResult, rows);
      showStatus("Admin failures loaded: " + (Array.isArray(rows) ? rows.length : 0), false);
    } catch (error) {
      if (isForbiddenMessage(error.message)) {
        setAdminTabVisible(false);
      }
      showStatus("Admin failures failed: " + error.message, true);
    }
  }

  async function loadAdminStuck() {
    if (!state.adminEnabled) {
      showStatus("Admin access not available.", true);
      return;
    }
    const limit = toInt(el.adminLimit.value, DEFAULT_LIMIT);
    const offset = toInt(el.adminOffset.value, DEFAULT_OFFSET);
    try {
      const rows = await api("/api/v1/admin/stuck/recent?limit=" + limit + "&offset=" + offset);
      setAdminSection("stuck");
      renderAdminStuckTable(Array.isArray(rows) ? rows : []);
      printJson(el.adminFailuresResult, rows);
      showStatus("Admin stuck loaded: " + (Array.isArray(rows) ? rows.length : 0), false);
    } catch (error) {
      if (isForbiddenMessage(error.message)) {
        setAdminTabVisible(false);
      }
      showStatus("Admin stuck failed: " + error.message, true);
    }
  }

  async function loadAdminCircuits() {
    if (!state.adminEnabled) {
      showStatus("Admin access not available.", true);
      return;
    }
    const capability = normalizeText(el.adminCircuitCapability.value);
    const operation = normalizeText(el.adminCircuitOperation.value);
    const limit = toInt(el.adminCircuitLimit.value, DEFAULT_LIMIT);
    const offset = toInt(el.adminCircuitOffset.value, DEFAULT_OFFSET);
    const params = new URLSearchParams();
    if (capability) {
      params.set("capability", capability);
    }
    if (operation) {
      params.set("operation", operation);
    }
    params.set("limit", String(limit));
    params.set("offset", String(offset));
    try {
      const rows = await api("/api/v1/admin/circuits?" + params.toString());
      printJson(el.adminCircuitsResult, rows);
      showStatus("Admin circuits loaded: " + (Array.isArray(rows) ? rows.length : 0), false);
    } catch (error) {
      showStatus("Admin circuits failed: " + error.message, true);
    }
  }

  async function loadAdminIdempotency() {
    if (!state.adminEnabled) {
      showStatus("Admin access not available.", true);
      return;
    }
    const key = normalizeText(el.adminIdempotencyKey.value);
    const capability = normalizeText(el.adminIdempotencyCapability.value);
    const operation = normalizeText(el.adminIdempotencyOperation.value);
    if (!key || !capability || !operation) {
      showStatus("Idempotency key, capability and operation are required.", true);
      return;
    }
    const params = new URLSearchParams();
    params.set("key", key);
    params.set("capability", capability);
    params.set("operation", operation);
    try {
      const row = await api("/api/v1/admin/idempotency?" + params.toString());
      printJson(el.adminIdempotencyResult, row);
      showStatus("Admin idempotency loaded.", false);
    } catch (error) {
      showStatus("Admin idempotency failed: " + error.message, true);
    }
  }

  function shiftOffset(input, step) {
    const current = toInt(input.value, DEFAULT_OFFSET);
    const next = Math.max(0, current + step);
    setOffset(input, next);
  }

  async function copyText(value, label) {
    const text = normalizeText(value);
    if (!text) {
      showStatus(label + " is empty.", true);
      return;
    }
    if (!navigator.clipboard || !navigator.clipboard.writeText) {
      showStatus("Clipboard API not available in this browser context.", true);
      return;
    }
    try {
      await navigator.clipboard.writeText(text);
      showStatus(label + " copied.", false);
    } catch (error) {
      showStatus("Copy failed: " + error.message, true);
    }
  }

  function bindEvents() {
    el.tabs.forEach(function (tab) {
      tab.addEventListener("click", function () {
        setView(tab.dataset.view);
      });
    });

    el.apiKey.addEventListener("input", function () {
      persistInput(STORAGE_KEYS.apiKey, el.apiKey.value);
    });
    el.apiBase.addEventListener("input", function () {
      persistInput(STORAGE_KEYS.apiBase, el.apiBase.value);
    });

    el.reloadFlows.addEventListener("click", loadFlows);
    el.executeFlowName.addEventListener("change", function () {
      persistInput(STORAGE_KEYS.lastFlow, el.executeFlowName.value);
      renderTypedForm();
      syncExecuteModeUi();
    });
    el.executeUseAdvanced.addEventListener("change", function () {
      localStorage.setItem(STORAGE_KEYS.executeUseAdvanced, el.executeUseAdvanced.checked ? "true" : "false");
      syncExecuteModeUi();
    });
    el.executePayload.addEventListener("input", function () {
      persistInput(STORAGE_KEYS.executePayload, el.executePayload.value);
    });
    el.executeButton.addEventListener("click", executeFlow);

    el.loadExecutionsRecent.addEventListener("click", function () {
      loadExecutions("recent");
    });
    el.loadExecutionsWaiting.addEventListener("click", function () {
      loadExecutions("waiting");
    });
    el.loadExecutionsStale.addEventListener("click", function () {
      loadExecutions("stale");
    });
    el.executionsPrev.addEventListener("click", function () {
      shiftOffset(el.executionsOffset, -toInt(el.executionsLimit.value, DEFAULT_LIMIT));
      loadExecutions(state.executionsMode);
    });
    el.executionsNext.addEventListener("click", function () {
      shiftOffset(el.executionsOffset, toInt(el.executionsLimit.value, DEFAULT_LIMIT));
      loadExecutions(state.executionsMode);
    });
    el.executionsStatusFilter.addEventListener("change", function () {
      persistExecutionFilters(state.executionsMode);
      loadExecutions(state.executionsMode);
    });
    if (el.executionPublishEventButton) {
      el.executionPublishEventButton.addEventListener("click", publishAwaitedEventFromExecution);
    }

    el.searchTraces.addEventListener("click", searchTraces);
    el.loadTrace.addEventListener("click", function () {
      loadTraceDetails();
    });
    el.tracePrev.addEventListener("click", function () {
      shiftOffset(el.traceOffset, -toInt(el.traceLimit.value, DEFAULT_LIMIT));
      searchTraces();
    });
    el.traceNext.addEventListener("click", function () {
      shiftOffset(el.traceOffset, toInt(el.traceLimit.value, DEFAULT_LIMIT));
      searchTraces();
    });
    el.copyTraceExecutionId.addEventListener("click", function () {
      const traceExecutionId = state.currentTrace && state.currentTrace.meta ? state.currentTrace.meta.executionId : el.traceExecutionId.value;
      copyText(traceExecutionId, "ExecutionId");
    });
    el.copyTraceCorrelationId.addEventListener("click", function () {
      const traceCorrelationId = state.currentTrace && state.currentTrace.meta ? state.currentTrace.meta.correlationId : "";
      copyText(traceCorrelationId, "CorrelationId");
    });
    if (el.copyTraceSummary) {
      el.copyTraceSummary.addEventListener("click", function () {
        copyText(buildTraceTextSummary(state.currentTrace), "Trace summary");
      });
    }
    if (el.copyTraceJson) {
      el.copyTraceJson.addEventListener("click", function () {
        const safe = sanitizeForDisplay(state.currentTrace || {}, "");
        copyText(JSON.stringify(safe, null, 2), "Trace JSON");
      });
    }

    el.publishEventButton.addEventListener("click", publishEvent);

    el.loadTimeline.addEventListener("click", function () {
      loadCorrelationTimeline();
    });
    el.timelinePrev.addEventListener("click", function () {
      shiftOffset(el.timelineOffset, -toInt(el.timelineLimit.value, DEFAULT_LIMIT));
      loadCorrelationTimeline();
    });
    el.timelineNext.addEventListener("click", function () {
      shiftOffset(el.timelineOffset, toInt(el.timelineLimit.value, DEFAULT_LIMIT));
      loadCorrelationTimeline();
    });

    if (el.loadAdminFailures) {
      el.loadAdminFailures.addEventListener("click", loadAdminFailures);
    }
    if (el.loadAdminStuck) {
      el.loadAdminStuck.addEventListener("click", loadAdminStuck);
    }
    if (el.adminSectionFailures) {
      el.adminSectionFailures.addEventListener("click", function () {
        setAdminSection("failures");
      });
    }
    if (el.adminSectionStuck) {
      el.adminSectionStuck.addEventListener("click", function () {
        setAdminSection("stuck");
      });
    }
    if (el.loadAdminCircuits) {
      el.loadAdminCircuits.addEventListener("click", loadAdminCircuits);
    }
    if (el.loadAdminIdempotency) {
      el.loadAdminIdempotency.addEventListener("click", loadAdminIdempotency);
    }
  }

  async function bootstrap() {
    readStoredInputs();
    bindEvents();
    clearTypedForm("Load flows to render typed input.");
    clearTraceSummary("Load trace to see step diagnostics.");
    renderExecutionStatusBlock(null);
    setAdminSection(state.adminSection);
    renderExecuteValidationErrors(null);
    await loadFlows();
    await loadExecutions(state.executionsMode);
    await searchTraces();
    await probeAdminAccess();
    if (state.adminEnabled) {
      await loadAdminFailures();
    }
    await loadBuildInfoFooter();
  }

  bootstrap();
})();
