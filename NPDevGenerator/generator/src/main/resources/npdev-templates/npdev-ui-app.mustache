  async function executeFlow() {
    const flowName = normalizeText(el.executeFlowName.value);
    if (!flowName) {
      showStatus("Select flow before execute.", true);
      return;
    }
    persistInput(STORAGE_KEYS.lastFlow, flowName);
    persistInput(STORAGE_KEYS.executePayload, el.executePayload.value);
    localStorage.setItem(STORAGE_KEYS.executeUseAdvanced, el.executeUseAdvanced.checked ? "true" : "false");

    let payload = {};
    try {
      const definition = selectedFlowDefinition();
      if (!el.executeUseAdvanced.checked && supportsTypedInput(definition)) {
        payload = buildPayloadFromTypedControls();
      } else {
        payload = asJson(el.executePayload.value, {});
      }
    } catch (error) {
      showStatus("Payload build failed: " + error.message, true);
      return;
    }
const response = await apiAllowError("/api/v1/flows/" + encodeURIComponent(flowName) + "/execute", "POST", payload);
const result = response.payload;
printJson(el.executeResult, result);
renderExecuteValidationErrors(result);
setExecuteLinks(result);
const statusText = result && result.status ? result.status : "UNKNOWN";
if (response.ok) {
  showStatus("Execution status: " + statusText, false);
} else {
  showStatus("Execution failed (HTTP " + response.status + "): " + mapHttpError(response.status, result), true);
}

}

  function renderExecutionStatusBlock(payload) {
    if (!el.executionStatusBlock) {
      return;
    }
    el.executionStatusBlock.innerHTML = "";
    const dl = document.createElement("dl");

    if (!payload || typeof payload !== "object") {
      appendStatusRow(dl, "Status", "Not loaded");
      el.executionStatusBlock.appendChild(dl);
      return;
    }

    appendStatusRow(dl, "Status", payload.status);
    appendStatusRow(dl, "Last Error Kind", payload.lastErrorKind || (payload.failureInfo && payload.failureInfo.kind));
    appendStatusRow(dl, "Last Error Code", payload.lastErrorCode || (payload.failureInfo && payload.failureInfo.code));
    appendStatusRow(dl, "Last Error Message", payload.lastErrorMessage || (payload.failureInfo && payload.failureInfo.message));
    appendStatusRow(dl, "Failed At", formatEpoch(payload.failedAtEpochMs));

    if (payload.status === "WAITING_EVENT") {
      appendStatusRow(dl, "Awaited Event", payload.waitingForEventName || payload.awaitedEventName);
      appendStatusRow(dl, "Next Eligible Resume", formatEpoch(payload.nextEligibleResumeAtEpochMs));
      appendStatusRow(
        dl,
        "Resume Attempt Count",
        payload.resumeAttemptCount === null || payload.resumeAttemptCount === undefined ? "-" : String(payload.resumeAttemptCount)
      );
    }

    const failureInfoDetails = payload.failureInfo && payload.failureInfo.details && typeof payload.failureInfo.details === "object"
      ? payload.failureInfo.details
      : null;
    if (failureInfoDetails) {
      const masked = sanitizeForDisplay(failureInfoDetails, "details");
      const detailText = Object.keys(masked).length === 0
        ? "-"
        : Object.keys(masked).map(function (key) {
          return key + "=" + normalizeText(masked[key]);
        }).join(" | ");
      appendStatusRow(dl, "Failure Details", detailText);
    }

    el.executionStatusBlock.appendChild(dl);
  }

  function syncExecutionEventHelper(payload) {
    if (!payload || typeof payload !== "object") {
      return;
    }
    if (el.executionAwaitedEventName) {
      el.executionAwaitedEventName.value = normalizeText(payload.waitingForEventName || payload.awaitedEventName);
    }
    if (el.executionCorrelationId) {
      el.executionCorrelationId.value = normalizeText(payload.correlationId || payload.awaitedCorrelationId);
    }
    if (el.executionEventPayload && !normalizeText(el.executionEventPayload.value)) {
      el.executionEventPayload.value = "{}";
    }
  }

  async function loadExecutionDetails(executionId) {
    try {
      const payload = await api("/api/v1/executions/" + encodeURIComponent(executionId));
      state.currentExecution = payload;
      renderExecutionStatusBlock(payload);
      syncExecutionEventHelper(payload);
      printJson(el.executionDetails, payload);
      if (payload && payload.executionId) {
        el.traceExecutionId.value = payload.executionId;
      }
    } catch (error) {
      showStatus("Execution detail load failed: " + error.message, true);
    }
  }

  async function tryResume(executionId, preferAdminPath) {
    if (!executionId) {
      throw new Error("executionId is required");
    }
    if (preferAdminPath) {
      try {
        return await api("/api/v1/admin/executions/" + encodeURIComponent(executionId) + "/resume", "POST", {});
      } catch (error) {
        if (!isForbiddenMessage(error.message)) {
          throw error;
        }
      }
    }
    return api("/api/v1/executions/" + encodeURIComponent(executionId) + "/resume", "POST", {});
  }

  async function resumeExecution(executionId) {
    try {
      const response = await tryResume(executionId, false);
      printJson(el.executionDetails, response);
      renderExecutionStatusBlock(response);
      showStatus("Resume requested for: " + executionId, false);
      await loadExecutions(state.executionsMode);
      await loadExecutionDetails(executionId);
    } catch (error) {
      showStatus("Resume failed: " + error.message, true);
    }
  }

  async function publishAwaitedEventFromExecution() {
    const eventName = normalizeText(el.executionAwaitedEventName && el.executionAwaitedEventName.value);
    const correlationId = normalizeText(el.executionCorrelationId && el.executionCorrelationId.value);
    if (!eventName || !correlationId) {
      showStatus("Awaited event helper requires EventName and CorrelationId.", true);
      return;
    }
    let payload;
    try {
      payload = asJson(el.executionEventPayload ? el.executionEventPayload.value : "{}", {});
    } catch (error) {
      showStatus("Execution helper payload JSON invalid: " + error.message, true);
      return;
    }
    try {
      const response = await api("/api/v1/events/publish", "POST", {
        eventName: eventName,
        correlationId: correlationId,
        payload: payload
      });
      printJson(el.executionPublishResult, response);
      showStatus("Awaited event published: " + eventName, false);
      if (state.currentExecution && state.currentExecution.executionId) {
        await loadExecutionDetails(state.currentExecution.executionId);
      }
    } catch (error) {
      showStatus("Awaited event publish failed: " + error.message, true);
    }
