  function clearTraceSummary(message) {
    el.traceSummary.innerHTML = "";
    const text = document.createElement("div");
    text.className = "typed-help";
    text.textContent = message || "Trace not loaded.";
    el.traceSummary.appendChild(text);
  }

  function stepLabel(step) {
    const index = step && step.stepIndex !== null && step.stepIndex !== undefined ? step.stepIndex : "?";
    const name = normalizeText(step && step.stepName);
    if (name) {
      return "#" + index + " " + name;
    }
    return "#" + index;
  }

  function appendInfoLine(container, text) {
    const line = document.createElement("div");
    line.className = "typed-help";
    line.textContent = text;
    container.appendChild(line);
  }

  function firstDefined(values) {
    for (let i = 0; i < values.length; i += 1) {
      if (values[i] !== undefined && values[i] !== null && values[i] !== "") {
        return values[i];
      }
    }
    return "-";
  }

  function renderTraceSummary(trace) {
    if (!trace || !trace.meta) {
      clearTraceSummary("Trace not loaded.");
      return;
    }
    el.traceSummary.innerHTML = "";

    const header = document.createElement("div");
    header.textContent = "Execution " + normalizeText(trace.meta.executionId) + " | Flow " + normalizeText(trace.meta.flowName) + " | Outcome " + normalizeText(trace.outcome);
    el.traceSummary.appendChild(header);
    appendInfoLine(el.traceSummary, "Correlation: " + normalizeText(trace.meta.correlationId));
    appendInfoLine(el.traceSummary, "Started: " + formatEpoch(trace.startedAtEpochMs) + " | Ended: " + formatEpoch(trace.endedAtEpochMs));

    const steps = Array.isArray(trace.steps) ? trace.steps : [];
    appendInfoLine(el.traceSummary, "Steps: " + steps.length);
    steps.forEach(function (step) {
      const card = document.createElement("div");
      card.className = "trace-step-card";

      const header = document.createElement("div");
      header.className = "trace-step-card-header";
      header.textContent = stepLabel(step) + " | " + normalizeText(step.stepType);
      card.appendChild(header);

      const meta = document.createElement("div");
      meta.className = "trace-step-card-meta";
      meta.textContent =
        "outcome=" + normalizeText(step.outcome)
        + " | duration=" + formatDuration(step.startedAtEpochMs, step.endedAtEpochMs);
      card.appendChild(meta);

      const info = step && step.info && typeof step.info === "object" ? step.info : {};
      const policy = document.createElement("div");
      policy.className = "trace-step-card-policy";
      policy.textContent =
        "capability-policy: attempts="
        + firstDefined([info.attemptCount, info.retryCount, info.attempt])
        + ", timeoutMs=" + firstDefined([info.timeoutMs])
        + ", circuit=" + firstDefined([info.circuitState, info.circuit])
        + ", bulkhead=" + firstDefined([info.bulkheadState, info.bulkhead])
        + ", idempotency=" + firstDefined([info.idempotencyState, info.idempotency]);
      card.appendChild(policy);

      el.traceSummary.appendChild(card);
    });
  }

  function buildTraceTextSummary(trace) {
    if (!trace || !trace.meta) {
      return "Trace not loaded.";
    }
    const lines = [];
    lines.push("ExecutionId: " + normalizeText(trace.meta.executionId));
    lines.push("Flow: " + normalizeText(trace.meta.flowName));
    lines.push("CorrelationId: " + normalizeText(trace.meta.correlationId));
    lines.push("Outcome: " + normalizeText(trace.outcome));
    lines.push("Started: " + formatEpoch(trace.startedAtEpochMs));
    lines.push("Ended: " + formatEpoch(trace.endedAtEpochMs));
    lines.push("");
    const steps = Array.isArray(trace.steps) ? trace.steps : [];
    lines.push("Steps (" + steps.length + "):");
    steps.forEach(function (step) {
      const info = step && step.info && typeof step.info === "object" ? step.info : {};
      lines.push(
        " - "
        + stepLabel(step)
        + " | type=" + normalizeText(step.stepType)
        + " | outcome=" + normalizeText(step.outcome)
        + " | duration=" + formatDuration(step.startedAtEpochMs, step.endedAtEpochMs)
        + " | attempts=" + firstDefined([info.attemptCount, info.retryCount, info.attempt])
        + " | timeoutMs=" + firstDefined([info.timeoutMs])
        + " | circuit=" + firstDefined([info.circuitState, info.circuit])
        + " | bulkhead=" + firstDefined([info.bulkheadState, info.bulkhead])
        + " | idempotency=" + firstDefined([info.idempotencyState, info.idempotency])
      );
    });
    return lines.join("\n");
  }

