  function renderCorrelationTimeline(response) {
    if (!response) {
      printJson(el.timelineDetails, { message: "No data." });
      return;
    }
    const lines = [];
    lines.push("CorrelationId: " + normalizeText(response.correlationId));
    lines.push("");
    const executions = Array.isArray(response.executions) ? response.executions : [];
    lines.push("Executions (" + executions.length + "):");
    executions.forEach(function (item) {
      lines.push(
        "  - " + normalizeText(item.executionId)
        + " | status=" + normalizeText(item.status)
        + " | flow=" + normalizeText(item.flowName)
        + " | waitingFor=" + normalizeText(item.waitingForEventName)
        + " | attempts=" + (item.resumeAttemptCount === null || item.resumeAttemptCount === undefined ? "-" : item.resumeAttemptCount)
        + " | nextEligible=" + formatEpoch(item.nextEligibleResumeAtEpochMs)
        + " | lastErr=" + normalizeText(item.lastResumeErrorCode)
        + " | failCode=" + normalizeText(item.lastErrorCode)
        + " | failedAt=" + formatEpoch(item.failedAtEpochMs)
      );
    });
    lines.push("");
    const events = Array.isArray(response.events) ? response.events : [];
    lines.push("Events (" + events.length + "):");
    events.forEach(function (event) {
      lines.push(
        "  - " + formatEpoch(event.timestampEpochMs)
        + " | " + normalizeText(event.eventName)
        + " | id=" + normalizeText(event.eventId)
        + " | flow=" + normalizeText(event.flowName)
        + " | step=" + (event.stepIndex === null || event.stepIndex === undefined ? "-" : event.stepIndex)
      );
    });
    lines.push("");
    const traceExecutionIds = Array.isArray(response.traceExecutionIds) ? response.traceExecutionIds : [];
    lines.push("Trace ExecutionIds (" + traceExecutionIds.length + "):");
    traceExecutionIds.forEach(function (id) {
      lines.push("  - " + normalizeText(id));
    });
    el.timelineDetails.textContent = lines.join("\n");
  }

