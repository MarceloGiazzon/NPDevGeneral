  async function loadExecutions(mode) {
    state.executionsMode = mode || "recent";
    const limit = toInt(el.executionsLimit.value, DEFAULT_LIMIT);
    const offset = toInt(el.executionsOffset.value, DEFAULT_OFFSET);
    persistExecutionFilters(state.executionsMode);
    let path;
    if (state.executionsMode === "stale") {
      const olderThanMinutes = toInt(el.staleOlderThanMinutes.value, 60);
      path = "/api/v1/executions/stale?olderThanMinutes="
        + olderThanMinutes
        + "&limit=" + limit
        + "&offset=" + offset;
    } else {
      path = "/api/v1/executions/summaries?mode="
        + encodeURIComponent(state.executionsMode === "waiting" ? "waiting" : "recent")
        + "&limit=" + limit + "&offset=" + offset;
    }
    try {
      const rows = await api(path);
      const normalizedRows = Array.isArray(rows) ? rows : [];
      const selectedStatus = normalizeText(el.executionsStatusFilter.value).toUpperCase();
      const filteredRows = !selectedStatus
        ? normalizedRows
        : normalizedRows.filter(function (row) {
          return normalizeText(row && row.status).toUpperCase() === selectedStatus;
        });
      renderExecutionsTable(filteredRows);
      if (filteredRows.length > 0) {
        state.currentExecution = filteredRows[0];
        renderExecutionStatusBlock(filteredRows[0]);
        syncExecutionEventHelper(filteredRows[0]);
        printJson(el.executionDetails, filteredRows[0]);
      } else {
        state.currentExecution = null;
        renderExecutionStatusBlock(null);
        printJson(el.executionDetails, { message: "No executions found." });
      }
      showStatus("Executions loaded (" + state.executionsMode + "): " + filteredRows.length, false);
    } catch (error) {
      showStatus("Executions load failed: " + error.message, true);
    }
  }

  function traceSearchParams() {
    const params = new URLSearchParams();
    const flowName = normalizeText(el.traceFilterFlowName.value);
    const status = normalizeText(el.traceFilterStatus.value);
    const from = normalizeText(el.traceFilterFrom.value);
    const to = normalizeText(el.traceFilterTo.value);
    const limit = toInt(el.traceLimit.value, DEFAULT_LIMIT);
    const offset = toInt(el.traceOffset.value, DEFAULT_OFFSET);

    if (flowName) {
      params.set("flowName", flowName);
    }
    if (status) {
      params.set("status", status);
    }
    if (from) {
      params.set("from", from);
    }
    if (to) {
      params.set("to", to);
    }
    params.set("limit", String(limit));
    params.set("offset", String(offset));
    return params;
  }

