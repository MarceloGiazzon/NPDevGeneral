package {{apiPackage}};

import com.finalexec.api.OpenApiDocumentBuilder;
import com.finalexec.config.ModelHolder;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ResponseBody;

/**
 * INT-7: {@code /v3/api-docs} is generated from the app's live model (every concept, query, flow and
 * aggregate, with JSON schemas), so a {@code /model-reload} shows up and a client generator always
 * sees the routes the app really serves. Both endpoints answer 404 when
 * {@code npdev.api.docs.enabled=false} (env {@code NPDEV_API_DOCS_ENABLED}): the spec names every
 * concept and field and is served without authentication.
 */
@Controller
public class OpenApiController {

    private final ModelHolder modelHolder;
    private final String appTitle;
    private final boolean enabled;

    public OpenApiController(
            ModelHolder modelHolder,
            @Value("${spring.application.name:NPDev app}") String appTitle,
            @Value("${npdev.api.docs.enabled:true}") boolean enabled
    ) {
        this.modelHolder = modelHolder;
        this.appTitle = appTitle;
        this.enabled = enabled;
    }

    @GetMapping(value = "/v3/api-docs", produces = MediaType.APPLICATION_JSON_VALUE)
    @ResponseBody
    public ResponseEntity<?> docs() {
        if (!enabled) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
        }
        return ResponseEntity.ok(OpenApiDocumentBuilder.build(modelHolder.get(), appTitle));
    }

    @GetMapping(value = "/swagger-ui/index.html", produces = MediaType.TEXT_HTML_VALUE)
    @ResponseBody
    public ResponseEntity<String> swaggerUi() {
        if (!enabled) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
        }
        return ResponseEntity.ok(SWAGGER_PAGE);
    }

    // The key box stores the caller's own X-Api-Key in this browser's localStorage only; the page
    // never carries a key. No double-open-brace sequences anywhere in this text (Mustache template).
    private static final String SWAGGER_PAGE = """
            <!doctype html>
            <html lang="en">
            <head>
              <meta charset="utf-8">
              <title>API docs</title>
              <link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@5.17.14/swagger-ui.css" />
              <style>
                body { margin: 0; }
                .npdev-key { padding: 8px 16px; font-family: sans-serif; background: #f4f4f4; }
                .npdev-key input { width: 24em; max-width: 60%; }
              </style>
            </head>
            <body>
              <div class="npdev-key">
                <label for="npdev-api-key">API key (sent as X-Api-Key, kept in this browser only):</label>
                <input id="npdev-api-key" type="password" autocomplete="off" />
              </div>
              <div id="swagger-ui"></div>
              <script src="https://unpkg.com/swagger-ui-dist@5.17.14/swagger-ui-bundle.js"></script>
              <script>
                var KEY = 'npdev.docs.apiKey';
                var box = document.getElementById('npdev-api-key');
                try { box.value = localStorage.getItem(KEY) || ''; } catch (e) { box.value = ''; }
                box.addEventListener('input', function () {
                  try { localStorage.setItem(KEY, box.value); } catch (e) { /* storage blocked */ }
                });
                window.ui = SwaggerUIBundle({
                  url: '/v3/api-docs',
                  dom_id: '#swagger-ui',
                  persistAuthorization: true,
                  requestInterceptor: function (req) {
                    var k = box.value;
                    if (k) { req.headers['X-Api-Key'] = k; }
                    return req;
                  }
                });
              </script>
            </body>
            </html>
            """;
}
