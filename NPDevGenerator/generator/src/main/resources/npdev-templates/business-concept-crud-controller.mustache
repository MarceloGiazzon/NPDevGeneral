    private static int sanitizePage(Integer page) {
        return page == null ? 0 : Math.max(0, page);
    }

    private static int sanitizeSize(Integer size) {
        if (size == null) {
            return DEFAULT_PAGE_SIZE;
        }
        return Math.max(1, Math.min(MAX_PAGE_SIZE, size));
    }

    private static String normalizeSortField(ConceptMetadata metadata, String requestedSort) {
        String sort = requestedSort == null || requestedSort.isBlank() ? metadata.idField() : requestedSort.trim();
        FieldMetadata field = metadata.field(sort);
        if (field == null || !field.sortable()) {
            return null;
        }
        return field.name();
    }

    private static String normalizeDirection(String direction) {
        return "desc".equalsIgnoreCase(direction == null ? "" : direction.trim()) ? "desc" : "asc";
    }

    private static List<Map<String, Object>> filterRows(
            ConceptMetadata metadata,
            List<Map<String, Object>> rows,
            String filter
    ) {
        if (filter == null || filter.isBlank()) {
            return rows;
        }
        String needle = filter.trim().toLowerCase(Locale.ROOT);
        List<String> filterableFields = metadata.fields().stream()
                .filter(FieldMetadata::filterable)
                .map(FieldMetadata::name)
                .toList();
        if (filterableFields.isEmpty()) {
            return rows;
        }
        List<Map<String, Object>> filtered = new ArrayList<>();
        for (Map<String, Object> row : rows) {
            for (String field : filterableFields) {
                Object value = row.get(field);
                if (value != null && String.valueOf(value).toLowerCase(Locale.ROOT).contains(needle)) {
                    filtered.add(row);
                    break;
                }
            }
        }
        return filtered;
    }


    private static FilterResult applyWhere(
            ConceptMetadata metadata,
            List<Map<String, Object>> rows,
            String where
    ) {
        if (where == null || where.isBlank()) {
            return new FilterResult(rows, null);
        }
        List<WhereClause> clauses = new ArrayList<>();
        for (String rawClause : where.split("[;,]")) {
            if (rawClause == null || rawClause.isBlank()) {
                continue;
            }
            WhereClause parsed = parseWhereClause(rawClause.trim());
            if (parsed == null) {
                return new FilterResult(rows, "Invalid where clause: " + rawClause.trim());
            }
            FieldMetadata field = metadata.field(parsed.field());
            if (field == null) {
                return new FilterResult(rows, "Unknown where field: " + parsed.field());
            }
            if (!field.enumValues().isEmpty()
                    && !"contains".equals(parsed.operator())
                    && field.enumValues().stream().noneMatch(value -> value.equals(parsed.value()))) {
                return new FilterResult(rows, "Invalid enum value for where field " + parsed.field()
                        + ": " + parsed.value() + " (allowed: " + field.enumValues() + ")");
            }
            clauses.add(parsed);
        }
        if (clauses.isEmpty()) {
            return new FilterResult(rows, null);
        }
        List<Map<String, Object>> filtered = new ArrayList<>();
        for (Map<String, Object> row : rows) {
            boolean keep = true;
            for (WhereClause clause : clauses) {
                if (!matchesWhere(row.get(clause.field()), clause.operator(), clause.value())) {
                    keep = false;
                    break;
                }
            }
            if (keep) {
                filtered.add(row);
            }
        }
        return new FilterResult(filtered, null);
    }

    private static WhereClause parseWhereClause(String rawClause) {
        String field;
        String operator;
        String value;
        String[] colonParts = rawClause.split(":", 3);
        if (colonParts.length == 3) {
            field = colonParts[0].trim();
            operator = colonParts[1].trim().toLowerCase(Locale.ROOT);
            value = colonParts[2].trim();
        } else {
            int equalsIndex = rawClause.indexOf('=');
            if (equalsIndex < 1) {
                return null;
            }
            field = rawClause.substring(0, equalsIndex).trim();
            operator = "eq";
            value = rawClause.substring(equalsIndex + 1).trim();
        }
        if (field.isBlank() || value.isBlank() || !List.of("eq", "ne", "contains").contains(operator)) {
            return null;
        }
        return new WhereClause(field, operator, value);
    }

    private static boolean matchesWhere(Object rawValue, String operator, String expected) {
        String actual = rawValue == null ? "" : String.valueOf(rawValue);
        return switch (operator) {
            case "eq" -> actual.equalsIgnoreCase(expected);
            case "ne" -> !actual.equalsIgnoreCase(expected);
            case "contains" -> actual.toLowerCase(Locale.ROOT).contains(expected.toLowerCase(Locale.ROOT));
            default -> false;
        };
    }

    private static Comparator<Map<String, Object>> rowComparator(String sortField, String direction) {
        Comparator<Map<String, Object>> comparator = (left, right) -> compareValues(left.get(sortField), right.get(sortField));
        if ("desc".equals(direction)) {
            comparator = comparator.reversed();
        }
        return comparator;
    }

    @SuppressWarnings({"rawtypes", "unchecked"})
    private static int compareValues(Object left, Object right) {
        if (left == null && right == null) {
            return 0;
        }
        if (left == null) {
            return 1;
        }
        if (right == null) {
            return -1;
        }
        if (left instanceof Comparable comparable && left.getClass().isInstance(right)) {
            return comparable.compareTo(right);
        }
        return String.valueOf(left).compareToIgnoreCase(String.valueOf(right));
    }

    private static Map<String, Object> toRecord(ConceptMetadata metadata, Object source) {
        Map<String, Object> out = new LinkedHashMap<>();
        for (FieldMetadata field : metadata.fields()) {
            out.put(field.name(), readValue(source, field.name()));
        }
        return out;
    }

    private static Object readValue(Object source, String fieldName) {
        if (source == null || fieldName == null || fieldName.isBlank()) {
            return null;
        }
        String suffix = fieldName.substring(0, 1).toUpperCase(Locale.ROOT) + fieldName.substring(1);
        for (String methodName : List.of("get" + suffix, "is" + suffix)) {
            try {
                return source.getClass().getMethod(methodName).invoke(source);
            } catch (Exception ignored) {
                // Keep reflection localized to generic response projection.
            }
        }
        return null;
    }

    private static UUID parseUuid(String id) {
        if (id == null || id.isBlank()) {
            return null;
        }
        try {
            return UUID.fromString(id.trim());
        } catch (IllegalArgumentException exception) {
            return null;
        }
    }

    private static ResponseEntity<Map<String, Object>> badRequest(String code, String message) {
        return ResponseEntity.badRequest().body(error(code, message));
    }

    private static Map<String, Object> error(String code, String message) {
        Map<String, Object> out = new LinkedHashMap<>();
        out.put("code", code);
        out.put("message", message == null || message.isBlank() ? code : message);
        return out;
    }

    private static String readableConstraintMessage(DataIntegrityViolationException exception) {
        String message = exception.getMostSpecificCause() == null
                ? exception.getMessage()
                : exception.getMostSpecificCause().getMessage();
        return message == null || message.isBlank()
                ? "Delete or save failed because of a database constraint."
                : message;
    }

    private record ConceptMetadata(
            String conceptName,
            String displayName,
            String tableName,
            String idField,
            String endpointBase,
            List<FieldMetadata> fields,
            Map<String, FieldMetadata> fieldsByName
    ) {
        ConceptMetadata(String conceptName, String displayName, String tableName, String idField, String endpointBase) {
            this(conceptName, displayName, tableName, idField, endpointBase, new ArrayList<>(), new LinkedHashMap<>());
        }

        void addField(FieldMetadata field) {
            fields.add(field);
            fieldsByName.put(field.name(), field);
        }

        FieldMetadata field(String name) {
            return fieldsByName.get(name);
        }
    }

    private record FieldMetadata(
            String name,
            String label,
            String columnName,
            String type,
            boolean required,
            boolean id,
            boolean readOnly,
            boolean sortable,
            boolean filterable,
            String widget,
            List<String> enumValues
    ) {
    }

    private record FilterResult(List<Map<String, Object>> rows, String error) {
    }

    private record WhereClause(String field, String operator, String value) {
    }

    private record ConceptBinding<T>(
            ConceptMetadata metadata,
            Supplier<List<T>> list,
            Function<UUID, Optional<T>> getById,
            Function<Map<String, Object>, T> create,
            BiFunction<UUID, Map<String, Object>, Optional<T>> update,
            Predicate<UUID> delete
    ) {
        static <T> ConceptBinding<T> of(
                ConceptMetadata metadata,
                Supplier<List<T>> list,
                Function<UUID, Optional<T>> getById,
                Function<Map<String, Object>, T> create,
                BiFunction<UUID, Map<String, Object>, Optional<T>> update,
                Predicate<UUID> delete
        ) {
            return new ConceptBinding<>(metadata, list, getById, create, update, delete);
        }
    }
