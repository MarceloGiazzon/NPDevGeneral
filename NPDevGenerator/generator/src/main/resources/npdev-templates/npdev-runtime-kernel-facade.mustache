    public CorrelationTimeline correlationTimeline(
            String correlationId,
            int limit,
            int offset,
            ExecutionContext requesterContext
    ) {
        long startedAtMs = System.currentTimeMillis();
        ExecutionContext requester = normalizeContext(requesterContext);
        metricInc(
                "npdev.api.correlation.timeline",
                requester,
                Map.of("outcome", "ATTEMPT")
        );
        if (correlationId == null || correlationId.isBlank()) {
            audit(requester, "READ_CORRELATION", "CORRELATION", "<blank>", OUTCOME_DENY, "invalid_input", Map.of());
            metricInc(
                    "npdev.api.correlation.timeline",
                    requester,
                    Map.of("outcome", "DENY")
            );
            metricObserveMs(
                    "npdev.api.correlation.timeline.duration_ms",
                    startedAtMs,
                    requester,
                    Map.of("outcome", "DENY")
            );
            return new CorrelationTimeline(correlationId, List.of(), List.of(), List.of());
        }
        if (!executionAuthorizationPolicy.canListExecutions(requester, requester.tenantId())
                || !executionAuthorizationPolicy.canReadEvents(requester, requester.tenantId())) {
            audit(requester, "READ_CORRELATION", "CORRELATION", correlationId, OUTCOME_DENY, "forbidden", Map.of());
            metricInc(
                    "npdev.api.correlation.timeline",
                    requester,
                    Map.of("outcome", "DENY")
            );
            metricObserveMs(
                    "npdev.api.correlation.timeline.duration_ms",
                    startedAtMs,
                    requester,
                    Map.of("outcome", "DENY")
            );
            throw forbidden();
        }
        int scopedLimit = normalizeLimit(limit);
        int scopedOffset = normalizeOffset(offset);

        List<ExecutionSummary> executions = executionSummaryStore.listByCorrelation(
                requester.tenantId(),
                correlationId,
                scopedLimit,
                scopedOffset
        );
        List<EventMetaSummary> events = eventMetaStore.listByCorrelation(
                requester.tenantId(),
                correlationId,
                scopedLimit,
                scopedOffset
        );
        TraceQuery summaryQuery = new TraceQuery(
                correlationId,
                null,
                null,
                null,
                null,
                scopedLimit,
                scopedOffset,
                requester.tenantId(),
                requester.actorId()
        );
        Set<String> traceExecutionIds = traceSummaryStore.searchSummaries(summaryQuery).stream()
                .map(TraceSummary::executionId)
                .collect(LinkedHashSet::new, LinkedHashSet::add, LinkedHashSet::addAll);
        audit(
                requester,
                "READ_CORRELATION",
                "CORRELATION",
                correlationId,
                OUTCOME_ALLOW,
                "ok",
                Map.of(
                        "events", String.valueOf(events.size()),
                        "executions", String.valueOf(executions.size()),
                        "traces", String.valueOf(traceExecutionIds.size())
                )
        );
        metricInc(
                "npdev.api.correlation.timeline",
                requester,
                Map.of("outcome", "ALLOW")
        );
        metricObserveMs(
                "npdev.api.correlation.timeline.duration_ms",
                startedAtMs,
                requester,
                Map.of("outcome", "ALLOW")
        );
        return new CorrelationTimeline(correlationId, executions, events, List.copyOf(traceExecutionIds));
    }

