    public ExecutionResult executeFlow(String flowName, Map<String, Object> input, ExecutionContext executionContext) {
        long startedAtMs = System.currentTimeMillis();
        ExecutionContext ctx = normalizeContext(executionContext);
        metricInc("npdev.api.execute.started", ctx, Map.of("flowName", safe(flowName)));
        if (!executionAuthorizationPolicy.canExecuteFlow(ctx, flowName)) {
            audit(ctx, "EXECUTE_FLOW", "FLOW", flowName, OUTCOME_DENY, "forbidden", Map.of());
            metricInc(
                    "npdev.api.execute.failed",
                    ctx,
                    Map.of("flowName", safe(flowName), "errorCode", "forbidden")
            );
            metricObserveMs("npdev.api.execute.duration_ms", startedAtMs, ctx, Map.of("flowName", safe(flowName)));
            throw forbidden();
        }
        try {
            ExecutionResult result = kernelRunner.executeFlow(
                    flowName,
                    input == null ? Map.of() : input,
                    ctx
            );
            audit(
                    ctx,
                    "EXECUTE_FLOW",
                    "FLOW",
                    flowName,
                    OUTCOME_ALLOW,
                    statusReason(result),
                    Map.of("status", statusValue(result))
            );
            if (result != null
                    && (result.getStatus() == null
                    || result.getStatus() == com.npdev.kernel.ExecutionStatus.OK
                    || result.getStatus() == com.npdev.kernel.ExecutionStatus.WAITING_EVENT)) {
                metricInc(
                        "npdev.api.execute.completed",
                        ctx,
                        Map.of("flowName", safe(flowName), "status", statusValue(result))
                );
            } else {
                metricInc(
                        "npdev.api.execute.failed",
                        ctx,
                        Map.of("flowName", safe(flowName), "errorCode", metricErrorCode(result))
                );
            }
            metricObserveMs("npdev.api.execute.duration_ms", startedAtMs, ctx, Map.of("flowName", safe(flowName)));
            return result;
        } catch (CorrelationOwnershipViolationException ignored) {
            audit(ctx, "EXECUTE_FLOW", "FLOW", flowName, OUTCOME_DENY, "correlation_owner_conflict", Map.of());
            metricInc(
                    "npdev.api.execute.failed",
                    ctx,
                    Map.of("flowName", safe(flowName), "errorCode", "correlation_owner_conflict")
            );
            metricObserveMs("npdev.api.execute.duration_ms", startedAtMs, ctx, Map.of("flowName", safe(flowName)));
            throw forbidden();
        } catch (RuntimeException exception) {
            audit(ctx, "EXECUTE_FLOW", "FLOW", flowName, OUTCOME_ERROR, errorReason(exception), Map.of());
            metricInc(
                    "npdev.api.execute.failed",
                    ctx,
                    Map.of("flowName", safe(flowName), "errorCode", errorReason(exception))
            );
            metricObserveMs("npdev.api.execute.duration_ms", startedAtMs, ctx, Map.of("flowName", safe(flowName)));
            throw exception;
        }
    }

    public ExecutionResult resumeExecution(String executionId, ExecutionContext executionContext) {
        long startedAtMs = System.currentTimeMillis();
        ExecutionContext ctx = normalizeContext(executionContext);
        metricInc("npdev.api.resume.attempted", ctx, Map.of("outcome", "ATTEMPT"));
        Optional<FlowInstance> instanceOpt = flowInstanceStore.findByExecutionId(executionId);
        if (instanceOpt.isPresent()
                && !executionAuthorizationPolicy.canResumeExecution(ctx, instanceOpt.get())) {
            audit(ctx, "RESUME_EXECUTION", "EXECUTION", executionId, OUTCOME_DENY, "forbidden", Map.of());
            metricInc("npdev.api.resume.failed", ctx, Map.of("errorCode", "forbidden"));
            metricObserveMs("npdev.api.resume.duration_ms", startedAtMs, ctx, Map.of("outcome", "DENY"));
            throw forbidden();
        }
        try {
            ExecutionResult result = kernelRunner.resumeExecution(executionId, ctx);
            audit(
                    ctx,
                    "RESUME_EXECUTION",
                    "EXECUTION",
                    executionId,
                    OUTCOME_ALLOW,
                    statusReason(result),
                    Map.of("status", statusValue(result))
            );
            metricObserveMs("npdev.api.resume.duration_ms", startedAtMs, ctx, Map.of("status", statusValue(result)));
            return result;
        } catch (RuntimeException exception) {
            audit(ctx, "RESUME_EXECUTION", "EXECUTION", executionId, OUTCOME_ERROR, errorReason(exception), Map.of());
            metricInc("npdev.api.resume.failed", ctx, Map.of("errorCode", errorReason(exception)));
            metricObserveMs("npdev.api.resume.duration_ms", startedAtMs, ctx, Map.of("status", "ERROR"));
            throw exception;
        }
    }

    public EventEnvelope publishExternalEvent(
            String eventName,
            String correlationId,
            String causationId,
            Map<String, Object> payload,
            ExecutionContext executionContext
    ) {
        long startedAtMs = System.currentTimeMillis();
        ExecutionContext ctx = normalizeContext(executionContext);
        metricInc("npdev.api.event.publish", ctx, Map.of("outcome", "ATTEMPT"));
        if (!executionAuthorizationPolicy.canPublishEvent(ctx, eventName, correlationId)) {
            audit(
                    ctx,
                    "PUBLISH_EVENT",
                    "EVENT",
                    eventName == null ? "<none>" : eventName,
                    OUTCOME_DENY,
                    "forbidden",
                    Map.of("correlationId", safe(correlationId))
            );
            metricInc("npdev.api.execute.failed", ctx, Map.of("errorCode", "forbidden", "mode", "publish_event"));
            metricObserveMs(
                    "npdev.api.event.publish.duration_ms",
                    startedAtMs,
                    ctx,
                    Map.of("outcome", "DENY")
            );
            throw forbidden();
        }
        try {
            EventEnvelope envelope = kernelRunner.publishExternalEvent(
                    eventName,
                    payload == null ? Map.of() : payload,
                    correlationId,
                    causationId,
                    ctx
            );
            audit(
                    ctx,
                    "PUBLISH_EVENT",
                    "EVENT",
                    envelope.eventId(),
                    OUTCOME_ALLOW,
                    "ok",
                    Map.of("eventName", safe(envelope.eventName()), "correlationId", safe(envelope.correlationId()))
            );
