    public KernelFacade(
            KernelRunner kernelRunner,
            TraceStore traceStore,
            TraceRedactionPolicy traceRedactionPolicy,
            EventRedactionPolicy eventRedactionPolicy,
            ExecutionRedactionPolicy executionRedactionPolicy,
            ExecutionAuthorizationPolicy executionAuthorizationPolicy,
            FlowInstanceStore flowInstanceStore,
            EventStore eventStore,
            TraceSummaryStore traceSummaryStore,
            ExecutionSummaryStore executionSummaryStore,
            EventMetaStore eventMetaStore,
            AuditLogStore auditLogStore,
            CircuitBreakerStateStore circuitBreakerStateStore,
            IdempotencyStore idempotencyStore,
            CorrelationOwnershipStore correlationOwnershipStore,
            MetricsSink metricsSink,
            CompiledModel compiledModel
    ) {
        this.kernelRunner = kernelRunner;
        this.traceStore = traceStore;
        this.traceRedactionPolicy = traceRedactionPolicy == null ? TraceRedactionPolicy.NOOP : traceRedactionPolicy;
        this.eventRedactionPolicy = eventRedactionPolicy == null ? EventRedactionPolicy.NOOP : eventRedactionPolicy;
        this.executionRedactionPolicy = executionRedactionPolicy == null
                ? ExecutionRedactionPolicy.NOOP
                : executionRedactionPolicy;
        this.executionAuthorizationPolicy = executionAuthorizationPolicy == null
                ? ExecutionAuthorizationPolicy.ALLOW_ALL
                : executionAuthorizationPolicy;
        this.flowInstanceStore = flowInstanceStore == null ? FlowInstanceStore.noop() : flowInstanceStore;
        this.eventStore = eventStore;
        this.traceSummaryStore = traceSummaryStore == null ? TraceSummaryStore.noop() : traceSummaryStore;
        this.executionSummaryStore = executionSummaryStore == null
                ? ExecutionSummaryStore.noop()
                : executionSummaryStore;
        this.eventMetaStore = eventMetaStore == null ? EventMetaStore.noop() : eventMetaStore;
        this.auditLogStore = auditLogStore == null ? AuditLogStore.noop() : auditLogStore;
