    }

    private Map<String, Object> idempotencySummary(IdempotencyRecord record) {
        Map<String, Object> out = new LinkedHashMap<>();
        out.put("tenantId", safe(record.tenantId()));
        out.put("idempotencyKey", safe(record.idempotencyKey()));
        out.put("capability", safe(record.capabilityName()));
        out.put("operation", safe(record.operationName()));
        out.put("createdAtMs", record.createdAtMs());
        out.put("status", safe(record.status()));
        out.put("errorCode", safe(record.errorCode()));
        out.put("resultAvailable", record.resultJsonRedacted() != null && !record.resultJsonRedacted().isBlank());
        return Map.copyOf(out);
    }

    private static String evidenceStatus(
            List<?> events,
            List<?> traces,
            List<?> audits,
            List<?> idempotencyRecords,
            List<?> correlationOwners
    ) {
        return events.isEmpty() && traces.isEmpty() && audits.isEmpty() && idempotencyRecords.isEmpty() && correlationOwners.isEmpty()
                ? "not_found"
                : events.isEmpty() || traces.isEmpty() || audits.isEmpty() || idempotencyRecords.isEmpty() || correlationOwners.isEmpty()
                        ? "partial"
                        : "complete";
    }

    private static String firstAuditMeta(List<AuditRecord> audits, String key) {
        return audits.stream()
                .map(AuditRecord::meta)
                .map(meta -> meta.get(key))
                .filter(value -> value != null && !value.isBlank())
                .findFirst()
                .orElse("");
    }

    private static String firstTraceTag(List<FlowTrace> traces, String key) {
        return traces.stream()
                .map(FlowTrace::meta)
                .map(FlowTraceMeta::tags)
                .map(tags -> tags.get(key))
                .filter(value -> value != null && !String.valueOf(value).isBlank())
                .map(String::valueOf)
                .findFirst()
                .orElse("");
    }

    private static String firstEventPayloadValue(List<EventEnvelope> events, String key) {
        return events.stream()
                .map(EventEnvelope::payload)
                .map(payload -> payload.get(key))
                .filter(value -> value != null && !String.valueOf(value).isBlank())
                .map(String::valueOf)
                .findFirst()
                .orElse("");
    }

    private static Map<String, Object> safePayloadSummary(Map<String, Object> payload) {
        if (payload == null || payload.isEmpty()) {
            return Map.of("redacted", true, "fieldCount", 0);
        }
        Map<String, Object> out = new LinkedHashMap<>();
        out.put("redacted", true);
        out.put("fieldCount", payload.size());
        for (String key : List.of("actionName", "procedureName", "executionId", "correlationId", "status", "createdCount")) {
            if (payload.containsKey(key)) {
                out.put(key, safe(String.valueOf(payload.get(key))));
            }
        }
        return Map.copyOf(out);
    }

    private static Map<String, Object> safeObjectMap(Map<String, Object> values) {
        if (values == null || values.isEmpty()) {
            return Map.of();
        }
        Map<String, Object> out = new LinkedHashMap<>();
        for (Map.Entry<String, Object> entry : values.entrySet()) {
            out.put(safe(entry.getKey()), safe(String.valueOf(entry.getValue())));
        }
        return Map.copyOf(out);
    }

    public String claimGeneratedActionCorrelation(String correlationId, ExecutionContext executionContext) {
        ExecutionContext ctx = normalizeContext(executionContext);
        try {
            correlationOwnershipStore.claimCorrelation(correlationId, ctx.tenantId());
            Optional<String> owner = correlationOwnershipStore.findTenantByCorrelationId(correlationId);
            if (owner.isPresent() && owner.get().equals(ctx.tenantId())) {
                return "owned: correlationId=" + safe(correlationId);
            }
            return "failed: correlation owner readback missing";
        } catch (RuntimeException exception) {
            return "failed: " + errorReason(exception);
        }
    }

    public Optional<IdempotencyRecord> findGeneratedActionIdempotency(
            String actionName,
            String idempotencyKey,
            ExecutionContext executionContext
    ) {
        ExecutionContext ctx = normalizeContext(executionContext);
        if (actionName == null || actionName.isBlank() || idempotencyKey == null || idempotencyKey.isBlank()) {
            return Optional.empty();
        }
        return idempotencyStore.find(
                ctx.tenantId(),
                generatedActionCapabilityName(actionName),
                generatedActionOperationName(actionName, ctx),
                idempotencyKey
        );
    }

    public String recordGeneratedActionIdempotencySuccess(
            String actionName,
            String idempotencyKey,
            String resultJsonRedacted,
            ExecutionContext executionContext
    ) {
        ExecutionContext ctx = normalizeContext(executionContext);
        if (actionName == null || actionName.isBlank() || idempotencyKey == null || idempotencyKey.isBlank()) {
            return "disabled: no idempotencyKey supplied";
        }
        try {
            idempotencyStore.saveSuccess(
                    ctx.tenantId(),
                    generatedActionCapabilityName(actionName),
                    generatedActionOperationName(actionName, ctx),
                    idempotencyKey,
                    resultJsonRedacted == null ? "{}" : resultJsonRedacted,
                    System.currentTimeMillis()
            );
            Optional<IdempotencyRecord> row = findGeneratedActionIdempotency(actionName, idempotencyKey, ctx);
            if (row.isPresent() && row.get().success()) {
                return "recorded: idempotencyKey=" + safe(idempotencyKey);
            }
            return "failed: idempotency readback missing";
        } catch (RuntimeException exception) {
            return "failed: " + errorReason(exception);
        }
    }

    public String recordGeneratedActionIdempotencyFailure(
            String actionName,
            String idempotencyKey,
            String errorCode,
            ExecutionContext executionContext
    ) {
        ExecutionContext ctx = normalizeContext(executionContext);
        if (actionName == null || actionName.isBlank() || idempotencyKey == null || idempotencyKey.isBlank()) {
            return "disabled: no idempotencyKey supplied";
        }
        try {
            idempotencyStore.saveFailure(
                    ctx.tenantId(),
                    generatedActionCapabilityName(actionName),
                    generatedActionOperationName(actionName, ctx),
                    idempotencyKey,
                    safe(errorCode),
                    System.currentTimeMillis()
            );
            Optional<IdempotencyRecord> row = findGeneratedActionIdempotency(actionName, idempotencyKey, ctx);
            if (row.isPresent() && IdempotencyRecord.STATUS_FAILED.equals(row.get().status())) {
                return "recorded: idempotencyKey=" + safe(idempotencyKey);
            }
            return "failed: idempotency failure readback missing";
        } catch (RuntimeException exception) {
            return "failed: " + errorReason(exception);
        }
    }

    public String recordGeneratedActionAudit(
            String actionName,
            String auditResourceType,
            String executionId,
            String correlationId,
            String outcome,
            String reasonCode,
            ExecutionContext executionContext
    ) {
        ExecutionContext ctx = normalizeContext(executionContext);
        String action = "GENERATED_ACTION_" + safe(outcome).toUpperCase().replace('-', '_');
        AuditRecord record = AuditRecord.create(
                ctx.tenantId(),
                ctx.actorId(),
                ctx.roles(),
                action,
                auditResourceType == null || auditResourceType.isBlank() ? "GENERATED_ACTION" : auditResourceType,
                executionId,
                safe(outcome),
                safe(reasonCode),
                safeTags(ctx.tags()),
                safeMeta(Map.of("actionName", safe(actionName), "correlationId", safe(correlationId)))
        );
        try {
            auditLogStore.append(record);
            List<AuditRecord> rows = auditLogStore.search(new AuditQuery(
                    ctx.tenantId(),
                    ctx.actorId(),
                    action,
                    record.resourceType(),
                    executionId,
                    null,
                    null,
                    10,
                    0
            ));
            boolean found = rows.stream().anyMatch(row -> record.auditId().equals(row.auditId()));
            return found ? "written: auditId=" + record.auditId() : "failed: audit readback missing";
        } catch (RuntimeException exception) {
            return "failed: " + errorReason(exception);
        }
    }

    public String writeGeneratedActionTrace(
            String actionName,
            String executionId,
            String correlationId,
            String outcome,
            long startedAtEpochMs,
            long endedAtEpochMs,
            int sideEffectCountBefore,
            int sideEffectCountAfter,
            ExecutionContext executionContext
    ) {
        ExecutionContext ctx = normalizeContext(executionContext);
        long started = startedAtEpochMs <= 0L ? System.currentTimeMillis() : startedAtEpochMs;
        long ended = Math.max(started, endedAtEpochMs <= 0L ? System.currentTimeMillis() : endedAtEpochMs);
        StepOutcome stepOutcome = "ok".equalsIgnoreCase(outcome) ? StepOutcome.OK : StepOutcome.FAILED;
        FlowTraceMeta meta = new FlowTraceMeta(
                executionId,
                correlationId,
                "generated.action." + safe(actionName),
                ctx.tenantId(),
                ctx.actorId(),
                Map.of("actionName", safe(actionName))
        );
        StepTrace step = new StepTrace(
                0,
                safe(actionName),
                "trusted-procedure",
                started,
                ended,
                stepOutcome,
                Map.of(
                        "sideEffectCountBefore", sideEffectCountBefore,
                        "sideEffectCountAfter", sideEffectCountAfter
                ),
                List.of(),
                null
        );
        FlowTrace trace = new FlowTrace(meta, started, ended, stepOutcome, List.of(step));
        try {
            traceStore.save(trace);
            return traceStore.findByExecutionId(executionId).isPresent()
                    ? "written: executionId=" + safe(executionId)
                    : "failed: trace readback missing";
        } catch (RuntimeException exception) {
            return "failed: " + errorReason(exception);
        }
    }

    public String verifyGeneratedActionEvent(String eventName, String correlationId, String eventId, ExecutionContext executionContext) {
        ExecutionContext ctx = normalizeContext(executionContext);
        try {
            Optional<EventEnvelope> row = eventStore.findFirst(eventName, correlationId, ctx.tenantId());
            if (row.isPresent() && (eventId == null || eventId.isBlank() || eventId.equals(row.get().eventId()))) {
                return "written: eventId=" + row.get().eventId();
            }
            return "failed: event readback missing";
        } catch (RuntimeException exception) {
            return "failed: " + errorReason(exception);
        }
    }

    private static ExecutionContext normalizeContext(ExecutionContext context) {
        return context == null ? ExecutionContext.anonymous() : context;
    }

    private ExecutionContext redactionContextFor(ExecutionContext requester) {
        if (executionAuthorizationPolicy.canUseDebugView(requester)) {
            return requester;
        }
        return requester.withRoles(Set.of("USER"));
    }

    private static int normalizeLimit(int limit) {
        if (limit <= 0) {
            return 50;
        }
        return Math.min(limit, 1000);
    }

    private static int normalizeOffset(int offset) {
        return Math.max(offset, 0);
    }

    private static TraceQuery tenantScopedTraceQuery(TraceQuery query, ExecutionContext requester) {
        TraceQuery effective = query == null ? TraceQuery.empty() : query;
        return new TraceQuery(
                effective.correlationId(),
                effective.flowName(),
                effective.status(),
                effective.fromEpochMs(),
                effective.toEpochMs(),
                effective.limit(),
                effective.offset(),
                requester.tenantId(),
                effective.actorId()
        );
    }

    private static AuditQuery tenantScopedAuditQuery(AuditQuery query, ExecutionContext requester) {
        AuditQuery effective = query == null ? AuditQuery.emptyForTenant(requester.tenantId()) : query;
        return new AuditQuery(
                requester.tenantId(),
                effective.actorId(),
                effective.action(),
                effective.resourceType(),
                effective.resourceId(),
                effective.fromMs(),
                effective.toMs(),
                effective.limit(),
                effective.offset()
        );
    }

    private void metricInc(String name, ExecutionContext context, Map<String, String> tags) {
        try {
            metricsSink.inc(name, mergeMetricTags(context, tags));
        } catch (RuntimeException ignored) {
            // Metrics must never break primary execution.
        }
    }

    private void metricObserveMs(
            String name,
            long startedAtEpochMs,
            ExecutionContext context,
            Map<String, String> tags
    ) {
        try {
            long durationMs = Math.max(0L, System.currentTimeMillis() - startedAtEpochMs);
            metricsSink.observeMs(name, durationMs, mergeMetricTags(context, tags));
        } catch (RuntimeException ignored) {
            // Metrics must never break primary execution.
        }
    }

    private <T> T metricTimed(
            String name,
            ExecutionContext context,
            Map<String, String> tags,
            Supplier<T> supplier
    ) {
        long startedAtEpochMs = System.currentTimeMillis();
        try {
            return supplier.get();
        } finally {
            metricObserveMs(name, startedAtEpochMs, context, tags);
        }
    }

    private static Map<String, String> mergeMetricTags(ExecutionContext context, Map<String, String> tags) {
        ExecutionContext safeContext = normalizeContext(context);
        Map<String, String> merged = new LinkedHashMap<>();
        merged.put("tenantId", safe(safeContext.tenantId()));
        if (tags != null) {
            for (Map.Entry<String, String> entry : tags.entrySet()) {
                String key = safe(entry.getKey());
                if ("<none>".equals(key)) {
                    continue;
                }
                merged.put(key, safe(entry.getValue()));
            }
        }
        return Map.copyOf(merged);
    }

    private void audit(
            ExecutionContext context,
            String action,
            String resourceType,
            String resourceId,
            String outcome,
            String reasonCode,
            Map<String, String> meta
    ) {
        try {
            ExecutionContext safeContext = normalizeContext(context);
            auditLogStore.append(AuditRecord.create(
                    safeContext.tenantId(),
                    safeContext.actorId(),
                    safeContext.roles(),
                    action,
                    resourceType,
                    safe(resourceId),
                    outcome,
                    safe(reasonCode),
                    safeTags(safeContext.tags()),
                    safeMeta(meta)
            ));
        } catch (RuntimeException ignored) {
            // Audit logging must never break primary execution.
        }
    }

    private static Map<String, String> safeTags(Map<String, String> tags) {
        if (tags == null || tags.isEmpty()) {
            return Map.of();
        }
        Map<String, String> safe = new LinkedHashMap<>();
        for (Map.Entry<String, String> entry : tags.entrySet()) {
            String key = safe(entry.getKey());
            if (key.equals("<none>")) {
                continue;
            }
            safe.put(key, safe(entry.getValue()));
        }
        return Map.copyOf(safe);
    }

    private static Map<String, String> safeMeta(Map<String, String> meta) {
        if (meta == null || meta.isEmpty()) {
            return Map.of();
        }
        Map<String, String> safe = new LinkedHashMap<>();
        for (Map.Entry<String, String> entry : meta.entrySet()) {
            String key = safe(entry.getKey());
            if (key.equals("<none>")) {
                continue;
            }
            safe.put(key, safe(entry.getValue()));
        }
        return Map.copyOf(safe);
    }

    private static String statusReason(ExecutionResult result) {
        if (result == null || result.getStatus() == null) {
            return "unknown";
        }
        return result.getStatus().name().toLowerCase();
    }

    private static String metricErrorCode(ExecutionResult result) {
        if (result != null && result.getFailureInfo() != null && result.getFailureInfo().code() != null) {
            return result.getFailureInfo().code();
        }
        if (result == null || result.getStatus() == null) {
            return "unknown";
        }
        return switch (result.getStatus()) {
            case INPUT_VALIDATION_FAILED -> "input_validation";
            case INVARIANT_FAILED -> "invariant_failed";
            case CAPABILITY_FAILED -> "capability_failed";
            case EVENT_PERSIST_FAILED -> "event_persist_failed";
            case EVENT_PAYLOAD_INVALID -> "event_payload_invalid";
            case WAITING_EVENT -> "waiting_event";
            case FAILED -> "failed";
            case OK -> "ok";
        };
    }

    private static String statusValue(ExecutionResult result) {
        if (result == null || result.getStatus() == null) {
            return "UNKNOWN";
        }
        return result.getStatus().name();
    }

    private static String errorReason(Throwable throwable) {
        if (throwable == null) {
            return "exception";
        }
        return "exception:" + throwable.getClass().getSimpleName();
    }

    private static String generatedActionCapabilityName(String actionName) {
        return "generated.action." + safe(actionName);
    }

    private static String generatedActionOperationName(String actionName, ExecutionContext context) {
        ExecutionContext safeContext = normalizeContext(context);
        return safe(actionName) + ":" + safe(safeContext.actorId());
    }

    private static String firstNonBlank(String... values) {
        if (values == null) {
            return "";
        }
        for (String value : values) {
            if (value != null && !value.isBlank()) {
                return value.trim();
            }
        }
        return "";
    }

    private static String safe(String value) {
        if (value == null) {
            return "<none>";
        }
        String trimmed = value.trim();
        return trimmed.isBlank() ? "<none>" : trimmed;
    }

    private static ExecutionSummary toExecutionSummary(FlowInstance instance) {
        return new ExecutionSummary(
                instance.executionId(),
                instance.tenantId(),
                instance.correlationId(),
                instance.flowName(),
                instance.status() == null ? null : instance.status().name(),
                instance.currentStepIndex(),
                instance.waitingForEventName(),
                instance.updatedAtEpochMs(),
                instance.resumeAttemptCount(),
                instance.lastResumeAtEpochMs(),
                instance.lastResumeErrorCode(),
                instance.nextEligibleResumeAtEpochMs(),
                instance.lastProgressAtEpochMs(),
                instance.lastErrorKind(),
                instance.lastErrorCode(),
                instance.failedAtEpochMs()
        );
    }

    private static ResponseStatusException forbidden() {
        return new ResponseStatusException(HttpStatus.FORBIDDEN, "forbidden");
    }

