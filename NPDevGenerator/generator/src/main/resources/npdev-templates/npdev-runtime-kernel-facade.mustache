    public Map<String, Object> generatedActionEvidenceByExecution(
            String executionId,
            ExecutionContext requesterContext
    ) {
        ExecutionContext requester = normalizeContext(requesterContext);
        Map<String, Object> out = new LinkedHashMap<>();
        List<String> warnings = new java.util.ArrayList<>();
        String safeExecutionId = safe(executionId);
        out.put("executionId", safeExecutionId);
        out.put("lookupMode", "executionId");
        if (executionId == null || executionId.isBlank()) {
            warnings.add("executionId is blank; use /generated/actions/correlations/{correlationId} when available");
            return emptyGeneratedActionEvidence(out, warnings, "not_found", "missing_execution_id");
        }

        Optional<FlowTrace> trace = findTrace(executionId, requester);
        String correlationId = trace
                .map(FlowTrace::meta)
                .map(FlowTraceMeta::correlationId)
                .filter(value -> value != null && !value.isBlank())
                .orElse("");
        List<AuditRecord> executionAudits = searchAudit(
                new AuditQuery(requester.tenantId(), null, null, null, executionId, null, null, 100, 0),
                requester
        ).stream()
                .filter(row -> row.action() != null && row.action().startsWith("GENERATED_ACTION_"))
                .toList();
        if (correlationId.isBlank()) {
            correlationId = executionAudits.stream()
                    .map(AuditRecord::meta)
                    .map(meta -> meta.get("correlationId"))
                    .filter(value -> value != null && !value.isBlank())
                    .findFirst()
                    .orElse("");
        }
        if (correlationId.isBlank()) {
            warnings.add("executionId lookup could not resolve correlationId from trace or generated-action audit evidence");
            warnings.add("Use /generated/actions/correlations/{correlationId} if the action response contains correlationId");
            out.put("audits", executionAudits.stream().map(this::auditSummary).toList());
            out.put("auditCount", executionAudits.size());
            return emptyGeneratedActionEvidence(out, warnings, executionAudits.isEmpty() ? "not_found" : "partial", "correlation_unresolved");
        }

        Map<String, Object> evidence = generatedActionEvidenceByCorrelation(correlationId, requester);
        out.putAll(evidence);
        out.put("lookupMode", "executionId");
        out.put("executionId", safeExecutionId);
        List<String> mergedWarnings = new java.util.ArrayList<>(warnings);
        Object existingWarnings = evidence.get("warnings");
        if (existingWarnings instanceof List<?> rows) {
            for (Object row : rows) {
                mergedWarnings.add(String.valueOf(row));
            }
        }
        out.put("warnings", List.copyOf(mergedWarnings));
        return Map.copyOf(out);
    }

    public Map<String, Object> generatedActionEvidenceByCorrelation(
            String correlationId,
            ExecutionContext requesterContext
    ) {
        ExecutionContext requester = normalizeContext(requesterContext);
        Map<String, Object> out = new LinkedHashMap<>();
        List<String> warnings = new java.util.ArrayList<>();
        String safeCorrelationId = safe(correlationId);
        out.put("correlationId", safeCorrelationId);
        out.put("lookupMode", "correlationId");
        if (correlationId == null || correlationId.isBlank()) {
            warnings.add("correlationId is blank");
            return emptyGeneratedActionEvidence(out, warnings, "not_found", "missing_correlation_id");
        }

        List<EventEnvelope> events = listEventsByCorrelation(correlationId, 100, 0, requester);
        List<FlowTrace> traces = searchTraces(new TraceQuery(correlationId, null, null, null, null, 100, 0), requester);
        List<AuditRecord> audits = searchAudit(AuditQuery.emptyForTenant(requester.tenantId()), requester).stream()
                .filter(row -> correlationId.equals(row.meta().get("correlationId")))
                .limit(100)
                .toList();
        Optional<String> owner = correlationOwnershipStore.findTenantByCorrelationId(correlationId);
        List<Map<String, Object>> correlationOwners = owner
                .filter(value -> value.equals(requester.tenantId()))
                .map(value -> List.of(Map.<String, Object>of("correlationId", safeCorrelationId, "tenantId", value)))
                .orElseGet(List::of);
        if (owner.isPresent() && !owner.get().equals(requester.tenantId())) {
            warnings.add("correlation owner exists for another tenant and was not returned");
        }

        String actionName = firstNonBlank(
                firstAuditMeta(audits, "actionName"),
                firstTraceTag(traces, "actionName"),
                firstEventPayloadValue(events, "actionName")
        );
        String procedureName = firstNonBlank(firstEventPayloadValue(events, "procedureName"), actionName);
        String executionId = firstNonBlank(
                traces.stream().map(FlowTrace::meta).map(FlowTraceMeta::executionId).findFirst().orElse(""),
                firstEventPayloadValue(events, "executionId"),
                audits.stream().map(AuditRecord::resourceId).filter(value -> value != null && !value.isBlank()).findFirst().orElse("")
        );
        String capabilityId = actionName.isBlank() ? "" : generatedActionCapabilityName(actionName);

        List<IdempotencyRecord> idempotencyRecords = generatedActionIdempotencyEvidence(
                actionName,
                audits,
                requester,
                warnings
        );

        out.put("executionId", safe(executionId));
        out.put("correlationId", safeCorrelationId);
        out.put("actionName", safe(actionName));
        out.put("procedureName", safe(procedureName));
        out.put("capabilityId", safe(capabilityId));
        out.put("status", evidenceStatus(events, traces, audits, idempotencyRecords, correlationOwners));
        out.put("evidenceStatus", evidenceStatus(events, traces, audits, idempotencyRecords, correlationOwners));
        out.put("eventCount", events.size());
        out.put("traceCount", traces.size());
        out.put("auditCount", audits.size());
        out.put("idempotencyCount", idempotencyRecords.size());
        out.put("correlationOwnerCount", correlationOwners.size());
        out.put("events", events.stream().map(this::eventSummary).toList());
        out.put("traces", traces.stream().map(this::traceSummary).toList());
        out.put("audits", audits.stream().map(this::auditSummary).toList());
        out.put("idempotencyRecords", idempotencyRecords.stream().map(this::idempotencySummary).toList());
        out.put("correlationOwners", correlationOwners);
        if (events.isEmpty()) {
            warnings.add("No event evidence found for correlationId");
        }
        if (traces.isEmpty()) {
            warnings.add("No trace evidence found for correlationId");
        }
        if (audits.isEmpty()) {
            warnings.add("No audit evidence found for correlationId");
        }
        if (idempotencyRecords.isEmpty()) {
            warnings.add("No idempotency evidence could be safely correlated from existing audit/action metadata");
        }
        if (correlationOwners.isEmpty()) {
            warnings.add("No correlation ownership evidence found for requester tenant");
        }
        out.put("warnings", List.copyOf(warnings));
        return Map.copyOf(out);
    }

    private Map<String, Object> emptyGeneratedActionEvidence(
            Map<String, Object> out,
            List<String> warnings,
            String status,
            String evidenceStatus
    ) {
        out.putIfAbsent("actionName", "");
        out.putIfAbsent("procedureName", "");
        out.putIfAbsent("capabilityId", "");
        out.put("status", status);
        out.put("evidenceStatus", evidenceStatus);
        out.putIfAbsent("eventCount", 0);
        out.putIfAbsent("traceCount", 0);
        out.putIfAbsent("auditCount", 0);
        out.put("idempotencyCount", 0);
        out.put("correlationOwnerCount", 0);
        out.putIfAbsent("events", List.of());
        out.putIfAbsent("traces", List.of());
        out.putIfAbsent("audits", List.of());
        out.put("idempotencyRecords", List.of());
        out.put("correlationOwners", List.of());
        out.put("warnings", List.copyOf(warnings));
        return Map.copyOf(out);
    }

    private List<IdempotencyRecord> generatedActionIdempotencyEvidence(
            String actionName,
            List<AuditRecord> audits,
            ExecutionContext requester,
            List<String> warnings
    ) {
        if (actionName == null || actionName.isBlank()) {
            warnings.add("Idempotency lookup skipped because actionName could not be derived from existing evidence");
            return List.of();
        }
        String idempotencyKey = audits.stream()
                .map(AuditRecord::tags)
                .map(tags -> tags.get("idempotencyKey"))
                .filter(value -> value != null && !value.isBlank())
                .findFirst()
                .orElse("");
        if (idempotencyKey.isBlank()) {
            warnings.add("Idempotency lookup skipped because no idempotencyKey was present in existing audit tags");
            return List.of();
        }
        try {
            return idempotencyStore.find(
                    requester.tenantId(),
                    generatedActionCapabilityName(actionName),
                    generatedActionOperationName(actionName, requester),
                    idempotencyKey
            ).map(List::of).orElseGet(List::of);
        } catch (RuntimeException exception) {
            warnings.add("Idempotency lookup failed: " + errorReason(exception));
            return List.of();
        }
    }

    private Map<String, Object> eventSummary(EventEnvelope event) {
        Map<String, Object> out = new LinkedHashMap<>();
        out.put("eventId", safe(event.eventId()));
        out.put("eventName", safe(event.eventName()));
        out.put("timestampMs", event.timestampEpochMs());
        out.put("correlationId", safe(event.correlationId()));
        out.put("causationId", safe(event.causationId()));
        out.put("flowName", safe(event.flowName()));
        out.put("stepIndex", event.stepIndex());
        out.put("tenantId", safe(event.tenantId()));
        out.put("actorId", safe(event.actorId()));
        out.put("payloadSummary", safePayloadSummary(event.payload()));
        return Map.copyOf(out);
    }

    private Map<String, Object> traceSummary(FlowTrace trace) {
        Map<String, Object> out = new LinkedHashMap<>();
        out.put("executionId", safe(trace.meta().executionId()));
        out.put("correlationId", safe(trace.meta().correlationId()));
        out.put("flowName", safe(trace.meta().flowName()));
        out.put("tenantId", safe(trace.meta().tenantId()));
        out.put("actorId", safe(trace.meta().actorId()));
        out.put("outcome", trace.outcome().name());
        out.put("startedAtMs", trace.startedAtEpochMs());
        out.put("endedAtMs", trace.endedAtEpochMs());
        out.put("stepCount", trace.steps().size());
        out.put("tags", safeObjectMap(trace.meta().tags()));
        return Map.copyOf(out);
    }

    private Map<String, Object> auditSummary(AuditRecord audit) {
        Map<String, Object> out = new LinkedHashMap<>();
        out.put("auditId", safe(audit.auditId()));
        out.put("timestampMs", audit.timestampMs());
        out.put("tenantId", safe(audit.tenantId()));
        out.put("actorId", safe(audit.actorId()));
        out.put("action", safe(audit.action()));
        out.put("resourceType", safe(audit.resourceType()));
        out.put("resourceId", safe(audit.resourceId()));
        out.put("outcome", safe(audit.outcome()));
        out.put("reasonCode", safe(audit.reasonCode()));
        out.put("tags", audit.tags());
        out.put("meta", audit.meta());
