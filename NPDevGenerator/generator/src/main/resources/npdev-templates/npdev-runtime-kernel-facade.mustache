            audit(ctx, "PUBLISH_EVENT", "EVENT", eventName, OUTCOME_ERROR, errorReason(exception), Map.of());
            metricInc("npdev.api.execute.failed", ctx, Map.of("errorCode", errorReason(exception), "mode", "publish_event"));
