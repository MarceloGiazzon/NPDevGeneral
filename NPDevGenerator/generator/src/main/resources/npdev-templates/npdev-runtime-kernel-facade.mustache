            metricObserveMs(
                    "npdev.api.event.publish.duration_ms",
                    startedAtMs,
                    ctx,
                    Map.of("outcome", "ALLOW")
            );
            return envelope;
        } catch (CorrelationOwnershipViolationException ignored) {
            audit(ctx, "PUBLISH_EVENT", "EVENT", eventName, OUTCOME_DENY, "correlation_owner_conflict", Map.of());
            metricInc(
                    "npdev.api.execute.failed",
                    ctx,
                    Map.of("errorCode", "correlation_owner_conflict", "mode", "publish_event")
