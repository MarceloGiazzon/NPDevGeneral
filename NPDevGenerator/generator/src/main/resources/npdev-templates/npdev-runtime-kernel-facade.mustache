    public List<String> listFlowNames() {
        return compiledModel.getFlows().stream()
                .map(flow -> flow.getName())
                .sorted()
                .toList();
    }

    public List<FlowDefinitionView> listFlowDefinitions() {
        return compiledModel.getFlows().stream()
                .map(flow -> new FlowDefinitionView(
                        flow.getName(),
                        flow.getConcept(),
                        flow.getMode(),
                        schemaToMap(flow.getInputSchema()),
                        schemaToMap(flow.getOutputSchema()),
                        flowStepViews(flow.getSteps(), "")
                ))
                .sorted((left, right) -> left.name().compareToIgnoreCase(right.name()))
                .toList();
    }

    private static List<FlowStepView> flowStepViews(List<com.npdev.dsl.v1.compiled.CompiledFlowStep> steps, String prefix) {
        java.util.List<FlowStepView> views = new java.util.ArrayList<>();
        if (steps == null) {
            return java.util.List.of();
        }
        for (int index = 0; index < steps.size(); index++) {
            com.npdev.dsl.v1.compiled.CompiledFlowStep step = steps.get(index);
            String orderKey = prefix == null || prefix.isBlank()
                    ? String.format("%04d", index)
                    : prefix + "." + String.format("%04d", index);
            String correlationHint = "";
            if (Boolean.TRUE.equals(step.getAwaitMatchCorrelation())) {
                correlationHint = "match-current-correlation";
            } else if (step.getAwaitPayloadMatch() != null && !step.getAwaitPayloadMatch().isEmpty()) {
                correlationHint = "payload-match";
            } else if ("event".equalsIgnoreCase(step.getType())
                    || "scheduleEvent".equalsIgnoreCase(step.getType())
                    || "await".equalsIgnoreCase(step.getType())) {
                correlationHint = "flow-correlation";
            }
            views.add(new FlowStepView(
                    orderKey,
                    step.getName(),
                    step.getType(),
                    step.getCheckpoint(),
                    step.getScope(),
                    step.getCapabilityCall() == null ? null : step.getCapabilityCall().getCapabilityName(),
                    step.getCapabilityCall() == null ? null : step.getCapabilityCall().getOperation(),
                    step.getCapabilityCall() == null ? java.util.List.of() : step.getCapabilityCall().getArgsRefs(),
                    step.getCapabilityCall() == null ? null : step.getCapabilityCall().getInputRef(),
                    step.getCapabilityCall() == null ? null : step.getCapabilityCall().getOutputRef(),
                    step.getEventName(),
                    step.getCondition(),
                    step.getAwaitEventName(),
                    step.getAwaitMatchCorrelation(),
                    step.getAwaitPayloadMatch(),
                    step.getDelaySeconds(),
                    step.getReturnValueRef(),
                    step.getThenSteps().size(),
                    step.getElseSteps().size(),
                    correlationHint
            ));
            views.addAll(flowStepViews(step.getThenSteps(), orderKey + ".then"));
            views.addAll(flowStepViews(step.getElseSteps(), orderKey + ".else"));
        }
        return java.util.List.copyOf(views);
    }

    private static Object schemaToMap(CompiledSchema schema) {
        if (schema == null) {
            return null;
        }
        Map<String, Object> out = new LinkedHashMap<>();
        if (schema.getType() != null) {
            out.put("type", schema.getType());
        }
        if (schema.getDescription() != null) {
            out.put("description", schema.getDescription());
        }
        if (!schema.getRequired().isEmpty()) {
            out.put("required", List.copyOf(schema.getRequired()));
        }
        if (schema.getMinLength() != null) {
            out.put("minLength", schema.getMinLength());
        }
        if (schema.getMaxLength() != null) {
            out.put("maxLength", schema.getMaxLength());
        }
        if (schema.getMin() != null) {
            out.put("min", schema.getMin());
        }
        if (schema.getMax() != null) {
            out.put("max", schema.getMax());
        }
        if (schema.getRegex() != null) {
            out.put("regex", schema.getRegex());
        }
        if (!schema.getProperties().isEmpty()) {
            Map<String, Object> properties = new LinkedHashMap<>();
            for (Map.Entry<String, CompiledSchema> entry : schema.getProperties().entrySet()) {
                properties.put(entry.getKey(), schemaToMap(entry.getValue()));
            }
            out.put("properties", properties);
        }
        return out;
    }

    public Optional<FlowTrace> findTrace(String executionId, ExecutionContext requesterContext) {
        long startedAtMs = System.currentTimeMillis();
        ExecutionContext requester = normalizeContext(requesterContext);
        metricInc("npdev.api.trace.read", requester, Map.of("mode", "detail", "outcome", "ATTEMPT"));
        if (executionId == null || executionId.isBlank()) {
            audit(requester, "READ_TRACE", "TRACE", "<blank>", OUTCOME_DENY, "invalid_input", Map.of());
            metricInc("npdev.api.trace.read", requester, Map.of("mode", "detail", "outcome", "DENY"));
            metricObserveMs("npdev.api.trace.read.duration_ms", startedAtMs, requester, Map.of("mode", "detail", "outcome", "DENY"));
            return Optional.empty();
        }
        ExecutionContext redactionContext = redactionContextFor(requester);
        Optional<FlowTrace> traceOpt = traceStore.findByExecutionId(executionId);
        if (traceOpt.isEmpty()) {
            audit(requester, "READ_TRACE", "TRACE", executionId, OUTCOME_ALLOW, "not_found", Map.of());
            metricInc("npdev.api.trace.read", requester, Map.of("mode", "detail", "outcome", "NOT_FOUND"));
            metricObserveMs("npdev.api.trace.read.duration_ms", startedAtMs, requester, Map.of("mode", "detail", "outcome", "NOT_FOUND"));
            return Optional.empty();
        }
        FlowTrace trace = traceOpt.get();
        if (!executionAuthorizationPolicy.canReadTrace(requester, trace)) {
            audit(requester, "READ_TRACE", "TRACE", executionId, OUTCOME_DENY, "forbidden", Map.of());
            metricInc("npdev.api.trace.read", requester, Map.of("mode", "detail", "outcome", "DENY"));
            metricObserveMs("npdev.api.trace.read.duration_ms", startedAtMs, requester, Map.of("mode", "detail", "outcome", "DENY"));
            throw forbidden();
        }
        FlowTrace redacted = traceRedactionPolicy.redact(trace, redactionContext);
        audit(requester, "READ_TRACE", "TRACE", executionId, OUTCOME_ALLOW, "ok", Map.of());
        metricInc("npdev.api.trace.read", requester, Map.of("mode", "detail", "outcome", "ALLOW"));
        metricObserveMs("npdev.api.trace.read.duration_ms", startedAtMs, requester, Map.of("mode", "detail", "outcome", "ALLOW"));
        return Optional.ofNullable(redacted);
    }

    public List<FlowTrace> searchTraces(TraceQuery query, ExecutionContext requesterContext) {
        long startedAtMs = System.currentTimeMillis();
        ExecutionContext requester = normalizeContext(requesterContext);
        ExecutionContext redactionContext = redactionContextFor(requester);
        TraceQuery scopedQuery = tenantScopedTraceQuery(query, requester);
        metricInc("npdev.api.trace.search", requester, Map.of("outcome", "ATTEMPT"));
        if (!executionAuthorizationPolicy.canSearchTraces(requester, scopedQuery)) {
            audit(requester, "SEARCH_TRACES", "TRACE", "<query>", OUTCOME_DENY, "forbidden", Map.of());
            metricInc("npdev.api.trace.search", requester, Map.of("outcome", "DENY"));
            metricObserveMs("npdev.api.trace.search.duration_ms", startedAtMs, requester, Map.of("outcome", "DENY"));
            throw forbidden();
        }
        List<FlowTrace> rows = traceStore.search(scopedQuery).stream()
                .filter(trace -> executionAuthorizationPolicy.canReadTrace(requester, trace))
                .map(trace -> traceRedactionPolicy.redact(trace, redactionContext))
                .toList();
        audit(
                requester,
                "SEARCH_TRACES",
                "TRACE",
                "<query>",
                OUTCOME_ALLOW,
                "ok",
                Map.of("count", String.valueOf(rows.size()))
        );
        metricInc("npdev.api.trace.search", requester, Map.of("outcome", "ALLOW"));
        metricObserveMs("npdev.api.trace.search.duration_ms", startedAtMs, requester, Map.of("outcome", "ALLOW"));
        return rows;
    }

