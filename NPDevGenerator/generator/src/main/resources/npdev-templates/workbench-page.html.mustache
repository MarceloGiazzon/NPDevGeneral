                  body: JSON.stringify({ draft: draftBeforeFold, result: res.b }) })
                .then(function (r2) { return r2.ok ? r2.json() : null; })
                .then(function (folded) { if (folded) store.patch(folded); render(); refreshServerDerivedFields(); })
                .catch(function () { render(); refreshServerDerivedFields(); });
