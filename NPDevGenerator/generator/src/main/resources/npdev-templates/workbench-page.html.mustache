<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{title}} — Workbench</title>
<style>
  :root{
    --np-bg:#eef1f5; --np-ink:#1c2733; --np-muted:#5a6b7b; --np-line:#c9d3de;
    --np-header:#c0c0ff; --np-l2:#d9dde2; --np-l3:#d6f0d6; --np-accent:#2b6cb0;
    --np-grid-head:#34506b; --np-danger:#b23; --np-ok:#227a34; --np-chip:#5a6b7b;
    --np-font:"Segoe UI",Roboto,system-ui,sans-serif;
  }
  *{box-sizing:border-box}
  body{margin:0;font:13px/1.4 var(--np-font);color:var(--np-ink);background:var(--np-bg)}
  .app{max-width:1200px;margin:0 auto;padding:14px}
  h1{font-size:15px;margin:0 0 2px}
  .sub{color:var(--np-muted);font-size:12px;margin:0 0 12px}
  .region{border:1px solid var(--np-line);border-radius:6px;margin-bottom:10px;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,.05)}
  .bar{display:flex;align-items:center;gap:12px;color:#fff;padding:5px 12px;font-weight:600;font-size:12.5px}
  .bar.head{background:#778899}.bar.items{background:#8894a0}.bar.band{background:#5a8a5a}
  .body{padding:10px 12px}
  .r-head{background:var(--np-header)}.r-items{background:var(--np-l2)}.r-band{background:var(--np-l3)}
  .grow{flex:1}
  .chip{background:var(--np-chip);color:#fff;border-radius:10px;padding:1px 9px;font-size:11px}
  .chip.dirty{background:#c9761d}
  form.grid2{display:grid;grid-template-columns:auto 1fr auto 1fr;gap:5px 8px;align-items:center}
  label{color:var(--np-muted)}
  input{font:12px var(--np-font);padding:2px 5px;border:1px solid var(--np-line);border-radius:3px;background:#fff}
  input.cell{width:100%;border-color:transparent;background:transparent}
  input.cell:focus{border-color:var(--np-accent);background:#fff}
  table{border-collapse:collapse;width:100%;font-size:12px;background:#fff}
  th{background:var(--np-grid-head);color:#fff;text-align:left;padding:3px 7px;font-weight:600;white-space:nowrap}
  td{border-bottom:1px solid #e6ebf0;padding:1px 4px;white-space:nowrap}
  tr.sel td{background:#dcecff}
  tr.master{cursor:pointer}
  .rowbtn{color:var(--np-danger);cursor:pointer;font-weight:700;padding:0 5px}
  .addrow{color:var(--np-accent);cursor:pointer;font-size:12px;display:inline-block;margin-top:4px}
  .grids{display:flex;gap:18px;align-items:flex-start;flex-wrap:wrap}
  .gwrap{min-width:220px}
  .gwrap h4{margin:0 0 3px;font-size:12px;color:#456}
  .btn{background:var(--np-accent);color:#fff;border:0;border-radius:4px;padding:5px 14px;font:12px var(--np-font);cursor:pointer}
  .msg{margin-left:10px;font-size:12px}
  .msg.ok{color:var(--np-ok)}.msg.err{color:var(--np-danger)}
  .rev{cursor:pointer;color:#fff;font-size:11px;opacity:.85;text-decoration:underline;background:none;border:0}
  .rev:hover{opacity:1}
  .derived{display:flex;gap:16px;flex-wrap:wrap;padding:5px 12px;font-size:12px;background:#fff;border:1px solid var(--np-line);border-radius:6px;margin-bottom:10px}
  .derived .item{display:flex;gap:5px;align-items:baseline}
  .derived .item .lbl{color:var(--np-muted)}
  .derived .item .val{font-weight:600}
  .pick{cursor:pointer;color:var(--np-accent);font-size:12px;display:inline-block;margin-top:4px;margin-left:12px}
  .modal{position:fixed;inset:0;background:rgba(20,28,38,.45);display:flex;align-items:center;justify-content:center;z-index:50}
  .modal-card{background:#fff;border-radius:8px;max-width:640px;width:92%;max-height:80vh;overflow:auto;box-shadow:0 10px 40px rgba(0,0,0,.3)}
  .modal-hd{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid var(--np-line);font-weight:600}
  .modal-bd{padding:6px 14px}
  .modal-ft{display:flex;gap:8px;justify-content:flex-end;padding:10px 14px;border-top:1px solid var(--np-line)}
  .modal tr.master.sel td{background:#dcecff}
  .btn.ghost{background:#e6ebf0;color:var(--np-ink)}
</style>
</head>
<body>
<div class="app" id="app"><p class="sub">Loading workbench…</p></div>

<script>
/* Generated Aggregate Workbench page for panel "{{panelName}}" (aggregate {{aggregateName}}).
   Descriptor-driven generic client: fetches loadWorkbench, renders header/grid/band, POSTs commit.
   Auth mirrors the shell: token from localStorage -> Authorization: Bearer + X-Api-Key. */
(function () {
  var PANEL = "{{panelName}}";
  var SELECTION_PANEL = "{{selectionPanel}}";
  var FILTERS = {{{filtersJson}}};
  // Move 6 Move A: the app's full resolved string catalogue (platform English defaults merged with
  // any settings.strings overrides at generation time) -- see CompiledSettings/PlatformStrings.
  var STRINGS = {{{stringsJson}}};
  var TOKEN_KEYS = ["npdev.shell.token", "npdev.businessUi.apiKey"];

  function token() { for (var i = 0; i < TOKEN_KEYS.length; i++) { var t = localStorage.getItem(TOKEN_KEYS[i]); if (t) return t; } return null; }
  function authHeaders() { var t = token(); return t ? { "Authorization": "Bearer " + t, "X-Api-Key": t } : {}; }

  var clone = function (v) { return v === undefined ? undefined : JSON.parse(JSON.stringify(v)); };
  var pick = function (o, fs) { var r = {}; (fs || []).forEach(function (f) { r[f] = o == null ? undefined : o[f]; }); return r; };
  var genId = function () { return "new-" + Math.random().toString(36).slice(2, 10); };

  function createStore(resp) {
    var descriptor = resp.workbench || {};
    // Move 11 W6: seed declared UI state BEFORE the first render, so a $ui.* predicate never
    // evaluates against an unset value on the way in. Seeded into a module-level variable, never
    // into `draft` -- see uiStateValues' own comment: it must not be reachable from toDraft().
    seedUiState(descriptor);
    var draft = clone(resp.data || {});
    (descriptor.sections || []).forEach(function (s) { if (!Array.isArray(draft[s.collection])) draft[s.collection] = []; });
    // baseline = the last persisted (or freshly loaded) tree; per-region revert (C8) restores from it.
    var baseline = clone(draft);
    var dirty = { header: false, sections: {} };
    function sectionDef(c) { return (descriptor.sections || []).filter(function (s) { return s.collection === c; })[0]; }
    function findRow(c, id) { return (draft[c] || []).filter(function (r) { return String(r.id) === String(id); })[0]; }
    return {
      aggregate: descriptor.aggregate || resp.aggregate,
      title: resp.title,
      descriptor: descriptor,
      isDirty: function () { var d = dirty.header; Object.keys(dirty.sections).forEach(function (k) { d = d || dirty.sections[k]; }); return d; },
      editHeader: function (f, v) { draft[f] = v; dirty.header = true; },
      editRow: function (c, id, f, v) { var r = findRow(c, id); if (r) { r[f] = v; dirty.sections[c] = true; } },
      editBandRow: function (c, id, b, bid, f, v) { var r = findRow(c, id); if (r) { var br = (r[b] || []).filter(function (x) { return String(x.id) === String(bid); })[0]; if (br) { br[f] = v; dirty.sections[c] = true; } } },
      addRow: function (c) { var row = { id: genId() }; (sectionDef(c).bands || []).forEach(function (b) { row[b.collection] = []; }); (draft[c] = draft[c] || []).push(row); dirty.sections[c] = true; return row.id; },
      deleteRow: function (c, id) { draft[c] = (draft[c] || []).filter(function (r) { return String(r.id) !== String(id); }); dirty.sections[c] = true; },
      addBandRow: function (c, id, b) { var r = findRow(c, id); if (!r) return null; var br = { id: genId() }; (r[b] = r[b] || []).push(br); dirty.sections[c] = true; return br.id; },
      // Add a band row seeded from a picked source row (C6): copy overlapping columns, assign a fresh id.
      addBandRowFrom: function (c, id, b, values) { var r = findRow(c, id); if (!r) return null; var br = Object.assign({}, values || {}); br.id = genId(); (r[b] = r[b] || []).push(br); dirty.sections[c] = true; return br.id; },
      deleteBandRow: function (c, id, b, bid) { var r = findRow(c, id); if (!r) return; r[b] = (r[b] || []).filter(function (x) { return String(x.id) !== String(bid); }); dirty.sections[c] = true; },
      // Per-region edit buffer (C8): true when the region has staged, uncommitted changes vs the baseline.
      regionDirty: function (scope, c) { return scope === "header" ? !!dirty.header : !!dirty.sections[c]; },
      // Discard a single region's staged changes back to the baseline, leaving other regions untouched.
      revertRegion: function (scope, c) {
        if (scope === "header") { ((descriptor.header && descriptor.header.fields) || []).forEach(function (f) { draft[f] = clone(baseline[f]); }); var lc = descriptor.lifecycle; if (lc && lc.statusField) draft[lc.statusField] = clone(baseline[lc.statusField]); dirty.header = false; }
        else { draft[c] = clone(baseline[c] || []); dirty.sections[c] = false; }
      },
      // Replace the working draft with a server-computed tree (invoke/recompute), preserving the baseline.
      // Marks every region dirty since the whole draft may have shifted; the user reviews and Saves.
      patch: function (newData) {
        draft = clone(newData || {});
        (descriptor.sections || []).forEach(function (s) { if (!Array.isArray(draft[s.collection])) draft[s.collection] = []; dirty.sections[s.collection] = true; });
        dirty.header = true;
      },
      // Lifecycle gating: the root's current state -> label + editability (terminal/read-only states).
      stateInfo: function () {
        var lc = descriptor.lifecycle;
        if (!lc || !lc.statusField) { return { editable: true, label: null }; }
        var val = draft[lc.statusField];
        var st = (lc.states || []).filter(function (s) { return s.value === val; })[0];
        return {
          value: val, label: st ? st.label : val, editable: st ? !!st.editable : true,
          // AW-P5: optional per-state action-rail gating (declared procedure names this state
          // permits). null/absent means no restriction -- every declared action stays enabled.
          allowedActions: st && st.allowedActions ? st.allowedActions : null
        };
      },
      toDraft: function () { return clone(draft); },
      view: function () {
        var hf = (descriptor.header && descriptor.header.fields) || [];
        return {
          aggregate: this.aggregate, title: this.title, dirty: this.isDirty(),
          // Move 6 Move D: address/render/component pass through from the descriptor unchanged --
          // "generated" (no render/component keys) for a region with no declared mount.
          header: {
            fields: hf, values: pick(draft, hf),
            address: descriptor.header && descriptor.header.address,
            render: (descriptor.header && descriptor.header.render) || null,
            component: (descriptor.header && descriptor.header.component) || null
          },
          sections: (descriptor.sections || []).map(function (s) {
            return {
              collection: s.collection, columns: s.columns || [], visibleWhen: s.visibleWhen || null,
              address: s.address, render: s.render || null, component: s.component || null,
              bandDefs: (s.bands || []).map(function (b) {
                return {
                  collection: b.collection, columns: b.columns || [], picker: b.picker || null, visibleWhen: b.visibleWhen || null,
                  address: b.address, render: b.render || null, component: b.component || null
                };
              }),
              rows: (draft[s.collection] || []).map(function (r) {
                return {
                  id: r.id, values: pick(r, s.columns || []),
                  bands: (s.bands || []).reduce(function (acc, b) { acc[b.collection] = (r[b.collection] || []).map(function (br) { return { id: br.id, values: pick(br, b.columns || []) }; }); return acc; }, {})
                };
              })
            };
          })
        };
      }
    };
  }

  var el = function (h) { var t = document.createElement("template"); t.innerHTML = h.trim(); return t.content.firstChild; };
  var EDITABLE = true;
  // Focus tracking so a debounced recompute re-render can restore the caret to the cell being edited.
  var activeFocusKey = null, restoreFocus = false;
  var cell = function (val, on, key) {
    var i = el('<input class="cell">');
    i.value = val == null ? "" : String(val);
    if (key) { i.setAttribute("data-fkey", key); i.addEventListener("focus", function () { activeFocusKey = key; }); }
    i.oninput = function (e) { on(e.target.value); scheduleRecompute(); };
    if (!EDITABLE) { i.readOnly = true; }
    return i;
  };

  // Reactive recompute (P3/C7): debounce cell edits, invoke the declared recompute procedure over the
  // draft, patch derived fields in place, and re-render — restoring focus to the cell being typed in.
  var recomputeTimer = null;
  function scheduleRecompute() {
    if (!store || !EDITABLE) return;
    var proc = store.descriptor.recompute;
    if (!proc) return;
    if (recomputeTimer) clearTimeout(recomputeTimer);
    recomputeTimer = setTimeout(function () { runRecompute(proc); }, 450);
  }
  function runRecompute(proc) {
    fetch("/api/runtime/aggregate/" + encodeURIComponent(store.aggregate) + "/invoke/" + encodeURIComponent(proc),
      { method: "POST", headers: Object.assign({ "Content-Type": "application/json" }, authHeaders()), body: JSON.stringify(store.toDraft()) })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (patched) { if (patched) { store.patch(patched); restoreFocus = true; render(); refreshServerDerivedFields(); } })
      .catch(function () { /* recompute is best-effort; keep the user's draft on failure */ });
  }

  // Move 5 (docs/MOVE5_CLOSE_ALL_OPEN_PLAN.md, Wave 2B / M6 "balanced banner",
  // docs/MOVE3_G2_CHECKLISTS.md): a DELIBERATELY narrow expression subset for display-only derived
  // fields -- not a client-side clone of the platform's real expression-cel engine (unrealistic to
  // reimplement CEL in a browser), just enough syntax for "sum across a nested path, optionally
  // filtering one collection first" that a balanced-totals banner needs. Only ever reads root; it
  // never writes anything back into the draft, so a derived value can never leak into a commit.
  //   sum(itens[].posicoes[].quantidade)
  //   sum(posicoes[].filter(papel=='Origem').quantidade)
  //   sum(itens[].posicoes[].filter(papel=='Origem').quantidade)
  //
  // REG-95 (Move 11 W5.1): the filter form -- including the second example above, this function's
  // OWN documented syntax -- silently evaluated to 0 from the day it shipped. `m[1].split(".")` cut
  // `posicoes[].filter(papel=='Origem')` in half at the dot BEFORE the filterMatch regex (which
  // requires the whole `<name>[].filter(...)` in one segment) ever saw it, so `filter(...)` fell
  // through to the plain-path branch, resolved to undefined, and the sum came out 0. A banner
  // reading 0 instead of the filtered total, with no error anywhere -- which is why M6 looked like
  // an authoring gap for two moves. Tokenizing instead of splitting is the whole fix; every branch
  // below is unchanged.
  var DERIVED_SEGMENT = /\w+\[\]\.filter\(\s*\w+\s*==\s*['"][^'"]*['"]\s*\)|\w+\[\]|\w+/g;

  function derivedSegments(path) {
    DERIVED_SEGMENT.lastIndex = 0;
    var segments = [];
    var consumed = 0;
    var match;
    while ((match = DERIVED_SEGMENT.exec(path)) !== null) {
      // Only a "." may separate segments; anything else means this is not an expression we
      // understand, and guessing at it is how a wrong number reaches a banner unannounced.
      if (match.index !== consumed && path.slice(consumed, match.index) !== ".") { return null; }
      segments.push(match[0]);
      consumed = match.index + match[0].length;
    }
    return consumed === path.length ? segments : null;
  }

  function evaluateDerived(root, expression) {
    var m = /^sum\((.+)\)$/.exec(String(expression || "").trim());
    if (!m) return undefined;
    var segments = derivedSegments(m[1].trim());
    if (!segments || !segments.length) return undefined;
    var cur = [root];
    for (var i = 0; i < segments.length; i++) {
      var seg = segments[i];
      var isLast = i === segments.length - 1;
      var filterMatch = /^(\w+)\[\]\.filter\((\w+)==['"]([^'"]*)['"]\)$/.exec(seg);
      var arrayMatch = /^(\w+)\[\]$/.exec(seg);
      if (filterMatch) {
        var arrField = filterMatch[1], filterField = filterMatch[2], filterValue = filterMatch[3];
        var next = [];
        cur.forEach(function (item) {
          ((item && item[arrField]) || []).forEach(function (child) {
            if (String(child[filterField]) === filterValue) next.push(child);
          });
        });
        cur = next;
      } else if (arrayMatch) {
        var field = arrayMatch[1];
        var next2 = [];
        cur.forEach(function (item) { ((item && item[field]) || []).forEach(function (child) { next2.push(child); }); });
        cur = next2;
      } else if (isLast) {
        var total = 0;
        cur.forEach(function (item) { total += Number(item && item[seg]) || 0; });
        return total;
      } else {
        cur = cur.map(function (item) { return item && item[seg]; }).filter(function (x) { return x != null; });
      }
    }
    return undefined;
  }

  // Conditional surface by toggle (Move 5, Wave 2C / Gap 2, docs/MOVE3_G2_CHECKLISTS.md): a
  // deliberately narrow boolean-predicate subset -- $root.<path> ==/!= '<literal>' -- for hiding a
  // collection, band, or action based on a header field (e.g. tipo/record-type). PRESENTATION-ONLY:
  // this never touches the draft, so a hidden collection's rows still commit unchanged (see
  // sectionVisible/render() below). A malformed or unrecognized expression fails OPEN (visible),
  // matching "never gate persistence" -- worst case something stays visible, it never disappears
  // incorrectly and silently drops data from view that the user still needed to see was committing.
  //   $root.tipo == 'RECEBIMENTO'
  //
  // Move 11 W6 (C1, docs/MOVE3_G2_CHECKLISTS.md): the SAME grammar now resolves a second root --
  //   $ui.registro == 'Recebimento'
  // -- reading a declared transaction.uiState control instead of a persisted root field. A
  // record-type toggle is transient screen state, not a field of anything, so before this there was
  // literally nothing for the predicate to read (C1's cause, confirmed against AutoPanelExpander's
  // own comment). Deliberately ONE grammar with two resolvable roots, never a second dialect.
  //
  // uiStateValues lives OUTSIDE the store, so it cannot reach store.toDraft() and therefore cannot
  // reach a commit payload -- the presentation-only rule visibleWhen already carries, kept true by
  // construction rather than by remembering.
  var uiStateValues = {};

  function evaluateVisibleWhen(root, expression) {
    var expr = String(expression || "").trim();
    if (!expr) return true;
    var u = /^\$?ui\.(\w+)\s*(==|!=)\s*'([^']*)'$/.exec(expr);
    if (u) {
      var current = uiStateValues[u[1]];
      var value = current == null ? "" : String(current);
      return u[2] === "==" ? value === u[3] : value !== u[3];
    }
    var m = /^\$?root\.([\w.]+)\s*(==|!=)\s*'([^']*)'$/.exec(expr);
    if (!m) return true;
    var path = m[1], op = m[2], literal = m[3];
    var parts = path.split(".");
    var cur = root;
    for (var i = 0; i < parts.length; i++) {
      if (cur == null) { cur = undefined; break; }
      cur = cur[parts[i]];
    }
    var actual = cur == null ? "" : String(cur);
    return op === "==" ? actual === literal : actual !== literal;
  }

  /** Move 11 W6: seed each declared control from its `default` once, before the first render. */
  function seedUiState(descriptor) {
    ((descriptor && descriptor.uiState) || []).forEach(function (control) {
      if (!Object.prototype.hasOwnProperty.call(uiStateValues, control.name)) {
        uiStateValues[control.name] = control["default"]
          || ((control.values || [])[0] == null ? "" : control.values[0]);
      }
    });
  }

  /** Move 11 W6: one <select> per declared control; changing it re-renders, nothing else. */
  function renderUiStateControls(descriptor) {
    var controls = (descriptor && descriptor.uiState) || [];
    if (!controls.length) return null;
    var bar = el('<div class="derived"></div>');
    controls.forEach(function (control) {
      var item = el('<span class="item"></span>');
      item.append(el('<span class="lbl">' + (control.label || control.name) + ':</span>'));
      var select = document.createElement("select");
      (control.values || []).forEach(function (value) {
        var option = document.createElement("option");
        option.value = value;
        option.textContent = value;
        if (String(uiStateValues[control.name]) === String(value)) { option.selected = true; }
        select.appendChild(option);
      });
      select.onchange = function () { uiStateValues[control.name] = select.value; render(); };
      item.append(select);
      bar.append(item);
    });
    return bar;
  }

  var store = null, selected = null, pendingMsg = null;
  // Move 6 Move B: server-tier derivedFields' last-fetched values, keyed by field name -- refreshed
  // (fire-and-forget, best-effort) after any draft-changing event; client-tier fields need none of
  // this, they're evaluated fresh from the draft on every render by evaluateDerived below.
  var serverDerivedValues = {};

  // Move 6 Move D (docs/MOVE6_TYPED_SURFACE_PLAN.md §5): the global mount registry an app-owned
  // web/regions/<name>.js populates via window.npdev.regions.register(name, {mount, update, unmount}).
  window.npdev = window.npdev || {};
  window.npdev.regions = window.npdev.regions || (function () {
    var registry = {};
    return {
      register: function (name, impl) { registry[name] = impl; },
      get: function (name) { return registry[name]; }
    };
  })();

  // address -> { el: <persistent container>, name: <currently mounted component name> }. render()
  // rebuilds the WHOLE DOM tree from scratch on every call; reusing the SAME container element and
  // re-inserting it (appending an already-in-document node MOVES it, it does not clone/destroy it)
  // is what lets a mounted component's own internal DOM survive across renders instead of being
  // torn down and remounted on every keystroke.
  var mountedRegionEls = {};

  /**
   * The NARROWED api a mounted component receives (Move 6 Move D §D.4): a frozen slice of the
   * region's own rows -- never the whole draft, never a sibling region (hard rule 1) -- and no
   * direct persistence path (hard rule 2: Workbench Save is the only commit path, so REG-72's
   * atomicity extends to custom regions for free).
   */
  function regionApi(rows, columns, ops) {
    return {
      rows: JSON.parse(JSON.stringify(rows || [])),
      columns: columns || [],
      editRow: ops.editRow || function () {},
      addRow: ops.addRow || function () {},
      deleteRow: ops.deleteRow || function () {},
      isDirty: ops.isDirty || function () { return false; },
      revert: ops.revert || function () {},
      readOnly: !EDITABLE,
      invoke: function (procedureName, extraInput) {
        return fetch("/api/runtime/aggregate/" + encodeURIComponent(store.aggregate) + "/invoke/" + encodeURIComponent(procedureName),
          { method: "POST", headers: Object.assign({ "Content-Type": "application/json" }, authHeaders()),
            body: JSON.stringify(Object.assign({}, store.toDraft(), extraInput || {})) })
          .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); });
      }
    };
  }

  /**
   * Renders a region whose descriptor says render==="component": mounts once (the first time this
   * address is encountered), calls update() on every subsequent render. Falls back to a visible
   * placeholder (never a silent blank) when the named component was never registered -- e.g. the
   * app's own web/regions/<name>.js failed to load or doesn't exist yet.
   */
  function mountRegion(region, api) {
    var address = region.address;
    var entry = mountedRegionEls[address];
    if (!entry) {
      var container = document.createElement("div");
      container.className = "region-mount";
      entry = { el: container, name: null };
      mountedRegionEls[address] = entry;
    }
    var impl = window.npdev.regions.get(region.component);
    if (!impl) {
      entry.el.innerHTML = '<p class="sub">Component "' + region.component + '" is not registered — '
        + 'check that web/regions/' + region.component + '.js is loaded and calls window.npdev.regions.register.</p>';
      entry.name = null;
      return entry.el;
    }
