            g.append(mountRegion(bd, regionApi(bandRows, bd.columns, {
              editRow: function (id, field, value) { store.editBandRow(sec.collection, selRow.id, bd.collection, id, field, value); scheduleRecompute(); },
              addRow: function () { var id = store.addBandRow(sec.collection, selRow.id, bd.collection); render(); return id; },
