        if (cur == null) return undefined;
        cur = cur[parts[i]];
      }
      return cur;
    }
    // applyTo.collection may name a top-level section OR a nested band (e.g. Movimento's
    // itens -> posicoes, capped-at-1-level in a plain Panel but real here) -- find which, so
    // appending a row targets the right parent.
    function findSectionForCollection(collectionName) {
      var sections = store.descriptor.sections || [];
      for (var i = 0; i < sections.length; i++) {
        if (sections[i].collection === collectionName) return { top: sections[i].collection };
      }
      for (var i = 0; i < sections.length; i++) {
        var bands = sections[i].bands || [];
        for (var j = 0; j < bands.length; j++) {
          if (bands[j].collection === collectionName) return { parent: sections[i].collection, band: collectionName };
        }
      }
      return null;
    }
    // Folds a procedure result into the draft per its declared applyTo, instead of invokeAction's
    // other branch (store.patch) which replaces the WHOLE draft -- correct for a "propose a new
    // draft"/"recompute the tree" action, wrong for a pure-computation suggestion like
    // SugerirDestino, which would otherwise silently discard the rest of the draft. A band-level
    // applyTo appends under the currently selected parent row (there is no other row context to
    // attach it to); if nothing is selected yet, the suggestion is dropped rather than guessed at.
    function applyResultTo(applyTo, result) {
      if (!applyTo || applyTo.mode !== "appendRow" || !applyTo.collection) return;
      var target = findSectionForCollection(applyTo.collection);
      if (!target) return;
      var newRowId = target.top
        ? store.addRow(target.top)
        : (selected == null ? null : store.addBandRow(target.parent, selected, target.band));
      if (newRowId == null) return;
      Object.keys(applyTo.map || {}).forEach(function (field) {
        var value = resolveApplyToValue(result, applyTo.map[field]);
        if (value === undefined) return;
        if (target.top) { store.editRow(target.top, newRowId, field, value); }
        else { store.editBandRow(target.parent, selected, target.band, newRowId, field, value); }
      });
    }
    // Move 6 Move B (docs/MOVE6_TYPED_SURFACE_PLAN.md §B.2): transaction.hooks.beforeAction is a
    // guard invoked over the current draft before ANY declared action's own procedure runs; a
    // non-ok result aborts with no invoke of the real action at all (same disposition as
    // aggregate.onValidate: reject outright, no partial effect).
    function runBeforeActionGuard(onPass) {
      var proc = store.descriptor.beforeAction;
      if (!proc) { onPass(); return; }
      fetch("/api/runtime/aggregate/" + encodeURIComponent(store.aggregate) + "/invoke/" + encodeURIComponent(proc),
        { method: "POST", headers: Object.assign({ "Content-Type": "application/json" }, authHeaders()), body: JSON.stringify(store.toDraft()) })
        .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, b: b }; }); })
        .then(function (res) {
          if (res.ok) { onPass(); }
          else { msg.className = "msg err"; msg.textContent = "Failed: " + (res.b && res.b.message || "beforeAction rejected this action"); }
        })
        .catch(function (e) { msg.className = "msg err"; msg.textContent = "Error: " + e; });
    }
    function invokeAction(action, extraInput) {
      runBeforeActionGuard(function () { invokeActionAfterGuard(action, extraInput); });
    }
    function invokeActionAfterGuard(action, extraInput) {
      msg.className = "msg"; msg.textContent = (action.label || "Running") + "…";
      var body = Object.assign({}, store.toDraft(), extraInput || {});
      fetch("/api/runtime/aggregate/" + encodeURIComponent(store.aggregate) + "/invoke/" + encodeURIComponent(action.procedure),
        { method: "POST", headers: Object.assign({ "Content-Type": "application/json" }, authHeaders()), body: JSON.stringify(body) })
        .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, b: b }; }); })
        .then(function (res) {
          if (res.ok) {
            pendingMsg = { className: "msg ok", text: (action.label || "Done") + " — review and Save." };
            // Move 6 Move B §B.4: afterAction subsumes applyTo -- a procedure receiving {draft,
            // result} and returning a patched draft is strictly more general than a static field
