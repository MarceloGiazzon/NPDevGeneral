      (store.descriptor.actions || [])
        .filter(function (a) { return !si.allowedActions || si.allowedActions.indexOf(a.procedure) !== -1; })
        .filter(function (a) { return evaluateVisibleWhen(draftNow, a.visibleWhen); })
        .forEach(function (a) {
          var fieldNames = a.inputFields || [];
          var inputsByField = {};
          if (fieldNames.length) {
            var inlineForm = el('<span class="action-inputs" style="margin-left:6px"></span>');
            fieldNames.forEach(function (field) {
