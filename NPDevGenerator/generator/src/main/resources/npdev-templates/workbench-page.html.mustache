<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{title}} — Workbench</title>
<style>
  :root{
    --np-bg:#eef1f5; --np-ink:#1c2733; --np-muted:#5a6b7b; --np-line:#c9d3de;
    --np-header:#c0c0ff; --np-l2:#d9dde2; --np-l3:#d6f0d6; --np-accent:#2b6cb0;
    --np-grid-head:#34506b; --np-danger:#b23; --np-ok:#227a34; --np-chip:#5a6b7b;
    --np-font:"Segoe UI",Roboto,system-ui,sans-serif;
  }
  *{box-sizing:border-box}
  body{margin:0;font:13px/1.4 var(--np-font);color:var(--np-ink);background:var(--np-bg)}
  .app{max-width:1200px;margin:0 auto;padding:14px}
  h1{font-size:15px;margin:0 0 2px}
  .sub{color:var(--np-muted);font-size:12px;margin:0 0 12px}
  .region{border:1px solid var(--np-line);border-radius:6px;margin-bottom:10px;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,.05)}
  .bar{display:flex;align-items:center;gap:12px;color:#fff;padding:5px 12px;font-weight:600;font-size:12.5px}
  .bar.head{background:#778899}.bar.items{background:#8894a0}.bar.band{background:#5a8a5a}
  .body{padding:10px 12px}
  .r-head{background:var(--np-header)}.r-items{background:var(--np-l2)}.r-band{background:var(--np-l3)}
  .grow{flex:1}
  .chip{background:var(--np-chip);color:#fff;border-radius:10px;padding:1px 9px;font-size:11px}
  .chip.dirty{background:#c9761d}
  form.grid2{display:grid;grid-template-columns:auto 1fr auto 1fr;gap:5px 8px;align-items:center}
  label{color:var(--np-muted)}
  input{font:12px var(--np-font);padding:2px 5px;border:1px solid var(--np-line);border-radius:3px;background:#fff}
  input.cell{width:100%;border-color:transparent;background:transparent}
  input.cell:focus{border-color:var(--np-accent);background:#fff}
  table{border-collapse:collapse;width:100%;font-size:12px;background:#fff}
  th{background:var(--np-grid-head);color:#fff;text-align:left;padding:3px 7px;font-weight:600;white-space:nowrap}
  td{border-bottom:1px solid #e6ebf0;padding:1px 4px;white-space:nowrap}
  tr.sel td{background:#dcecff}
  tr.master{cursor:pointer}
  .rowbtn{color:var(--np-danger);cursor:pointer;font-weight:700;padding:0 5px}
  .addrow{color:var(--np-accent);cursor:pointer;font-size:12px;display:inline-block;margin-top:4px}
  .grids{display:flex;gap:18px;align-items:flex-start;flex-wrap:wrap}
  .gwrap{min-width:220px}
  .gwrap h4{margin:0 0 3px;font-size:12px;color:#456}
  .btn{background:var(--np-accent);color:#fff;border:0;border-radius:4px;padding:5px 14px;font:12px var(--np-font);cursor:pointer}
  .msg{margin-left:10px;font-size:12px}
  .msg.ok{color:var(--np-ok)}.msg.err{color:var(--np-danger)}
  .rev{cursor:pointer;color:#fff;font-size:11px;opacity:.85;text-decoration:underline;background:none;border:0}
  .rev:hover{opacity:1}
  .pick{cursor:pointer;color:var(--np-accent);font-size:12px;display:inline-block;margin-top:4px;margin-left:12px}
  .modal{position:fixed;inset:0;background:rgba(20,28,38,.45);display:flex;align-items:center;justify-content:center;z-index:50}
  .modal-card{background:#fff;border-radius:8px;max-width:640px;width:92%;max-height:80vh;overflow:auto;box-shadow:0 10px 40px rgba(0,0,0,.3)}
  .modal-hd{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid var(--np-line);font-weight:600}
  .modal-bd{padding:6px 14px}
  .modal-ft{display:flex;gap:8px;justify-content:flex-end;padding:10px 14px;border-top:1px solid var(--np-line)}
  .modal tr.master.sel td{background:#dcecff}
  .btn.ghost{background:#e6ebf0;color:var(--np-ink)}
</style>
</head>
<body>
<div class="app" id="app"><p class="sub">Loading workbench…</p></div>

<script>
/* Generated Aggregate Workbench page for panel "{{panelName}}" (aggregate {{aggregateName}}).
   Descriptor-driven generic client: fetches loadWorkbench, renders header/grid/band, POSTs commit.
   Auth mirrors the shell: token from localStorage -> Authorization: Bearer + X-Api-Key. */
(function () {
  var PANEL = "{{panelName}}";
  var SELECTION_PANEL = "{{selectionPanel}}";
  var FILTERS = {{{filtersJson}}};
  var TOKEN_KEYS = ["npdev.shell.token", "npdev.businessUi.apiKey"];

  function token() { for (var i = 0; i < TOKEN_KEYS.length; i++) { var t = localStorage.getItem(TOKEN_KEYS[i]); if (t) return t; } return null; }
  function authHeaders() { var t = token(); return t ? { "Authorization": "Bearer " + t, "X-Api-Key": t } : {}; }

  var clone = function (v) { return v === undefined ? undefined : JSON.parse(JSON.stringify(v)); };
  var pick = function (o, fs) { var r = {}; (fs || []).forEach(function (f) { r[f] = o == null ? undefined : o[f]; }); return r; };
  var genId = function () { return "new-" + Math.random().toString(36).slice(2, 10); };

  function createStore(resp) {
    var descriptor = resp.workbench || {};
    var draft = clone(resp.data || {});
    (descriptor.sections || []).forEach(function (s) { if (!Array.isArray(draft[s.collection])) draft[s.collection] = []; });
    // baseline = the last persisted (or freshly loaded) tree; per-region revert (C8) restores from it.
    var baseline = clone(draft);
    var dirty = { header: false, sections: {} };
    function sectionDef(c) { return (descriptor.sections || []).filter(function (s) { return s.collection === c; })[0]; }
    function findRow(c, id) { return (draft[c] || []).filter(function (r) { return String(r.id) === String(id); })[0]; }
    return {
      aggregate: descriptor.aggregate || resp.aggregate,
      title: resp.title,
      descriptor: descriptor,
      isDirty: function () { var d = dirty.header; Object.keys(dirty.sections).forEach(function (k) { d = d || dirty.sections[k]; }); return d; },
      editHeader: function (f, v) { draft[f] = v; dirty.header = true; },
      editRow: function (c, id, f, v) { var r = findRow(c, id); if (r) { r[f] = v; dirty.sections[c] = true; } },
      editBandRow: function (c, id, b, bid, f, v) { var r = findRow(c, id); if (r) { var br = (r[b] || []).filter(function (x) { return String(x.id) === String(bid); })[0]; if (br) { br[f] = v; dirty.sections[c] = true; } } },
      addRow: function (c) { var row = { id: genId() }; (sectionDef(c).bands || []).forEach(function (b) { row[b.collection] = []; }); (draft[c] = draft[c] || []).push(row); dirty.sections[c] = true; return row.id; },
      deleteRow: function (c, id) { draft[c] = (draft[c] || []).filter(function (r) { return String(r.id) !== String(id); }); dirty.sections[c] = true; },
      addBandRow: function (c, id, b) { var r = findRow(c, id); if (!r) return null; var br = { id: genId() }; (r[b] = r[b] || []).push(br); dirty.sections[c] = true; return br.id; },
      // Add a band row seeded from a picked source row (C6): copy overlapping columns, assign a fresh id.
      addBandRowFrom: function (c, id, b, values) { var r = findRow(c, id); if (!r) return null; var br = Object.assign({}, values || {}); br.id = genId(); (r[b] = r[b] || []).push(br); dirty.sections[c] = true; return br.id; },
      deleteBandRow: function (c, id, b, bid) { var r = findRow(c, id); if (!r) return; r[b] = (r[b] || []).filter(function (x) { return String(x.id) !== String(bid); }); dirty.sections[c] = true; },
      // Per-region edit buffer (C8): true when the region has staged, uncommitted changes vs the baseline.
      regionDirty: function (scope, c) { return scope === "header" ? !!dirty.header : !!dirty.sections[c]; },
      // Discard a single region's staged changes back to the baseline, leaving other regions untouched.
      revertRegion: function (scope, c) {
        if (scope === "header") { ((descriptor.header && descriptor.header.fields) || []).forEach(function (f) { draft[f] = clone(baseline[f]); }); var lc = descriptor.lifecycle; if (lc && lc.statusField) draft[lc.statusField] = clone(baseline[lc.statusField]); dirty.header = false; }
        else { draft[c] = clone(baseline[c] || []); dirty.sections[c] = false; }
      },
      // Replace the working draft with a server-computed tree (invoke/recompute), preserving the baseline.
      // Marks every region dirty since the whole draft may have shifted; the user reviews and Saves.
      patch: function (newData) {
        draft = clone(newData || {});
        (descriptor.sections || []).forEach(function (s) { if (!Array.isArray(draft[s.collection])) draft[s.collection] = []; dirty.sections[s.collection] = true; });
        dirty.header = true;
      },
      // Lifecycle gating: the root's current state -> label + editability (terminal/read-only states).
      stateInfo: function () {
        var lc = descriptor.lifecycle;
        if (!lc || !lc.statusField) { return { editable: true, label: null }; }
        var val = draft[lc.statusField];
        var st = (lc.states || []).filter(function (s) { return s.value === val; })[0];
        return {
          value: val, label: st ? st.label : val, editable: st ? !!st.editable : true,
          // AW-P5: optional per-state action-rail gating (declared procedure names this state
          // permits). null/absent means no restriction -- every declared action stays enabled.
          allowedActions: st && st.allowedActions ? st.allowedActions : null
        };
      },
      toDraft: function () { return clone(draft); },
      view: function () {
        var hf = (descriptor.header && descriptor.header.fields) || [];
        return {
          aggregate: this.aggregate, title: this.title, dirty: this.isDirty(),
          header: { fields: hf, values: pick(draft, hf) },
          sections: (descriptor.sections || []).map(function (s) {
            return {
              collection: s.collection, columns: s.columns || [],
              bandDefs: (s.bands || []).map(function (b) { return { collection: b.collection, columns: b.columns || [], picker: b.picker || null }; }),
              rows: (draft[s.collection] || []).map(function (r) {
                return {
                  id: r.id, values: pick(r, s.columns || []),
                  bands: (s.bands || []).reduce(function (acc, b) { acc[b.collection] = (r[b.collection] || []).map(function (br) { return { id: br.id, values: pick(br, b.columns || []) }; }); return acc; }, {})
                };
              })
            };
          })
        };
      }
    };
  }

  var el = function (h) { var t = document.createElement("template"); t.innerHTML = h.trim(); return t.content.firstChild; };
  var EDITABLE = true;
  // Focus tracking so a debounced recompute re-render can restore the caret to the cell being edited.
  var activeFocusKey = null, restoreFocus = false;
  var cell = function (val, on, key) {
    var i = el('<input class="cell">');
    i.value = val == null ? "" : String(val);
    if (key) { i.setAttribute("data-fkey", key); i.addEventListener("focus", function () { activeFocusKey = key; }); }
    i.oninput = function (e) { on(e.target.value); scheduleRecompute(); };
    if (!EDITABLE) { i.readOnly = true; }
    return i;
  };

  // Reactive recompute (P3/C7): debounce cell edits, invoke the declared recompute procedure over the
  // draft, patch derived fields in place, and re-render — restoring focus to the cell being typed in.
  var recomputeTimer = null;
  function scheduleRecompute() {
    if (!store || !EDITABLE) return;
    var proc = store.descriptor.recompute;
    if (!proc) return;
    if (recomputeTimer) clearTimeout(recomputeTimer);
    recomputeTimer = setTimeout(function () { runRecompute(proc); }, 450);
  }
  function runRecompute(proc) {
    fetch("/api/runtime/aggregate/" + encodeURIComponent(store.aggregate) + "/invoke/" + encodeURIComponent(proc),
      { method: "POST", headers: Object.assign({ "Content-Type": "application/json" }, authHeaders()), body: JSON.stringify(store.toDraft()) })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (patched) { if (patched) { store.patch(patched); restoreFocus = true; render(); } })
      .catch(function () { /* recompute is best-effort; keep the user's draft on failure */ });
  }

  var store = null, selected = null;

  function render() {
    var v = store.view();
    var si = store.stateInfo();
    EDITABLE = si.editable;
    if (selected == null && v.sections[0] && v.sections[0].rows[0]) selected = v.sections[0].rows[0].id;
    var app = document.getElementById("app"); app.innerHTML = "";
    var stateChip = si.label ? ' <span class="chip">' + si.label + '</span>' : '';
    var roChip = EDITABLE ? '' : ' <span class="chip" style="background:var(--np-danger)">read-only</span>';
    app.append(el('<h1>' + v.title + ' <span class="chip ' + (v.dirty ? 'dirty' : '') + '">' + (v.dirty ? 'unsaved' : 'workbench') + '</span>' + stateChip + roChip + '</h1>'));
    app.append(el('<p class="sub">Aggregate: <b>' + v.aggregate + '</b></p>'));

    var head = el('<div class="region r-head"></div>');
    var headBar = el('<div class="bar head"><span>Header</span><span class="grow"></span></div>');
    if (EDITABLE && store.regionDirty("header")) headBar.append(regionRevert("header", null));
    head.append(headBar);
    var hb = el('<div class="body"></div>'); var f = el('<form class="grid2"></form>');
    v.header.fields.forEach(function (fld) { f.append(el('<label>' + fld + ':</label>')); var d = el("<div></div>"); d.append(cell(v.header.values[fld], function (val) { store.editHeader(fld, val); }, "h:" + fld)); f.append(d); });
    hb.append(f); head.append(hb); app.append(head);

    v.sections.forEach(function (sec) {
      var items = el('<div class="region r-items"></div>');
      var itemsBar = el('<div class="bar items"><span>' + sec.collection + '</span><span class="grow"></span><span class="chip">' + sec.rows.length + ' rows</span></div>');
      if (EDITABLE && store.regionDirty("section", sec.collection)) itemsBar.append(regionRevert("section", sec.collection));
      items.append(itemsBar);
      var ib = el('<div class="body"></div>'); var tbl = el("<table></table>");
      tbl.append(el("<tr>" + sec.columns.map(function (c) { return "<th>" + c + "</th>"; }).join("") + "<th></th></tr>"));
      sec.rows.forEach(function (r) {
        var tr = el('<tr class="master ' + (r.id === selected ? "sel" : "") + '"></tr>');
        sec.columns.forEach(function (c) { var td = el("<td></td>"); td.append(cell(r.values[c], function (val) { store.editRow(sec.collection, r.id, c, val); }, "s:" + sec.collection + ":" + r.id + ":" + c)); tr.append(td); });
        var del = el('<td></td>');
        if (EDITABLE) { var x = el('<span class="rowbtn">✕</span>'); x.onclick = function (e) { e.stopPropagation(); store.deleteRow(sec.collection, r.id); if (selected === r.id) selected = null; render(); }; del.append(x); }
        tr.append(del); tr.onclick = function () { selected = r.id; render(); }; tbl.append(tr);
      });
      ib.append(tbl);
      if (EDITABLE) { var add = el('<span class="addrow">+ add row</span>'); add.onclick = function () { selected = store.addRow(sec.collection); render(); }; ib.append(add); }
      items.append(ib); app.append(items);

      var selRow = sec.rows.filter(function (r) { return r.id === selected; })[0];
      if (sec.bandDefs.length && selRow) {
        var band = el('<div class="region r-band"></div>');
        band.append(el('<div class="bar band"><span>' + sec.collection + ' → bands (row ' + selRow.id + ')</span></div>'));
        var bb = el('<div class="body"></div>'); var grids = el('<div class="grids"></div>');
        sec.bandDefs.forEach(function (bd) {
          var g = el('<div class="gwrap"></div>'); g.append(el("<h4>" + bd.collection + "</h4>"));
          var gt = el("<table></table>"); gt.append(el("<tr>" + bd.columns.map(function (c) { return "<th>" + c + "</th>"; }).join("") + "<th></th></tr>"));
          (selRow.bands[bd.collection] || []).forEach(function (br) {
            var tr = el("<tr></tr>");
            bd.columns.forEach(function (c) { var td = el("<td></td>"); td.append(cell(br.values[c], function (val) { store.editBandRow(sec.collection, selRow.id, bd.collection, br.id, c, val); }, "b:" + sec.collection + ":" + selRow.id + ":" + bd.collection + ":" + br.id + ":" + c)); tr.append(td); });
            var del = el('<td></td>');
            if (EDITABLE) { var bx = el('<span class="rowbtn">✕</span>'); bx.onclick = function () { store.deleteBandRow(sec.collection, selRow.id, bd.collection, br.id); render(); }; del.append(bx); }
            tr.append(del); gt.append(tr);
          });
          g.append(gt);
          if (EDITABLE) {
            var add2 = el('<span class="addrow">+ add row</span>'); add2.onclick = function () { store.addBandRow(sec.collection, selRow.id, bd.collection); render(); }; g.append(add2);
            // C6 "Seleciona …": pick band rows from a source Selection panel via a modal, instead of blank add.
            if (bd.picker) { var pk = el('<span class="pick">＋ ' + (bd.picker.label || "Selecionar") + '</span>'); pk.onclick = (function (secC, rowId, band) { return function () { openBandPicker(secC, rowId, band); }; })(sec.collection, selRow.id, bd); g.append(pk); }
          }
          grids.append(g);
        });
        bb.append(grids); band.append(bb); app.append(band);
      }
    });

    var barDiv = el('<div style="margin:8px 0"></div>');
    if (!EDITABLE) {
      barDiv.append(el('<span class="sub">Read-only' + (si.label ? ' — Fase: ' + si.label : '') + '. Editing is disabled in this state.</span>'));
      app.append(barDiv);
      return;
    }
    var msg = el('<span class="msg"></span>');
    function commitDraft(label) {
      msg.className = "msg"; msg.textContent = (label || "Saving") + "…";
      fetch("/api/runtime/aggregate/" + encodeURIComponent(store.aggregate),
        { method: "POST", headers: Object.assign({ "Content-Type": "application/json" }, authHeaders()), body: JSON.stringify(store.toDraft()) })
        .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, b: b }; }); })
        .then(function (res) {
          if (res.ok) { msg.className = "msg ok"; msg.textContent = (label || "Saved") + "."; store = createStore({ workbench: store.descriptor, title: store.title, aggregate: store.aggregate, data: res.b }); render(); }
          else { msg.className = "msg err"; msg.textContent = "Failed: " + (res.b && res.b.message || r.status); }
        })
        .catch(function (e) { msg.className = "msg err"; msg.textContent = "Error: " + e; });
    }
    var save = el('<button class="btn">Save</button>'); save.onclick = function () { commitDraft("Saved"); };
    barDiv.append(save);
    // Lifecycle transition actions available from the current state (e.g. "Confirmar Saída"): set the
    // status field to the target state and commit; the persistence adapter enforces the legal transition.
    var lc = store.descriptor.lifecycle;
    if (lc && lc.statusField && si.value) {
      (lc.transitions || []).filter(function (t) { return t.from === si.value; }).forEach(function (t) {
        var b = el('<button class="btn" style="background:var(--np-ok);margin-left:6px">' + (t.label || ("→ " + t.to)) + '</button>');
        b.onclick = function () { store.editHeader(lc.statusField, t.to); commitDraft(t.label || ("→ " + t.to)); };
        barDiv.append(b);
      });
    }
    // Procedure-over-aggregate actions (P6): invoke a declared procedure over the current draft and patch
    // it in place (no persistence — the user reviews and commits explicitly). Only offered while editable.
    function invokeAction(action) {
      msg.className = "msg"; msg.textContent = (action.label || "Running") + "…";
      fetch("/api/runtime/aggregate/" + encodeURIComponent(store.aggregate) + "/invoke/" + encodeURIComponent(action.procedure),
        { method: "POST", headers: Object.assign({ "Content-Type": "application/json" }, authHeaders()), body: JSON.stringify(store.toDraft()) })
        .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, b: b }; }); })
        .then(function (res) {
          if (res.ok) { msg.className = "msg ok"; msg.textContent = (action.label || "Done") + " — review and Save."; store.patch(res.b); render(); }
          else { msg.className = "msg err"; msg.textContent = "Failed: " + (res.b && res.b.message || "error"); }
        })
        .catch(function (e) { msg.className = "msg err"; msg.textContent = "Error: " + e; });
    }
    if (EDITABLE) {
      (store.descriptor.actions || [])
        .filter(function (a) { return !si.allowedActions || si.allowedActions.indexOf(a.procedure) !== -1; })
        .forEach(function (a) {
          var b = el('<button class="btn" style="background:var(--np-accent);margin-left:6px">' + (a.label || a.procedure) + '</button>');
          b.onclick = function () { invokeAction(a); };
          barDiv.append(b);
        });
    }
    barDiv.append(msg); app.append(barDiv);

    // Restore caret to the cell being typed in after a recompute-triggered re-render (P3).
    if (restoreFocus && activeFocusKey) {
      var box = app.querySelector('[data-fkey="' + (window.CSS && CSS.escape ? CSS.escape(activeFocusKey) : activeFocusKey) + '"]');
      if (box) { box.focus(); try { var n = box.value.length; box.setSelectionRange(n, n); } catch (e) { } }
    }
    restoreFocus = false;
  }

  // A per-region revert control (C8): discards that region's staged edits back to the baseline.
  function regionRevert(scope, c) {
    var b = el('<button class="rev" title="Discard changes in this region">⟲ revert</button>');
    b.onclick = function (e) { e.stopPropagation(); store.revertRegion(scope, c); render(); };
    return b;
  }

  // C6 band picker modal: fetch candidate rows from the band's source Selection panel and let the user
  // check some to append as band rows (columns overlapping the band are copied from the picked source row).
  function openBandPicker(secCollection, rowId, bd) {
    var picker = bd.picker; if (!picker || !picker.panel) return;
    var cols = picker.columns && picker.columns.length ? picker.columns : bd.columns;
    var chosen = {};
    var overlay = el('<div class="modal"></div>');
    var card = el('<div class="modal-card"></div>');
    card.append(el('<div class="modal-hd"><span>' + (picker.label || "Selecionar") + '</span></div>'));
    var body = el('<div class="modal-bd"><p class="sub">Loading…</p></div>');
    card.append(body);
    var ft = el('<div class="modal-ft"></div>');
    var cancel = el('<button class="btn ghost">Cancelar</button>'); cancel.onclick = function () { overlay.remove(); };
    var add = el('<button class="btn">Adicionar</button>');
    add.onclick = function () {
      Object.keys(chosen).forEach(function (k) {
        var src = chosen[k]; var values = {};
        bd.columns.forEach(function (c) { if (src && src[c] !== undefined) values[c] = src[c]; });
        store.addBandRowFrom(secCollection, rowId, bd.collection, values);
      });
      overlay.remove(); render();
    };
    ft.append(cancel); ft.append(add); card.append(ft);
    overlay.append(card); overlay.onclick = function (e) { if (e.target === overlay) overlay.remove(); };
    document.body.append(overlay);
    fetch("/api/runtime/metadata/ui/panels/" + encodeURIComponent(picker.panel), { headers: authHeaders() })
      .then(function (r) { return r.json(); })
      .then(function (p) {
        var rows = null; var data = p.data || {};
        Object.keys(data).forEach(function (kk) { if (Array.isArray(data[kk]) && rows === null) rows = data[kk]; });
        rows = rows || [];
        body.innerHTML = "";
        if (!rows.length) { body.append(el('<p class="sub">No records available.</p>')); return; }
        var tbl = el("<table></table>");
        tbl.append(el("<tr><th></th>" + cols.map(function (c) { return "<th>" + c + "</th>"; }).join("") + "</tr>"));
        rows.forEach(function (r) {
          var d = r.data || {};
          var tr = el('<tr class="master"></tr>');
          var ck = el('<td><input type="checkbox"></td>');
          var box = ck.querySelector("input");
          box.onchange = function () { if (box.checked) { chosen[r.id] = d; tr.classList.add("sel"); } else { delete chosen[r.id]; tr.classList.remove("sel"); } };
          tr.append(ck);
          cols.forEach(function (c) { tr.append(el("<td>" + (d[c] == null ? "" : String(d[c])) + "</td>")); });
          tr.onclick = function (e) { if (e.target !== box) { box.checked = !box.checked; box.onchange(); } };
          tbl.append(tr);
        });
        body.append(tbl);
      })
      .catch(function (e) { body.innerHTML = '<p class="sub">Failed to load: ' + e + '</p>'; });
  }

  // List mode: with no ?id, show the root records (from the Selection panel), filter client-side on
  // the declared filter fields, and open one in the editor by navigating to ?id=<rowId>.
  var listState = { rows: [], columns: [], filters: {} };
  function openRow(id) { location.search = "?id=" + encodeURIComponent(id); }
  function filteredRows() {
    return listState.rows.filter(function (r) {
      return FILTERS.every(function (f) {
        var q = (listState.filters[f] || "").toLowerCase();
        if (!q) return true;
        return String((r.data || {})[f] == null ? "" : (r.data || {})[f]).toLowerCase().indexOf(q) >= 0;
      });
    });
  }
  function renderList() {
    var app = document.getElementById("app"); app.innerHTML = "";
    app.append(el('<h1>{{title}} <span class="chip">' + listState.rows.length + ' records</span></h1>'));
    app.append(el('<p class="sub">Select a record to open its workbench, or create a new one.</p>'));
    if (FILTERS.length) {
      var fbar = el('<form class="grid2"></form>');
      FILTERS.forEach(function (f) {
        fbar.append(el('<label>' + f + ':</label>'));
        var d = el("<div></div>");
        var i = el('<input>'); i.value = listState.filters[f] || "";
        i.oninput = function (e) { listState.filters[f] = e.target.value; renderTableOnly(); };
        d.append(i); fbar.append(d);
      });
      var reg = el('<div class="region r-items"></div>'); var rb = el('<div class="body"></div>');
      rb.append(fbar); reg.append(rb); app.append(reg);
    }
    app.append(el('<div id="listtable"></div>'));
    renderTableOnly();
    var barDiv = el('<div style="margin:8px 0"></div>');
    var neu = el('<button class="btn">New</button>'); neu.onclick = function () { openRow("new"); };
    barDiv.append(neu); app.append(barDiv);
  }
  function renderTableOnly() {
    var host = document.getElementById("listtable"); if (!host) return; host.innerHTML = "";
    var rows = filteredRows();
    var tbl = el("<table></table>");
    tbl.append(el("<tr>" + listState.columns.map(function (c) { return "<th>" + c + "</th>"; }).join("") + "</tr>"));
    rows.forEach(function (r) {
      var tr = el('<tr class="master"></tr>');
      listState.columns.forEach(function (c) { var v = (r.data || {})[c]; tr.append(el("<td>" + (v == null ? "" : String(v)) + "</td>")); });
      tr.onclick = function () { openRow(r.id); };
      tbl.append(tr);
    });
    host.append(tbl);
  }
  function loadList() {
    if (!SELECTION_PANEL) { document.getElementById("app").innerHTML = '<p class="sub">No selection panel configured.</p>'; return; }
    fetch("/api/runtime/metadata/ui/panels/" + encodeURIComponent(SELECTION_PANEL), { headers: authHeaders() })
      .then(function (r) { return r.json(); })
      .then(function (p) {
        var rows = null; var data = p.data || {};
        Object.keys(data).forEach(function (k) { if (Array.isArray(data[k]) && rows === null) rows = data[k]; });
        listState.rows = rows || [];
        listState.columns = (p.layout && p.layout.fields) || [];
        renderList();
      })
      .catch(function (e) { document.getElementById("app").innerHTML = '<p class="sub">Failed to load list: ' + e + '</p>'; });
  }

  function boot() {
    var id = new URLSearchParams(location.search).get("id") || "";
    if (!id) { loadList(); return; }
    // "new" loads the workbench descriptor with an empty tree (server returns descriptor + data:{}).
    var wbId = (id === "new") ? "" : id;
    var url = "/api/runtime/metadata/ui/panels/" + encodeURIComponent(PANEL) + (wbId ? "?id=" + encodeURIComponent(wbId) : "");
    fetch(url, { headers: authHeaders() })
      .then(function (r) { return r.json(); })
      .then(function (resp) { store = createStore(resp); render(); })
      .catch(function (e) { document.getElementById("app").innerHTML = '<p class="sub">Failed to load workbench: ' + e + '</p>'; });
  }
  document.addEventListener("DOMContentLoaded", boot);
}());
</script>
</body>
</html>
