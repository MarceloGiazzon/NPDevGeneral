    function add(region) { if (region && region.render === "component" && region.component && names.indexOf(region.component) === -1) names.push(region.component); }
    add(descriptor.header);
    (descriptor.sections || []).forEach(function (s) { add(s); (s.bands || []).forEach(add); });
    return names;
  }

