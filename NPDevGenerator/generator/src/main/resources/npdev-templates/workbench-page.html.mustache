    }));
  }

  function refreshServerDerivedFields() {
    var defs = (store.descriptor.derived || []).filter(function (d) { return d.tier === "server" && d.procedure; });
    if (!defs.length) return;
    var draft = store.toDraft();
    defs.forEach(function (d) {
      fetch("/api/runtime/aggregate/" + encodeURIComponent(store.aggregate) + "/invoke/" + encodeURIComponent(d.procedure),
        { method: "POST", headers: Object.assign({ "Content-Type": "application/json" }, authHeaders()), body: JSON.stringify(draft) })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (result) {
