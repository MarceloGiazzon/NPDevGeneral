package {{controllerPackage}};

import com.finalexec.config.ModelHolder;
import com.npdev.dsl.v1.compiled.CompiledAggregateFunction;
import com.npdev.dsl.v1.compiled.CompiledGroupByField;
import com.npdev.dsl.v1.compiled.CompiledProcedureParameter;
import com.npdev.dsl.v1.compiled.CompiledQuery;
import com.npdev.generated.runtime.service.RuntimeContextService;
import com.npdev.kernel.ExecutionContext;
import com.npdev.kernel.concepts.ConceptAggregateQuery;
import com.npdev.kernel.concepts.ConceptAggregateRequest;
import com.npdev.kernel.concepts.ConceptAggregateResult;
import com.npdev.kernel.concepts.ConceptGateway;
import com.npdev.kernel.concepts.ConceptGatewayAccessDeniedException;
import com.npdev.kernel.concepts.ConceptPage;
import com.npdev.kernel.concepts.ConceptQuery;
import com.npdev.kernel.concepts.ConceptQueryPredicateCompiler;
import com.npdev.kernel.concepts.ConceptQueryRequest;
import com.npdev.kernel.concepts.ConceptRecord;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.server.ResponseStatusException;

import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

/**
 * Move 10 B1 (LC-B1, MOVE10_AI_LOWCODE_PLAN Part B): executes a NAMED query declared in the
 * model -- plain (rows of concept records) or aggregate ({@link CompiledQuery#isAggregate()},
 * rows of grouped/aggregated output) -- exposed at REST alongside the generic
 * {@code /api/concepts/{conceptName}} surface, so a hand-written screen (and Move 10 B2's
 * chart/KPI gadgets) can use a declared query directly instead of re-deriving its filter/grouping
 * client-side. Routes through {@link ConceptGateway#query}/{@link ConceptGateway#aggregate}, which
 * enforce tenant isolation and permissions exactly as every other concept read does -- this
 * controller adds no authorization logic of its own.
 */
@RestController
public class GeneratedQueryController {

    private final ModelHolder modelHolder;
    private final ConceptGateway conceptGateway;
    private final RuntimeContextService runtimeContextService;

    public GeneratedQueryController(
            ModelHolder modelHolder, ConceptGateway conceptGateway, RuntimeContextService runtimeContextService) {
        this.modelHolder = modelHolder;
        this.conceptGateway = conceptGateway;
        this.runtimeContextService = runtimeContextService;
    }

    @GetMapping("/api/queries/{queryName}")
    public Map<String, Object> run(@PathVariable String queryName, HttpServletRequest request) {
        ExecutionContext context = runtimeContextService.currentContext(request);
        CompiledQuery query = findQuery(queryName);
        try {
            Map<String, Object> bound = bindParameters(request, query.parameters());
            return query.isAggregate()
                    ? runAggregate(query, context, bound)
                    : runPlain(query, context, bound, request);
        } catch (ConceptGatewayAccessDeniedException denied) {
            throw new ResponseStatusException(HttpStatus.FORBIDDEN, denied.getMessage());
        } catch (ConceptQueryPredicateCompiler.UnsupportedPredicateException predicate) {
            // X0: a predicate outside the v2 grammar, or an unbound :param, surfaces as a 400 --
            // never as an unfiltered (or 500) response.
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, predicate.getMessage());
        }
    }

    /**
     * WMS-12 (QueryExecutionEndpoint gaps): binds the query's declared {@code parameters[]} from
     * request query-string values. Per X0 an unbound declared parameter is REFUSED (400) rather
     * than defaulted to null or dropped from the filter -- an unfiltered result is never served
     * for a query that declares a bound placeholder. Values are coerced by shape (boolean /
     * integer / decimal / string) so the compiled filter literal matches the stored column type.
     */
    private static Map<String, Object> bindParameters(
            HttpServletRequest request, List<CompiledProcedureParameter> parameters) {
        Map<String, Object> bound = new LinkedHashMap<>();
        for (CompiledProcedureParameter parameter : parameters) {
            String raw = request.getParameter(parameter.name());
            if (raw == null) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                        "Query parameter '" + parameter.name() + "' is required (declared in this "
                                + "query's parameters[] but not supplied).");
            }
            bound.put(parameter.name(), coerceLiteral(raw));
        }
        return bound;
    }

    private static Object coerceLiteral(String raw) {
        String trimmed = raw.trim();
        if ("true".equalsIgnoreCase(trimmed)) {
            return Boolean.TRUE;
        }
        if ("false".equalsIgnoreCase(trimmed)) {
            return Boolean.FALSE;
        }
        try {
            return Long.parseLong(trimmed);
        } catch (NumberFormatException ignored) {
            // not an integer -- fall through
        }
        try {
            return Double.parseDouble(trimmed);
        } catch (NumberFormatException ignored) {
            // not a number -- keep the raw string
        }
        return raw;
    }

    private static int parseOffset(HttpServletRequest request) {
        String raw = request.getParameter("offset");
        if (raw == null || raw.isBlank()) {
            return 0;
        }
        try {
            return Math.max(0, Integer.parseInt(raw.trim()));
        } catch (NumberFormatException malformed) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "offset must be a non-negative integer");
        }
    }

    private static int parseLimit(HttpServletRequest request, int declaredLimit) {
        String raw = request.getParameter("limit");
        if (raw == null || raw.isBlank()) {
            return declaredLimit;
        }
        try {
            return Math.min(Math.max(1, Integer.parseInt(raw.trim())), ConceptQuery.MAX_LIMIT);
        } catch (NumberFormatException malformed) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "limit must be a positive integer");
        }
    }

    private CompiledQuery findQuery(String queryName) {
        for (CompiledQuery candidate : modelHolder.get().getQueries()) {
            if (candidate.name().equalsIgnoreCase(queryName)) {
                return candidate;
            }
        }
        throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Unknown query: " + queryName);
    }

    private Map<String, Object> runAggregate(
            CompiledQuery query, ExecutionContext context, Map<String, Object> bound) {
        List<ConceptQuery.Filter> filters = ConceptQueryPredicateCompiler.compileToConceptQueryFilters(
                query.where(), query.parameters(), bound);
        List<ConceptAggregateQuery.GroupByField> groupBy = new ArrayList<>();
        for (CompiledGroupByField field : query.groupBy()) {
            groupBy.add(new ConceptAggregateQuery.GroupByField(field.field(), field.bucket()));
        }
        List<ConceptAggregateQuery.AggregateFunction> aggregates = new ArrayList<>();
        for (CompiledAggregateFunction aggregate : query.aggregates()) {
            aggregates.add(new ConceptAggregateQuery.AggregateFunction(
                    aggregate.name(), aggregate.fn(), aggregate.field()));
        }
        List<ConceptQuery.Filter> having = ConceptQueryPredicateCompiler.compileToConceptQueryFilters(
                query.having(), query.parameters(), bound);
        List<ConceptQuery.Sort> sorts = ConceptQueryPredicateCompiler.compileOrderBy(query.orderBy());

        ConceptAggregateQuery aggregateQuery = new ConceptAggregateQuery(
                filters, groupBy, aggregates, having, sorts, query.limit());
        ConceptAggregateResult result = conceptGateway.aggregate(
                new ConceptAggregateRequest(query.concept(), aggregateQuery), context);

        Map<String, Object> body = new LinkedHashMap<>();
        body.put("query", query.name());
        body.put("aggregate", true);
        body.put("rows", result.rows());
        // R7.5 (LC-B2 follow-up): a chart/table/kpi gadget only ever saw the aggregated rows, with
        // no way back to the records that produced them -- every gadget was a dead end. `concept`
        // names the source concept and `groupBy` echoes each declared groupBy field (with its
        // bucket, if any) so shell.js can build a drill-down link using the row's own key values,
        // through the SAME `where` DSL (field:eq:value) R7.3 already taught the grid -- no new
        // filter format, no new endpoint. A bucketed field (e.g. a month-truncated date) is flagged
        // so the client can skip it: the row holds the bucket label, not the raw stored value, and
        // an eq filter against the raw field would not match any record.
        body.put("concept", query.concept());
        List<Map<String, Object>> groupByNodes = new ArrayList<>();
        for (CompiledGroupByField field : query.groupBy()) {
            Map<String, Object> node = new LinkedHashMap<>();
            node.put("field", field.field());
            node.put("bucket", field.bucket());
            groupByNodes.add(node);
        }
        body.put("groupBy", groupByNodes);
        return body;
    }

    private Map<String, Object> runPlain(
            CompiledQuery query, ExecutionContext context, Map<String, Object> bound, HttpServletRequest request) {
        List<ConceptQuery.Filter> filters = ConceptQueryPredicateCompiler.compileToConceptQueryFilters(
                query.where(), query.parameters(), bound);
        List<ConceptQuery.Sort> sorts = ConceptQueryPredicateCompiler.compileOrderBy(query.orderBy());
        int declaredLimit = query.limit() != null && query.limit() > 0 ? query.limit() : ConceptQuery.DEFAULT_LIMIT;
        int offset = parseOffset(request);
        int limit = parseLimit(request, declaredLimit);
        ConceptQuery conceptQuery = new ConceptQuery(filters, sorts, offset, limit);
        ConceptPage page = conceptGateway.query(new ConceptQueryRequest(query.concept(), conceptQuery), context);

        List<Map<String, Object>> rows = new ArrayList<>();
        for (ConceptRecord record : page.items()) {
            rows.add(record.data());
        }
        Map<String, Object> body = new LinkedHashMap<>();
        body.put("query", query.name());
        body.put("aggregate", false);
        body.put("rows", rows);
        body.put("total", page.total());
        body.put("offset", offset);
        body.put("limit", limit);
        return body;
    }
}
