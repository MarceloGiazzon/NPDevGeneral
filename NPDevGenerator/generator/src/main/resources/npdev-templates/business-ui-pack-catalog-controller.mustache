package {{controllerPackage}};

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.SerializationFeature;
import com.fasterxml.jackson.databind.node.ArrayNode;
import com.fasterxml.jackson.databind.node.ObjectNode;
import com.npdev.generated.runtime.service.RuntimeContextService;
import com.npdev.kernel.ExecutionContext;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.core.io.ClassPathResource;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.server.ResponseStatusException;

import com.fasterxml.jackson.core.type.TypeReference;

import java.io.IOException;
import java.io.InputStream;
import java.nio.file.Files;
import java.nio.file.Path;
import java.time.Instant;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

/**
 * Read-only "app store" view: every built-in platform pack the generator found on disk at
 * generation time, with its version/description/concept count and whether it is composed into
 * this app ({@code internal.tables}/{@code packs.included}). Super-user only — this is admin
 * surface, not business data.
 *
 * <p>"Install" first attempts a best-effort write into the generation-time
 * {@code Input/config.json}'s {@code packs.included} array, reached via the relative path every
 * sample's local dev workflow uses ({@code Output/App} -> {@code ../../Input/config.json}). This
 * only exists/works in that local workflow -- a config.json living outside the deployed app's own
 * filesystem in any other deployment shape means the write silently does nothing there, falling
 * back to recording intent only. Either way, there is no hot-reload: a regenerate is still required
 * to actually compose the pack.</p>
 */
@RestController
public class GeneratedPackCatalogController {

    private static final String SUPER_USER_ROLE = "{{superUserRole}}";
    private static final String CATALOG_RESOURCE = "npdev/store/pack-catalog.json";
    private static final Path INSTALL_INTENTS_FILE = Path.of("npdev-pack-install-intents.json");
    // Stable across every sample: Output/App (this app's CWD when run locally) -> ../../Input is
    // always the sibling Input/ directory the generator itself read config.json from (confirmed by
    // config.json's own finalExec.root convention, "..\Output\App" relative to Input/). Only valid
    // for the local dev/sample workflow -- intentionally not configurable, since a real deployment
    // has no Input/ to find regardless of what path we guess.
    private static final Path LOCAL_DEV_CONFIG_FILE = Path.of("..", "..", "Input", "config.json");
    private static final Path LOCAL_DEV_MODEL_FILE = Path.of("..", "..", "Input", "model.json");
    private static final java.util.regex.Pattern PACK_NAME_PATTERN = java.util.regex.Pattern.compile("^[a-z][a-z0-9_-]*$");
    private static final java.util.regex.Pattern FIELD_NAME_PATTERN = java.util.regex.Pattern.compile("^[a-zA-Z_][a-zA-Z0-9_]*$");
    // reference/object/array are deliberately excluded: they need richer sub-schemas (target
    // concept, nested property lists) this admin form doesn't attempt to author.
    private static final List<String> EDITABLE_FIELD_TYPES = List.of(
            "string", "uuid", "int", "integer", "long", "boolean", "date", "datetime", "enum");
    // Guards a pack.json's read-modify-write the same way INSTALL_INTENTS_LOCK guards the intents
    // file -- a distinct lock since it protects a different file.
    private static final Object PACK_EDIT_LOCK = new Object();
    private static final ObjectMapper OBJECT_MAPPER = new ObjectMapper().enable(SerializationFeature.INDENT_OUTPUT);
    // Guards the install-intents file's read-modify-write: two concurrent POSTs without this can
    // each read the same pre-update content and the second writer's append silently clobbers the
    // first's (a lost-update race), since java.nio.file.Files has no atomic "append a JSON array
    // element" operation. The file is small and this endpoint is low-traffic (super-user-only
    // admin action), so a simple in-process lock is proportionate -- no need for file locking.
    private static final Object INSTALL_INTENTS_LOCK = new Object();

    private final RuntimeContextService runtimeContextService;
    private final org.springframework.beans.factory.ObjectProvider<javax.sql.DataSource> dataSourceProvider;

    public GeneratedPackCatalogController(
            RuntimeContextService runtimeContextService,
            org.springframework.beans.factory.ObjectProvider<javax.sql.DataSource> dataSourceProvider) {
        this.runtimeContextService = runtimeContextService;
        this.dataSourceProvider = dataSourceProvider;
    }

    @GetMapping("/api/admin/packs")
    public Map<String, Object> packs(HttpServletRequest request) {
        requireSuperUser(request);
        return readCatalog();
    }

    /**
     * Prefers the durable, deployment-independent {@code npdev_pack_install_intent} table when a
     * real DataSource exists (any deployment shape) -- only falls back to the local intents file
     * (the pre-existing, local-dev-only mechanism) when this app's engine has no physical database
     * at all (e.g. a pure in-memory trial run), so the two records never silently diverge for the
     * same deployment.
     */
    @GetMapping("/api/admin/packs/install-intents")
    public Map<String, Object> installIntents(HttpServletRequest request) {
        requireSuperUser(request);
        Map<String, Object> body = new LinkedHashMap<>();
        javax.sql.DataSource dataSource = dataSourceProvider.getIfAvailable();
        if (dataSource != null) {
            body.put("intents", readIntentsFromDatabase(dataSource));
            body.put("durable", true);
        } else {
            synchronized (INSTALL_INTENTS_LOCK) {
                body.put("intents", readIntents());
            }
            body.put("durable", false);
        }
        return body;
    }

    @PostMapping("/api/admin/packs/{alias}/install-intent")
    public Map<String, Object> recordInstallIntent(@PathVariable String alias, HttpServletRequest request) {
        ExecutionContext context = requireSuperUser(request);
        requireKnownPackAlias(alias);
        boolean configWritten = tryWriteConfigInclude(alias);
        javax.sql.DataSource dataSource = dataSourceProvider.getIfAvailable();
        boolean recordedDurably = false;
        if (dataSource != null) {
            recordIntentInDatabase(dataSource, alias, context.actorId(), configWritten);
            recordedDurably = true;
        } else {
            synchronized (INSTALL_INTENTS_LOCK) {
                List<Map<String, Object>> intents = readIntents();
                Map<String, Object> intent = new LinkedHashMap<>();
                intent.put("alias", alias);
                intent.put("requestedAt", Instant.now().toString());
                intent.put("configWritten", configWritten);
                intents.add(intent);
                writeIntents(intents);
            }
        }
        Map<String, Object> body = new LinkedHashMap<>();
        body.put("recorded", true);
        body.put("alias", alias);
        body.put("configWritten", configWritten);
        body.put("recordedDurably", recordedDurably);
        body.put("message", configWritten
                ? "Install intent recorded and written to config.json's packs.included for \"" + alias
                        + "\". Regenerate to apply -- this does not hot-reload."
                : "Install intent recorded for \"" + alias
                        + "\"" + (recordedDurably
                                ? " in this app's own database (visible to any admin reaching this deployment)"
                                : "")
                        + ", but config.json could not be located/updated automatically (only works in the "
                        + "local dev/sample workflow). Add it to packs.included by hand and regenerate to apply.");
        return body;
    }

    private static void recordIntentInDatabase(
            javax.sql.DataSource dataSource, String alias, String requestedBy, boolean configWritten) {
        String sql = "INSERT INTO npdev_pack_install_intent (intent_id, alias, requested_at_ms, requested_by, config_written) VALUES (?, ?, ?, ?, ?)";
        try (java.sql.Connection connection = dataSource.getConnection();
             java.sql.PreparedStatement statement = connection.prepareStatement(sql)) {
            statement.setString(1, java.util.UUID.randomUUID().toString());
            statement.setString(2, alias);
            statement.setLong(3, Instant.now().toEpochMilli());
            statement.setString(4, requestedBy == null ? "" : requestedBy);
            statement.setString(5, String.valueOf(configWritten));
            statement.executeUpdate();
        } catch (java.sql.SQLException exception) {
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Failed to record pack install intent");
        }
    }

    private static List<Map<String, Object>> readIntentsFromDatabase(javax.sql.DataSource dataSource) {
        String sql = "SELECT alias, requested_at_ms, requested_by, config_written FROM npdev_pack_install_intent ORDER BY requested_at_ms ASC";
        try (java.sql.Connection connection = dataSource.getConnection();
             java.sql.PreparedStatement statement = connection.prepareStatement(sql);
             java.sql.ResultSet resultSet = statement.executeQuery()) {
            List<Map<String, Object>> out = new ArrayList<>();
            while (resultSet.next()) {
                Map<String, Object> intent = new LinkedHashMap<>();
                intent.put("alias", resultSet.getString("alias"));
                intent.put("requestedAt", Instant.ofEpochMilli(resultSet.getLong("requested_at_ms")).toString());
                intent.put("requestedBy", resultSet.getString("requested_by"));
                intent.put("configWritten", Boolean.parseBoolean(resultSet.getString("config_written")));
                out.add(intent);
            }
            return out;
        } catch (java.sql.SQLException exception) {
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Failed to read pack install intents");
        }
    }

    /**
     * Best-effort: read Input/config.json, add {@code alias} to its packs.included array if not
     * already present, write it back. Returns false (never throws) for anything that stops this
     * from working -- file not found, not valid JSON, not writable -- since this whole path is a
     * convenience for the local dev workflow, not something a real deployment can rely on.
     */
    private boolean tryWriteConfigInclude(String alias) {
        synchronized (INSTALL_INTENTS_LOCK) {
            try {
                if (!Files.isRegularFile(LOCAL_DEV_CONFIG_FILE)) {
                    return false;
                }
                JsonNode root = OBJECT_MAPPER.readTree(LOCAL_DEV_CONFIG_FILE.toFile());
                if (!(root instanceof ObjectNode configNode)) {
                    return false;
                }
                JsonNode packsNode = configNode.get("packs");
                ObjectNode packsObject = (packsNode instanceof ObjectNode existing)
                        ? existing
                        : configNode.putObject("packs");
                JsonNode includedNode = packsObject.get("included");
                ArrayNode includedArray = (includedNode instanceof ArrayNode existing)
                        ? existing
                        : packsObject.putArray("included");
                boolean alreadyPresent = false;
                for (JsonNode entry : includedArray) {
                    if (alias.equals(entry.asText())) {
                        alreadyPresent = true;
                        break;
                    }
                }
                if (!alreadyPresent) {
                    includedArray.add(alias);
                }
                OBJECT_MAPPER.writeValue(LOCAL_DEV_CONFIG_FILE.toFile(), configNode);
                return true;
            } catch (Exception exception) {
                return false;
            }
        }
    }

    /**
     * Author-time "export a concept to a new pack" (gap C.2), surfaced from the running app rather
     * than requiring the {@code export-concept-to-pack.ps1} script -- but under the SAME local-
     * workflow-only constraint as install: this app's own {@code Input/model.json} and the platform
     * {@code NPDevContract/packs/} directory are only both reachable from a sample's own local dev
     * checkout, never from a real deployment. There is no partial/fallback mode here (unlike
     * install's intent-recording) because there is nothing meaningful to defer -- either the pack
     * gets written now, or it can't be exported from this running instance at all.
     */
    @PostMapping("/api/admin/packs/export")
    public Map<String, Object> exportConceptToPack(@org.springframework.web.bind.annotation.RequestBody Map<String, Object> request,
                                                     HttpServletRequest httpRequest) {
        requireSuperUser(httpRequest);
        String conceptName = String.valueOf(request.getOrDefault("conceptName", "")).trim();
        String packName = String.valueOf(request.getOrDefault("packName", "")).trim();
        String author = String.valueOf(request.getOrDefault("author", "")).trim();
        String category = String.valueOf(request.getOrDefault("category", "other")).trim();
        String description = String.valueOf(request.getOrDefault("description", "")).trim();
        String version = String.valueOf(request.getOrDefault("version", "1.0.0")).trim();
        if (conceptName.isBlank() || packName.isBlank() || author.isBlank()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "conceptName, packName, and author are required");
        }
        if (!PACK_NAME_PATTERN.matcher(packName).matches()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                    "packName must match ^[a-z][a-z0-9_-]*$ (pack.schema.json's identifier pattern), got: " + packName);
        }

        Path workspaceRoot = locateWorkspaceRoot();
        if (workspaceRoot == null) {
            Map<String, Object> body = new LinkedHashMap<>();
            body.put("exported", false);
            body.put("message", "Cannot export from this deployment: the platform NPDevContract/packs "
                    + "directory is only reachable from a sample's local dev checkout.");
            return body;
        }
        if (!Files.isRegularFile(LOCAL_DEV_MODEL_FILE)) {
            Map<String, Object> body = new LinkedHashMap<>();
            body.put("exported", false);
            body.put("message", "Cannot export: this app's own Input/model.json was not found at the expected local dev path.");
            return body;
        }

        Path packSchemaPath = workspaceRoot.resolve("NPDevContract").resolve("schemas").resolve("pack.schema.json");
        List<String> validCategories = readCategoryEnum(packSchemaPath);
        if (!validCategories.isEmpty() && !validCategories.contains(category)) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                    "category must be one of: " + validCategories + ", got: " + category);
        }

        JsonNode conceptNode;
        try {
            JsonNode model = OBJECT_MAPPER.readTree(LOCAL_DEV_MODEL_FILE.toFile());
            conceptNode = null;
            for (JsonNode candidate : model.path("concepts")) {
                if (conceptName.equals(candidate.path("name").asText(""))) {
                    conceptNode = candidate;
                    break;
                }
            }
        } catch (IOException exception) {
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Failed to read Input/model.json");
        }
        if (conceptNode == null) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Concept not found in this app's model: " + conceptName);
        }

        Path packDir = workspaceRoot.resolve("NPDevContract").resolve("packs").resolve(packName);
        Path packJsonPath = packDir.resolve("pack.json");
        if (Files.exists(packJsonPath)) {
            throw new ResponseStatusException(HttpStatus.CONFLICT,
                    "Pack already exists, refusing to overwrite: " + packName);
        }

        ObjectNode pack = OBJECT_MAPPER.createObjectNode();
        pack.put("$schema", "../../schemas/pack.schema.json");
        pack.put("dslVersion", "1.0.0");
        pack.put("pack", packName);
        pack.put("version", version);
        pack.put("description", description.isBlank()
                ? ("Exported from concept '" + conceptName + "' via the running app's admin UI.")
                : description);
        pack.put("category", category);
        pack.put("author", author);
        ArrayNode concepts = pack.putArray("concepts");
        concepts.add(conceptNode);

        try {
            Files.createDirectories(packDir);
            OBJECT_MAPPER.writeValue(packJsonPath.toFile(), pack);
        } catch (IOException exception) {
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Failed to write pack.json");
        }

        Map<String, Object> body = new LinkedHashMap<>();
        body.put("exported", true);
        body.put("packName", packName);
        body.put("conceptName", conceptName);
        body.put("message", "Exported concept '" + conceptName + "' to new pack '" + packName
                + "'. It now appears in the Store catalog on the next generation.");
        return body;
    }

    /**
     * Full field editing (add) of an EXISTING pack's concept -- a real reversal of the earlier
     * "extend the manifest renderer, don't converge with the React Editor" boundary, deliberately
     * scoped to pack.json specifically: unlike an app's own authored model.json (which the React
     * Editor owns, and which DOES have live-schema/migration implications the instant it's
     * regenerated), a pack.json is a not-yet-consumed platform CATALOG TEMPLATE -- editing it has
     * zero effect on any already-composed app's database until some app actually (re)composes this
     * pack at a future generation.
     */
    @PostMapping("/api/admin/packs/{alias}/concepts/{concept}/fields")
    public Map<String, Object> addPackField(
            @PathVariable String alias, @PathVariable String concept,
            @org.springframework.web.bind.annotation.RequestBody Map<String, Object> request,
            HttpServletRequest httpRequest) {
        requireSuperUser(httpRequest);
        String fieldName = String.valueOf(request.getOrDefault("name", "")).trim();
        String fieldType = String.valueOf(request.getOrDefault("type", "")).trim();
        boolean required = Boolean.TRUE.equals(request.get("required"));
        Object enumValuesRaw = request.get("enumValues");

        if (fieldName.isBlank() || !FIELD_NAME_PATTERN.matcher(fieldName).matches()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                    "name must be a valid identifier (^[a-zA-Z_][a-zA-Z0-9_]*$), got: " + fieldName);
        }
        if (!EDITABLE_FIELD_TYPES.contains(fieldType)) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "type must be one of: "
                    + EDITABLE_FIELD_TYPES + " (reference/object/array are not editable from this admin form), got: " + fieldType);
        }
        if ("enum".equals(fieldType) && !(enumValuesRaw instanceof List<?> enumList && !enumList.isEmpty())) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "enumValues is required and must be non-empty for type=enum");
        }

        synchronized (PACK_EDIT_LOCK) {
            ObjectNode packRoot = requireEditablePack(alias);
            ObjectNode conceptNode = requireConceptNode(packRoot, concept, alias);
            ArrayNode fields = requireFieldsArray(conceptNode);
            for (JsonNode existing : fields) {
                if (fieldName.equals(existing.path("name").asText(""))) {
                    throw new ResponseStatusException(HttpStatus.CONFLICT, "Field already exists on " + concept + ": " + fieldName);
                }
            }
            ObjectNode newField = OBJECT_MAPPER.createObjectNode();
            newField.put("name", fieldName);
            newField.put("type", fieldType);
            if (required) {
                newField.put("required", true);
            }
            if ("enum".equals(fieldType)) {
                ArrayNode enumValues = newField.putArray("enumValues");
                for (Object value : (List<?>) enumValuesRaw) {
                    enumValues.add(String.valueOf(value));
                }
            }
            fields.add(newField);
            writePackJson(alias, packRoot);
        }

        Map<String, Object> body = new LinkedHashMap<>();
        body.put("added", true);
        body.put("field", fieldName);
        body.put("message", "Added field '" + fieldName + "' to " + alias + "::" + concept
                + ". Takes effect for apps that compose this pack on their NEXT generation.");
        return body;
    }

    /** Change an existing field's type (and enumValues, if applicable). Refuses to retype the
     *  concept's own id field, since that would break every generated entity referencing it. */
    @org.springframework.web.bind.annotation.PutMapping("/api/admin/packs/{alias}/concepts/{concept}/fields/{fieldName}")
    public Map<String, Object> updatePackField(
            @PathVariable String alias, @PathVariable String concept, @PathVariable String fieldName,
            @org.springframework.web.bind.annotation.RequestBody Map<String, Object> request,
            HttpServletRequest httpRequest) {
        requireSuperUser(httpRequest);
        String newType = String.valueOf(request.getOrDefault("type", "")).trim();
        Object enumValuesRaw = request.get("enumValues");
        if (!EDITABLE_FIELD_TYPES.contains(newType)) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "type must be one of: " + EDITABLE_FIELD_TYPES + ", got: " + newType);
        }
        if ("enum".equals(newType) && !(enumValuesRaw instanceof List<?> enumList && !enumList.isEmpty())) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "enumValues is required and must be non-empty for type=enum");
        }

        synchronized (PACK_EDIT_LOCK) {
            ObjectNode packRoot = requireEditablePack(alias);
            ObjectNode conceptNode = requireConceptNode(packRoot, concept, alias);
            ArrayNode fields = requireFieldsArray(conceptNode);
            ObjectNode target = null;
            for (JsonNode candidate : fields) {
                if (fieldName.equals(candidate.path("name").asText("")) && candidate instanceof ObjectNode objectNode) {
                    target = objectNode;
                    break;
                }
            }
            if (target == null) {
                throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Field not found: " + fieldName);
            }
            if (target.path("id").asBoolean(false)) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Refusing to retype the concept's own id field: " + fieldName);
            }
            if ("reference".equals(target.path("type").asText(""))) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                        "Refusing to retype a reference/bond field from this scalar-only editor: " + fieldName);
            }
            target.put("type", newType);
            if ("enum".equals(newType)) {
                ArrayNode enumValues = target.putArray("enumValues");
                for (Object value : (List<?>) enumValuesRaw) {
                    enumValues.add(String.valueOf(value));
                }
            } else {
                target.remove("enumValues");
            }
            writePackJson(alias, packRoot);
        }

        Map<String, Object> body = new LinkedHashMap<>();
        body.put("updated", true);
        body.put("field", fieldName);
        body.put("message", "Updated field '" + fieldName + "' on " + alias + "::" + concept + " to type " + newType
                + ". Takes effect for apps that compose this pack on their NEXT generation.");
        return body;
    }

    /** Refuses to remove the concept's own id field, or the last remaining field (pack.schema.json
     *  requires at least one field per concept). */
    @org.springframework.web.bind.annotation.DeleteMapping("/api/admin/packs/{alias}/concepts/{concept}/fields/{fieldName}")
    public Map<String, Object> deletePackField(
            @PathVariable String alias, @PathVariable String concept, @PathVariable String fieldName,
            HttpServletRequest httpRequest) {
        requireSuperUser(httpRequest);

        synchronized (PACK_EDIT_LOCK) {
            ObjectNode packRoot = requireEditablePack(alias);
            ObjectNode conceptNode = requireConceptNode(packRoot, concept, alias);
            ArrayNode fields = requireFieldsArray(conceptNode);
            int removeIndex = -1;
            for (int i = 0; i < fields.size(); i++) {
                JsonNode candidate = fields.get(i);
                if (fieldName.equals(candidate.path("name").asText(""))) {
                    if (candidate.path("id").asBoolean(false)) {
                        throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Refusing to remove the concept's own id field: " + fieldName);
                    }
                    if ("reference".equals(candidate.path("type").asText(""))) {
                        throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                                "Refusing to remove a reference/bond field from this scalar-only editor: " + fieldName);
                    }
                    removeIndex = i;
                    break;
                }
            }
            if (removeIndex < 0) {
                throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Field not found: " + fieldName);
            }
            if (fields.size() <= 1) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                        "Refusing to remove the last field on " + concept + " (a concept needs at least one field)");
            }
            fields.remove(removeIndex);
            writePackJson(alias, packRoot);
        }

        Map<String, Object> body = new LinkedHashMap<>();
        body.put("removed", true);
        body.put("field", fieldName);
        body.put("message", "Removed field '" + fieldName + "' from " + alias + "::" + concept
                + ". Takes effect for apps that compose this pack on their NEXT generation.");
        return body;
    }

    private static ObjectNode requireEditablePack(String alias) {
        Path workspaceRoot = locateWorkspaceRoot();
        if (workspaceRoot == null) {
            throw new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE,
                    "Cannot edit packs from this deployment: the platform NPDevContract/packs directory is only reachable from a local dev checkout.");
        }
        Path packJsonPath = workspaceRoot.resolve("NPDevContract").resolve("packs").resolve(alias).resolve("pack.json");
        if (!Files.isRegularFile(packJsonPath)) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Unknown pack: " + alias);
        }
        try {
            JsonNode root = OBJECT_MAPPER.readTree(packJsonPath.toFile());
            if (!(root instanceof ObjectNode objectNode)) {
                throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "pack.json is not a JSON object: " + alias);
            }
            return objectNode;
        } catch (IOException exception) {
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Failed to read pack.json for " + alias);
        }
    }

    private static ObjectNode requireConceptNode(ObjectNode packRoot, String concept, String alias) {
        for (JsonNode candidate : packRoot.path("concepts")) {
            if (concept.equals(candidate.path("name").asText("")) && candidate instanceof ObjectNode objectNode) {
                return objectNode;
            }
        }
        throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Concept not found in pack " + alias + ": " + concept);
    }

    private static ArrayNode requireFieldsArray(ObjectNode conceptNode) {
        JsonNode fieldsNode = conceptNode.get("fields");
        if (fieldsNode instanceof ArrayNode arrayNode) {
            return arrayNode;
        }
        return conceptNode.putArray("fields");
    }

    private static void writePackJson(String alias, ObjectNode packRoot) {
        Path workspaceRoot = locateWorkspaceRoot();
        Path packJsonPath = workspaceRoot.resolve("NPDevContract").resolve("packs").resolve(alias).resolve("pack.json");
        try {
            OBJECT_MAPPER.writeValue(packJsonPath.toFile(), packRoot);
        } catch (IOException exception) {
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Failed to write pack.json for " + alias);
        }
    }

    private static List<String> readCategoryEnum(Path packSchemaPath) {
        if (!Files.isRegularFile(packSchemaPath)) {
            return List.of();
        }
        try {
            JsonNode schema = OBJECT_MAPPER.readTree(packSchemaPath.toFile());
            List<String> values = new ArrayList<>();
            for (JsonNode value : schema.path("properties").path("category").path("enum")) {
                values.add(value.asText());
            }
            return values;
        } catch (IOException exception) {
            return List.of();
        }
    }

    /** Same sibling-directory discovery {@link com.npdev.generator.provenance.PackCatalogEmitter}
     *  uses at generation time, re-implemented here since this runs inside the generated app's own
     *  process, not the generator's -- only ever resolves in a local dev checkout. */
    private static Path locateWorkspaceRoot() {
        Path current = Path.of("").toAbsolutePath();
        while (current != null) {
            if (Files.isDirectory(current.resolve("NPDevContract"))
                    && Files.isDirectory(current.resolve("NPDevGenerator"))
                    && Files.isDirectory(current.resolve("NPDevKernel"))
                    && Files.isDirectory(current.resolve("NPDevRuntimeHost"))) {
                return current;
            }
            current = current.getParent();
        }
        return null;
    }

    /** Rejects an alias that doesn't actually appear in the generated pack catalog -- previously
     *  any string was accepted and silently recorded, with no feedback that it named nothing real. */
    @SuppressWarnings("unchecked")
    private void requireKnownPackAlias(String alias) {
        List<Map<String, Object>> packs = (List<Map<String, Object>>) readCatalog().getOrDefault("packs", List.of());
        boolean known = packs.stream().anyMatch(pack -> alias.equals(String.valueOf(pack.get("alias"))));
        if (!known) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Unknown pack alias: " + alias);
        }
    }

    private ExecutionContext requireSuperUser(HttpServletRequest request) {
        ExecutionContext context = runtimeContextService.currentContext(request);
        if (!context.roles().contains(SUPER_USER_ROLE)) {
            throw new ResponseStatusException(HttpStatus.FORBIDDEN, "Super-user role required");
        }
        return context;
    }

    private Map<String, Object> readCatalog() {
        try (InputStream in = new ClassPathResource(CATALOG_RESOURCE).getInputStream()) {
            JsonNode root = OBJECT_MAPPER.readTree(in);
            Map<String, Object> body = new LinkedHashMap<>();
            body.put("discoverable", root.path("discoverable").asBoolean(false));
            body.put("packs", OBJECT_MAPPER.convertValue(root.path("packs"), new TypeReference<List<Map<String, Object>>>() { }));
            return body;
        } catch (Exception exception) {
            Map<String, Object> body = new LinkedHashMap<>();
            body.put("discoverable", false);
            body.put("packs", List.of());
            return body;
        }
    }

    private List<Map<String, Object>> readIntents() {
        if (!Files.isRegularFile(INSTALL_INTENTS_FILE)) {
            return new ArrayList<>();
        }
        try {
            JsonNode root = OBJECT_MAPPER.readTree(INSTALL_INTENTS_FILE.toFile());
            List<Map<String, Object>> intents = OBJECT_MAPPER.convertValue(root, new TypeReference<List<Map<String, Object>>>() { });
            return intents == null ? new ArrayList<>() : intents;
        } catch (IOException exception) {
            return new ArrayList<>();
        }
    }

    private void writeIntents(List<Map<String, Object>> intents) {
        try {
            OBJECT_MAPPER.writeValue(INSTALL_INTENTS_FILE.toFile(), intents);
        } catch (IOException exception) {
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Failed to record install intent");
        }
    }
}
