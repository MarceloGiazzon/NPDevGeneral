    private static Map<String, Object> validateMapRequest(Map<String, Object> request, boolean update, UUID pathId) {
        if (request == null) {
            throw new IllegalArgumentException("Request body is required");
        }
        Map<String, Object> normalized = new LinkedHashMap<>();
        for (Map.Entry<String, Object> entry : request.entrySet()) {
            String fieldName = entry.getKey();
            if (fieldName == null || fieldName.isBlank()) {
                throw new IllegalArgumentException("Unknown blank field in request body");
            }
            if (!ALL_FIELD_NAMES.contains(fieldName)) {
                throw new IllegalArgumentException("Unknown field for {{conceptName}}: " + fieldName);
            }
            validateEnumValue(fieldName, entry.getValue());
            normalized.put(fieldName, entry.getValue());
        }
        if (update && normalized.containsKey(ID_FIELD_NAME)) {
            UUID bodyId = toUuid(normalized.get(ID_FIELD_NAME));
            if (bodyId == null) {
                throw new IllegalArgumentException("Invalid id field '" + ID_FIELD_NAME + "' in request body");
            }
            if (pathId != null && !pathId.equals(bodyId)) {
                throw new IllegalArgumentException("Body id field '" + ID_FIELD_NAME
                        + "' must match path id. pathId=" + pathId + " bodyId=" + bodyId);
            }
        }
        if (!update) {
            for (String requiredField : REQUIRED_CREATE_FIELD_NAMES) {
                Object value = normalized.get(requiredField);
                if (value == null || (value instanceof String text && text.trim().isEmpty())) {
                    throw new IllegalArgumentException("Required field is missing for {{conceptName}}: " + requiredField);
                }
            }
        }
        return normalized;
    }

    private static void validateEnumValue(String fieldName, Object value) {
        Set<String> allowedValues = ENUM_VALUES_BY_FIELD.get(fieldName);
        if (allowedValues == null || allowedValues.isEmpty() || value == null) {
            return;
        }
        String normalized = String.valueOf(value).trim();
        if (normalized.isEmpty()) {
            return;
        }
        boolean match = allowedValues.stream().anyMatch(candidate -> candidate.equals(normalized));
        if (!match) {
            throw new IllegalArgumentException("Invalid enum value for {{conceptName}}." + fieldName
                    + ": " + normalized + " (allowed: " + allowedValues + ")");
        }
    }

    private static UUID toUuid(Object value) {
        if (value == null) {
            return null;
        }
        if (value instanceof UUID uuid) {
            return uuid;
        }
        try {
            return UUID.fromString(String.valueOf(value).trim());
        } catch (Exception exception) {
            return null;
        }
    }

    private void enforceWithKernel(String entityName, Map<String, Object> payload) {
        List<GeneratedCrudRuntimeSupport.InvariantViolationDetail> violations = runtimeSupport.validateEntityDetailed(
                entityName,
                payload,
                (requestedEntityName, fieldName, value, excludeId, invariantPayload) ->
                        persistence.existsUnique(fieldName, value, excludeId)
        );
        if (!violations.isEmpty()) {
            throw new GeneratedCrudRuntimeSupport.InvariantViolationException(violations);
        }
    }

