    /**
     * REG-16-resid Round 3 (R3-F2). The many-to-many bond endpoints above shipped with NO
     * authorization of any kind: no coarse {@code checkCrudPermission}, no row-level
     * {@code access.write} gate, no tenant predicate (the junction SQL keys on the source id alone),
     * and no audit -- while create/update/delete on the very same concept had all four. Any
     * authenticated caller holding a record id could rewrite that record's relationships regardless
     * of write scope, which is LNCH13-F1's class of bug on a surface LNCH13-F1 did not cover.
     *
     * <p>The gate is the SOURCE record's write authorization, not the junction row's: a junction row
     * has no owner of its own, and "may I change what this record is linked to" is exactly "may I
     * write this record". Routing through the gateway also supplies the tenant check for free --
     * {@code authorizeWrite} resolves the record within the caller's tenant, so a cross-tenant id
     * fails there rather than needing a tenant column the junction table does not have.
     */
    private void enforceBondMembershipWrite(UUID id) {
{{#kernelControlled}}
        runtimeSupport.checkCrudPermission("{{conceptName}}", "UPDATE", generatedCrudExecutionContext());
{{/kernelControlled}}
        if (conceptGateway == null) {
            throw new IllegalStateException("ConceptGateway is required for generated bond mutations.");
        }
        try {
            conceptGateway.authorizeWrite(
                    new ConceptReadRequest(CONCEPT_NAME, String.valueOf(id), currentTenantId()),
                    generatedCrudExecutionContext()
            );
        } catch (ConceptGatewaySemanticException exception) {
            throw new GeneratedCrudRuntimeSupport.InvariantViolationException(List.of(
                    new GeneratedCrudRuntimeSupport.InvariantViolationDetail(
                            exception.code(),
                            CONCEPT_NAME,
                            "conceptGateway",
                            null,
                            exception.getMessage(),
                            false
                    )
            ));
        }
    }

    /**
     * Reading a record's bond members discloses its relationships, so it needs the same scope the
     * record itself needs. {@code findByIdFromConceptStore} goes through the gateway, so this
     * enforces tenant isolation AND row-level {@code access.read} -- and a denied row is reported as
     * absent, matching how every other read on this surface treats one.
     */
    private void requireReadableBondSource(UUID id) {
        if (findByIdFromConceptStore(id).isEmpty()) {
            throw new GeneratedCrudRuntimeSupport.InvariantViolationException(List.of(
                    new GeneratedCrudRuntimeSupport.InvariantViolationDetail(
                            "not_found",
                            CONCEPT_NAME,
                            "conceptGateway",
                            null,
                            CONCEPT_NAME + " was not found",
                            false
                    )
            ));
        }
    }

