    private {{entityName}} saveToConceptStore({{entityName}} entity) {
        UUID id = entity.getId();
        if (id == null) {
            throw new IllegalArgumentException("Generated CRUD cannot save {{conceptName}} without an id.");
        }
        conceptStore.save(new ConceptRecord(CONCEPT_NAME, String.valueOf(id), DEFAULT_TENANT_ID, mapFromEntity(entity)));
        return entity;
    }

    private void deleteFromConceptStore(UUID id) {
        if (id != null) {
            conceptStore.deleteById(DEFAULT_TENANT_ID, CONCEPT_NAME, String.valueOf(id));
        }
    }

    private boolean existsUniqueInConceptStore(String fieldName, Object value, UUID excludeId) {
        if (fieldName == null || fieldName.isBlank() || value == null) {
            return false;
        }
        String normalizedField = fieldName.trim();
        for (ConceptRecord record : conceptStore.findAll(DEFAULT_TENANT_ID, CONCEPT_NAME)) {
            if (excludeId != null && String.valueOf(excludeId).equalsIgnoreCase(record.id())) {
                continue;
            }
            Object existingValue = record.data().get(normalizedField);
            if (uniqueValuesEqual(existingValue, value)) {
                return true;
            }
        }
        return false;
    }

    private {{entityName}} entityFromRecord(ConceptRecord record) {
        Map<String, Object> data = new LinkedHashMap<>(record.data());
        data.putIfAbsent(ID_FIELD_NAME, record.id());
        return OBJECT_MAPPER.convertValue(data, {{entityName}}.class);
    }

    private Map<String, Object> mapFromEntity({{entityName}} entity) {
        return new LinkedHashMap<>(OBJECT_MAPPER.convertValue(entity, MAP_TYPE));
    }

    private static boolean uniqueValuesEqual(Object left, Object right) {
        if (left == null || right == null) {
            return false;
        }
        if (left instanceof String || right instanceof String) {
            return String.valueOf(left).trim().equalsIgnoreCase(String.valueOf(right).trim());
        }
        return left.equals(right) || String.valueOf(left).equals(String.valueOf(right));
    }

    private void publishMutationEvent(String action, UUID id, {{entityName}} snapshot) {
        String topic = "{{entityName}}." + action;
        if (!ALLOWED_MUTATION_TOPICS.contains(topic)) {
            throw new IllegalStateException("Undeclared mutation event topic: " + topic);
        }
        runtimeSupport.publishMutationEvent("{{entityName}}", action, id, snapshot, ALLOWED_MUTATION_TOPICS);
    }
