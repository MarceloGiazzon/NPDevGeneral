    private void enforceWithConceptGateway(String conceptName, UUID id, Map<String, Object> payload) {
        if (conceptGateway == null) {
            throw new IllegalStateException("ConceptGateway is required for generated CRUD mutations.");
        }
        try {
            conceptGateway.save(
                    new ConceptWriteRequest(conceptName, String.valueOf(id), null, payload),
                    generatedCrudExecutionContext()
            );
        } catch (ConceptGatewaySemanticException exception) {
            throw new GeneratedCrudRuntimeSupport.InvariantViolationException(List.of(
                    new GeneratedCrudRuntimeSupport.InvariantViolationDetail(
                            exception.code(),
                            conceptName,
                            "conceptGateway",
                            null,
                            exception.getMessage(),
                            false
                    )
            ));
        } catch (RuntimeException exception) {
            throw GeneratedCrudRuntimeSupport.mapDataIntegrityViolation(conceptName, null, exception)
                    .orElseThrow(() -> exception);
        }
    }

    private void enforceDeleteWithConceptGateway(String conceptName, UUID id) {
        if (conceptGateway == null) {
            throw new IllegalStateException("ConceptGateway is required for generated CRUD mutations.");
        }
        try {
            conceptGateway.delete(
                    new ConceptReadRequest(conceptName, String.valueOf(id), null),
                    generatedCrudExecutionContext()
            );
        } catch (ConceptGatewaySemanticException exception) {
            throw new GeneratedCrudRuntimeSupport.InvariantViolationException(List.of(
