    private Optional<{{entityName}}> updateFromSource(UUID id, Object source) {
        ExecutionContext crudCtx = generatedCrudExecutionContext();
{{#kernelControlled}}
        runtimeSupport.checkCrudPermission("{{conceptName}}", "UPDATE", crudCtx);
{{/kernelControlled}}
        Optional<{{entityName}}> opt = persistence.findById(id);
        if (opt.isEmpty()) return Optional.empty();

        {{entityName}} existing = opt.get();
        runtimeSupport.checkOptimisticVersion("{{conceptName}}", existing, source);
        String previousLifecycleStatus = runtimeSupport.captureLifecycleStatus("{{entityName}}", existing);
        Map<String, Object> updatePayload = runtimeSupport.buildUpdateInvariantPayload("{{entityName}}", id, existing, source);
        enforceWithKernel("{{entityName}}", updatePayload);
{{#kernelControlled}}
        enforceWithConceptGateway("{{conceptName}}", id, updatePayload);
{{/kernelControlled}}
        runtimeSupport.applyUpdateFields("{{entityName}}", source, existing);
        existing.setVersion((existing.getVersion() == null ? 0L : existing.getVersion()) + 1);

        {{entityName}} updated = saveWithIntegrityMapping(existing);
{{#kernelControlled}}
        runtimeSupport.auditCrudMutation("{{conceptName}}", "UPDATE", String.valueOf(updated.getId()), "ALLOW", crudCtx);
{{/kernelControlled}}
        runtimeSupport.publishLifecycleTransitionEvent("{{entityName}}", previousLifecycleStatus, updated, updatePayload);
{{#emitUpdatedEvent}}
        publishMutationEvent("updated", updated.getId(), updated);
{{/emitUpdatedEvent}}
        return Optional.of(updated);
    }

