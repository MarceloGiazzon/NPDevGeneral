        Map<String, Object> createPayload = runtimeSupport.buildCreateInvariantPayload("{{entityName}}", source);
        UUID generatedId = runtimeSupport.ensureGeneratedId("{{entityName}}", createPayload);
        enforceWithKernel("{{entityName}}", createPayload);
{{#kernelControlled}}
        enforceWithConceptGateway("{{conceptName}}", generatedId, createPayload);
{{/kernelControlled}}

        {{entityName}} e = new {{entityName}}();
        runtimeSupport.assignGeneratedId("{{entityName}}", e, generatedId);
        runtimeSupport.applyCreateFields("{{entityName}}", source, e);

        {{entityName}} created = saveWithIntegrityMapping(e);
{{#kernelControlled}}
        runtimeSupport.auditCrudMutation("{{conceptName}}", "CREATE", String.valueOf(created.getId()), "ALLOW", crudCtx);
{{/kernelControlled}}
