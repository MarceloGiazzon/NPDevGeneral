    /**
     * Tenant isolation: every {@code conceptStore} call is scoped to the caller's own tenant from
     * the verified auth context, falling back to {@code DEFAULT_TENANT_ID} only when no tenant
     * claim is present at all (e.g. an unauthenticated trial boot). The DB-level unique index on a
     * {@code unique:true} field stays GLOBAL (not tenant-scoped) — tenant-scoping it would break FK
     * resolution for natural-key bond anchors — so {@link #existsUniqueInConceptStore} pre-checking
     * only the caller's tenant is an intentional, narrower pre-check: a genuine cross-tenant
     * collision on a unique field still gets caught, just later, as a 409 data-integrity violation
     * from the database instead of the friendlier validation error.
     */
    private String currentTenantId() {
        String tenantId = generatedCrudExecutionContext().tenantId();
        return tenantId == null || tenantId.isBlank() ? DEFAULT_TENANT_ID : tenantId;
    }

    // LNCH-13: reads go through conceptGateway (not conceptStore directly) so a concept's
    // declared row-level access.read rule is enforced on this generated CRUD surface the same way
    // it already was on writes (see enforceWithConceptGateway/enforceDeleteWithConceptGateway) --
    // conceptStore itself has no notion of row-level scoping, only the gateway/semantic-policy layer does.
    private Optional<{{entityName}}> findByIdFromConceptStore(UUID id) {
        if (id == null) {
            return Optional.empty();
        }
        return conceptGateway.read(
                new ConceptReadRequest(CONCEPT_NAME, String.valueOf(id), currentTenantId()),
                generatedCrudExecutionContext()
        ).map(this::entityFromRecord);
    }

    private List<{{entityName}}> findAllFromConceptStore() {
        return conceptGateway.list(
                new ConceptListRequest(CONCEPT_NAME, currentTenantId()),
                generatedCrudExecutionContext()
        ).stream()
                .map(this::entityFromRecord)
                .toList();
    }

    private {{entityName}} saveToConceptStore({{entityName}} entity) {
        UUID id = entity.getId();
        if (id == null) {
            throw new IllegalArgumentException("Generated CRUD cannot save {{conceptName}} without an id.");
        }
        conceptStore.save(new ConceptRecord(CONCEPT_NAME, String.valueOf(id), currentTenantId(), mapFromEntity(entity)));
        return entity;
    }

    private void deleteFromConceptStore(UUID id) {
        if (id == null) {
            return;
        }
        try {
            conceptStore.deleteById(currentTenantId(), CONCEPT_NAME, String.valueOf(id));
        } catch (RuntimeException exception) {
            throw GeneratedCrudRuntimeSupport.mapDataIntegrityViolation("{{conceptName}}", null, exception)
                    .orElseThrow(() -> exception);
        }
    }

    private boolean existsUniqueInConceptStore(String fieldName, Object value, UUID excludeId) {
        if (fieldName == null || fieldName.isBlank() || value == null) {
            return false;
        }
        String normalizedField = fieldName.trim();
        for (ConceptRecord record : conceptStore.findAll(currentTenantId(), CONCEPT_NAME)) {
            if (excludeId != null && String.valueOf(excludeId).equalsIgnoreCase(record.id())) {
                continue;
            }
            Object existingValue = record.data().get(normalizedField);
            if (uniqueValuesEqual(existingValue, value)) {
                return true;
            }
        }
        return false;
    }

    // LIFT-UNIQUE-P3: compound-unique pre-check, same full-scan-of-the-tenant strategy as
    // existsUniqueInConceptStore above, extended to require every (field, value) pair to match
    // the same candidate row (an AND across columns, not an OR of independent field checks).
    private boolean existsUniqueCompoundInConceptStore(List<String> fieldNames, List<Object> values, UUID excludeId) {
        if (fieldNames == null || fieldNames.isEmpty() || values == null || fieldNames.size() != values.size()) {
            return false;
        }
        for (ConceptRecord record : conceptStore.findAll(currentTenantId(), CONCEPT_NAME)) {
            if (excludeId != null && String.valueOf(excludeId).equalsIgnoreCase(record.id())) {
                continue;
            }
            boolean allMatch = true;
            for (int i = 0; i < fieldNames.size(); i++) {
                Object existingValue = record.data().get(fieldNames.get(i));
                if (!uniqueValuesEqual(existingValue, values.get(i))) {
                    allMatch = false;
                    break;
                }
            }
            if (allMatch) {
                return true;
            }
        }
        return false;
    }

    private {{entityName}} entityFromRecord(ConceptRecord record) {
        Map<String, Object> data = new LinkedHashMap<>(record.data());
        data.putIfAbsent(ID_FIELD_NAME, record.id());
        return OBJECT_MAPPER.convertValue(data, {{entityName}}.class);
    }

    private Map<String, Object> mapFromEntity({{entityName}} entity) {
        return new LinkedHashMap<>(OBJECT_MAPPER.convertValue(entity, MAP_TYPE));
    }

    private static boolean uniqueValuesEqual(Object left, Object right) {
        if (left == null || right == null) {
            return false;
        }
        if (left instanceof String || right instanceof String) {
            return String.valueOf(left).trim().equalsIgnoreCase(String.valueOf(right).trim());
        }
        return left.equals(right) || String.valueOf(left).equals(String.valueOf(right));
    }

    private void publishMutationEvent(String action, UUID id, {{entityName}} snapshot) {
        String topic = "{{entityName}}." + action;
        if (!ALLOWED_MUTATION_TOPICS.contains(topic)) {
            throw new IllegalStateException("Undeclared mutation event topic: " + topic);
        }
        runtimeSupport.publishMutationEvent("{{entityName}}", action, id, snapshot, ALLOWED_MUTATION_TOPICS);
    }
