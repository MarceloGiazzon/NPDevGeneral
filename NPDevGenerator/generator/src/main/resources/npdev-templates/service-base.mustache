        Map<String, Object> updatePayload = runtimeSupport.buildUpdateInvariantPayload("{{conceptName}}", id, existing, source);
        runtimeSupport.enforceBondTargetTenant("{{conceptName}}", updatePayload, crudCtx);
        enforceWithKernel("{{conceptName}}", updatePayload);
{{#codaAllowed}}
        codaHook.ifPresent(hook -> hook.beforeUpdate("{{conceptName}}", id, updatePayload, crudCtx));
