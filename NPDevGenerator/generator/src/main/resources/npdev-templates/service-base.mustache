                "{{conceptName}}", previous{{capName}}, updated.get{{capName}}());
{{/fileFields}}
{{/hasFileFields}}
{{#codaAllowed}}
        codaHook.ifPresent(hook -> hook.afterUpdate("{{conceptName}}", updated, crudCtx));
{{/codaAllowed}}
{{#kernelControlled}}
        runtimeSupport.auditCrudMutation("{{conceptName}}", "UPDATE", String.valueOf(updated.getId()), "ALLOW", crudCtx);
{{/kernelControlled}}
        runtimeSupport.publishLifecycleTransitionEvent("{{conceptName}}", previousLifecycleStatus, updated, updatePayload);
{{#emitUpdatedEvent}}
        publishMutationEvent("updated", updated.getId(), updated);
{{/emitUpdatedEvent}}
{{#hasExtraUpdateEvents}}
{{#extraUpdateEvents}}
