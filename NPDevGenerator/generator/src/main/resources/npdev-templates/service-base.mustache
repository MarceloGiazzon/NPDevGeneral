    @Transactional
    public {{entityName}} create({{entityName}}CreateRequest dto) {
        if (dto == null) {
            throw new IllegalArgumentException("Request body is required");
        }
        Map<String, Object> createPayload = runtimeSupport.buildCreateInvariantPayload("{{entityName}}", dto);
        UUID generatedId = runtimeSupport.ensureGeneratedId(createPayload);
        enforceWithKernel("{{entityName}}", createPayload);
        enforceWithConceptGateway("{{conceptName}}", generatedId, createPayload);

        {{entityName}} e = new {{entityName}}();
        runtimeSupport.assignGeneratedId(e, generatedId);
        runtimeSupport.applyCreateFields("{{entityName}}", dto, e);

        {{entityName}} created = persistence.save(e);
{{#emitCreatedEvent}}
        publishMutationEvent("created", created.getId(), created);
{{/emitCreatedEvent}}
        return created;
    }

    @Transactional
    public Optional<{{entityName}}> update(UUID id, {{entityName}}UpdateRequest dto) {
        if (dto == null) {
            throw new IllegalArgumentException("Request body is required");
        }

        Optional<{{entityName}}> opt = persistence.findById(id);
        if (opt.isEmpty()) return Optional.empty();

        {{entityName}} existing = opt.get();
        String previousLifecycleStatus = runtimeSupport.captureLifecycleStatus("{{entityName}}", existing);
        Map<String, Object> updatePayload = runtimeSupport.buildUpdateInvariantPayload("{{entityName}}", id, existing, dto);
        enforceWithKernel("{{entityName}}", updatePayload);
        enforceWithConceptGateway("{{conceptName}}", id, updatePayload);
        runtimeSupport.applyUpdateFields("{{entityName}}", dto, existing);

        {{entityName}} updated = persistence.save(existing);
        runtimeSupport.publishLifecycleTransitionEvent("{{entityName}}", previousLifecycleStatus, updated, updatePayload);
{{#emitUpdatedEvent}}
        publishMutationEvent("updated", updated.getId(), updated);
{{/emitUpdatedEvent}}
        return Optional.of(updated);
    }

    @Transactional
    public boolean delete(UUID id) {
        if (!persistence.existsById(id)) return false;
        enforceDeleteWithConceptGateway("{{conceptName}}", id);
        persistence.deleteById(id);
{{#emitDeletedEvent}}
        publishMutationEvent("deleted", id, null);
{{/emitDeletedEvent}}
        return true;
