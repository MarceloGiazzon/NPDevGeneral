    private {{entityName}} createFromSource(Object source) {
        ExecutionContext crudCtx = generatedCrudExecutionContext();
{{#kernelControlled}}
        runtimeSupport.checkCrudPermission("{{conceptName}}", "CREATE", crudCtx);
{{/kernelControlled}}
        String idempotencyKey = runtimeSupport.extractCrudIdempotencyKey();
        if (idempotencyKey != null) {
            String existingId = runtimeSupport.checkCrudIdempotency(crudCtx.tenantId(), "{{conceptName}}", idempotencyKey).orElse(null);
            if (existingId != null && !existingId.isBlank()) {
                try {
                    java.util.Optional<{{entityName}}> cached = getById(UUID.fromString(existingId));
                    if (cached.isPresent()) return cached.get();
                } catch (IllegalArgumentException ignored) {
                    // malformed stored id — fall through to create
                }
            }
        }
        Map<String, Object> createPayload = runtimeSupport.buildCreateInvariantPayload("{{conceptName}}", source);
        runtimeSupport.enforceBondTargetTenant("{{conceptName}}", createPayload, crudCtx);
        UUID generatedId = runtimeSupport.ensureGeneratedId("{{conceptName}}", createPayload);
        enforceWithKernel("{{conceptName}}", createPayload);
{{#codaAllowed}}
        codaHook.ifPresent(hook -> hook.beforeCreate("{{conceptName}}", createPayload, crudCtx));
{{/codaAllowed}}
        // LNCH-13/REG-16-resid R2: enforceWithConceptGateway now runs BEFORE any create flow, not
        // only when no create flow is declared, so a declared access.write row-level rule -- and the
        // coarse invariant/lifecycle rule profiles -- are checked, and can DENY, before a flow's own
        // side effects (notifications, external calls) ever run. Without this, a concept combining a
        // custom create flow with access.write got ZERO row-level write enforcement on this endpoint:
        // enforceWithCreateFlow only calls kernelRunner.execute(...), never conceptGateway.save(...),
        // and the later saveWithIntegrityMapping(e) persists straight through conceptStore, bypassing
        // ConceptGatewaySemanticPolicy.isRowWritable entirely.
{{#kernelControlled}}
        enforceWithConceptGateway("{{conceptName}}", generatedId, createPayload);
{{/kernelControlled}}
{{#hasCreateFlow}}
        enforceWithCreateFlow(crudCtx, generatedId, createPayload);
{{/hasCreateFlow}}

        {{entityName}} e = new {{entityName}}();
        runtimeSupport.assignGeneratedId("{{conceptName}}", e, generatedId);
        runtimeSupport.applyCreateFields("{{conceptName}}", source, e);
        // Tenant isolation: the row is owned by whoever creates it, from the verified auth
        // context — never from caller-supplied data, since CreateRequest DTOs never carry a
        // tenantId field (DtoEmitter only emits DSL-declared fields).
        e.setTenantId(currentTenantId());

        {{entityName}} created = saveWithIntegrityMapping(e);
{{#codaAllowed}}
        codaHook.ifPresent(hook -> hook.afterCreate("{{conceptName}}", created, crudCtx));
{{/codaAllowed}}
{{#kernelControlled}}
        runtimeSupport.auditCrudMutation("{{conceptName}}", "CREATE", String.valueOf(created.getId()), "ALLOW", crudCtx);
{{/kernelControlled}}
        runtimeSupport.recordCrudIdempotencySuccess(crudCtx.tenantId(), "{{conceptName}}", String.valueOf(created.getId()), idempotencyKey);
{{#emitCreatedEvent}}
        publishMutationEvent("created", created.getId(), created);
{{/emitCreatedEvent}}
{{#hasExtraCreateEvents}}
{{#extraCreateEvents}}
        runtimeSupport.publishDeclaredEvent("{{javaString}}", "{{conceptName}}", created.getId(), created);
{{/extraCreateEvents}}
{{/hasExtraCreateEvents}}
        return created;
