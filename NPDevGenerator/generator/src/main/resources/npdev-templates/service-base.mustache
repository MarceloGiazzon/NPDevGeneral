    private void enforceWithKernel(String entityName, Map<String, Object> payload) {
        List<GeneratedCrudRuntimeSupport.InvariantViolationDetail> violations = runtimeSupport.validateEntityDetailed(
                entityName,
                payload,
                (requestedEntityName, fieldName, value, excludeId, invariantPayload) ->
                        persistence.existsUnique(fieldName, value, excludeId)
        );
        if (!violations.isEmpty()) {
            throw new GeneratedCrudRuntimeSupport.InvariantViolationException(violations);
        }
    }

    private void enforceWithConceptGateway(String conceptName, UUID id, Map<String, Object> payload) {
        if (conceptGateway == null) {
            throw new IllegalStateException("ConceptGateway is required for generated CRUD mutations.");
        }
        try {
            conceptGateway.save(
                    new ConceptWriteRequest(conceptName, String.valueOf(id), null, payload),
                    generatedCrudExecutionContext()
            );
        } catch (ConceptGatewaySemanticException exception) {
            throw new GeneratedCrudRuntimeSupport.InvariantViolationException(List.of(
                    new GeneratedCrudRuntimeSupport.InvariantViolationDetail(
                            exception.code(),
                            conceptName,
                            "conceptGateway",
                            null,
                            exception.getMessage(),
                            false
                    )
            ));
        }
    }

    private void enforceDeleteWithConceptGateway(String conceptName, UUID id) {
        if (conceptGateway == null) {
            throw new IllegalStateException("ConceptGateway is required for generated CRUD mutations.");
        }
        try {
            conceptGateway.delete(
                    new ConceptReadRequest(conceptName, String.valueOf(id), null),
                    generatedCrudExecutionContext()
            );
        } catch (ConceptGatewaySemanticException exception) {
            throw new GeneratedCrudRuntimeSupport.InvariantViolationException(List.of(
                    new GeneratedCrudRuntimeSupport.InvariantViolationDetail(
                            exception.code(),
                            conceptName,
                            "conceptGateway",
                            null,
                            exception.getMessage(),
                            false
                    )
            ));
        }
    }

    private ExecutionContext generatedCrudExecutionContext() {
        return ExecutionContext.anonymous().withTag("executionMode", "headless");
    }

    private void publishMutationEvent(String action, UUID id, {{entityName}} snapshot) {
        String topic = "{{entityName}}." + action;
        if (!ALLOWED_MUTATION_TOPICS.contains(topic)) {
            throw new IllegalStateException("Undeclared mutation event topic: " + topic);
        }
        runtimeSupport.publishMutationEvent("{{entityName}}", action, id, snapshot, ALLOWED_MUTATION_TOPICS);
    }
