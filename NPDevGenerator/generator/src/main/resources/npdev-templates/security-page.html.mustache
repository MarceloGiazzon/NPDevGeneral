<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Account security — {{appName}}</title>
<style>
  /* THM-8: every colour reads the shared --np-* theme variables when a theme is applied (npdev-display.js), and falls
     back to the page's own value otherwise, so an app with the default theme looks exactly as before. */
  :root {
    --bg: var(--np-bg, #f4f5f7); --card: var(--np-surface, #ffffff); --ink: var(--np-text, #1f2430); --muted: var(--np-text-muted, #6b7280);
    --accent: var(--np-accent, #2563eb); --accent-ink: var(--np-on-accent, #ffffff); --line: var(--np-border, #e2e5ea);
    --error: var(--np-negative, #b91c1c); --error-bg: #fef2f2; --ok: var(--np-positive, #15803d); --ok-bg: #f0fdf4;
  }
  html[data-np-theme-name] {
    --error-bg: color-mix(in srgb, var(--np-negative) 12%, var(--np-surface));
    --ok-bg: color-mix(in srgb, var(--np-positive) 12%, var(--np-surface));
  }
  html[data-np-theme-name] .tab { background: var(--bg); }
  html[data-np-theme-name] .oauth-button { background: var(--card); color: var(--ink); }
  html[data-np-theme-name] .oauth-button:hover { background: var(--bg); }
  html[data-np-theme-name] input { background: var(--card); color: var(--ink); }
  html[data-np-theme-name] input:focus { border-color: var(--accent); }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
         background: var(--bg); color: var(--ink);
         font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .card { width: 26rem; max-width: calc(100vw - 2rem); background: var(--card);
          border: 1px solid var(--line); border-radius: 10px; padding: 1.5rem 1.5rem 1.75rem;
          box-shadow: 0 6px 24px rgba(16, 24, 40, .07); }
  h1 { font-size: 1.15rem; margin: 0 0 .35rem; font-weight: 600; }
  h2 { font-size: 1rem; margin: 0 0 .6rem; font-weight: 600; }
  label { display: block; margin-bottom: .85rem; font-size: .85rem; color: var(--muted); }
  input[type="password"], input[type="text"] { width: 100%; margin-top: .3rem; padding: .55rem .6rem;
          border: 1px solid var(--line); border-radius: 7px; font-size: .95rem; }
  input:focus { outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); border-color: var(--accent); }
  button { padding: .55rem .9rem; border: 1px solid var(--line); border-radius: 7px; background: var(--card);
           color: var(--ink); font-size: .9rem; cursor: pointer; }
  button.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  button.danger { color: var(--error); border-color: var(--error); }
  button:disabled { opacity: .55; cursor: not-allowed; }
  .row { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: .4rem; }
  .devices { list-style: none; padding: 0; margin: .4rem 0; }
  .devices li { display: flex; gap: .75rem; align-items: center; justify-content: space-between; flex-wrap: wrap;
    padding: .5rem 0; border-top: 1px solid rgba(128,128,128,.25); }
  .devices .what { font-weight: 600; }
  .devices .meta { font-size: .85rem; opacity: .8; }
  .note { font-size: .85rem; color: var(--muted); margin: 0 0 1rem; line-height: 1.45; }
  .status { font-weight: 600; }
  .secret { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 1.05rem;
            letter-spacing: .06em; padding: .6rem .7rem; background: var(--bg); border-radius: 7px;
            word-break: break-all; margin: .4rem 0 .6rem; }
  pre.codes { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .95rem;
              padding: .7rem; background: var(--bg); border-radius: 7px; margin: .4rem 0 .6rem; }
  .banner { margin-top: 1rem; padding: .6rem .7rem; border-radius: 7px; font-size: .85rem; line-height: 1.4; }
  .banner.error { background: var(--error-bg); color: var(--error); }
  .banner.ok { background: var(--ok-bg); color: var(--ok); }
  a { color: var(--accent); }
  .hidden { display: none; }
</style>
<script src="/npdev-i18n.js"></script>
<script>NPDevI18n.use({{{i18nJson}}});</script>
<script src="/npdev-display.js"></script>
<script>if (window.NPDevDisplay) { NPDevDisplay.boot(); }</script>
</head>
<body data-app-name="{{appName}}">
<main class="card">
  <h1 data-i18n="pages.security.heading">Account security</h1>
  <p class="note" data-i18n="pages.security.note">Two-step sign-in with an authenticator app protects your account even if your password leaks.</p>

  <p id="loading" class="note" data-i18n="pages.security.loading">Loading…</p>
  <p id="unavailable" class="note hidden" data-i18n="pages.security.unavailable">Two-step sign-in is not available in this app.</p>
  <p id="signedOut" class="note hidden"><span data-i18n="pages.security.sessionExpired">Your session expired.</span> <a href="/login.html" data-i18n="pages.security.signInAgain">Sign in again</a>.</p>

  <section id="offView" class="hidden">
    <p data-i18n="pages.security.statusOff">Two-step sign-in is off.</p>
    <div class="row"><button class="primary" id="turnOnBtn" type="button" data-i18n="pages.security.turnOn">Turn on</button></div>
  </section>

  <section id="passwordStep" class="hidden">
    <h2 data-i18n="pages.security.confirmItsYou">Confirm it is you</h2>
    <form id="startForm" autocomplete="off">
      <label><span data-i18n="pages.security.currentPassword">Current password</span>
        <input id="startPassword" type="password" autocomplete="current-password" required>
      </label>
      <div class="row">
        <button class="primary" id="startBtn" type="submit" data-i18n="pages.security.continue">Continue</button>
        <button id="startCancelBtn" type="button" data-i18n="pages.security.cancel">Cancel</button>
      </div>
    </form>
  </section>

  <section id="enrollStep" class="hidden">
    <h2 data-i18n="pages.security.addToApp">Add it to your authenticator app</h2>
    <p class="note" data-i18n="pages.security.enrollNote">In Google Authenticator, Microsoft Authenticator, 1Password or any similar app, add an account with this key (time-based, 6 digits). On a phone you can also tap the link.</p>
    <div class="secret" id="secretText"></div>
    <p class="note"><a id="otpauthLink" href="#" data-i18n="pages.security.openInApp">Open in authenticator app</a></p>
    <form id="confirmForm" autocomplete="off">
      <label><span data-i18n="pages.security.codeFromApp">6-digit code from the app</span>
        <input id="confirmCode" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required>
      </label>
      <div class="row">
        <button class="primary" id="confirmBtn" type="submit" data-i18n="pages.security.turnOn">Turn on</button>
        <button id="confirmCancelBtn" type="button" data-i18n="pages.security.cancel">Cancel</button>
      </div>
    </form>
  </section>

  <section id="codesStep" class="hidden">
    <h2 data-i18n="pages.security.saveCodes">Save your recovery codes</h2>
    <p class="note" data-i18n="pages.security.codesNote">Each code works once if you lose your phone. They are shown only now.</p>
    <pre class="codes" id="codesText"></pre>
    <div class="row">
      <button id="copyBtn" type="button" data-i18n="pages.security.copy">Copy</button>
      <button id="downloadBtn" type="button" data-i18n="pages.security.downloadTxt">Download .txt</button>
    </div>
    <label style="margin-top:.8rem"><input id="savedBox" type="checkbox"> <span data-i18n="pages.security.savedThem">I saved them</span></label>
    <div class="row"><button class="primary" id="doneBtn" type="button" disabled data-i18n="pages.security.done">Done</button></div>
  </section>

  <section id="onView" class="hidden">
    <p><span data-i18n="pages.security.statusOn">Two-step sign-in is on.</span> <span id="codesLeft"></span></p>
    <div class="row">
      <button id="newCodesBtn" type="button" data-i18n="pages.security.newCodes">New recovery codes</button>
      <button class="danger" id="turnOffBtn" type="button" data-i18n="pages.security.turnOff">Turn off</button>
    </div>
  </section>

  <section id="newCodesStep" class="hidden">
    <h2 data-i18n="pages.security.newCodes">New recovery codes</h2>
    <p class="note" data-i18n="pages.security.oldCodesStop">The old codes stop working.</p>
    <form id="newCodesForm" autocomplete="off">
      <label><span data-i18n="pages.security.codeFromApp">6-digit code from the app</span>
        <input id="newCodesCode" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required>
      </label>
      <div class="row">
        <button class="primary" type="submit" data-i18n="pages.security.generate">Generate</button>
        <button id="newCodesCancelBtn" type="button" data-i18n="pages.security.cancel">Cancel</button>
      </div>
    </form>
  </section>

  <section id="offStep" class="hidden">
    <h2 data-i18n="pages.security.turnOffHeading">Turn off two-step sign-in</h2>
    <form id="offForm" autocomplete="off">
      <label><span data-i18n="pages.security.currentPassword">Current password</span>
        <input id="offPassword" type="password" autocomplete="current-password" required>
      </label>
      <label><span data-i18n="pages.security.codeOrRecovery">6-digit code from the app, or a recovery code</span>
        <input id="offCode" type="text" autocomplete="one-time-code" required>
      </label>
      <div class="row">
        <button class="danger" type="submit" data-i18n="pages.security.turnOff">Turn off</button>
        <button id="offCancelBtn" type="button" data-i18n="pages.security.cancel">Cancel</button>
      </div>
    </form>
  </section>

  <section id="sessionsCard" class="hidden">
    <h2 data-i18n="pages.security.sessions">Sessions</h2>
    <p class="note" data-i18n="pages.security.sessionsNote">Lost a phone or used a shared computer? Sign out everywhere else. You stay signed in here.</p>
    <h3 data-i18n="pages.security.whereSignedIn">Where you're signed in</h3>
    <p class="note" id="deviceListNote" data-i18n="pages.security.deviceListNote">Each browser or device you signed in on. End one to sign out just that device.</p>
    <ul id="deviceList" class="devices"></ul>
    <div class="row"><button class="danger" id="revokeOthersBtn" type="button" data-i18n="pages.security.signOutOthers">Sign out of all other devices</button></div>
  </section>

  <p id="errorBanner" class="banner error hidden"></p>
  <p id="okBanner" class="banner ok hidden"></p>
</main>

<script>
(function () {
  "use strict";
  // REG-349: the page's static text is translated once the DOM is ready; dynamic messages call NPDevI18n.t directly.
  document.addEventListener("DOMContentLoaded", function () { NPDevI18n.apply(document); });
  document.title = NPDevI18n.t("pages.security.title", "Account security — {appName}", { appName: document.body.getAttribute("data-app-name") });
  var TOKEN_KEYS = ["npdev.shell.token", "npdev.businessUi.apiKey"];
  var SECTIONS = ["loading", "unavailable", "signedOut", "offView", "passwordStep", "enrollStep",
                  "codesStep", "onView", "newCodesStep", "offStep"];
  var MESSAGES = {
    unauthenticated: NPDevI18n.t("pages.security.errUnauthenticated", "Your session expired. Sign in again."),
    invalid_password: NPDevI18n.t("pages.security.errInvalidPassword", "That password is not correct."),
    invalid_code: NPDevI18n.t("pages.security.errInvalidCode", "That code is not valid. Check the app and try again."),
    mfa_already_enabled: NPDevI18n.t("pages.security.errMfaAlreadyEnabled", "Two-step sign-in is already on."),
    mfa_enroll_not_started: NPDevI18n.t("pages.security.errMfaEnrollNotStarted", "Start again: the setup was not started."),
    mfa_not_enabled: NPDevI18n.t("pages.security.errMfaNotEnabled", "Two-step sign-in is not on."),
    too_many_attempts: NPDevI18n.t("pages.security.errTooManyAttempts", "Too many attempts. Wait a few minutes and try again."),
    mfa_not_available: NPDevI18n.t("pages.security.unavailable", "Two-step sign-in is not available in this app."),
    token_issuance_unavailable: NPDevI18n.t("pages.security.errTokenIssuanceUnavailable", "This app cannot sign other devices out."),
    revoke_sessions_failed: NPDevI18n.t("pages.security.errRevokeSessionsFailed", "Could not sign out the other devices. Try again.")
  };

  function $(id) { return document.getElementById(id); }
  function currentToken() {
    for (var i = 0; i < TOKEN_KEYS.length; i++) {
      var v = localStorage.getItem(TOKEN_KEYS[i]);
      if (v) { return v; }
    }
    return null;
  }
  // The ONLY write to web storage on this page: the replacement session token (same two keys
  // change-password-page stores). Recovery codes and TOTP secrets never touch storage.
  function storeToken(token) {
    TOKEN_KEYS.forEach(function (key) { localStorage.setItem(key, token); });
  }
  function show(name) {
    SECTIONS.forEach(function (s) { $(s).classList.toggle("hidden", s !== name); });
  }
  function clearBanners() { $("errorBanner").classList.add("hidden"); $("okBanner").classList.add("hidden"); }
  function showError(code) {
    $("errorBanner").textContent = MESSAGES[code] || NPDevI18n.t("pages.security.errSomethingWrong", "Something went wrong ({code}).", { code: code });
    $("errorBanner").classList.remove("hidden");
    $("okBanner").classList.add("hidden");
  }
  function showOk(text) {
    $("okBanner").textContent = text;
    $("okBanner").classList.remove("hidden");
    $("errorBanner").classList.add("hidden");
  }

  // Recovery codes live only in the DOM of this page (never in web storage) until the user leaves.
  function api(method, path, body) {
    var token = currentToken();
    var headers = { "X-NPDev-Request": "1", "Authorization": "Bearer " + token };
    var init = { method: method, headers: headers };
    if (body !== undefined) {
      headers["Content-Type"] = "application/json";
      init.body = JSON.stringify(body);
    }
    return fetch(path, init).then(function (r) {
      return r.text().then(function (text) {
        var parsed = {};
        try { parsed = text ? JSON.parse(text) : {}; } catch (e) { parsed = {}; }
        return { status: r.status, body: parsed };
      });
    });
  }
  function errorCode(res) { return res.body && res.body.error ? res.body.error : "request_failed"; }

  // SESS-2: "Where you're signed in" -- every live session of this user, this device marked, one Revoke each.
  function deviceName(agent) {
    if (!agent) { return NPDevI18n.t("pages.security.unknownDevice", "Unknown device"); }
    var browser = /Edg\//.test(agent) ? "Edge" : /Firefox\//.test(agent) ? "Firefox"
      : /Chrome\//.test(agent) ? "Chrome" : /Safari\//.test(agent) ? "Safari" : NPDevI18n.t("pages.security.browserGeneric", "Browser");
    var os = /Windows/.test(agent) ? "Windows" : /Android/.test(agent) ? "Android"
      : /iPhone|iPad/.test(agent) ? "iOS" : /Mac OS X/.test(agent) ? "macOS" : /Linux/.test(agent) ? "Linux" : "";
    return os ? NPDevI18n.t("pages.security.browserOnOs", "{browser} on {os}", { browser: browser, os: os }) : browser;
  }
  function renderDevices(sessions) {
    var list = $("deviceList");
    while (list.firstChild) { list.removeChild(list.firstChild); }
    $("deviceListNote").classList.toggle("hidden", !sessions.length);
    sessions.forEach(function (s) {
      var li = document.createElement("li");
      var info = document.createElement("div");
      var what = document.createElement("div");
      what.className = "what";
      what.textContent = s.current
        ? NPDevI18n.t("pages.security.deviceThisDevice", "{name} (this device)", { name: deviceName(s.userAgent) })
        : deviceName(s.userAgent);
      var meta = document.createElement("div");
      meta.className = "meta";
      meta.textContent = NPDevI18n.t("pages.security.deviceMeta", "{address} \u00b7 last active {when}", {
        address: s.ipAddress || NPDevI18n.t("pages.security.unknownAddress", "unknown address"),
        when: s.lastSeenAt || s.createdAt || NPDevI18n.t("pages.security.unknownTime", "unknown")
      });
      info.appendChild(what);
      info.appendChild(meta);
      li.appendChild(info);
      if (!s.current) {
        var button = document.createElement("button");
        button.type = "button";
        button.className = "danger";
        button.textContent = NPDevI18n.t("pages.security.revoke", "Revoke");
        button.addEventListener("click", function () {
          clearBanners();
          button.disabled = true;
          api("DELETE", "/api/auth/sessions/" + encodeURIComponent(s.id)).then(function (res) {
            if (res.status === 401) { show("signedOut"); return; }
            if (res.status !== 200 && res.status !== 404) { button.disabled = false; showError(errorCode(res)); return; }
            showOk(NPDevI18n.t("pages.security.deviceSignedOut", "That device was signed out."));
            loadDevices();
          }).catch(function () { button.disabled = false; showError("request_failed"); });
        });
        li.appendChild(button);
      }
      list.appendChild(li);
    });
  }
  function loadDevices() {
    api("GET", "/api/auth/sessions").then(function (res) {
      renderDevices(res.status === 200 && res.body.sessions ? res.body.sessions : []);
    }).catch(function () { renderDevices([]); });
  }

  function loadStatus() {
    clearBanners();
    $("sessionsCard").classList.toggle("hidden", !currentToken());
    if (currentToken()) { loadDevices(); }
    if (!currentToken()) { show("signedOut"); return; }
    show("loading");
    api("GET", "/api/auth/mfa/status").then(function (res) {
      if (res.status === 401) { show("signedOut"); return; }
      if (res.status === 503) { show("unavailable"); return; }
      if (res.status !== 200) { show("offView"); showError(errorCode(res)); return; }
      if (res.body.enabled) {
        $("codesLeft").textContent = NPDevI18n.t("pages.security.codesLeft", "{count} recovery codes left.", { count: res.body.recoveryCodesLeft });
        show("onView");
      } else {
        show("offView");
      }
    }).catch(function () { show("offView"); showError("request_failed"); });
  }

  function groupSecret(secret) {
    return (secret.match(/.{1,4}/g) || [secret]).join(" ");
  }

  $("turnOnBtn").addEventListener("click", function () {
    clearBanners(); $("startForm").reset(); show("passwordStep");
  });
  $("startCancelBtn").addEventListener("click", function () { clearBanners(); loadStatus(); });
  $("startForm").addEventListener("submit", function (ev) {
    ev.preventDefault(); clearBanners();
    $("startBtn").disabled = true;
    api("POST", "/api/auth/mfa/enroll/start", { password: $("startPassword").value }).then(function (res) {
      $("startBtn").disabled = false;
      if (res.status !== 200) { showError(errorCode(res)); return; }
      $("startForm").reset();
      $("secretText").textContent = groupSecret(res.body.secret);
      var uri = String(res.body.otpauthUri || "");
      if (uri.indexOf("otpauth://") === 0) { $("otpauthLink").setAttribute("href", uri); }
      $("confirmForm").reset();
      show("enrollStep");
    }).catch(function () { $("startBtn").disabled = false; showError("request_failed"); });
  });
  $("confirmCancelBtn").addEventListener("click", function () {
    clearBanners(); $("secretText").textContent = ""; loadStatus();
  });
  $("confirmForm").addEventListener("submit", function (ev) {
    ev.preventDefault(); clearBanners();
    $("confirmBtn").disabled = true;
    api("POST", "/api/auth/mfa/enroll/confirm", { code: $("confirmCode").value }).then(function (res) {
      $("confirmBtn").disabled = false;
      if (res.status !== 200) { showError(errorCode(res)); return; }
      $("secretText").textContent = "";
      $("confirmForm").reset();
      showCodes(res.body.recoveryCodes || []);
    }).catch(function () { $("confirmBtn").disabled = false; showError("request_failed"); });
  });

  function showCodes(codes) {
    $("codesText").textContent = codes.join("\n");
    $("savedBox").checked = false;
    $("doneBtn").disabled = true;
    show("codesStep");
  }
  $("savedBox").addEventListener("change", function () { $("doneBtn").disabled = !$("savedBox").checked; });
  $("copyBtn").addEventListener("click", function () {
    var text = $("codesText").textContent;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () { showOk(NPDevI18n.t("pages.security.copied", "Copied.")); },
        function () { showError("request_failed"); });
    }
  });
  $("downloadBtn").addEventListener("click", function () {
    var blob = new Blob([$("codesText").textContent + "\n"], { type: "text/plain" });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url;
    a.download = "recovery-codes.txt";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
  });
  $("doneBtn").addEventListener("click", function () {
    $("codesText").textContent = "";
    loadStatus();
  });

  $("newCodesBtn").addEventListener("click", function () {
    clearBanners(); $("newCodesForm").reset(); show("newCodesStep");
  });
  $("newCodesCancelBtn").addEventListener("click", function () { clearBanners(); loadStatus(); });
  $("newCodesForm").addEventListener("submit", function (ev) {
    ev.preventDefault(); clearBanners();
    api("POST", "/api/auth/mfa/recovery-codes", { code: $("newCodesCode").value }).then(function (res) {
      if (res.status !== 200) { showError(errorCode(res)); return; }
      $("newCodesForm").reset();
      showCodes(res.body.recoveryCodes || []);
    }).catch(function () { showError("request_failed"); });
  });

  $("turnOffBtn").addEventListener("click", function () {
    clearBanners(); $("offForm").reset(); show("offStep");
  });
  $("offCancelBtn").addEventListener("click", function () { clearBanners(); loadStatus(); });
  $("offForm").addEventListener("submit", function (ev) {
    ev.preventDefault(); clearBanners();
    api("POST", "/api/auth/mfa/disable", { password: $("offPassword").value, code: $("offCode").value })
      .then(function (res) {
        if (res.status !== 200) { showError(errorCode(res)); return; }
        $("offForm").reset();
        loadStatus();
        showOk(NPDevI18n.t("pages.security.statusOff", "Two-step sign-in is off."));
      }).catch(function () { showError("request_failed"); });
  });

  // SEC-15: bumps this user's token_version server-side; the answer carries a fresh token (and the
  // refreshed session cookie), so this browser stays signed in while every other session ends.
  $("revokeOthersBtn").addEventListener("click", function () {
    clearBanners();
    $("revokeOthersBtn").disabled = true;
    api("POST", "/api/auth/sessions/revoke-others").then(function (res) {
      $("revokeOthersBtn").disabled = false;
      if (res.status === 401) { show("signedOut"); return; }
      if (res.status !== 200 || !res.body.token) { showError(errorCode(res)); return; }
      storeToken(res.body.token);
      showOk(NPDevI18n.t("pages.security.othersSignedOut", "Other sessions were signed out."));
      loadDevices();
    }).catch(function () { $("revokeOthersBtn").disabled = false; showError("request_failed"); });
  });

  loadStatus();
})();
</script>
</body>
</html>
