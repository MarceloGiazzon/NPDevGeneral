/* NPDev platform text catalogue lookup (REG-349). Emitted to static/npdev-i18n.js and loaded by every
 * page the platform draws (business UI, shell, workbench, sign-in pages) BEFORE their own script.
 *
 * Every platform-owned text is `NPDevI18n.t(id, englishText, vars)`: the id is looked up in
 * the language the visitor chose (localStorage "npdev.ui.locale", "pt-BR" -> "pt"), then in the app's own
 * catalogue (its generation-time backOffice.locale, plus backOffice.strings overrides), then the English text in
 * the call itself, so a page still reads right when the catalogue is missing. `{name}` placeholders are replaced
 * from the third argument. The English text in the call must equal the English catalogue entry
 * (scripts/quality/check-ui-i18n.py compares them), which is why a call site never needs a second source.
 *
 * The catalogue arrives as `{ strings, stringsByLocale }`: the generated manifest already has this shape, so a page
 * with a manifest calls `NPDevI18n.use(manifest)`; a page without one inlines the same two keys.
 * This file is static (no Mustache tags).
 */
(function () {
  "use strict";
  if (window.NPDevI18n) { return; }
  var KEY = "npdev.ui.locale";
  var catalogue = null;

  function stored() {
    try { return localStorage.getItem(KEY) || ""; } catch (ignored) { return ""; }
  }

  function language() {
    return stored().split("-")[0].toLowerCase();
  }

  function fill(text, vars) {
    if (!vars) { return text; }
    return String(text).replace(/\{([A-Za-z0-9_]+)\}/g, function (whole, name) {
      return Object.prototype.hasOwnProperty.call(vars, name) && vars[name] != null ? String(vars[name]) : whole;
    });
  }

  function lookup(key) {
    if (!catalogue) { return null; }
    var lang = language();
    var byLocale = lang && catalogue.stringsByLocale ? catalogue.stringsByLocale[lang] : null;
    if (byLocale && byLocale[key]) { return byLocale[key]; }
    var strings = catalogue.strings;
    return strings && strings[key] ? strings[key] : null;
  }

  /*
   * REG-353 (3): the server answers in English. The common field-validation sentences the runtime builds (required,
   * unique, length, range, date, enum, type) are matched here and shown through the catalogue ids common.server.*;
   * the English template of each id lives in npdev-i18n/common.en.json (check-ui-i18n compares en and pt), and the
   * server's own text is the fallback, so a sentence this table does not know is shown exactly as the server sent it
   * (a model author's invariant message is never touched). Each entry: [pattern, names of the captured groups, a call that names its catalogue id, which is what check-ui-i18n reads].
   */
  var E = "Entity (.+?): ";
  var SERVER_RULES = [
    [new RegExp("^" + E + "required field '(.+?)' is missing(?: \\(ref=.*\\))?$"), ["entity", "field"], function (v) { return NPDevI18n.t("common.server.required", "Entity {entity}: required field '{field}' is missing", v); }],
    [new RegExp("^" + E + "unique constraint violated for field '(.+?)'(?: \\(ref=.*\\))?$"), ["entity", "field"], function (v) { return NPDevI18n.t("common.server.unique", "Entity {entity}: unique constraint violated for field '{field}'", v); }],
    [new RegExp("^" + E + "unique constraint violated for fields \\((.+?)\\)(?: \\(ref=.*\\))?$"), ["entity", "fields"], function (v) { return NPDevI18n.t("common.server.uniqueFields", "Entity {entity}: unique constraint violated for fields ({fields})", v); }],
    [new RegExp("^" + E + "field '(.+?)' exceeds maxLength (\\S+) \\(got (\\d+) characters\\)$"), ["entity", "field", "max", "got"], function (v) { return NPDevI18n.t("common.server.maxLength", "Entity {entity}: field '{field}' exceeds maxLength {max} (got {got} characters)", v); }],
    [new RegExp("^" + E + "field '(.+?)' is shorter than minLength (\\S+) \\(got (\\d+) characters\\)$"), ["entity", "field", "min", "got"], function (v) { return NPDevI18n.t("common.server.minLength", "Entity {entity}: field '{field}' is shorter than minLength {min} (got {got} characters)", v); }],
    [new RegExp("^" + E + "field '(.+?)' is below min (\\S+) \\(got (\\S+)\\)$"), ["entity", "field", "min", "got"], function (v) { return NPDevI18n.t("common.server.belowMin", "Entity {entity}: field '{field}' is below min {min} (got {got})", v); }],
    [new RegExp("^" + E + "field '(.+?)' is above max (\\S+) \\(got (\\S+)\\)$"), ["entity", "field", "max", "got"], function (v) { return NPDevI18n.t("common.server.aboveMax", "Entity {entity}: field '{field}' is above max {max} (got {got})", v); }],
    [new RegExp("^" + E + "date field '(.+?)' must use ISO format YYYY-MM-DD$"), ["entity", "field"], function (v) { return NPDevI18n.t("common.server.dateFormat", "Entity {entity}: date field '{field}' must use ISO format YYYY-MM-DD", v); }],
    [new RegExp("^" + E + "datetime field '(.+?)' must use ISO datetime format$"), ["entity", "field"], function (v) { return NPDevI18n.t("common.server.datetimeFormat", "Entity {entity}: datetime field '{field}' must use ISO datetime format", v); }],
    [new RegExp("^" + E + "enum constraint violated for field '(.+?)' \\(allowed: (.+)\\)$"), ["entity", "field", "allowed"], function (v) { return NPDevI18n.t("common.server.enumValue", "Entity {entity}: enum constraint violated for field '{field}' (allowed: {allowed})", v); }],
    [new RegExp("^" + E + "field '(.+?)' must be a number$"), ["entity", "field"], function (v) { return NPDevI18n.t("common.server.notNumber", "Entity {entity}: field '{field}' must be a number", v); }],
    [new RegExp("^" + E + "field '(.+?)' must be a whole number$"), ["entity", "field"], function (v) { return NPDevI18n.t("common.server.notWhole", "Entity {entity}: field '{field}' must be a whole number", v); }],
    [new RegExp("^" + E + "field '(.+?)' must be boolean$"), ["entity", "field"], function (v) { return NPDevI18n.t("common.server.notBoolean", "Entity {entity}: field '{field}' must be boolean", v); }],
    [new RegExp("^" + E + "field '(.+?)' must be a UUID$"), ["entity", "field"], function (v) { return NPDevI18n.t("common.server.notUuid", "Entity {entity}: field '{field}' must be a UUID", v); }]
  ];

  window.NPDevI18n = {
    /**
     * A sentence the server sent, in the visitor's language when it is one of the common field-validation sentences
     * (SERVER_RULES above); anything else, and every sentence in English, comes back unchanged.
     */
    server: function (text) {
      var sent = text == null ? "" : String(text);
      if (window.NPDevI18n.language() === "en") { return sent; }
      for (var i = 0; i < SERVER_RULES.length; i++) {
        var found = SERVER_RULES[i][0].exec(sent);
        if (found) {
          var vars = {};
          SERVER_RULES[i][1].forEach(function (name, at) { vars[name] = found[at + 1]; });
          return SERVER_RULES[i][2](vars);
        }
      }
      return sent;
    },
    /** The catalogue in force (for the browser routines that audit a page for untranslated text). */
    catalogue: function () { return catalogue; },
    /** Hand over the catalogue ({ strings, stringsByLocale }); the manifest object itself qualifies. */
    use: function (source) { if (source && typeof source === "object") { catalogue = source; } },
    /** The text for `key`, placeholders filled; `fallback` (English) when the catalogue has none. */
    t: function (key, fallback, vars) {
      var found = lookup(key);
      return fill(found != null ? found : fallback, vars);
    },
    /**
     * One text out of a per-language map ({ "pt-BR": "Pedido" }): the visitor's exact tag, else a tag of the language in force
     * (the visitor's choice, else the app default's), else `fallback` (the English / default text).
     */
    pick: function (map, fallback) {
      if (!map || typeof map !== "object") { return fallback; }
      var chosen = stored();
      if (chosen && typeof map[chosen] === "string" && map[chosen]) { return map[chosen]; }
      var wanted = window.NPDevI18n.language().toLowerCase();
      var keys = Object.keys(map);
      for (var i = 0; i < keys.length; i++) {
        if (keys[i].split("-")[0].toLowerCase() === wanted && typeof map[keys[i]] === "string" && map[keys[i]]) { return map[keys[i]]; }
      }
      return fallback;
    },
    /** The language in force: the visitor's choice, else the app default's language, else "en". */
    language: function () {
      return language() || (catalogue && catalogue.defaultLanguage) || "en";
    },
    /**
     * Translate static markup in place. `data-i18n="id"` replaces the element's text, `data-i18n-attrs=
     * "placeholder=id;title=id"` replaces those attributes, and the element's own English text/attribute is the
     * fallback (and what check-ui-i18n.py compares with the English catalogue). Also sets <html lang>.
     */
    apply: function (root) {
      var scope = root || document;
      var html = document.documentElement;
      if (html && scope === document) { html.setAttribute("lang", window.NPDevI18n.language()); }
      var texts = scope.querySelectorAll("[data-i18n]");
      for (var i = 0; i < texts.length; i++) {
        var node = texts[i];
        node.textContent = window.NPDevI18n.t(node.getAttribute("data-i18n"), node.textContent.trim());
      }
      var withAttrs = scope.querySelectorAll("[data-i18n-attrs]");
      for (var j = 0; j < withAttrs.length; j++) {
        var holder = withAttrs[j];
        holder.getAttribute("data-i18n-attrs").split(";").forEach(function (pair) {
          var at = pair.indexOf("=");
          if (at < 1) { return; }
          var attr = pair.slice(0, at).trim();
          holder.setAttribute(attr, window.NPDevI18n.t(pair.slice(at + 1).trim(), holder.getAttribute(attr) || ""));
        });
      }
    }
  };
})();
