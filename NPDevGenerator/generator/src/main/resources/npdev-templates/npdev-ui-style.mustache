:root {
  --bg: #f4f1e8;
  --panel: #fffdf8;
  --line: #d4c8b0;
  --text: #1d232e;
  --muted: #586274;
  --accent: #0b7a6e;
  --accent-2: #f08d35;
  --danger: #b42318;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: "IBM Plex Sans", "Trebuchet MS", sans-serif;
  color: var(--text);
  background: radial-gradient(circle at 12% 8%, #fff9ef 0%, var(--bg) 55%, #ede8db 100%);
  min-height: 100vh;
}

.bg-shape {
  position: fixed;
  pointer-events: none;
  opacity: 0.22;
  filter: blur(2px);
}

.bg-shape-a {
  width: 340px;
  height: 340px;
  top: -90px;
  right: -60px;
  border-radius: 45% 55% 60% 40%;
  background: linear-gradient(135deg, #ffd59d, #f08d35);
}

.bg-shape-b {
  width: 290px;
  height: 290px;
  bottom: -80px;
  left: -60px;
  border-radius: 50% 50% 35% 65%;
  background: linear-gradient(135deg, #9ee0d4, #0b7a6e);
}

.shell {
  max-width: 1200px;
  margin: 24px auto;
  padding: 20px;
}

.topbar {
  display: flex;
  gap: 24px;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 14px;
}

.topbar h1 {
  margin: 0;
  letter-spacing: 0.02em;
}

.subtitle {
  margin: 6px 0 0 0;
  color: var(--muted);
}

.badge {
  display: inline-block;
  margin-top: 10px;
  padding: 4px 8px;
  border-radius: 999px;
  border: 1px solid #cc6d20;
  background: #fff1df;
  color: #a24f11;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.identity {
  display: grid;
  grid-template-columns: max-content 220px;
  gap: 8px 10px;
  align-items: center;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 12px;
}

label {
  font-size: 0.92rem;
  color: var(--muted);
}

input, select, textarea, button {
  font: inherit;
}

input, select, textarea {
  width: 100%;
  padding: 8px 10px;
  border-radius: 8px;
  border: 1px solid var(--line);
  background: #fff;
}

textarea {
  font-family: "Courier Prime", "Consolas", monospace;
}

button {
  cursor: pointer;
  border: 1px solid var(--line);
  background: #fff;
  border-radius: 10px;
  padding: 8px 12px;
}

button.primary {
  border-color: #056d61;
  background: linear-gradient(135deg, var(--accent), #0b8f80);
  color: #fff;
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 16px 0;
}

.tab.active {
  background: var(--accent-2);
  border-color: #cc6d20;
  color: #fff;
}

.view {
  display: none;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 16px;
}

.view.active {
  display: block;
}

.hint {
  color: var(--muted);
}

.list {
  list-style: none;
  padding: 0;
  margin: 14px 0 0 0;
  display: grid;
  gap: 10px;
}

.list li {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 10px 12px;
  background: #fff;
}

.grid, .controls {
  display: grid;
  gap: 10px;
  align-items: center;
}

.controls {
  grid-template-columns: max-content 120px max-content 120px max-content;
}

.controls.wide {
  grid-template-columns: max-content 170px max-content 110px max-content 110px max-content 170px repeat(5, max-content);
}

.controls.trace-filters {
  grid-template-columns: max-content 150px max-content 130px max-content 170px max-content 170px max-content 90px max-content 90px repeat(3, max-content);
}

.table-wrap {
  overflow-x: auto;
  margin-top: 12px;
}

table {
  width: 100%;
  border-collapse: collapse;
  background: #fff;
}

th, td {
  border-bottom: 1px solid var(--line);
  text-align: left;
  padding: 9px 10px;
}

tbody tr {
  cursor: pointer;
}

tbody tr:hover {
  background: #f8f4eb;
}

.actions-cell {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.panel {
  margin-top: 10px;
  min-height: 120px;
  max-height: 420px;
  overflow: auto;
  background: #111827;
  color: #e8f0f7;
  border-radius: 10px;
  padding: 12px;
  font-family: "Courier Prime", "Consolas", monospace;
  font-size: 0.88rem;
}

.actions {
  display: flex;
  gap: 8px;
  margin-top: 10px;
}

.inline-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.light-panel {
  margin-top: 10px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #fff;
  color: var(--text);
  padding: 12px;
}

.typed-field {
  display: grid;
  gap: 6px;
  margin-bottom: 10px;
}

.typed-required::after {
  content: " *";
  color: var(--danger);
}

.typed-help {
  font-size: 0.82rem;
  color: var(--muted);
}

.status-block dl {
  margin: 0;
  display: grid;
  grid-template-columns: max-content 1fr;
  gap: 6px 12px;
}

.status-block dt {
  color: var(--muted);
  font-weight: 600;
}

.status-block dd {
  margin: 0;
}

.admin-panel {
  margin-top: 10px;
}

.inline-result {
  margin-top: 10px;
  font-size: 0.86rem;
  color: var(--muted);
}

.runbook-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.runbook-links a {
  font-size: 0.84rem;
  color: var(--accent);
  text-decoration: none;
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 4px 10px;
  background: #fff;
}

.runbook-links a:hover {
  text-decoration: underline;
}

.runbook-note {
  margin-top: 8px;
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 8px 10px;
  background: #fff;
}

.runbook-note summary {
  cursor: pointer;
  font-weight: 600;
}

.runbook-note p {
  margin: 8px 0 0 0;
  color: var(--muted);
}

.trace-step-card {
  margin-top: 10px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #fff;
  padding: 10px;
}

.trace-step-card-header {
  font-weight: 700;
}

.trace-step-card-meta {
  margin-top: 6px;
  color: var(--muted);
  font-size: 0.84rem;
}

.trace-step-card-policy {
  margin-top: 6px;
  font-family: "Courier Prime", "Consolas", monospace;
  font-size: 0.8rem;
  color: #435066;
}

.status {
  margin-bottom: 14px;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid #e0ab00;
  background: #fff6dd;
  color: #7a5800;
}

.status.error {
  border-color: #f3b8b3;
  background: #fef1f0;
  color: var(--danger);
}

.hidden {
  display: none;
}

.footer-meta {
  margin-top: 14px;
  border-top: 1px solid var(--line);
  padding-top: 10px;
  color: var(--muted);
  font-size: 0.84rem;
}

@media (max-width: 900px) {
  .topbar {
    flex-direction: column;
  }

  .identity {
    width: 100%;
    grid-template-columns: max-content 1fr;
  }

  .controls {
    grid-template-columns: 1fr;
  }

  .controls.wide {
    grid-template-columns: 1fr;
  }

  .controls.trace-filters {
    grid-template-columns: 1fr;
  }

  .status-block dl {
    grid-template-columns: 1fr;
  }
}
