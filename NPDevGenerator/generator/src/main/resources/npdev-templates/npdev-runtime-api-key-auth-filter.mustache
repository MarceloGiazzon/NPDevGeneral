package {{configPackage}};

import com.npdev.kernel.ports.ApiKeyCredentialResolver;
import com.npdev.kernel.ports.ApiKeyMappings;
import jakarta.servlet.FilterChain;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import org.springframework.web.filter.OncePerRequestFilter;

import java.io.IOException;
import java.util.LinkedHashMap;
import java.util.Map;
import java.util.Set;

public class RuntimeApiKeyAuthFilter extends OncePerRequestFilter {
    public static final String CLAIMS_ATTRIBUTE = "npdev.auth.claims";

    private final Map<String, PrincipalClaims> byApiKey;
    private final ApiKeyCredentialResolver credentialResolver;

    public RuntimeApiKeyAuthFilter(String encodedMappings) {
        this(encodedMappings, ApiKeyCredentialResolver.NONE);
    }

    // The static mappings (encodedMappings, baked in at generation/startup time) are checked FIRST
    // and always win; credentialResolver is consulted only as a fallback for a key it doesn't
    // recognize, so a tenant onboarded at runtime (no regenerate/restart) can still authenticate.
    public RuntimeApiKeyAuthFilter(String encodedMappings, ApiKeyCredentialResolver credentialResolver) {
        // R7 Stage A (fail closed): no static-mapping default of any kind. A blank, missing, or
        // malformed value parses (ApiKeyMappings, the one shared grammar) to an EMPTY map -- every API
        // key request then falls through to unauthorized("invalid_api_key") -- rather than the previous
        // behavior of silently granting ADMIN via the hardcoded "api-dev"/"dev-key" pair whenever
        // configuration was absent or broken. A misconfigured deployment refuses every request instead
        // of quietly authenticating as an administrator.
        ApiKeyMappings.Parsed parsed = ApiKeyMappings.parse(encodedMappings);
        Map<String, PrincipalClaims> claimsByKey = new LinkedHashMap<>();
        parsed.byApiKey().forEach((key, principal) -> claimsByKey.put(key, PrincipalClaims.fromCredential(principal)));
        this.byApiKey = Map.copyOf(claimsByKey);
        // REG-319: an entry that does not fit the grammar is dropped, so its caller is answered
        // invalid_api_key. Say so once at startup (the count only: the entry's text holds a secret),
        // or an operator who wrote key=ADMIN sees a clean boot and a locked-out app with no clue why.
        if (parsed.dropped() > 0) {
            logger.warn("npdev.auth.api-keys: " + parsed.dropped() + " entr" + (parsed.dropped() == 1 ? "y" : "ies")
                    + " did not match " + ApiKeyMappings.SHAPE + " and " + (parsed.dropped() == 1 ? "was" : "were")
                    + " ignored; those keys are answered invalid_api_key (see docs/CONFIGURATION.md#authentication)");
        }
        this.credentialResolver = credentialResolver == null ? ApiKeyCredentialResolver.NONE : credentialResolver;
    }

    @Override
    protected boolean shouldNotFilter(HttpServletRequest request) {
        String uri = request == null ? null : request.getRequestURI();
        if (uri == null) {
            return true;
        }
        // R6.2: an inbound webhook door has its OWN independent authentication -- an HMAC-SHA256
        // signature WebhookInboundController itself verifies, using a secret named per-webhook in
        // the model. A third party posting e.g. a payment confirmation holds no NPDev credential at
        // all and never will, so this filter must not demand an X-Api-Key it can never present.
        if (uri.startsWith("/api/hooks/")) {
            return true;
        }
        // R6.4: the cross-app messaging door is the same shape as the webhook door above, for the
        // same reason -- the caller is another NPDev APP, not a human, and it holds no X-Api-Key.
        // It authenticates by an HMAC-SHA256 signature over the payload that
        // HttpMessagingCapabilityAdapter verifies itself (plus a trusted-sender check and a
        // deliveryId dedupe) before anything is dispatched. Demanding an api-key here would make
        // peer delivery impossible in apikey mode, which is the DEFAULT -- exempting it does not
        // widen access, because the adapter rejects a forged signature or an unknown sender with
        // 401 before any subscriber runs.
        if (uri.startsWith("/npdev/messaging/")) {
            return true;
        }
        // P6 (G4): the anonymous read surface -- GET/HEAD only under /api/public/. Same check as
        // com.finalexec.publicread.PublicReadPaths (JwtBearerAuthFilter's side), inlined here.
        String method = request.getMethod();
        if (("GET".equalsIgnoreCase(method) || "HEAD".equalsIgnoreCase(method))
                && (uri.startsWith("/api/public/") || uri.equals("/api/public")
                        || uri.startsWith("/api/v1/public/") || uri.equals("/api/v1/public"))) {
            return true;
        }
        // An earlier filter in the chain (e.g. SuperUserCredentialAuthFilter, order -110) may already
        // have authenticated this request via a completely independent credential (the ControlPanel's
        // X-Super-User-Key) and set the claims attribute. This filter must not clobber that
        // stronger/first identity -- neither by overwriting it with a weaker api-key principal nor by
        // rejecting the whole request when a stray or invalid X-Api-Key header is also present. Skip
        // entirely once the request is already authenticated. Mirrors the identical guard in
        // JwtBearerAuthFilter.
        if (request.getAttribute(CLAIMS_ATTRIBUTE) != null) {
            return true;
        }
        if (normalize(request.getHeader("X-Api-Key")) != null || normalize(request.getHeader("X-API-Key")) != null) {
            return false;
        }
        return !(uri.startsWith("/api/") || uri.startsWith("/api/v1/"));
    }

    @Override
    protected void doFilterInternal(
            HttpServletRequest request,
            HttpServletResponse response,
            FilterChain filterChain
    ) throws ServletException, IOException {
        String apiKey = normalize(request.getHeader("X-Api-Key"));
        if (apiKey == null) {
            apiKey = normalize(request.getHeader("X-API-Key"));
        }
        if (apiKey == null) {
            unauthorized(response, "missing_api_key");
            return;
        }
        PrincipalClaims claims = byApiKey.get(apiKey);
        if (claims == null) {
            claims = credentialResolver.resolve(apiKey).map(PrincipalClaims::fromCredential).orElse(null);
        }
        if (claims == null) {
            unauthorized(response, "invalid_api_key");
            return;
        }
        request.setAttribute(CLAIMS_ATTRIBUTE, claims.toClaimMap());
        filterChain.doFilter(request, response);
    }

    private static void unauthorized(HttpServletResponse response, String code) throws IOException {
        response.setStatus(HttpServletResponse.SC_UNAUTHORIZED);
        response.setContentType("application/json");
        response.getWriter().write("{\"error\":\"" + code + "\"}");
    }

    private static String normalize(String value) {
        if (value == null) {
            return null;
        }
        String trimmed = value.trim();
        return trimmed.isBlank() ? null : trimmed;
    }

    private record PrincipalClaims(String tenantId, String actorId, Set<String> roles) {
        static PrincipalClaims fromCredential(ApiKeyCredentialResolver.Principal principal) {
            return new PrincipalClaims(principal.tenantId(), principal.actorId(), principal.roles());
        }

        Map<String, Object> toClaimMap() {
            return Map.of(
                    "tenant_id", tenantId,
                    "actor_id", actorId,
                    "roles", roles
            );
        }
    }
}
