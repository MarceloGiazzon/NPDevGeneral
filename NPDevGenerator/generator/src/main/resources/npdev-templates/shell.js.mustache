// NPDev platform-default unified shell: injects a top bar, a collapsible left nav tree, and a
// collapsible right gadget rail around whatever a hand-authored page already renders, reading its
// menu from the same `workspace::Menu` table (GET /api/workspace_menus) and its GuidePage/theme
// declarations from the generated manifest (GET /npdev-business-ui/generated-ui-manifest.json) --
// one source of truth for navigation and frame appearance across the platform. A future SPA host
// mode (`window.NPDevShell.mount(...)`) lets the generic business UI delegate its own chrome to
// this same script instead of rendering its own (not wired yet -- see business-ui-app.mustache).
//
// This only MOVES existing DOM nodes into a wrapper div; it never clones or rebuilds them, so a
// page's own ids, event listeners, and inline script logic keep working unmodified.
//
// Auth is deliberately mode-agnostic: apps can run in apiKey mode (X-Api-Key header) or JWT mode
// (Authorization: Bearer), and this script has no reliable way to know which from a static asset
// alone (the generated-ui-manifest.json's own "auth" block only carries the real mode since the
// Phase 2 fix -- but reading it is itself an async fetch). Pragmatic fix, kept from the original
// shell: send BOTH headers whenever a token is found; each app's actual auth filter only reads the
// header it cares about and ignores the other.
(function () {
  "use strict";

  var TOKEN_STORAGE_KEYS = ["npdev.shell.token", "npdev.businessUi.apiKey"];
  var BUSINESS_UI_ROOT = "/npdev-business-ui/index.html";
  var CACHE_TTL_MS = 60000;
  var COLLAPSED_GROUPS_KEY = "npdev.shell.collapsedGroups";
  var SIDEBAR_COLLAPSED_KEY = "npdev.shell.sidebarCollapsed";
  var RIGHTBAR_COLLAPSED_KEY = "npdev.shell.rightbarCollapsed";
  var RECENT_ITEMS_KEY = "npdev.shell.recentItems";

  // App-owned theme hook: an app can ship a `theme.css` in its own web/ folder (served at the
  // static root, next to its hand-authored pages) to override the shell's `--np-*` tokens and any
  // page styling. Injected here -- after the page's own shell.css <link>, so it wins the cascade --
  // because every surface (hand-authored pages AND the generated business UI) loads this script,
  // and npdev-generated/ itself is hash-verified, so post-generation edits there are impossible.
  // Apps without a theme.css just get a harmless 404 no-op.
  (function injectAppTheme() {
    if (document.querySelector('link[data-npdev-app-theme]')) return;
    var link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = "/theme.css";
    link.setAttribute("data-npdev-app-theme", "true");
    document.head.appendChild(link);
  })();

  var el = {};
  var state = {
    manifest: null, menuRows: [], roles: [], actorId: "", isSuperUser: false, token: null,
    hostMode: false, deriveNativeGroups: null
  };
  var gadgetRenderers = {};
  var contextState = { title: "", rows: [] };

  // ---------------------------------------------------------------- auth ----

  function findToken() {
    for (var i = 0; i < TOKEN_STORAGE_KEYS.length; i++) {
      var value = localStorage.getItem(TOKEN_STORAGE_KEYS[i]);
      if (value) return value;
    }
    return null;
  }

  function authHeaders(token) {
    if (!token) return {};
    return { "Authorization": "Bearer " + token, "X-Api-Key": token };
  }

  function fetchJson(path, token) {
    return fetch(path, { headers: authHeaders(token) }).then(function (res) {
      if (!res.ok) throw new Error(path + " -> HTTP " + res.status);
      return res.json();
    });
  }

  // ------------------------------------------------------------ storage ----

  function readJsonStorage(storage, key, fallback) {
    try {
      var raw = storage.getItem(key);
      return raw ? JSON.parse(raw) : fallback;
    } catch (error) {
      return fallback;
    }
  }

  function writeJsonStorage(storage, key, value) {
    try {
      storage.setItem(key, JSON.stringify(value));
    } catch (error) {
      // storage full/unavailable -- collapse state and cache are best-effort, never fatal.
    }
  }

  // Cheap non-cryptographic hash so the sessionStorage cache key doesn't embed the raw token.
  function tokenHash(token) {
    var text = token || "anonymous";
    var hash = 0;
    for (var i = 0; i < text.length; i++) {
      hash = ((hash << 5) - hash + text.charCodeAt(i)) | 0;
    }
    return String(hash);
  }

  function readCache(token) {
    var cached = readJsonStorage(sessionStorage, "npdev.shell.cache." + tokenHash(token), null);
    if (!cached || typeof cached.ts !== "number") return null;
    if (Date.now() - cached.ts > CACHE_TTL_MS) return null;
    return cached;
  }

  function writeCache(token, data) {
    writeJsonStorage(sessionStorage, "npdev.shell.cache." + tokenHash(token), {
      ts: Date.now(), me: data.me, menuRows: data.menuRows, manifest: data.manifest
    });
  }

  // ---------------------------------------------------------- nav helpers ----

  function sectionAnchor(target) {
    return "concept-" + String(target).replace(/[^a-zA-Z0-9_-]/g, "-");
  }

  // In host mode (shell running inside the generic business UI itself, via NPDevShell.mount), a
  // BUSINESS-kind link is a same-page hash -- clicking it never reloads, app.js's own hashchange
  // listener switches sections instantly. In static-page mode (a hand-authored page), the same
  // link has to actually navigate to the SPA first, so it's qualified with BUSINESS_UI_ROOT.
  function businessHref(target) {
    return (state.hostMode ? "" : BUSINESS_UI_ROOT) + "#" + sectionAnchor(target);
  }

  // Mirrors business-ui-app.mustache's resolveMenuTarget: PAGE -> a site-root-absolute href (all
  // companion pages are mounted at the site root); BUSINESS -> a section link, qualified per
  // businessHref() above; INTERNAL has no generic resolution (only the fixed platform surfaces
  // rendered by renderNpdevSection know how to target themselves).
  function resolveHref(item) {
    if (item.kind === "PAGE") {
      var href = (item.target || "").trim();
      return href ? "/" + href.replace(/^\/+/, "") : null;
    }
    if (item.kind === "BUSINESS") {
      return businessHref(item.target);
    }
    return null;
  }

  function currentPath() {
    return window.location.pathname.split("/").pop();
  }

  // ------------------------------------------------------------- skeleton ----

  function wrapContent() {
    var originalChildren = Array.prototype.slice.call(document.body.childNodes);
    var content = document.createElement("div");
    content.className = "npdev-shell-content";
    originalChildren.forEach(function (node) { content.appendChild(node); });
    return content;
  }

  function buildTopbar() {
    var bar = document.createElement("div");
    bar.className = "npdev-shell-topbar";

    var sidebarToggle = document.createElement("button");
    sidebarToggle.className = "npdev-shell-collapse-toggle";
    sidebarToggle.type = "button";
    sidebarToggle.title = "Recolher/expandir menu";
    sidebarToggle.textContent = "☰";
    sidebarToggle.addEventListener("click", function () {
      var collapsed = !document.body.classList.contains("npdev-shell-sidebar-collapsed");
      document.body.classList.toggle("npdev-shell-sidebar-collapsed", collapsed);
      writeJsonStorage(localStorage, SIDEBAR_COLLAPSED_KEY, collapsed);
    });
    bar.appendChild(sidebarToggle);

    var logo = document.createElement("span");
    logo.className = "npdev-shell-logo";
    logo.textContent = (document.title || "NPDev App").split(" - ")[0];
    bar.appendChild(logo);
    el.logo = logo;

    var breadcrumb = document.createElement("span");
    breadcrumb.className = "npdev-shell-breadcrumb";
    bar.appendChild(breadcrumb);
    el.breadcrumb = breadcrumb;

    var identity = document.createElement("span");
    identity.className = "npdev-shell-identity";
    identity.textContent = "carregando...";
    bar.appendChild(identity);
    el.identity = identity;

    var rightbarToggle = document.createElement("button");
    rightbarToggle.className = "npdev-shell-rightbar-toggle";
    rightbarToggle.type = "button";
    rightbarToggle.title = "Mostrar/ocultar painel lateral";
    rightbarToggle.textContent = "▤";
    rightbarToggle.addEventListener("click", function () {
      var collapsed = !document.body.classList.contains("npdev-shell-rightbar-collapsed");
      document.body.classList.toggle("npdev-shell-rightbar-collapsed", collapsed);
      writeJsonStorage(localStorage, RIGHTBAR_COLLAPSED_KEY, collapsed);
    });
    bar.appendChild(rightbarToggle);
    el.rightbarToggle = rightbarToggle;

    return bar;
  }

  function paintSkeleton() {
    var content = wrapContent();
    var sidebar = document.createElement("div");
    sidebar.id = "sideNav";
    sidebar.className = "npdev-shell-sidebar";
    var rightbar = document.createElement("div");
    rightbar.className = "npdev-shell-rightbar";

    var bodyRow = document.createElement("div");
    bodyRow.className = "npdev-shell-body";
    bodyRow.appendChild(sidebar);
    bodyRow.appendChild(content);
    bodyRow.appendChild(rightbar);

    document.body.appendChild(buildTopbar());
    document.body.appendChild(bodyRow);
    document.body.classList.add("npdev-shell-active");

    el.sidebar = sidebar;
    el.rightbar = rightbar;
    el.content = content;

    if (readJsonStorage(localStorage, SIDEBAR_COLLAPSED_KEY, false)) {
      document.body.classList.add("npdev-shell-sidebar-collapsed");
    }
    if (readJsonStorage(localStorage, RIGHTBAR_COLLAPSED_KEY, false)) {
      document.body.classList.add("npdev-shell-rightbar-collapsed");
    }
  }

  // --------------------------------------------------------------- identity ----

  function applyIdentity() {
    el.identity.innerHTML = "";
    if (state.token && state.actorId) {
      var text = document.createElement("span");
      text.textContent = "logado como " + state.actorId + (state.roles.length ? " (" + state.roles.join(", ") + ")" : "");
      el.identity.appendChild(text);
      var logoutBtn = document.createElement("button");
      logoutBtn.className = "npdev-shell-logout";
      logoutBtn.type = "button";
      logoutBtn.textContent = "Sair";
      logoutBtn.addEventListener("click", function () {
        TOKEN_STORAGE_KEYS.forEach(function (key) { localStorage.removeItem(key); });
        sessionStorage.clear();
        window.location.reload();
      });
      el.identity.appendChild(logoutBtn);
    } else {
      el.identity.textContent = "nao autenticado";
    }
  }

  // ------------------------------------------------------------------ nav ----

  function isCollapsed(groupId) {
    var collapsed = readJsonStorage(localStorage, COLLAPSED_GROUPS_KEY, []);
    return collapsed.indexOf(groupId) !== -1;
  }

  function setCollapsed(groupId, collapsed) {
    var ids = readJsonStorage(localStorage, COLLAPSED_GROUPS_KEY, []);
    var idx = ids.indexOf(groupId);
    if (collapsed && idx === -1) ids.push(groupId);
    if (!collapsed && idx !== -1) ids.splice(idx, 1);
    writeJsonStorage(localStorage, COLLAPSED_GROUPS_KEY, ids);
  }

  function addSectionHeader(container, label) {
    var header = document.createElement("div");
    header.className = "npdev-shell-nav-section";
    header.textContent = label;
    container.appendChild(header);
  }

  // First-letter glyph shown only when the sidebar is collapsed (CSS hides it otherwise) -- gives
  // collapsed mode an actual icon rail instead of a column of blank, unlabeled pills.
  function buildNavIcon(label) {
    var icon = document.createElement("span");
    icon.className = "npdev-shell-nav-icon";
    icon.textContent = (label || "?").trim().charAt(0).toUpperCase() || "?";
    return icon;
  }

  function addLeafLink(container, href, label, path) {
    var a = document.createElement("a");
    a.href = href;
    a.title = label;
    a.appendChild(buildNavIcon(label));
    var labelSpan = document.createElement("span");
    labelSpan.className = "npdev-shell-nav-label";
    labelSpan.textContent = label;
    a.appendChild(labelSpan);
    var isHash = href.indexOf("#") === 0;
    if (isHash) {
      if (window.location.hash && window.location.hash === href) a.className = "active";
    } else {
      var linkPath = href.indexOf("/") === 0 ? href.split("/").pop() : null;
      if (linkPath && linkPath === path) a.className = "active";
    }
    a.addEventListener("click", function () {
      // A bare same-page hash only makes sense as a "recent item" from within the SPA itself --
      // qualify it with the SPA's own root so the recent-items gadget stays a valid link from any
      // page (a hand-authored page has no element with that hash id at all).
      recordRecentItem(label, isHash && state.hostMode ? BUSINESS_UI_ROOT + href : href);
    });
    container.appendChild(a);
    return a;
  }

  // Re-toggles .active on every hash-style sidebar link after a same-page section switch (host
  // mode) -- cheap, no data refetch, since the switch itself is instant (app.js's own hashchange
  // listener already did the actual work; this only keeps the nav's own highlight in sync).
  function refreshActiveLinks() {
    if (!el.sidebar) return;
    var hash = window.location.hash;
    el.sidebar.querySelectorAll("a").forEach(function (a) {
      var href = a.getAttribute("href") || "";
      if (href.indexOf("#") === 0) {
        a.classList.toggle("active", hash === href);
      }
    });
  }

  // Renders one workspace::Menu node (and, recursively, its children via parentMenuId) as either a
  // collapsible group (GROUP kind, or any kind that has children) or a leaf link.
  function renderMenuNode(container, node, childrenByParent, path) {
    var children = childrenByParent[node.id] || [];
    if (children.length === 0 && node.kind !== "GROUP") {
      var href = resolveHref(node);
      if (href) addLeafLink(container, href, node.label, path);
      return;
    }

    var groupId = "menu-" + node.id;
    var group = document.createElement("div");
    group.className = "npdev-shell-nav-group" + (isCollapsed(groupId) ? " collapsed" : "");

    var header = document.createElement("button");
    header.type = "button";
    header.className = "npdev-shell-nav-group-header";
    header.title = node.label;
    var caret = document.createElement("span");
    caret.className = "npdev-shell-nav-caret";
    caret.textContent = "▼";
    header.appendChild(caret);
    header.appendChild(buildNavIcon(node.label));
    var labelSpan = document.createElement("span");
    labelSpan.className = "npdev-shell-nav-label";
    labelSpan.textContent = node.label;
    header.appendChild(labelSpan);
    header.addEventListener("click", function () {
      var collapsed = !group.classList.contains("collapsed");
      group.classList.toggle("collapsed", collapsed);
      setCollapsed(groupId, collapsed);
    });
    group.appendChild(header);

    var childrenContainer = document.createElement("div");
    childrenContainer.className = "npdev-shell-nav-children";
    children.forEach(function (child) { renderMenuNode(childrenContainer, child, childrenByParent, path); });
    group.appendChild(childrenContainer);

    container.appendChild(group);
  }

  function renderSystemSection(container, appName, rows) {
    if (!rows.length) return;
    addSectionHeader(container, appName || "Sistema");
    var byId = {};
    rows.forEach(function (row) { byId[row.id] = row; });
    var childrenByParent = {};
    var roots = [];
    rows.forEach(function (row) {
      if (row.parentMenuId && byId[row.parentMenuId]) {
        childrenByParent[row.parentMenuId] = childrenByParent[row.parentMenuId] || [];
        childrenByParent[row.parentMenuId].push(row);
      } else {
        roots.push(row);
      }
    });
    var sortByOrdinal = function (a, b) { return (a.ordinal || 0) - (b.ordinal || 0); };
    roots.sort(sortByOrdinal);
    Object.keys(childrenByParent).forEach(function (key) { childrenByParent[key].sort(sortByOrdinal); });

    var path = currentPath();
    roots.forEach(function (root) { renderMenuNode(container, root, childrenByParent, path); });
  }

  // Auto-derived, super-user-gated platform section: admin concepts (identity/workspace tables)
  // plus the fixed INTERNAL surfaces. Never seeded into workspace::Menu -- doing so would
  // duplicate whatever the generic business UI's own nav already lists natively for these same
  // targets (the exact trap documented in BusinessUiEmitter.menuSeedJson).
  function renderNpdevSection(container, manifest) {
    if (!state.isSuperUser || !manifest) return;
    var adminConcepts = (manifest.concepts || []).filter(function (c) { return c.admin; });
    if (!adminConcepts.length) return;

    addSectionHeader(container, "NPDev");
    adminConcepts.forEach(function (concept) {
      addLeafLink(container, businessHref(concept.conceptName), concept.displayName, null);
    });
    addLeafLink(container, businessHref("__store__"), "Store", null);
    addLeafLink(container, businessHref("__boxview__"), "Box View", null);
    addLeafLink(container, businessHref("__promotion__"), "Promotion", null);
  }

  // Host-mode-only: business concepts and declared Panels have no natural home in the System tree
  // (workspace::Menu is an author-curated overlay, not a full concept catalog) or in the NPDev
  // section (admin-gated). app.js supplies these via NPDevShell.mount({ deriveNativeGroups }) so
  // an app that has never authored a menu.json/Menu row still gets a working nav for every
  // concept/Panel, exactly like the SPA's own pre-Phase-4 default nav did.
  function renderNativeGroup(container, label, items) {
    if (!items || !items.length) return;
    addSectionHeader(container, label);
    items.forEach(function (item) {
      addLeafLink(container, "#" + item.hash, item.label, null);
    });
  }

  function renderSidebar() {
    el.sidebar.innerHTML = "";
    renderSystemSection(el.sidebar, state.manifest ? state.manifest.appName : "", state.menuRows);
    if (state.hostMode && typeof state.deriveNativeGroups === "function") {
      var native = state.deriveNativeGroups() || {};
      renderNativeGroup(el.sidebar, "Dados", native.data);
      renderNativeGroup(el.sidebar, "Paineis", native.panels);
    }
    renderNpdevSection(el.sidebar, state.manifest);
  }

  // -------------------------------------------------------------- gadgets ----

  function recentItems() {
    return readJsonStorage(localStorage, RECENT_ITEMS_KEY, []);
  }

  function recordRecentItem(label, href) {
    if (!label || !href) return;
    var items = recentItems().filter(function (item) { return item.href !== href; });
    items.unshift({ label: label, href: href });
    writeJsonStorage(localStorage, RECENT_ITEMS_KEY, items.slice(0, 10));
  }

  function renderRecentItemsGadget(container) {
    var items = recentItems();
    if (!items.length) {
      var empty = document.createElement("div");
      empty.className = "npdev-shell-gadget-empty";
      empty.textContent = "Nenhum item recente ainda.";
      container.appendChild(empty);
      return;
    }
    var list = document.createElement("ul");
    items.forEach(function (item) {
      var li = document.createElement("li");
      var a = document.createElement("a");
      a.href = item.href;
      a.textContent = item.label;
      li.appendChild(a);
      list.appendChild(li);
    });
    container.appendChild(list);
  }

  function renderContextInfoGadget(container) {
    if (!contextState.rows || !contextState.rows.length) {
      var empty = document.createElement("div");
      empty.className = "npdev-shell-gadget-empty";
      empty.textContent = "Sem contexto no momento.";
      container.appendChild(empty);
      return;
    }
    var list = document.createElement("ul");
    contextState.rows.forEach(function (row) {
      var li = document.createElement("li");
      li.textContent = row;
      list.appendChild(li);
    });
    container.appendChild(list);
  }

  function renderPageFragmentGadget(container, config) {
    var url = config && config.url;
    if (!url) return;
    fetch(url).then(function (res) { return res.ok ? res.text() : ""; }).then(function (html) {
      // Same-origin static HTML fragment only; scripts inside are intentionally not executed
      // (innerHTML never runs <script> tags) -- this is a display-only gadget, not a mini-app host.
      var holder = document.createElement("div");
      holder.innerHTML = html;
      container.appendChild(holder);
    }).catch(function () { /* best-effort */ });
  }

  gadgetRenderers["recent-items"] = function (container) { renderRecentItemsGadget(container); };
  gadgetRenderers["context-info"] = function (container) { renderContextInfoGadget(container); };
  gadgetRenderers["page-fragment"] = function (container, config) { renderPageFragmentGadget(container, config); };

  // Move 10 B2 (LC-B2, MOVE10_AI_LOWCODE_PLAN Part B): kpi/bar/line/table gadgets bind to a named
  // B1 aggregate query and render SERVER-FED numbers -- no client-side arithmetic (the numbers
  // come from GET /api/queries/{name} already grouped/aggregated) and no charting library from a
  // CDN (bar/line are hand-rolled inline SVG, self-contained like the rest of this generated file).

  function fetchGadgetQuery(gadget) {
    if (!gadget || !gadget.query) return Promise.reject(new Error("gadget has no query binding"));
    return fetchJson("/api/queries/" + encodeURIComponent(gadget.query), state.token);
  }

  function gadgetMessage(container, message) {
    var empty = document.createElement("div");
    empty.className = "npdev-shell-gadget-empty";
    empty.textContent = message;
    container.appendChild(empty);
  }

  function numberOrZero(value) {
    var n = Number(value);
    return isFinite(n) ? n : 0;
  }

  function formatNumber(value) {
    return value.toLocaleString ? value.toLocaleString() : String(value);
  }

  // R7.5 (Roadmap R7.5): every gadget was a dead end -- clicking a KPI/bar/line/table datum did
  // nothing. GeneratedQueryController.runAggregate now reports which concept an aggregate query
  // reads from and each declared groupBy field (with its bucket, if any); these turn that into a
  // click target landing on the SAME grid, pre-filtered to exactly the clicked slice -- through the
  // EXISTING `where` DSL (field:eq:value, comma-joined) R7.3 already taught business-ui-app.mustache
  // (buildWhereParam/columnFilters), carried over the EXISTING hash-based deep link
  // (businessHref/sectionAnchor) via a `?where=` suffix on the fragment. No new filter format, no
  // new endpoint -- this only produces a link the grid already knows how to consume. A bucketed
  // groupBy field is excluded: the row holds the bucket label (e.g. a month name), not the raw
  // stored value, so an eq filter against the raw field would silently match nothing.
  function drillableKeys(result) {
    return ((result && result.groupBy) || [])
        .filter(function (g) { return g && g.field && !g.bucket; })
        .map(function (g) { return g.field; });
  }

  function drilldownWhereParam(keys, row) {
    var clauses = [];
    (keys || []).forEach(function (key) {
      var value = row ? row[key] : undefined;
      if (value === undefined || value === null) return;
      clauses.push(key + ":eq:" + value);
    });
    if (!clauses.length) return "";
    var params = new URLSearchParams();
    params.set("where", clauses.join(","));
    return params.toString();
  }

  function drilldownHref(concept, keys, row) {
    var whereParam = drilldownWhereParam(keys, row);
    var base = businessHref(concept);
    return whereParam ? base + "?" + whereParam : base;
  }

  // In host mode (gadget rail and grid are the same page -- see business-ui-app.mustache's
  // NPDevShell.mount call), a hash change is enough: app.js's own hashchange listener does the rest.
  // Elsewhere (a hand-authored page hosting a dashboard GuidePage) the same href is a real navigation
  // to the generic business UI.
  function navigateToDrilldown(concept, keys, row) {
    var href = drilldownHref(concept, keys, row);
    if (state.hostMode) {
      if (window.location.hash === href) {
        window.dispatchEvent(new Event("hashchange"));
      } else {
        window.location.hash = href;
      }
    } else {
      window.location.href = href;
    }
  }

  // role/aria-label make a clicked shape identifiable both to assistive tech and to a browser
  // verification routine's selector (`[aria-label="..."]`) -- an SVG <rect>/<circle> has no visible
  // text of its own to target otherwise. The <title> child is the native SVG hover tooltip.
  function makeClickableSvg(node, label, onClick) {
    node.style.cursor = "pointer";
    node.setAttribute("role", "button");
    node.setAttribute("aria-label", label);
    node.addEventListener("click", onClick);
    var titleEl = svgEl("title", {});
    titleEl.textContent = label;
    node.appendChild(titleEl);
  }

  function renderKpiGadget(container, gadget) {
    fetchGadgetQuery(gadget).then(function (result) {
      var rows = (result && result.rows) || [];
      if (!rows.length) { gadgetMessage(container, "Sem dados."); return; }
      var total = 0;
      rows.forEach(function (row) { total += numberOrZero(row[gadget.y]); });
      var big = document.createElement("div");
      big.className = "npdev-shell-gadget-kpi";
      big.textContent = formatNumber(total);
      if (result && result.concept) {
        big.style.cursor = "pointer";
        big.title = "Ver " + result.concept;
        big.addEventListener("click", function () { navigateToDrilldown(result.concept, [], {}); });
      }
      container.appendChild(big);
    }).catch(function (err) { gadgetMessage(container, "Erro: " + err.message); });
  }

  function renderTableGadget(container, gadget) {
    fetchGadgetQuery(gadget).then(function (result) {
      var rows = (result && result.rows) || [];
      if (!rows.length) { gadgetMessage(container, "Sem dados."); return; }
      var columns = Object.keys(rows[0]);
      var table = document.createElement("table");
      table.className = "npdev-shell-gadget-table";
      var thead = document.createElement("thead");
      var htr = document.createElement("tr");
      columns.forEach(function (c) {
        var th = document.createElement("th");
        th.textContent = c;
        htr.appendChild(th);
      });
      thead.appendChild(htr);
      table.appendChild(thead);
      var tbody = document.createElement("tbody");
      var drillConcept = result && result.concept;
      var drillKeys = drillableKeys(result);
      rows.forEach(function (row) {
        var tr = document.createElement("tr");
        columns.forEach(function (c) {
          var td = document.createElement("td");
          var v = row[c];
          td.textContent = typeof v === "number" ? formatNumber(v) : String(v == null ? "" : v);
          tr.appendChild(td);
        });
        if (drillConcept) {
          tr.style.cursor = "pointer";
          tr.title = "Ver " + drillConcept;
          tr.addEventListener("click", function () { navigateToDrilldown(drillConcept, drillKeys, row); });
        }
        tbody.appendChild(tr);
      });
      table.appendChild(tbody);
      container.appendChild(table);
    }).catch(function (err) { gadgetMessage(container, "Erro: " + err.message); });
  }

  var CHART_COLORS = ["#295572", "#4d8fe8", "#e05d5d", "#f0a868", "#4caf7d", "#9b6bd1", "#c2185b", "#607d8b"];

  function svgEl(tag, attrs) {
    var node = document.createElementNS("http://www.w3.org/2000/svg", tag);
    for (var k in attrs) {
      if (Object.prototype.hasOwnProperty.call(attrs, k)) node.setAttribute(k, attrs[k]);
    }
    return node;
  }

  // Grouped-bar / multi-line chart over the (already-aggregated) query rows: x names a groupBy
  // field (the category axis), y names an aggregates output (the value axis), series (optional)
  // names a second groupBy field that splits each category into multiple bars/lines.
  function renderXyChart(container, rows, gadget, chartType, result) {
    var xField = gadget.x, yField = gadget.y, seriesField = gadget.series;
    var categories = [], categorySeen = {};
    rows.forEach(function (row) {
      var key = String(row[xField]);
      if (!categorySeen[key]) { categorySeen[key] = true; categories.push(key); }
    });
    var seriesValues = [], seriesSeen = {};
    rows.forEach(function (row) {
      var key = seriesField ? String(row[seriesField]) : "_";
      if (!seriesSeen[key]) { seriesSeen[key] = true; seriesValues.push(key); }
    });
    var valueByKey = {};
    var rowByKey = {};
    rows.forEach(function (row) {
      var cKey = String(row[xField]);
      var sKey = seriesField ? String(row[seriesField]) : "_";
      valueByKey[cKey + "" + sKey] = numberOrZero(row[yField]);
      rowByKey[cKey + "" + sKey] = row;
    });
    var drillConcept = result && result.concept;
    var drillKeys = drillableKeys(result);

    var width = 480, height = 220, padTop = 16, padRight = 12, padBottom = 30, padLeft = 46;
    var innerW = width - padLeft - padRight, innerH = height - padTop - padBottom;
    var maxValue = 0;
    categories.forEach(function (c) {
      seriesValues.forEach(function (s) { maxValue = Math.max(maxValue, valueByKey[c + "" + s] || 0); });
    });
    if (maxValue <= 0) maxValue = 1;

    var svg = svgEl("svg", {
      viewBox: "0 0 " + width + " " + height, width: "100%", height: String(height),
      "class": "npdev-shell-gadget-chart"
    });
    svg.appendChild(svgEl("line", { x1: padLeft, y1: padTop, x2: padLeft, y2: padTop + innerH, stroke: "#c8d0da" }));
    svg.appendChild(svgEl("line", {
      x1: padLeft, y1: padTop + innerH, x2: padLeft + innerW, y2: padTop + innerH, stroke: "#c8d0da"
    }));
    [0, 0.5, 1].forEach(function (t) {
      var y = padTop + innerH - t * innerH;
      var tick = svgEl("text", { x: padLeft - 6, y: y + 3, "text-anchor": "end", "font-size": "9", fill: "#6b7280" });
      tick.textContent = String(Math.round(maxValue * t));
      svg.appendChild(tick);
    });

    var catCount = Math.max(1, categories.length);
    var catBand = innerW / catCount;

    if (chartType === "line") {
      seriesValues.forEach(function (s, si) {
        var color = CHART_COLORS[si % CHART_COLORS.length];
        var pts = categories.map(function (c, ci) {
          var v = valueByKey[c + "" + s] || 0;
          var x = padLeft + catBand * (ci + 0.5);
          var y = padTop + innerH - (v / maxValue) * innerH;
          return x + "," + y;
        });
        svg.appendChild(svgEl("polyline", { points: pts.join(" "), fill: "none", stroke: color, "stroke-width": "2" }));
        categories.forEach(function (c, ci) {
          var v = valueByKey[c + "" + s] || 0;
          var x = padLeft + catBand * (ci + 0.5);
          var y = padTop + innerH - (v / maxValue) * innerH;
          var point = svgEl("circle", { cx: x, cy: y, r: "2.5", fill: color });
          if (drillConcept) {
            makeClickableSvg(point, c + (seriesField ? " / " + s : ""), function () {
              navigateToDrilldown(drillConcept, drillKeys, rowByKey[c + "" + s]);
            });
          }
          svg.appendChild(point);
        });
      });
    } else {
      var groupWidth = catBand * 0.7;
      var barWidth = groupWidth / Math.max(1, seriesValues.length);
      categories.forEach(function (c, ci) {
        seriesValues.forEach(function (s, si) {
          var v = valueByKey[c + "" + s] || 0;
          var barH = (v / maxValue) * innerH;
          var x = padLeft + catBand * ci + (catBand - groupWidth) / 2 + si * barWidth;
          var y = padTop + innerH - barH;
          var bar = svgEl("rect", {
            x: x, y: y, width: Math.max(1, barWidth - 2), height: Math.max(0, barH),
            fill: CHART_COLORS[si % CHART_COLORS.length]
          });
          if (drillConcept) {
            makeClickableSvg(bar, c + (seriesField ? " / " + s : ""), function () {
              navigateToDrilldown(drillConcept, drillKeys, rowByKey[c + "" + s]);
            });
          }
          svg.appendChild(bar);
        });
      });
    }

    categories.forEach(function (c, ci) {
      var x = padLeft + catBand * (ci + 0.5);
      var label = svgEl("text", { x: x, y: padTop + innerH + 13, "text-anchor": "middle", "font-size": "9", fill: "#1c2333" });
      label.textContent = c.length > 10 ? c.slice(0, 9) + "…" : c;
      svg.appendChild(label);
    });

    container.appendChild(svg);

    if (seriesField && seriesValues.length > 1) {
      var legend = document.createElement("div");
      legend.className = "npdev-shell-gadget-legend";
      seriesValues.forEach(function (s, si) {
        var item = document.createElement("span");
        item.className = "npdev-shell-gadget-legend-item";
        var swatch = document.createElement("i");
        swatch.style.background = CHART_COLORS[si % CHART_COLORS.length];
        item.appendChild(swatch);
        item.appendChild(document.createTextNode(s));
        legend.appendChild(item);
      });
      container.appendChild(legend);
    }
  }

  function renderXyChartGadget(container, gadget, chartType) {
    fetchGadgetQuery(gadget).then(function (result) {
      var rows = (result && result.rows) || [];
      if (!rows.length) { gadgetMessage(container, "Sem dados."); return; }
      renderXyChart(container, rows, gadget, chartType, result);
    }).catch(function (err) { gadgetMessage(container, "Erro: " + err.message); });
  }

  gadgetRenderers["kpi"] = function (container, gadget) { renderKpiGadget(container, gadget); };
  gadgetRenderers["table"] = function (container, gadget) { renderTableGadget(container, gadget); };
  gadgetRenderers["bar"] = function (container, gadget) { renderXyChartGadget(container, gadget, "bar"); };
  gadgetRenderers["line"] = function (container, gadget) { renderXyChartGadget(container, gadget, "line"); };

  function renderGadgets(gadgets) {
    el.rightbar.innerHTML = "";
    (gadgets || []).forEach(function (gadget) {
      var card = document.createElement("div");
      card.className = "npdev-shell-gadget";
      var title = document.createElement("h4");
      title.textContent = gadget.title || gadget.name;
      card.appendChild(title);
      var body = document.createElement("div");
      card.appendChild(body);
      var renderer = gadgetRenderers[gadget.type];
      if (renderer) {
        renderer(body, gadget);
      } else {
        var placeholder = document.createElement("div");
        placeholder.className = "npdev-shell-gadget-empty";
        placeholder.textContent = "Tipo de gadget desconhecido: " + gadget.type;
        body.appendChild(placeholder);
      }
      el.rightbar.appendChild(card);
    });
  }

  // ---------------------------------------------------------- guide pages ----

  function findGuidePage(manifest, name) {
    var pages = (manifest && manifest.guidePages) || [];
    for (var i = 0; i < pages.length; i++) {
      if (pages[i].name === name) return pages[i];
    }
    return pages.length ? pages[0] : null;
  }

  function currentGuidePageName() {
    var meta = document.querySelector('meta[name="npdev-guide-page"]');
    return meta && meta.content ? meta.content.trim() : "";
  }

  function applyGuidePage(manifest, name) {
    var page = findGuidePage(manifest, name || (manifest && manifest.defaultGuidePage));
    if (!page) return;
    document.body.dataset.guidePage = page.name;

    var regions = page.regions || { top: true, left: { enabled: true }, right: { enabled: false } };
    document.body.classList.toggle("npdev-shell-no-top", regions.top === false);
    document.body.classList.toggle("npdev-shell-no-left", !(regions.left && regions.left.enabled));
    document.body.classList.toggle("npdev-shell-no-right", !(regions.right && regions.right.enabled));

    // Only apply the GuidePage's own default when the user has never explicitly toggled the
    // rightbar (i.e. nothing at all stored yet) -- `readJsonStorage(..., null) === false` is a
    // real, explicit "expanded" preference, not "no preference", and must never be silently
    // overridden back to collapsed on the next page/reload (confirmed live: a plain truthiness
    // check here made every explicit expand get stomped by the GuidePage default on next paint).
    if (regions.right && regions.right.enabled && readJsonStorage(localStorage, RIGHTBAR_COLLAPSED_KEY, null) === null) {
      document.body.classList.toggle("npdev-shell-rightbar-collapsed", Boolean(regions.right.defaultCollapsed));
    }
    if (regions.right && regions.right.width) {
      document.documentElement.style.setProperty("--np-rightbar-w", regions.right.width + "px");
    }

    var theme = page.theme || {};
    if (theme.mode) {
      // Both the body[data-np-theme="dark"] rule AND the prefers-color-scheme:dark media
      // query's own light-mode escape hatch (":root:not([data-np-theme=\"light\"])") are
      // selectors shell.css checks -- the escape hatch specifically looks at <html> (:root), not
      // <body>. Setting only body.dataset here left that escape hatch permanently unmatched
      // (<html> never got the attribute), so a GuidePage's explicit theme.mode="light" was
      // silently overridden back to dark colors on any visitor whose OS/browser prefers dark --
      // confirmed live: business-ui-style.mustache's :root text color inherits --np-text, which
      // the media query then flips to near-white while the (hardcoded-white) modal/panel
      // backgrounds stayed light, producing unreadable near-invisible form labels.
      document.documentElement.dataset.npTheme = theme.mode;
      document.body.dataset.npTheme = theme.mode;
    }
    if (theme.accent) {
      document.documentElement.style.setProperty("--np-accent", theme.accent);
    }
    if (theme.logoText) {
      el.logo.textContent = theme.logoText;
    } else if (theme.logoUrl) {
      el.logo.innerHTML = "";
      var img = document.createElement("img");
      img.src = theme.logoUrl;
      img.alt = document.title || "";
      img.style.height = "22px";
      el.logo.appendChild(img);
    }

    renderGadgets(page.gadgets);
  }

  // -------------------------------------------------------------- login ----

  // When the app declares auth.loginPath (jwt mode only), an unauthenticated visitor is bounced to
  // it with ?next=<original path> instead of silently seeing "nao autenticado" chrome around an
  // API-error-riddled page. apiKey-mode apps keep today's inline notice (dev ergonomics -- there's
  // no login flow to redirect to). A visitor already on the login page is never redirected (loop
  // guard), whether or not it happens to include this script.
  function shouldRedirectToLogin(auth, token) {
    return Boolean(auth && auth.loginPath && auth.mode === "jwt" && !token);
  }

  function redirectToLogin(loginPathRaw) {
    var loginPath = "/" + String(loginPathRaw).replace(/^\/+/, "");
    if (window.location.pathname === loginPath) return false;
    var next = encodeURIComponent(window.location.pathname + window.location.search);
    window.location.href = loginPath + "?next=" + next;
    return true;
  }

  function maybeRedirectToLogin(manifest) {
    var auth = manifest && manifest.auth;
    if (!shouldRedirectToLogin(auth, state.token)) return false;
    return redirectToLogin(auth.loginPath);
  }

  // Persisted (not session-scoped) so the very next visit -- not just the next request within the
  // same tab -- can redirect before paintSkeleton() ever runs, eliminating the brief "carregando..."
  // flash a fresh manifest fetch would otherwise cause. Only ever written with the real, freshly
  // fetched auth block, so it can't go stale in a way that would loop or redirect somewhere wrong;
  // worst case (auth mode changed server-side since the last visit) is one visit's flash while it
  // re-learns, same as before this optimization existed at all.
  var AUTH_CONFIG_KEY = "npdev.shell.authConfig";

  function maybeRedirectToLoginSync() {
    var auth = readJsonStorage(localStorage, AUTH_CONFIG_KEY, null);
    if (!shouldRedirectToLogin(auth, findToken())) return false;
    return redirectToLogin(auth.loginPath);
  }

  // ------------------------------------------------------------- pipeline ----

  function applyData(me, menuRows, manifest, token) {
    state.token = token;
    state.roles = Array.isArray(me.roles) ? me.roles : [];
    state.actorId = me.actorId || "";
    state.manifest = manifest;
    state.menuRows = menuRows;
    var superUserRole = manifest && manifest.superUserRole;
    state.isSuperUser = Boolean(superUserRole) && state.roles.indexOf(superUserRole) !== -1;

    if (maybeRedirectToLogin(manifest)) return;

    applyIdentity();
    renderSidebar();
    applyGuidePage(manifest, currentGuidePageName());
    recordRecentItem(document.title, window.location.pathname);
  }

  function init() {
    if (maybeRedirectToLoginSync()) return;

    paintSkeleton();
    var token = findToken();
    var cached = readCache(token);
    if (cached) {
      applyData(cached.me, cached.menuRows, cached.manifest, token);
    }

    Promise.all([
      fetchJson("/api/me", token).catch(function () { return { roles: [], actorId: "" }; }),
      fetchJson("/api/workspace_menus?page=0&size=200&sort=ordinal&direction=asc", token).catch(function () { return { content: [] }; }),
      fetchJson("/npdev-business-ui/generated-ui-manifest.json", token).catch(function () { return { guidePages: [], defaultGuidePage: "Default" }; })
    ]).then(function (results) {
      var me = results[0];
      var rows = Array.isArray(results[1]) ? results[1] : (Array.isArray(results[1].content) ? results[1].content : []);
      var manifest = results[2];
      var visible = rows.filter(function (row) {
        return row.visible !== false && (!row.requiredRole || (Array.isArray(me.roles) && me.roles.indexOf(row.requiredRole) !== -1));
      });
      writeJsonStorage(localStorage, AUTH_CONFIG_KEY, manifest && manifest.auth ? manifest.auth : null);
      writeCache(token, { me: me, menuRows: visible, manifest: manifest });
      applyData(me, visible, manifest, token);
    });
  }

  window.addEventListener("hashchange", function () {
    if (state.hostMode) refreshActiveLinks();
  });

  // Public API surface. `mount` puts the shell in SPA host mode: the generic business UI supplies
  // a `deriveNativeGroups` callback (business concepts + declared Panels, which have no natural
  // home in the System/NPDev sections) and the shell renders/manages the WHOLE chrome exactly as
  // it does for a hand-authored page -- app.js itself never builds a header or nav again.
  window.NPDevShell = {
    registerGadget: function (type, renderFn) { gadgetRenderers[type] = renderFn; },
    // `context.title` becomes the topbar breadcrumb (e.g. the active section's display name);
    // `context.rows` feeds the context-info gadget, if the active GuidePage declares one.
    setContext: function (context) {
      contextState = context || { title: "", rows: [] };
      if (el.breadcrumb) {
        el.breadcrumb.textContent = contextState.title ? "/ " + contextState.title : "";
      }
      // R7.5 fix: re-apply whichever GuidePage is CURRENTLY active (document.body.dataset
      // .guidePage) -- so a context refresh (e.g. new context-info rows) re-renders that page's
      // own gadgets -- rather than unconditionally recomputing the name from the static
      // <meta name="npdev-guide-page"> tag. That tag only ever expresses a hand-authored page's
      // OWN fixed page-level choice; in host mode (business-ui-app.mustache) no such tag exists,
      // so this always fell through to manifest.defaultGuidePage ("Default") -- silently undoing
      // applyActiveGuidePage's own explicit `applyGuidePage(concept.guidePage)` call one line
      // above this one, on EVERY render. Confirmed live: a concept's own GuidePage (distinct
      // gadgets/regions/theme from Default) never took effect, because this line reset it back
      // in the same call before the next paint. Falls back to the meta tag only when no page is
      // active yet, which is exactly the hand-authored-page case the fallback exists for.
      if (state.manifest) {
        applyGuidePage(state.manifest, document.body.dataset.guidePage || currentGuidePageName());
      }
    },
    applyGuidePage: function (name) {
      if (state.manifest) applyGuidePage(state.manifest, name);
    },
    mount: function (options) {
      state.hostMode = true;
      state.deriveNativeGroups = options && options.deriveNativeGroups;
      init();
    }
  };

  var hostScript = document.querySelector('script[data-npdev-shell="host"]');
  if (!hostScript) {
    init();
  }
})();
