    protected ResponseEntity<?> getByIdBase(UUID id) {
        Optional<{{entityName}}> opt = service.getById(id);
        return opt.<ResponseEntity<?>>map(ResponseEntity::ok)
                .orElseGet(() -> ResponseEntity.notFound().build());
