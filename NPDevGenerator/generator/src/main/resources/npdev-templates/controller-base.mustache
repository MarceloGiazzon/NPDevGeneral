    /**
     * RUN-1 (R8a): {@code service.listCapped()} bounds the read (see ServiceBase.list()'s own
     * javadoc for why) and reports whether the cap actually cut anything -- surfaced here as two
     * response headers rather than silently returning a partial list as if it were complete.
     * {@code X-List-Truncated}: {@code "true"} means more rows existed than this response carries;
     * {@code X-List-Limit}: the cap that was applied ({@code ConceptQuery.MAX_LIMIT}), so a caller
     * that hits {@code "true"} knows to switch to the windowed alternative instead
     * ({@code GET /api/concepts/{conceptName}}, which pushes filter/sort/page down to SQL via
     * {@code ServiceBase#page}).
     */
    protected ResponseEntity<List<{{entityName}}>> listBase() {
        com.npdev.kernel.concepts.ConceptListSlice<{{entityName}}> slice = service.listCapped();
        return ResponseEntity.ok()
                .header("X-List-Truncated", String.valueOf(slice.truncated()))
                .header("X-List-Limit", String.valueOf(com.npdev.kernel.concepts.ConceptQuery.MAX_LIMIT))
                .body(slice.records());
    }

    protected ResponseEntity<?> createBase({{entityName}}CreateRequest request) {
        try {
            {{entityName}} created = service.create(request);

            try {
                java.lang.reflect.Method getId = created.getClass().getMethod("getId");
                Object idVal = getId.invoke(created);
                if (idVal != null) {
                    return ResponseEntity.created(URI.create("/api/{{route}}/" + idVal)).body(created);
                }
            } catch (Exception ignored) {}

            return ResponseEntity.ok(created);
        } catch (com.npdev.runtime.support.GeneratedCrudRuntimeSupport.InvariantViolationException ex) {
            return ResponseEntity.status(ex.statusCode()).body(ex.toResponseBody());
        } catch (com.npdev.generated.services.{{entityName}}ServiceBase.UniqueViolation ex) {
            return ResponseEntity.status(409).body(ex.getMessage());
        } catch (IllegalArgumentException ex) {
            return ResponseEntity.badRequest().body(ex.getMessage());
        }
    }

    protected ResponseEntity<?> updateBase(UUID id, {{entityName}}UpdateRequest request) {
        try {
            Optional<{{entityName}}> updated = service.update(id, request);
            return updated.<ResponseEntity<?>>map(ResponseEntity::ok)
                    .orElseGet(() -> ResponseEntity.notFound().build());
        } catch (com.npdev.runtime.support.GeneratedCrudRuntimeSupport.InvariantViolationException ex) {
            return ResponseEntity.status(ex.statusCode()).body(ex.toResponseBody());
        } catch (com.npdev.generated.services.{{entityName}}ServiceBase.UniqueViolation ex) {
            return ResponseEntity.status(409).body(ex.getMessage());
        } catch (IllegalArgumentException ex) {
            return ResponseEntity.badRequest().body(ex.getMessage());
        }
    }

    protected ResponseEntity<?> deleteBase(UUID id) {
        try {
            boolean ok = service.delete(id);
            if (!ok) return ResponseEntity.notFound().build();
            return ResponseEntity.noContent().build();
        } catch (com.npdev.runtime.support.GeneratedCrudRuntimeSupport.InvariantViolationException ex) {
            return ResponseEntity.status(ex.statusCode()).body(ex.toResponseBody());
        } catch (IllegalArgumentException ex) {
            return ResponseEntity.badRequest().body(ex.getMessage());
        }
    }
