package {{apiPackage}};

import {{dtoPackage}}.CorrelationTimelineResponse;
import {{dtoPackage}}.EventQueryResponse;
import {{servicePackage}}.KernelFacade;
import {{servicePackage}}.RuntimeContextService;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;

@RestController
@RequestMapping({"/api/v1", "/api"})
public class EventQueryController {
    private final KernelFacade kernelFacade;
    private final RuntimeContextService runtimeContextService;

    public EventQueryController(KernelFacade kernelFacade, RuntimeContextService runtimeContextService) {
        this.kernelFacade = kernelFacade;
        this.runtimeContextService = runtimeContextService;
    }

    @GetMapping("/events/{eventId}")
    public ResponseEntity<EventQueryResponse> getEvent(
            @PathVariable String eventId,
            HttpServletRequest request
    ) {
        return kernelFacade.findEvent(eventId, runtimeContextService.currentContext(request))
                .map(EventQueryResponse::from)
                .map(ResponseEntity::ok)
                .orElseGet(() -> ResponseEntity.notFound().build());
    }

    @GetMapping("/events/by-correlation/{correlationId}")
    public List<EventQueryResponse> listByCorrelation(
            @PathVariable String correlationId,
            @RequestParam(required = false, defaultValue = "50") Integer limit,
            @RequestParam(required = false, defaultValue = "0") Integer offset,
            HttpServletRequest request
    ) {
        return kernelFacade.listEventsByCorrelation(
                        correlationId,
                        limit == null ? 50 : limit,
                        offset == null ? 0 : offset,
                        runtimeContextService.currentContext(request)
                ).stream()
                .map(EventQueryResponse::from)
                .toList();
    }

    @GetMapping("/events/by-name/{eventName}")
    public List<EventQueryResponse> listByEventName(
            @PathVariable String eventName,
            @RequestParam(required = false, defaultValue = "50") Integer limit,
            @RequestParam(required = false, defaultValue = "0") Integer offset,
            HttpServletRequest request
    ) {
        return kernelFacade.listEventsByName(
                        eventName,
                        limit == null ? 50 : limit,
                        offset == null ? 0 : offset,
                        runtimeContextService.currentContext(request)
                ).stream()
                .map(EventQueryResponse::from)
                .toList();
    }

    @GetMapping("/events")
    public List<EventQueryResponse> listEvents(
            @RequestParam(name = "type", required = false) String eventType,
            @RequestParam(name = "name", required = false) String eventName,
            @RequestParam(required = false, defaultValue = "50") Integer limit,
            @RequestParam(required = false, defaultValue = "0") Integer offset,
            HttpServletRequest request
    ) {
        String effectiveEventName = eventType != null && !eventType.isBlank() ? eventType : eventName;
        if (effectiveEventName == null || effectiveEventName.isBlank()) {
            return List.of();
        }
        return kernelFacade.listEventsByName(
                        effectiveEventName,
                        limit == null ? 50 : limit,
                        offset == null ? 0 : offset,
                        runtimeContextService.currentContext(request)
                ).stream()
                .map(EventQueryResponse::from)
                .toList();
    }

    @GetMapping("/correlations/{correlationId}/timeline")
    public CorrelationTimelineResponse timeline(
            @PathVariable String correlationId,
            @RequestParam(required = false, defaultValue = "50") Integer limit,
            @RequestParam(required = false, defaultValue = "0") Integer offset,
            HttpServletRequest request
    ) {
        return CorrelationTimelineResponse.from(
                kernelFacade.correlationTimeline(
                        correlationId,
                        limit == null ? 50 : limit,
                        offset == null ? 0 : offset,
                        runtimeContextService.currentContext(request)
                )
        );
    }
}
