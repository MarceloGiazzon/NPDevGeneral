<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reset password — {{appName}}</title>
<style>
  /* THM-8: every colour reads the shared --np-* theme variables when a theme is applied (npdev-display.js), and falls
     back to the page's own value otherwise, so an app with the default theme looks exactly as before. */
  :root {
    --bg: var(--np-bg, #f4f5f7); --card: var(--np-surface, #ffffff); --ink: var(--np-text, #1f2430); --muted: var(--np-text-muted, #6b7280);
    --accent: var(--np-accent, #2563eb); --accent-ink: var(--np-on-accent, #ffffff); --line: var(--np-border, #e2e5ea);
    --error: var(--np-negative, #b91c1c); --error-bg: #fef2f2; --ok: var(--np-positive, #15803d); --ok-bg: #f0fdf4;
  }
  html[data-np-theme-name] {
    --error-bg: color-mix(in srgb, var(--np-negative) 12%, var(--np-surface));
    --ok-bg: color-mix(in srgb, var(--np-positive) 12%, var(--np-surface));
  }
  html[data-np-theme-name] .tab { background: var(--bg); }
  html[data-np-theme-name] .oauth-button { background: var(--card); color: var(--ink); }
  html[data-np-theme-name] .oauth-button:hover { background: var(--bg); }
  html[data-np-theme-name] input { background: var(--card); color: var(--ink); }
  html[data-np-theme-name] input:focus { border-color: var(--accent); }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
         background: var(--bg); color: var(--ink);
         font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .card { width: 22rem; max-width: calc(100vw - 2rem); background: var(--card);
          border: 1px solid var(--line); border-radius: 10px; padding: 1.5rem 1.5rem 1.75rem;
          box-shadow: 0 6px 24px rgba(16, 24, 40, .07); }
  h1 { font-size: 1.15rem; margin: 0 0 1.1rem; font-weight: 600; }
  label { display: block; margin-bottom: .85rem; font-size: .85rem; color: var(--muted); }
  input { width: 100%; margin-top: .3rem; padding: .55rem .6rem; border: 1px solid var(--line);
          border-radius: 7px; font-size: .95rem; }
  input:focus { outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); border-color: var(--accent); }
  .primary { width: 100%; padding: .6rem; border: 0; border-radius: 7px; background: var(--accent);
             color: var(--accent-ink); font-size: .95rem; cursor: pointer; }
  .primary:hover { filter: brightness(1.05); }
  .primary:disabled { opacity: .6; cursor: not-allowed; }
  .note { font-size: .85rem; color: var(--muted); margin: 0 0 1rem; line-height: 1.45; }
  .note a { color: var(--accent); }
  .banner { margin-top: 1rem; padding: .6rem .7rem; border-radius: 7px; font-size: .85rem; line-height: 1.4; }
  .banner.error { background: var(--error-bg); color: var(--error); }
  .banner.ok { background: var(--ok-bg); color: var(--ok); }
  .hidden { display: none; }
  .pw-tools { display: flex; justify-content: space-between; align-items: center; gap: .5rem;
              margin: -.55rem 0 .85rem; min-height: 1.75rem; }
  .pw-caps { font-size: .8rem; color: var(--error); }
  .pw-toggle { margin-left: auto; background: none; border: 0; padding: .25rem .45rem; border-radius: 5px;
               color: var(--accent); font-size: .85rem; cursor: pointer; min-height: 1.75rem; }
  .pw-toggle:hover { text-decoration: underline; }
  .pw-toggle:focus-visible { outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); }
  button[aria-busy="true"] { cursor: progress; }
</style>
<script src="/npdev-i18n.js"></script>
<script>NPDevI18n.use({{{i18nJson}}});</script>
<script src="/npdev-display.js"></script>
<script>if (window.NPDevDisplay) { NPDevDisplay.boot(); }</script>
</head>
<body data-app-name="{{appName}}">
<main class="card">
  <h1 data-i18n="pages.reset.heading">Reset password</h1>

  <section id="requestPane">
    <p class="note" data-i18n="pages.reset.requestNote">Enter your username. If your account has an email on file, we send a link that lets you choose a new password.</p>
    <form id="requestForm" autocomplete="on">
      <label><span data-i18n="pages.reset.username">Username</span>
        <input id="username" name="username" autocomplete="username" required>
      </label>
      <button class="primary" id="requestBtn" type="submit" data-i18n="pages.reset.sendResetLink">Send reset link</button>
    </form>
    <p id="requestSent" class="banner ok hidden" data-i18n="pages.reset.requestSent">If that account exists and has an email on file, a reset link is on its way. If you have no email on file, ask your administrator.</p>
    <p class="note" style="margin-top:1rem"><a href="#" id="haveCode" data-i18n="pages.reset.haveCode">I have a code</a> &middot; <a href="/login.html" data-i18n="pages.reset.backToSignIn">Back to sign in</a></p>
  </section>

  <section id="confirmPane" class="hidden">
    <p class="note" data-i18n="pages.reset.confirmNote">Choose a new password for your account.</p>
    <form id="confirmForm" autocomplete="off">
      <label id="codeLabel"><span data-i18n="pages.reset.code">Code</span>
        <input id="code" name="code" autocomplete="off" required>
      </label>
      <label><span data-i18n="pages.reset.newPassword">New password</span>
        <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="8" required>
      </label>
      <label><span data-i18n="pages.reset.confirmNewPassword">Confirm new password</span>
        <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required>
      </label>
      <button class="primary" id="confirmBtn" type="submit" data-i18n="pages.reset.setNewPassword">Set new password</button>
    </form>
    <p class="note" style="margin-top:1rem"><a href="/login.html" data-i18n="pages.reset.backToSignIn">Back to sign in</a></p>
  </section>

  <p id="errorBanner" class="banner error hidden"></p>
  <p id="okBanner" class="banner ok hidden"></p>
</main>

<script>
(function () {
  "use strict";
  // REG-349: the page's static text is translated once the DOM is ready; dynamic messages call NPDevI18n.t directly.
  document.addEventListener("DOMContentLoaded", function () { NPDevI18n.apply(document); });
  document.title = NPDevI18n.t("pages.reset.title", "Reset password — {appName}", { appName: document.body.getAttribute("data-app-name") });
  var params = new URLSearchParams(window.location.search);
  var urlToken = params.get("token");

  var requestPane = document.getElementById("requestPane");
  var confirmPane = document.getElementById("confirmPane");
  var errorBanner = document.getElementById("errorBanner");
  var okBanner = document.getElementById("okBanner");
  var requestSent = document.getElementById("requestSent");
  // UX: show-password toggle + Caps Lock hint for every password input, and an in-flight guard.
  var PW_SHOW = NPDevI18n.t("pages.password.show", "Show"), PW_HIDE = NPDevI18n.t("pages.password.hide", "Hide"),
      PW_CAPS = NPDevI18n.t("pages.password.capsLockOn", "Caps Lock is on");
  function enhancePasswordField(input) {
    var anchor = input.closest("label") || input;
    var row = document.createElement("div");
    row.className = "pw-tools";
    var hint = document.createElement("span");
    hint.className = "pw-caps";
    hint.id = input.id + "Caps";
    hint.setAttribute("aria-live", "polite");
    var toggle = document.createElement("button");
    toggle.type = "button";
    toggle.className = "pw-toggle";
    toggle.id = input.id + "Toggle";
    toggle.setAttribute("aria-controls", input.id);
    toggle.setAttribute("aria-pressed", "false");
    toggle.textContent = PW_SHOW;
    toggle.addEventListener("click", function () {
      var reveal = input.type === "password";
      input.type = reveal ? "text" : "password";
      toggle.textContent = reveal ? PW_HIDE : PW_SHOW;
      toggle.setAttribute("aria-pressed", String(reveal));
    });
    function capsCheck(ev) {
      var on = !!(ev.getModifierState && ev.getModifierState("CapsLock"));
      hint.textContent = on ? PW_CAPS : "";
    }
    input.addEventListener("keydown", capsCheck);
    input.addEventListener("keyup", capsCheck);
    input.addEventListener("blur", function () { hint.textContent = ""; });
    input.setAttribute("aria-describedby", hint.id);
    row.appendChild(hint);
    row.appendChild(toggle);
    anchor.parentNode.insertBefore(row, anchor.nextSibling);
  }
  Array.prototype.forEach.call(document.querySelectorAll('input[type="password"]'), enhancePasswordField);

  // Double-submit guard: disable + aria-busy + busy label while a request is in flight.
  function setBusy(btn, busy, busyText) {
    if (busy) {
      btn.setAttribute("data-label", btn.textContent);
      btn.textContent = busyText;
      btn.disabled = true;
      btn.setAttribute("aria-busy", "true");
    } else {
      btn.textContent = btn.getAttribute("data-label") || btn.textContent;
      btn.disabled = false;
      btn.removeAttribute("aria-busy");
    }
  }


  var MESSAGES = {
    invalid_request: NPDevI18n.t("pages.reset.errInvalidRequest", "Fill in the code and a new password."),
    invalid_or_expired_token: NPDevI18n.t("pages.reset.errInvalidOrExpiredToken", "This code is invalid, already used or expired. Request a new reset link."),
    identity_pack_not_composed: NPDevI18n.t("pages.reset.errIdentityPackNotComposed", "This application has no sign-in configured."),
    password_too_long: NPDevI18n.t("pages.reset.errPasswordTooLong", "The new password is too long (256 characters at most)."),
    password_too_common: NPDevI18n.t("pages.reset.errPasswordTooCommon", "That password is too common. Choose another one."),
    password_matches_username: NPDevI18n.t("pages.reset.errPasswordMatchesUsername", "The password cannot be the same as the username.")
  };
  function showError(code, minLength) {
    var message = code === "password_too_short"
      ? NPDevI18n.t("pages.reset.errPasswordTooShort", "The new password must have at least {min} characters.", { min: String(minLength || 8) })
      : MESSAGES[code] || NPDevI18n.t("pages.reset.errResetFailed", "Could not reset the password ({code}).", { code: code });
    errorBanner.textContent = message;
    errorBanner.classList.remove("hidden");
    okBanner.classList.add("hidden");
  }
  function clearBanners() {
    errorBanner.classList.add("hidden");
    okBanner.classList.add("hidden");
  }
  function showConfirmPane() {
    requestPane.classList.add("hidden");
    confirmPane.classList.remove("hidden");
    clearBanners();
  }
  function postJson(path, body) {
    return fetch(path, {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-NPDev-Request": "1" },
      body: JSON.stringify(body)
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (b) { return { status: r.status, body: b }; });
    });
  }

  if (urlToken) {
    document.getElementById("code").value = urlToken;
    document.getElementById("codeLabel").classList.add("hidden");
    showConfirmPane();
    // SEC-6: an invitation link (?invite=1) is the same one-time token with welcome wording.
    // SEC-14: a self-signup link (?signup=1) is the same token with account-creation wording.
    // The wording replaces text that NPDevI18n.apply translates on DOMContentLoaded, so it must run after that listener.
    document.addEventListener("DOMContentLoaded", function () {
      if (params.get("signup") === "1") {
        document.querySelector("h1").textContent = NPDevI18n.t("pages.reset.signupHeading", "Finish creating your account");
        document.querySelector("#confirmPane .note").textContent = NPDevI18n.t("pages.reset.signupNote", "Choose a password to finish creating your account.");
        document.getElementById("confirmBtn").textContent = NPDevI18n.t("pages.reset.createAccount", "Create account");
      }
      if (params.get("invite") === "1") {
        document.querySelector("h1").textContent = NPDevI18n.t("pages.reset.inviteHeading", "Welcome - set your password");
        document.querySelector("#confirmPane .note").textContent = NPDevI18n.t("pages.reset.inviteNote", "You have been invited. Choose a password to activate your account.");
        document.getElementById("confirmBtn").textContent = NPDevI18n.t("pages.reset.setPassword", "Set password");
      }
    });
  }

  document.getElementById("haveCode").addEventListener("click", function (ev) {
    ev.preventDefault();
    showConfirmPane();
  });

  document.getElementById("requestForm").addEventListener("submit", function (ev) {
    ev.preventDefault();
    clearBanners();
    requestSent.classList.add("hidden");
    var username = document.getElementById("username").value.trim();
    if (!username) { return; }
    var btn = document.getElementById("requestBtn");
    if (btn.disabled) { return; }
    setBusy(btn, true, NPDevI18n.t("pages.reset.sending", "Sending\u2026"));
    postJson("/api/auth/password-reset/request", { username: username }).then(function () {
      // The server answers identically whether or not the account exists; so does this page.
      requestSent.classList.remove("hidden");
    }).catch(function () {
      requestSent.classList.remove("hidden");
    }).then(function () { setBusy(btn, false); });
  });

  document.getElementById("confirmForm").addEventListener("submit", function (ev) {
    ev.preventDefault();
    clearBanners();
    var code = document.getElementById("code").value.trim();
    var newPassword = document.getElementById("newPassword").value;
    var confirmPassword = document.getElementById("confirmPassword").value;
    if (!code || !newPassword) { return; }
    if (newPassword !== confirmPassword) {
      errorBanner.textContent = NPDevI18n.t("pages.reset.passwordsDoNotMatch", "The new passwords do not match.");
      errorBanner.classList.remove("hidden");
      return;
    }
    var btn = document.getElementById("confirmBtn");
    if (btn.disabled) { return; }
    setBusy(btn, true, NPDevI18n.t("pages.reset.saving", "Saving\u2026"));
    postJson("/api/auth/password-reset/confirm", { token: code, newPassword: newPassword }).then(function (res) {
      if (res.status === 200 && res.body && res.body.ok) {
        document.getElementById("confirmForm").classList.add("hidden");
        okBanner.innerHTML = NPDevI18n.t("pages.reset.passwordChanged", "Password changed. You can now <a href='/login.html'>sign in</a> with the new password.");
        okBanner.classList.remove("hidden");
      } else {
        showError(res.body && res.body.error ? res.body.error : "password_reset_failed", res.body && res.body.minLength);
      }
    }).catch(function () {
      showError("password_reset_failed");
    }).then(function () { setBusy(btn, false); });
  });
})();
</script>
</body>
</html>
