<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reset password — {{appName}}</title>
<style>
  :root {
    --bg: #f4f5f7; --card: #ffffff; --ink: #1f2430; --muted: #6b7280;
    --accent: #2563eb; --accent-ink: #ffffff; --line: #e2e5ea;
    --error: #b91c1c; --error-bg: #fef2f2; --ok: #15803d; --ok-bg: #f0fdf4;
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
         background: var(--bg); color: var(--ink);
         font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .card { width: 22rem; max-width: calc(100vw - 2rem); background: var(--card);
          border: 1px solid var(--line); border-radius: 10px; padding: 1.5rem 1.5rem 1.75rem;
          box-shadow: 0 6px 24px rgba(16, 24, 40, .07); }
  h1 { font-size: 1.15rem; margin: 0 0 1.1rem; font-weight: 600; }
  label { display: block; margin-bottom: .85rem; font-size: .85rem; color: var(--muted); }
  input { width: 100%; margin-top: .3rem; padding: .55rem .6rem; border: 1px solid var(--line);
          border-radius: 7px; font-size: .95rem; }
  input:focus { outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); border-color: var(--accent); }
  .primary { width: 100%; padding: .6rem; border: 0; border-radius: 7px; background: var(--accent);
             color: var(--accent-ink); font-size: .95rem; cursor: pointer; }
  .primary:hover { filter: brightness(1.05); }
  .primary:disabled { opacity: .6; cursor: not-allowed; }
  .note { font-size: .85rem; color: var(--muted); margin: 0 0 1rem; line-height: 1.45; }
  .note a { color: var(--accent); }
  .banner { margin-top: 1rem; padding: .6rem .7rem; border-radius: 7px; font-size: .85rem; line-height: 1.4; }
  .banner.error { background: var(--error-bg); color: var(--error); }
  .banner.ok { background: var(--ok-bg); color: var(--ok); }
  .hidden { display: none; }
</style>
</head>
<body>
<main class="card">
  <h1>Reset password</h1>

  <section id="requestPane">
    <p class="note">Enter your username. If your account has an email on file, we send a link that lets you choose a new password.</p>
    <form id="requestForm" autocomplete="on">
      <label>Username
        <input id="username" name="username" autocomplete="username" required>
      </label>
      <button class="primary" id="requestBtn" type="submit">Send reset link</button>
    </form>
    <p id="requestSent" class="banner ok hidden">If that account exists and has an email on file, a reset link is on its way. If you have no email on file, ask your administrator.</p>
    <p class="note" style="margin-top:1rem"><a href="#" id="haveCode">I have a code</a> &middot; <a href="/login.html">Back to sign in</a></p>
  </section>

  <section id="confirmPane" class="hidden">
    <p class="note">Choose a new password for your account.</p>
    <form id="confirmForm" autocomplete="off">
      <label id="codeLabel">Code
        <input id="code" name="code" autocomplete="off" required>
      </label>
      <label>New password
        <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="8" required>
      </label>
      <label>Confirm new password
        <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required>
      </label>
      <button class="primary" id="confirmBtn" type="submit">Set new password</button>
    </form>
    <p class="note" style="margin-top:1rem"><a href="/login.html">Back to sign in</a></p>
  </section>

  <p id="errorBanner" class="banner error hidden"></p>
  <p id="okBanner" class="banner ok hidden"></p>
</main>

<script>
(function () {
  "use strict";
  var params = new URLSearchParams(window.location.search);
  var urlToken = params.get("token");

  var requestPane = document.getElementById("requestPane");
  var confirmPane = document.getElementById("confirmPane");
  var errorBanner = document.getElementById("errorBanner");
  var okBanner = document.getElementById("okBanner");
  var requestSent = document.getElementById("requestSent");

  var MESSAGES = {
    invalid_request: "Fill in the code and a new password.",
    invalid_or_expired_token: "This code is invalid, already used or expired. Request a new reset link.",
    identity_pack_not_composed: "This application has no sign-in configured.",
    password_too_short: "The new password must have at least %MIN% characters.",
    password_too_long: "The new password is too long (256 characters at most).",
    password_too_common: "That password is too common. Choose another one.",
    password_matches_username: "The password cannot be the same as the username."
  };
  function showError(code, minLength) {
    var message = MESSAGES[code] || "Could not reset the password (" + code + ").";
    errorBanner.textContent = message.replace("%MIN%", String(minLength || 8));
    errorBanner.classList.remove("hidden");
    okBanner.classList.add("hidden");
  }
  function clearBanners() {
    errorBanner.classList.add("hidden");
    okBanner.classList.add("hidden");
  }
  function showConfirmPane() {
    requestPane.classList.add("hidden");
    confirmPane.classList.remove("hidden");
    clearBanners();
  }
  function postJson(path, body) {
    return fetch(path, {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-NPDev-Request": "1" },
      body: JSON.stringify(body)
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (b) { return { status: r.status, body: b }; });
    });
  }

  if (urlToken) {
    document.getElementById("code").value = urlToken;
    document.getElementById("codeLabel").classList.add("hidden");
    showConfirmPane();
    // SEC-6: an invitation link (?invite=1) is the same one-time token with welcome wording.
    // SEC-14: a self-signup link (?signup=1) is the same token with account-creation wording.
    if (params.get("signup") === "1") {
      document.querySelector("h1").textContent = "Finish creating your account";
      document.querySelector("#confirmPane .note").textContent = "Choose a password to finish creating your account.";
      document.getElementById("confirmBtn").textContent = "Create account";
    }
    if (params.get("invite") === "1") {
      document.querySelector("h1").textContent = "Welcome - set your password";
      document.querySelector("#confirmPane .note").textContent = "You have been invited. Choose a password to activate your account.";
      document.getElementById("confirmBtn").textContent = "Set password";
    }
  }

  document.getElementById("haveCode").addEventListener("click", function (ev) {
    ev.preventDefault();
    showConfirmPane();
  });

  document.getElementById("requestForm").addEventListener("submit", function (ev) {
    ev.preventDefault();
    clearBanners();
    requestSent.classList.add("hidden");
    var username = document.getElementById("username").value.trim();
    if (!username) { return; }
    var btn = document.getElementById("requestBtn");
    btn.disabled = true;
    postJson("/api/auth/password-reset/request", { username: username }).then(function () {
      // The server answers identically whether or not the account exists; so does this page.
      btn.disabled = false;
      requestSent.classList.remove("hidden");
    }).catch(function () {
      btn.disabled = false;
      requestSent.classList.remove("hidden");
    });
  });

  document.getElementById("confirmForm").addEventListener("submit", function (ev) {
    ev.preventDefault();
    clearBanners();
    var code = document.getElementById("code").value.trim();
    var newPassword = document.getElementById("newPassword").value;
    var confirmPassword = document.getElementById("confirmPassword").value;
    if (!code || !newPassword) { return; }
    if (newPassword !== confirmPassword) {
      errorBanner.textContent = "The new passwords do not match.";
      errorBanner.classList.remove("hidden");
      return;
    }
    var btn = document.getElementById("confirmBtn");
    btn.disabled = true;
    postJson("/api/auth/password-reset/confirm", { token: code, newPassword: newPassword }).then(function (res) {
      btn.disabled = false;
      if (res.status === 200 && res.body && res.body.ok) {
        document.getElementById("confirmForm").classList.add("hidden");
        okBanner.innerHTML = "Password changed. You can now <a href=\"/login.html\">sign in</a> with the new password.";
        okBanner.classList.remove("hidden");
      } else {
        showError(res.body && res.body.error ? res.body.error : "password_reset_failed", res.body && res.body.minLength);
      }
    }).catch(function () {
      btn.disabled = false;
      showError("password_reset_failed");
    });
  });
})();
</script>
</body>
</html>
