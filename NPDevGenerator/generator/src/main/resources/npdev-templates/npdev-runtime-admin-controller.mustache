@RestController
@RequestMapping({"/api/v1/admin", "/api/admin"})
public class AdminController {
    private static final ObjectMapper UI_MODEL_MAPPER = new ObjectMapper();
    private static volatile JsonNode MODEL_EDITOR_DRAFT = null;
    private static volatile JsonNode RULE_EDITOR_DRAFT = null;
    private static volatile JsonNode ORCHESTRATION_EDITOR_DRAFT = null;

    private final KernelFacade kernelFacade;
    private final RuntimeContextService runtimeContextService;
    private final NPDevModelProvider modelProvider;

    public AdminController(KernelFacade kernelFacade, RuntimeContextService runtimeContextService, NPDevModelProvider modelProvider) {
        this.kernelFacade = kernelFacade;
        this.runtimeContextService = runtimeContextService;
        this.modelProvider = modelProvider;
    }

    @GetMapping("/failures/recent")
    public List<ExecutionSummaryResponse> listRecentFailures(
            @RequestParam(required = false, defaultValue = "50") Integer limit,
            @RequestParam(required = false, defaultValue = "0") Integer offset,
            HttpServletRequest request
    ) {
        return kernelFacade.listRecentFailureExecutions(
                        limit == null ? 50 : limit,
                        offset == null ? 0 : offset,
                        runtimeContextService.currentContext(request)
                ).stream()
                .map(ExecutionSummaryResponse::from)
                .toList();
    }

    @GetMapping("/stuck/recent")
    public List<ExecutionSummaryResponse> listRecentStuck(
            @RequestParam(required = false, defaultValue = "50") Integer limit,
            @RequestParam(required = false, defaultValue = "0") Integer offset,
            HttpServletRequest request
    ) {
        return kernelFacade.listRecentStuckExecutions(
                        limit == null ? 50 : limit,
                        offset == null ? 0 : offset,
                        runtimeContextService.currentContext(request)
                ).stream()
                .map(ExecutionSummaryResponse::from)
                .toList();
    }

    @GetMapping("/circuits")
    public List<AdminCircuitResponse> listCircuits(
            @RequestParam(required = false) String capability,
            @RequestParam(required = false) String operation,
            @RequestParam(required = false, defaultValue = "50") Integer limit,
            @RequestParam(required = false, defaultValue = "0") Integer offset,
            HttpServletRequest request
    ) {
        return kernelFacade.listCircuitStates(
                        capability,
                        operation,
                        limit == null ? 50 : limit,
                        offset == null ? 0 : offset,
                        runtimeContextService.currentContext(request)
                ).stream()
                .map(AdminCircuitResponse::from)
                .toList();
    }

    @GetMapping("/idempotency")
    public ResponseEntity<AdminIdempotencyResponse> getIdempotency(
            @RequestParam("key") String idempotencyKey,
            @RequestParam("capability") String capability,
            @RequestParam("operation") String operation,
            HttpServletRequest request
    ) {
        return kernelFacade.findIdempotencyRecord(
                        idempotencyKey,
                        capability,
                        operation,
                        runtimeContextService.currentContext(request)
                )
                .map(AdminIdempotencyResponse::from)
                .map(ResponseEntity::ok)
                .orElseGet(() -> ResponseEntity.notFound().build());
    }

    @PostMapping("/executions/{executionId}/resume")
    public ResponseEntity<FlowExecutionResponse> resumeExecutionAsAdmin(
            @PathVariable String executionId,
            HttpServletRequest request
    ) {
        requireAdminContext(request);
        ExecutionResult result = kernelFacade.resumeExecution(
                executionId,
                runtimeContextService.currentContext(request)
        );
        return ResponseEntity.status(mapStatus(result.getStatus())).body(FlowExecutionResponse.from(result));
    }

    @GetMapping(value = "/model/export", produces = MediaType.APPLICATION_JSON_VALUE)
    public ResponseEntity<String> exportModel(HttpServletRequest request) {
        requireAdminContext(request);
        ClassPathResource resource = new ClassPathResource("npdev/model.json");
        if (!resource.exists()) {
            return ResponseEntity.notFound().build();
        }
        try (InputStream inputStream = resource.getInputStream()) {
            String body = new String(inputStream.readAllBytes(), StandardCharsets.UTF_8);
            return ResponseEntity.ok().contentType(MediaType.APPLICATION_JSON).body(body);
        } catch (IOException exception) {
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "model_export_failed", exception);
        }
    }

    @GetMapping(value = {"/model/ui", "/ui-model"}, produces = MediaType.APPLICATION_JSON_VALUE)
    public ResponseEntity<String> exportUiModel(HttpServletRequest request) {
        requireAdminContext(request);
        ClassPathResource resource = new ClassPathResource("npdev/model.json");
        if (!resource.exists()) {
            return ResponseEntity.notFound().build();
        }
        try (InputStream inputStream = resource.getInputStream()) {
            String body = new String(inputStream.readAllBytes(), StandardCharsets.UTF_8);
            return ResponseEntity.ok().contentType(MediaType.APPLICATION_JSON).body(buildUiModelProjectionSafe(body));
        } catch (IOException exception) {
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "ui_model_export_failed", exception);
        }
    }




    @GetMapping(value = {"/model/editor/draft"}, produces = MediaType.APPLICATION_JSON_VALUE)
    public ResponseEntity<String> getModelEditorDraft(HttpServletRequest request) {
        requireAdminContext(request);
        return readDraftOrModel(MODEL_EDITOR_DRAFT, DraftKind.MODEL);
    }

    @PostMapping(value = {"/model/editor/draft"}, consumes = MediaType.APPLICATION_JSON_VALUE, produces = MediaType.APPLICATION_JSON_VALUE)
    public ResponseEntity<String> saveModelEditorDraft(@RequestBody String draftJson, HttpServletRequest request) {
        requireAdminContext(request);
        return saveDraft(draftJson, DraftKind.MODEL);
    }

    @DeleteMapping(value = {"/model/editor/draft"})
    public ResponseEntity<Void> resetModelEditorDraft(HttpServletRequest request) {
        requireAdminContext(request);
        MODEL_EDITOR_DRAFT = null;
        return ResponseEntity.noContent().build();
    }

    @GetMapping(value = {"/model/rules/draft"}, produces = MediaType.APPLICATION_JSON_VALUE)
    public ResponseEntity<String> getRuleEditorDraft(HttpServletRequest request) {
        requireAdminContext(request);
        return readDraftOrModel(RULE_EDITOR_DRAFT, DraftKind.RULES);
    }

    @PostMapping(value = {"/model/rules/draft"}, consumes = MediaType.APPLICATION_JSON_VALUE, produces = MediaType.APPLICATION_JSON_VALUE)
    public ResponseEntity<String> saveRuleEditorDraft(@RequestBody String draftJson, HttpServletRequest request) {
        requireAdminContext(request);
        return saveDraft(draftJson, DraftKind.RULES);
    }

    @DeleteMapping(value = {"/model/rules/draft"})
    public ResponseEntity<Void> resetRuleEditorDraft(HttpServletRequest request) {
        requireAdminContext(request);
        RULE_EDITOR_DRAFT = null;
        return ResponseEntity.noContent().build();
    }

    @GetMapping(value = {"/model/orchestration/draft"}, produces = MediaType.APPLICATION_JSON_VALUE)
    public ResponseEntity<String> getOrchestrationEditorDraft(HttpServletRequest request) {
        requireAdminContext(request);
        return readDraftOrModel(ORCHESTRATION_EDITOR_DRAFT, DraftKind.ORCHESTRATION);
    }

    @PostMapping(value = {"/model/orchestration/draft"}, consumes = MediaType.APPLICATION_JSON_VALUE, produces = MediaType.APPLICATION_JSON_VALUE)
    public ResponseEntity<String> saveOrchestrationEditorDraft(@RequestBody String draftJson, HttpServletRequest request) {
        requireAdminContext(request);
        return saveDraft(draftJson, DraftKind.ORCHESTRATION);
    }

    @DeleteMapping(value = {"/model/orchestration/draft"})
    public ResponseEntity<Void> resetOrchestrationEditorDraft(HttpServletRequest request) {
        requireAdminContext(request);
        ORCHESTRATION_EDITOR_DRAFT = null;
        return ResponseEntity.noContent().build();
    }

    private enum DraftKind {
        MODEL,
        RULES,
        ORCHESTRATION
    }

    private ResponseEntity<String> saveDraft(String draftJson, DraftKind draftKind) {
        try {
            JsonNode parsed = UI_MODEL_MAPPER.readTree(draftJson);
            switch (draftKind) {
                case MODEL -> MODEL_EDITOR_DRAFT = parsed;
                case RULES -> RULE_EDITOR_DRAFT = parsed;
                case ORCHESTRATION -> ORCHESTRATION_EDITOR_DRAFT = parsed;
            }
            return ResponseEntity.ok().contentType(MediaType.APPLICATION_JSON)
                    .body(UI_MODEL_MAPPER.writerWithDefaultPrettyPrinter().writeValueAsString(parsed));
        } catch (IOException exception) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "draft_invalid_json", exception);
        }
    }

    /**
     * REG-139 root cause: on a fresh JVM start the draft field is null (a plain static, never
     * persisted), and this used to fall back to classpath resource {@code npdev/model.json} --
     * returned VERBATIM, as if a compiled model ({@code $schema}/{@code namespace}/{@code concepts}/
     * {@code procedures}/{@code panels}) were interchangeable with a draft ({@code namespace}/
     * {@code version}/{@code entities}). The two shapes share only {@code namespace}, so the model
     * editor's {@code draft.entities.find(...)} threw on undefined before the shell even painted.
     * (That classpath resource can ALSO be RuntimeHost's own unreplaced template placeholder rather
     * than this app's real model, depending on how generation resolved the model source --
     * {@code modelProvider}'s compiled-model.json is unconditionally written and is this app's one
     * reliable source of truth, so it is used here instead of re-reading that resource.)
     */
    private ResponseEntity<String> readDraftOrModel(JsonNode draft, DraftKind draftKind) {
        if (draft != null) {
            try {
                return ResponseEntity.ok().contentType(MediaType.APPLICATION_JSON)
                        .body(UI_MODEL_MAPPER.writerWithDefaultPrettyPrinter().writeValueAsString(draft));
            } catch (IOException exception) {
                throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "draft_serialize_failed", exception);
            }
        }
        try {
            return ResponseEntity.ok().contentType(MediaType.APPLICATION_JSON).body(buildEmptyDraft(draftKind));
        } catch (IOException exception) {
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "draft_load_failed", exception);
        }
    }

    /**
     * No draft has been saved yet -- a genuinely empty draft of the CORRECT, panel-specific shape is
     * the truthful response (each of the three panels expects a different shape: the model/rule
     * editors key their draft on {@code entities[]}, the orchestration editor on
     * {@code triggerRules}/{@code actionRules}/{@code scheduleRules}). Namespace/version are read
     * from the app's own compiled model so the empty draft still identifies the right app --
     * everything else stays empty rather than attempting to project compiled-model concepts into
     * draft-shaped entities, since that projection is not a genuine equivalence (REG-139: "a
     * differently wrong draft is not an improvement").
     */
    private String buildEmptyDraft(DraftKind draftKind) throws IOException {
        CompiledModel compiledModel = modelProvider.compiledModel();
        ObjectNode node = UI_MODEL_MAPPER.createObjectNode();
        switch (draftKind) {
            case MODEL -> {
                node.put("namespace", compiledModel.getNamespace());
                node.put("dslVersion", compiledModel.getDslVersion());
                node.put("version", compiledModel.getVersion());
                node.set("entities", UI_MODEL_MAPPER.createArrayNode());
            }
            case RULES -> {
                node.put("namespace", compiledModel.getNamespace());
                node.put("version", compiledModel.getVersion());
                node.set("entities", UI_MODEL_MAPPER.createArrayNode());
            }
            case ORCHESTRATION -> {
                node.put("name", "");
                node.set("triggerRules", UI_MODEL_MAPPER.createArrayNode());
                node.set("actionRules", UI_MODEL_MAPPER.createArrayNode());
                node.set("scheduleRules", UI_MODEL_MAPPER.createArrayNode());
            }
        }
        return UI_MODEL_MAPPER.writerWithDefaultPrettyPrinter().writeValueAsString(node);
    }

    private static String buildUiModelProjectionSafe(String modelJson) {
        try {
            return buildUiModelProjection(modelJson);
        } catch (Exception exception) {
            try {
                return buildEmptyUiModelProjection(modelJson);
            } catch (Exception fallbackException) {
                throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "ui_model_export_failed", exception);
            }
        }
    }

    private static String buildUiModelProjection(String modelJson) throws IOException {
        JsonNode root = UI_MODEL_MAPPER.readTree(stripUtf8Bom(modelJson));
        ObjectNode projection = UI_MODEL_MAPPER.createObjectNode();
        copyText(root, projection, "namespace");
        copyText(root, projection, "dslVersion");
        copyText(root, projection, "version");

        ArrayNode concepts = UI_MODEL_MAPPER.createArrayNode();
        JsonNode conceptNodes = root.path("concepts");
        if (conceptNodes.isArray()) {
            for (JsonNode concept : conceptNodes) {
                ArrayNode fields = UI_MODEL_MAPPER.createArrayNode();
                JsonNode conceptFields = concept.path("fields");
                if (conceptFields.isArray()) {
                    for (JsonNode field : conceptFields) {
                        JsonNode uiNode = field.get("ui");
                        if (uiNode == null || !uiNode.isObject() || uiNode.size() == 0) {
                            continue;
                        }
                        ObjectNode fieldNode = UI_MODEL_MAPPER.createObjectNode();
                        copyText(field, fieldNode, "name");
                        copyText(field, fieldNode, "type");
                        JsonNode enumValues = field.get("enumValues");
                        if (enumValues != null && enumValues.isArray()) {
                            fieldNode.set("enumValues", enumValues.deepCopy());
                        }

                        ObjectNode uiOut = UI_MODEL_MAPPER.createObjectNode();
                        copyText(uiNode, uiOut, "label");
                        copyText(uiNode, uiOut, "placeholder");
                        copyText(uiNode, uiOut, "helpText");
                        copyText(uiNode, uiOut, "widget");
                        copyText(uiNode, uiOut, "group");
                        copyText(uiNode, uiOut, "section");
                        copyInt(uiNode, uiOut, "order");
                        fieldNode.set("ui", uiOut);
                        fields.add(fieldNode);
                    }
                }

                if (fields.size() == 0) {
                    continue;
                }
                ObjectNode conceptNode = UI_MODEL_MAPPER.createObjectNode();
                copyText(concept, conceptNode, "name");
                conceptNode.set("fields", fields);
                concepts.add(conceptNode);
            }
        }

        projection.set("concepts", concepts);
        return UI_MODEL_MAPPER.writerWithDefaultPrettyPrinter().writeValueAsString(projection);
    }


    private static String buildEmptyUiModelProjection(String modelJson) throws IOException {
        JsonNode root = UI_MODEL_MAPPER.readTree(stripUtf8Bom(modelJson));
        ObjectNode projection = UI_MODEL_MAPPER.createObjectNode();
        copyText(root, projection, "namespace");
        copyText(root, projection, "dslVersion");
        copyText(root, projection, "version");
        projection.set("concepts", UI_MODEL_MAPPER.createArrayNode());
        return UI_MODEL_MAPPER.writerWithDefaultPrettyPrinter().writeValueAsString(projection);
    }

    private static String stripUtf8Bom(String value) {
        if (value == null || value.isEmpty()) {
            return value;
        }
        if (value.charAt(0) == '﻿') {
            return value.substring(1);
        }
        return value;
    }


    private static Properties loadBuildInfo() {
        Properties properties = new Properties();
        ClassPathResource resource = new ClassPathResource("npdev-build-info.properties");
        if (!resource.exists()) {
            return properties;
        }
        try (InputStream inputStream = resource.getInputStream()) {
            properties.load(inputStream);
            return properties;
        } catch (IOException exception) {
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "build_info_load_failed", exception);
        }
    }

    private static void copyText(JsonNode source, ObjectNode target, String field) {
        if (source == null || target == null || field == null || field.isBlank()) {
            return;
        }
        JsonNode value = source.get(field);
        if (value != null && value.isTextual()) {
            target.put(field, value.asText());
        }
    }

    private static void copyInt(JsonNode source, ObjectNode target, String field) {
        if (source == null || target == null || field == null || field.isBlank()) {
            return;
        }
        JsonNode value = source.get(field);
        if (value != null && value.isNumber()) {
            target.put(field, value.asInt());
        }
    }

    private void requireAdminContext(HttpServletRequest request) {
        ExecutionContext context = runtimeContextService.currentContext(request);
        if (!context.hasRole("ADMIN")) {
            throw new ResponseStatusException(HttpStatus.FORBIDDEN, "forbidden");
        }
    }

    private static HttpStatus mapStatus(ExecutionStatus status) {
        if (status == null) {
            return HttpStatus.INTERNAL_SERVER_ERROR;
        }
        return switch (status) {
            case OK -> HttpStatus.OK;
            case WAITING_EVENT -> HttpStatus.ACCEPTED;
            case INPUT_VALIDATION_FAILED, INVARIANT_FAILED, CAPABILITY_FAILED, EVENT_PERSIST_FAILED, EVENT_PAYLOAD_INVALID, FAILED -> HttpStatus.UNPROCESSABLE_ENTITY;
        };
    }
}

