package {{apiPackage}};

import {{dtoPackage}}.TraceSummaryResponse;
import {{servicePackage}}.KernelFacade;
import {{servicePackage}}.RuntimeContextService;
import com.npdev.kernel.ExecutionContext;
import com.npdev.kernel.ports.TraceQuery;
import com.npdev.kernel.trace.FlowTrace;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;

@RestController
@RequestMapping({"/api/v1/traces", "/api/traces"})
public class TraceController {
    private final KernelFacade kernelFacade;
    private final RuntimeContextService runtimeContextService;

    public TraceController(KernelFacade kernelFacade, RuntimeContextService runtimeContextService) {
        this.kernelFacade = kernelFacade;
        this.runtimeContextService = runtimeContextService;
    }

    @GetMapping("/{executionId}")
    public ResponseEntity<FlowTrace> getTrace(
            @PathVariable String executionId,
            HttpServletRequest request
    ) {
        return kernelFacade.findTrace(executionId, runtimeContextService.currentContext(request))
                .map(ResponseEntity::ok)
                .orElseGet(() -> ResponseEntity.notFound().build());
    }

    @GetMapping
    public List<FlowTrace> searchTraces(
            @RequestParam(required = false) String correlationId,
            @RequestParam(required = false) String flowName,
            @RequestParam(required = false) String status,
            @RequestParam(required = false) Long from,
            @RequestParam(required = false) Long to,
            @RequestParam(required = false, defaultValue = "50") Integer limit,
            @RequestParam(required = false, defaultValue = "0") Integer offset,
            HttpServletRequest request
    ) {
        TraceQuery query = new TraceQuery(
                correlationId,
                flowName,
                status,
                from,
                to,
                limit == null ? 50 : limit,
                offset == null ? 0 : offset
        );
        return kernelFacade.searchTraces(query, runtimeContextService.currentContext(request));
    }

    @GetMapping("/summaries")
    public List<TraceSummaryResponse> searchTraceSummaries(
            @RequestParam(required = false) String correlationId,
            @RequestParam(required = false) String flowName,
            @RequestParam(required = false) String status,
            @RequestParam(required = false) Long from,
            @RequestParam(required = false) Long to,
            @RequestParam(required = false, defaultValue = "50") Integer limit,
            @RequestParam(required = false, defaultValue = "0") Integer offset,
            HttpServletRequest request
    ) {
        TraceQuery query = new TraceQuery(
                correlationId,
                flowName,
                status,
                from,
                to,
                limit == null ? 50 : limit,
                offset == null ? 0 : offset
        );
        return kernelFacade.searchTraceSummaries(query, runtimeContextService.currentContext(request)).stream()
                .map(TraceSummaryResponse::from)
                .toList();
    }
}
