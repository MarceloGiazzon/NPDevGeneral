{
  "namespace": "demo.nested",
  "dslVersion": "3.0.0",
  "version": "v1",
  "concepts": [
    {
      "name": "Order",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "id": true,
          "required": true
        },
        {
          "name": "reference",
          "type": "string",
          "required": true
        },
        {
          "name": "shipping",
          "type": "object",
          "properties": {
            "carrier": {
              "type": "string"
            },
            "address": {
              "type": "object",
              "properties": {
                "street": {
                  "type": "string"
                },
                "geo": {
                  "type": "object",
                  "properties": {
                    "lat": {
                      "type": "string"
                    },
                    "lng": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "invariants": [
        {
          "name": "ReferenceRequired",
          "expr": "reference != null && reference != ''"
        }
      ]
    }
  ],
  "capabilities": [
    {
      "name": "persistence",
      "type": "PersistenceCapability",
      "operations": [
        "save",
        "unique",
        "findById"
      ]
    }
  ]
}
